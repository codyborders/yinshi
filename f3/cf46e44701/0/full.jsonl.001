s None:\n            database.execute(\n                \"\"\"INSERT INTO workspaces (repo_id, name, branch, path, state)\n                   VALUES (?, ?, ?, ?, 'archived')\"\"\",\n                (repo_id, f\"{name} (cleanup required)\", branch, path),\n            )\n        database.commit()\n    except BaseException:\n        database.rollback()\n        raise\n\n\nasync def _settle_unadmitted_worktree(\n    run_database_operation: DatabaseOperationRunner,\n    *,\n    repo_id: str,\n    repo_path: str,\n    worktree_path: str,\n    name: str,\n    branch: str,\n) -> None:\n    \"\"\"Remove an unadmitted worktree or persist its exact cleanup owner.\"\"\"\n    attempt = asyncio.create_task(delete_worktree(repo_path, worktree_path))\n    cancellation: asyncio.CancelledError | None = None\n    try:\n        await asyncio.shield(attempt)\n    except asyncio.CancelledError as error:\n        cancellation = error\n        while not attempt.done():\n            try:\n                await asyncio.shield(attempt)\n            except asyncio.CancelledError:\n                continue\n            except (GitError, OSError):\n                break\n    cleanup_error: BaseException | None = None\n    if not attempt.cancelled():\n        try:\n            attempt.result()\n        except (GitError, OSError) as error:\n            cleanup_error = error\n    if cleanup_error is not None:\n        record = asyncio.create_task(\n            run_database_operation(\n                lambda database: _record_unadmitted_worktree(\n                    database,\n                    repo_id=repo_id,\n                    name=name,\n                    branch=branch,\n                    path=worktree_path,\n                )\n            )\n        )\n        while not record.done():\n            try:\n                await asyncio.shield(record)\n            except asyncio.CancelledError:\n                continue\n        record.result()\n        if cancellation is None:\n            raise cleanup_error\n    if cancellation is not None:\n        raise cancellation\n\n\nasync def _create_workspace_for_repo_unlocked(\n"},{"oldText":"    try:\n        rowid = await run_database_operation(admit)\n    except BaseException:\n        try:\n            await delete_worktree(repo_path, worktree_dir)\n        except (GitError, OSError):\n            logger.warning(\"Failed to remove unadmitted worktree\")\n        raise","newText":"    try:\n        rowid = await run_database_operation(admit)\n    except BaseException:\n        await _settle_unadmitted_worktree(\n            run_database_operation,\n            repo_id=repo_id,\n            repo_path=repo_path,\n            worktree_path=worktree_dir,\n            name=name,\n            branch=branch,\n        )\n        raise"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":993,"output":1431,"cacheRead":231168,"cacheWrite":0,"reasoning":586,"totalTokens":233592,"cost":{"input":0.004965000000000001,"output":0.04293,"cacheRead":0.11558399999999999,"cacheWrite":0,"total":0.16347899999999999}},"stopReason":"toolUse","timestamp":1789289555095,"responseId":"resp_0212e7de83dbbd32016aa66453add087d0b7d7c343a614e461","rawStopReason":"completed"}}
