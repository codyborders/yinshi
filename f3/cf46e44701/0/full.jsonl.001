     raise TypeError(\"broker private key is invalid\")\n447-        if not callable(getattr(launch_service, \"handle\", None)):\n448-            raise TypeError(\"launch service is invalid\")\n449-        if type(replica_lifecycle_enabled) is not bool:\n450-            raise TypeError(\"replica lifecycle gate is invalid\")\n451-        if replica_lifecycle_enabled and replica_coordinator is None:\n452-            raise ValueError(\"enabled replica lifecycle requires a coordinator\")\n453-        self._broker_incarnation = broker_incarnation\n454-        self._database_incarnation = database_incarnation\n455-        self._application_uid = application_uid\n456-        self._application_public_key = application_public_key\n457-        self._broker_private_key = broker_private_key\n458-        self._launch_service = launch_service\n459-        self._replica_coordinator = replica_coordinator\n460-        self._replica_lifecycle_enabled = replica_lifecycle_enabled\n461-\n462-    @property\n463-    def application_uid(self) -> int:\n464-        return self._application_uid\n465-\n466-    def _authenticate(self, frame: bytes, *, peer_uid: int) -> BrokerRequest:\n467-        if type(peer_uid) is not int or peer_uid != self._application_uid:\n468-            raise BrokerProtocolError(\"broker peer UID is not authorized\")\n469-        request = parse_signed_request(frame, public_key=self._application_public_key)\n470-        if request.broker_incarnation != self._broker_incarnation:\n471-            raise BrokerProtocolError(\"broker incarnation is stale\")\n472-        if request.database_incarnation != self._database_incarnation:\n473-            raise BrokerProtocolError(\"database incarnation is stale\")\n474-        return request\n475-\n476-    def _disabled_replica_response(self, request: BrokerRequest) -> bytes:\n477-        return create_signed_response(\n478-            request,\n479-            private_key=self._broker_private_key,\n480-            status=\"error\",\n481-            error=\"replica_lifecycle_disabled\",\n482-            result={\n483-                \"stage\": \"ingest\",\n484-                \"state\": \"rejected\",\n485-                \"code\": \"replica_lifecycle_disabled\",\n486-            },\n487-        )\n488-\n489-    async def handle(self, frame: bytes, *, peer_uid: int) -> bytes:\n490-        \"\"\"Route authenticated launch and replica frames without schema overlap.\"\"\"\n491-        request = self._authenticate(frame, peer_uid=peer_uid)\n492-        if request.request_type == _SUPPORTED_REQUEST_TYPE:\n493-            return await self._launch_service.handle(frame, peer_uid=peer_uid)\n494-        if request.request_type != _REPLICA_REQUEST_TYPE:\n495-            raise BrokerProtocolError(\"broker request type is not supported\")\n496-        if not self._replica_lifecycle_enabled:\n497-            return self._disabled_replica_response(request)\n498-        try:\n499-            authority: ReplicaAuthority = replica_authority_from_request(request)\n500-        except (TypeError, ValueError) as error:\n501-            raise BrokerProtocolError(\"replica lifecycle payload is invalid\") from error\n502-        coordinator = self._replica_coordinator\n503-        if coordinator is None:\n504-            raise RuntimeError(\"enabled replica lifecycle has no coordinator\")\n505-        return await coordinator.run(request, frame, authority)\n1022:class BrokerReplicaJournal:\n1025:    def __init__(\n1594:    def require_response_signer(\n"}],"isError":false,"timestamp":1789324025798}}
