{"type":"message","id":"1bdc3123","parentId":"17389b64","timestamp":"2026-09-12T18:19:53.567Z","message":{"role":"toolResult","toolCallId":"call_uexgbXcJrFUcmlKpslnKYikF|fc_0212e7de83dbbd32016aa597c894a087d0ba9d43565b1a0921","toolName":"bash","content":[{"type":"text","text":" backend/tests/test_workspace_replica_artifact.py | 1147 ++++++++++++++++++++++\n 1 file changed, 1147 insertions(+)\n1147\t0\tbackend/tests/test_workspace_replica_artifact.py\n485:def test_encoder_checks_aggregate_sizes_before_building_payloads(\n503:def test_encoder_checks_total_size_before_framing(monkeypatch: pytest.MonkeyPatch) -> None:\n512:def test_limit_object_rejects_boolean_negative_and_inconsistent_values() -> None:\n523:def test_decoder_rejects_envelope_corruption() -> None:\n538:def test_decoder_rejects_digest_unknown_section_and_reordering() -> None:\n552:def test_decoder_rejects_control_count_and_aggregate_mismatches() -> None:\n568:def test_decoder_rejects_manifest_kind_flags_parent_and_order_corruption() -> None:\n587:def test_decoder_enforces_consumer_limits_before_payload_conversion() -> None:\n600:def test_exact_limits_pass_and_one_byte_less_fails() -> None:\n632:def test_errors_do_not_include_raw_path_or_content() -> None:\n643:def test_source_state_digest_binds_every_section() -> None:\n663:def test_decode_v2_index_sha1_single_entry() -> None:\n674:def test_decode_v2_index_sha1_multiple_entries_same_file_different_stages() -> None:\n698:def test_decode_v2_index_sha1_preserves_index_bytes_exact() -> None:\n713:def test_decode_v3_index_sha1_single_entry() -> None:\n723:def test_decode_v3_index_sha1_multiple_entries() -> None:\n747:def test_decode_v2_index_sha256_single_entry() -> None:\n766:def test_decode_v2_index_sha256_multiple_entries() -> None:\n792:def test_decode_v3_index_sha256_single_entry() -> None:\n810:def test_decode_v3_index_sha256_multiple_entries() -> None:\n837:def test_derive_oid_per_distinct_nonzero_index_stage() -> None:\n860:def test_derive_oid_ignores_zero_sha1() -> None:\n883:def test_roots_equals_sorted_unique_head_plus_derived_index_oids_sha1() -> None:\n903:def test_roots_equals_sorted_unique_head_plus_derived_index_oids_sha256() -> None:\n929:def test_reject_omitted_roots_with_index() -> None:\n945:def test_reject_omitted_roots_empty() -> None:\n963:def test_reject_injected_root_not_from_head_or_index() -> None:\n979:def test_reject_injected_root_extra_beyond_derived_set() -> None:\n1001:def test_reject_wrong_object_format_in_control() -> None:\n1011:def test_reject_trailer_digest_mismatch() -> None:\n1023:def test_reject_truncated_section_header() -> None:\n1032:def test_reject_truncated_control_payload() -> None:\n1041:def test_reject_truncated_manifest_entries() -> None:\n1053:def test_reject_bad_trailer_checksum() -> None:\n1067:def test_reject_unsorted_manifest_entries() -> None:\n1082:def test_reject_duplicate_path_stage_in_index() -> None:\n1101:def test_reject_stage_zero_conflict_mixture() -> None:\n1121:def test_reject_zero_oid_as_non_intent_to_add() -> None:\n1136:def test_allow_intent_to_add_zero_oid_representation() -> None:\n1165:def test_reject_unsupported_mode_in_index() -> None:\n1182:def test_reject_gitlink_entry() -> None:\n1199:def test_reject_sparse_directory_entry() -> None:\n1228:def test_reject_index_version_4() -> None:\n1245:def test_reject_split_index_extension() -> None:\n1264:def test_reject_unknown_mandatory_extension() -> None:\n1291:def test_reject_malformed_optional_extension() -> None:\n1318:def test_reject_null_byte_in_path() -> None:\n1343:def test_reject_trailing_malformed_data() -> None:\n1350:def test_reject_trailing_garbage_in_section() -> None:\n1361:def test_accept_optional_extension_tree() -> None:\n1384:def test_accept_optional_extension_reuc() -> None:\n1406:def test_accept_optional_extension_untr() -> None:\n1428:def test_accept_optional_extension_fsmn() -> None:\n1450:def test_accept_optional_extension_eoie() -> None:\n1471:def test_accept_optional_extension_ieot() -> None:\n1495:def test_accept_conflict_stages_1_2_3() -> None:\n1518:def _create_sha1_repo_with_file(tmpdir: str) -> tuple[str, bytes, str]:\n1545:def _create_sha256_repo_with_file(tmpdir: str) -> tuple[str, bytes, str]:\n1572:def test_real_git_index_v2_sha1_round_trip() -> None:\n1597:def test_real_git_index_sha256_round_trip() -> None:\n"}],"isError":false,"timestamp":1789237193567}}
{"type":"message","id":"c1afe6fb","parentId":"1bdc3123","timestamp":"2026-09-12T18:19:59.363Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Assessing test implementation quality**","thinkingSignature":"{\"id\":\"rs_0212e7de83dbbd32016aa597cdf36887d0af49ce069e73664a\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"REDACTED\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Assessing test implementation quality**\"}]}"},{"type":"toolCall","id":"call_Sj5LJbg9n4Cpqat4ue5aLbD4|fc_0212e7de83dbbd32016aa597ced62887d0a344366054807bae","name":"read","arguments":{"path":"/Users/user/projects/yinshi/backend/tests/test_workspace_replica_artifact.py","offset":640,"limit":1030}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":1228,"output":62,"cacheRead":122624,"cacheWrite":0,"reasoning":20,"totalTokens":123914,"cost":{"input":0.0061400000000000005,"output":0.00186,"cacheRead":0.061312,"cacheWrite":0,"total":0.069312}},"stopReason":"toolUse","timestamp":1789237193573,"responseId":"resp_0212e7de83dbbd32016aa597cb233487d0acddcbdd116cada2","rawStopReason":"completed"}}
{"type":"message","id":"e1358519","parentId":"c1afe6fb","timestamp":"2026-09-12T18:19:59.375Z","message":{"role":"toolResult","toolCallId":"call_Sj5LJbg9n4Cpqat4ue5aLbD4|fc_0212e7de83dbbd32016aa597ced62887d0a344366054807bae","toolName":"read","content":[{"type":"text","text":"    assert \"customer-secret-sentinel\" not in str(excinfo.value)\n\n\ndef test_source_state_digest_binds_every_section() -> None:\n    source = artifact_input()\n    original = decode_worktree_artifact(encode_worktree_artifact(source))\n    changed_entry = replace(source.entries[1], content=b\"changed\")\n    changed = replace(source, entries=(source.entries[0], changed_entry, source.entries[2]))\n    different = decode_worktree_artifact(encode_worktree_artifact(changed))\n    assert original.source_state_sha256 != different.source_state_sha256\n\n    digests = [\n        hashlib.sha256(payload).digest()\n        for _, payload in sections(encode_worktree_artifact(source))\n    ]\n    expected = hashlib.sha256(b\"yinshi-replica-source-v1\\x00\" + b\"\".join(digests)).digest()\n    assert artifact_module.compute_source_state_sha256(*digests) == expected\n    assert expected == original.source_state_sha256\n\n\n# ---- Git index v2 parsing (SHA-1) ----\n\n\ndef test_decode_v2_index_sha1_single_entry() -> None:\n    sha1 = b\"\\x00\\x01\\x02\\x03\" + b\"\\x04\" * 16\n    index_bytes = _build_git_index_v2([(0o100644, sha1, b\"file.txt\")])\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID, sha1))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n    assert decoded.index_bytes == index_bytes\n    assert sha1 in decoded.root_oids\n\n\ndef test_decode_v2_index_sha1_multiple_entries_same_file_different_stages() -> None:\n    \"\"\"Three entries for 'conflict' at stages 1, 2, 3 must each contribute distinct OIDs.\"\"\"\n    sha1_1 = b\"\\x01\" * 20\n    sha1_2 = b\"\\x02\" * 20\n    sha1_3 = b\"\\x03\" * 20\n    table = bytearray()\n    for stage, sha1 in [(1, sha1_1), (2, sha1_2), (3, sha1_3)]:\n        table += _build_entry(0o100644, sha1, b\"conflict\", stage)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 3) + bytes(table) + checksum\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(OID, sha1_1, sha1_2, sha1_3),\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n    assert all(oid in decoded.root_oids for oid in (OID, sha1_1, sha1_2, sha1_3))\n\n\ndef test_decode_v2_index_sha1_preserves_index_bytes_exact() -> None:\n    entries = [\n        (0o100644, b\"\\x10\" * 20, b\"a.txt\"),\n        (0o100644, b\"\\x20\" * 20, b\"b.txt\"),\n    ]\n    index_bytes = _build_git_index_v2(entries)\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.index_bytes == index_bytes\n\n\n# ---- Git index v3 parsing (SHA-1) ----\n\n\ndef test_decode_v3_index_sha1_single_entry() -> None:\n    sha1 = b\"\\xab\\xcd\" + b\"\\xef\" * 18\n    index_bytes = _build_git_index_v3([(0o100644, sha1, b\"file.txt\")])\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID, sha1))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n    assert decoded.index_bytes == index_bytes\n\n\ndef test_decode_v3_index_sha1_multiple_entries() -> None:\n    sha1_a = b\"\\xaa\" * 20\n    sha1_b = b\"\\xbb\" * 20\n    sha1_c = b\"\\xcc\" * 20\n    index_bytes = _build_git_index_v3([\n        (0o100644, sha1_a, b\"a.txt\"),\n        (0o100644, sha1_b, b\"b.txt\"),\n        (0o100644, sha1_c, b\"c.txt\"),\n    ])\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(OID, sha1_a, sha1_b, sha1_c),\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n    assert all(oid in decoded.root_oids for oid in (OID, sha1_a, sha1_b, sha1_c))\n\n\n# ---- Git index v2 parsing (SHA-256) ----\n\n\ndef test_decode_v2_index_sha256_single_entry() -> None:\n    sha256 = b\"\\xde\\xad\" + b\"\\xbe\\xef\" * 15\n    index_bytes = _build_git_index_v2_sha256([(0o100644, sha256, b\"blob.bin\")])\n    source = WorktreeArtifactInput(\n        object_format=\"sha256\",\n        head_state=\"symbolic\",\n        head_target=b\"refs/heads/main\",\n        head_oid=sha256,\n        index_bytes=index_bytes,\n        root_oids=(sha256,),\n        policy_digest=b\"p\" * 32,\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.object_format == \"sha256\"\n    assert decoded.has_index is True\n    assert decoded.index_bytes == index_bytes\n\n\ndef test_decode_v2_index_sha256_multiple_entries() -> None:\n    sha256_a = b\"\\x11\" * 32\n    sha256_b = b\"\\x22\" * 32\n    index_bytes = _build_git_index_v2_sha256([\n        (0o100644, sha256_a, b\"a.bin\"),\n        (0o100644, sha256_b, b\"b.bin\"),\n    ])\n    source = WorktreeArtifactInput(\n        object_format=\"sha256\",\n        head_state=\"symbolic\",\n        head_target=b\"refs/heads/main\",\n        head_oid=sha256_a,\n        index_bytes=index_bytes,\n        root_oids=(sha256_a, sha256_b),\n        policy_digest=b\"q\" * 32,\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.object_format == \"sha256\"\n    assert sha256_a in decoded.root_oids\n    assert sha256_b in decoded.root_oids\n\n\n# ---- Git index v3 parsing (SHA-256) ----\n\n\ndef test_decode_v3_index_sha256_single_entry() -> None:\n    sha256 = b\"\\xca\\xfe\" + b\"\\xba\\xbe\" * 15\n    index_bytes = _build_git_index_v3_sha256([(0o100644, sha256, b\"data\")])\n    source = WorktreeArtifactInput(\n        object_format=\"sha256\",\n        head_state=\"symbolic\",\n        head_target=b\"refs/heads/main\",\n        head_oid=sha256,\n        index_bytes=index_bytes,\n        root_oids=(sha256,),\n        policy_digest=b\"r\" * 32,\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.object_format == \"sha256\"\n    assert decoded.has_index is True\n\n\ndef test_decode_v3_index_sha256_multiple_entries() -> None:\n    sha256_x = b\"\\xaa\" * 32\n    sha256_y = b\"\\xbb\" * 32\n    sha256_z = b\"\\xcc\" * 32\n    index_bytes = _build_git_index_v3_sha256([\n        (0o100644, sha256_x, b\"x\"),\n        (0o100644, sha256_y, b\"y\"),\n        (0o100644, sha256_z, b\"z\"),\n    ])\n    source = WorktreeArtifactInput(\n        object_format=\"sha256\",\n        head_state=\"symbolic\",\n        head_target=b\"refs/heads/main\",\n        head_oid=sha256_x,\n        index_bytes=index_bytes,\n        root_oids=(sha256_x, sha256_y, sha256_z),\n        policy_digest=b\"s\" * 32,\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n    assert all(oid in decoded.root_oids for oid in (sha256_x, sha256_y, sha256_z))\n\n\n# ---- OID derivation: every distinct nonzero index-stage OID ----\n\n\ndef test_derive_oid_per_distinct_nonzero_index_stage() -> None:\n    \"\"\"Each distinct (path, stage) with nonzero sha1 contributes one OID to ROOTS.\"\"\"\n    sha1_a = b\"\\xa1\" * 20\n    sha1_b = b\"\\xb2\" * 20\n    sha1_c = b\"\\xc3\" * 20\n    index_bytes = _build_git_index_v2([\n        (0o100644, sha1_a, b\"same\"),\n        (0o100644, sha1_b, b\"other\"),\n        (0o100644, sha1_c, b\"same\"),\n    ])\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(OID, sha1_a, sha1_b, sha1_c),\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert sha1_a in decoded.root_oids\n    assert sha1_b in decoded.root_oids\n    assert sha1_c in decoded.root_oids\n\n\ndef test_derive_oid_ignores_zero_sha1() -> None:\n    \"\"\"Entries with all-zero sha1 must not contribute OID to ROOTS.\"\"\"\n    sha1 = b\"\\xd4\" * 20\n    zero = b\"\\x00\" * 20\n    index_bytes = _build_git_index_v2([\n        (0o100644, sha1, b\"real\"),\n        (0o100644, zero, b\"intent\"),\n    ])\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=sha1,\n        root_oids=(sha1,),\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert sha1 in decoded.root_oids\n    assert zero not in decoded.root_oids\n\n\n# ---- ROOTS equality: sorted unique HEAD OID + derived index OIDs ----\n\n\ndef test_roots_equals_sorted_unique_head_plus_derived_index_oids_sha1() -> None:\n    \"\"\"ROOTS must equal sorted unique HEAD OID plus all derived index OIDs.\"\"\"\n    sha1_1 = b\"\\xe1\" * 20\n    sha1_2 = b\"\\xe2\" * 20\n    index_bytes = _build_git_index_v2([\n        (0o100644, sha1_1, b\"a\"),\n        (0o100644, sha1_2, b\"b\"),\n    ])\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(sha1_1, sha1_2, OID),\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    expected_roots = tuple(sorted(set((OID, sha1_1, sha1_2))))\n    assert decoded.root_oids == expected_roots\n\n\ndef test_roots_equals_sorted_unique_head_plus_derived_index_oids_sha256() -> None:\n    \"\"\"ROOTS must equal sorted unique HEAD OID plus all derived index OIDs (SHA-256).\"\"\"\n    sha256_1 = b\"\\xf1\" * 32\n    sha256_2 = b\"\\xf2\" * 32\n    index_bytes = _build_git_index_v2_sha256([\n        (0o100644, sha256_1, b\"a\"),\n        (0o100644, sha256_2, b\"b\"),\n    ])\n    source = WorktreeArtifactInput(\n        object_format=\"sha256\",\n        head_state=\"symbolic\",\n        head_target=b\"refs/heads/main\",\n        head_oid=sha256_1,\n        index_bytes=index_bytes,\n        root_oids=(sha256_1, sha256_2),\n        policy_digest=b\"t\" * 32,\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    expected_roots = tuple(sorted(set((sha256_1, sha256_2))))\n    assert decoded.root_oids == expected_roots\n\n\n# ---- Rejection: omitted roots when index present ----\n\n\ndef test_reject_omitted_roots_with_index() -> None:\n    \"\"\"When index is present and HEAD OID is set, omitting roots that include HEAD OID fails.\"\"\"\n    sha1 = b\"\\xa0\" * 20\n    index_bytes = _build_git_index_v2([(0o100644, sha1, b\"f\")])\n    # HEAD OID is set but roots only have sha1 (missing HEAD OID)\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(sha1,),\n    )\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\ndef test_reject_omitted_roots_empty() -> None:\n    \"\"\"Empty root_oids must be rejected when index and head_oid are present.\"\"\"\n    sha1 = b\"\\xb0\" * 20\n    index_bytes = _build_git_index_v2([(0o100644, sha1, b\"f\")])\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(),\n    )\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: injected roots (root not from HEAD or index) ----\n\n\ndef test_reject_injected_root_not_from_head_or_index() -> None:\n    \"\"\"Roots must only contain HEAD OID or OIDs derivable from index entries.\"\"\"\n    sha1 = b\"\\xc0\" * 20\n    index_bytes = _build_git_index_v2([(0o100644, sha1, b\"f\")])\n    injected = b\"\\xff\" * 20\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(OID, sha1, injected),\n    )\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\ndef test_reject_injected_root_extra_beyond_derived_set() -> None:\n    \"\"\"Extra root OIDs that do not come from HEAD or index entries must be rejected.\"\"\"\n    sha1_a = b\"\\xa1\" * 20\n    sha1_b = b\"\\xa2\" * 20\n    index_bytes = _build_git_index_v2([\n        (0o100644, sha1_a, b\"a\"),\n    ])\n    extra = b\"\\xee\" * 20\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(OID, sha1_a, extra),\n    )\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: wrong object format ----\n\n\ndef test_reject_wrong_object_format_in_control() -> None:\n    \"\"\"Unsupported format code in control section must be rejected.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    values = sections(encoded)\n    control = bytearray(values[0][1])\n    control[0] = 99  # invalid format code\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(reframe([(1, bytes(control)), *values[1:]]))\n\n\ndef test_reject_trailer_digest_mismatch() -> None:\n    \"\"\"A corrupted trailer digest must be rejected.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    damaged = bytearray(encoded)\n    damaged[-1] ^= 0xFF\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(bytes(damaged))\n\n\n# ---- Rejection: truncated entries ----\n\n\ndef test_reject_truncated_section_header() -> None:\n    \"\"\"Artifact with truncated section header must be rejected.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    # Chop off the last section's header\n    truncated = encoded[:36 + 3 * 44 + 10]\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(truncated)\n\n\ndef test_reject_truncated_control_payload() -> None:\n    \"\"\"Truncated control payload must be rejected.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    values = sections(encoded)\n    short_control = values[0][1][:10]\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(reframe([(1, short_control), *values[1:]]))\n\n\ndef test_reject_truncated_manifest_entries() -> None:\n    \"\"\"Manifest with truncated entry must be rejected.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    values = sections(encoded)\n    manifest = values[2][1][:20]\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(reframe([*values[:2], (3, manifest), values[3]]))\n\n\n# ---- Rejection: bad checksum (trailer) ----\n\n\ndef test_reject_bad_trailer_checksum() -> None:\n    \"\"\"A single-bit flip in the trailer digest must be rejected.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    # Flip a byte in the last section's digest area (bytes 36-43 of last section)\n    last_section_start = len(encoded) - 44 - len(values[3][1]) if (values := sections(encoded)) else 0\n    damaged = bytearray(encoded)\n    damaged[-43] ^= 1\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(bytes(damaged))\n\n\n# ---- Rejection: unsorted entries ----\n\n\ndef test_reject_unsorted_manifest_entries() -> None:\n    \"\"\"Manifest entries must be sorted by path.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    values = sections(encoded)\n    manifest = bytearray(values[2][1])\n    # Swap first two path lengths to create unsorted order\n    if len(manifest) >= 28:\n        manifest[16:20], manifest[20:24] = manifest[20:24], manifest[16:20]\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(reframe([*values[:2], (3, bytes(manifest)), values[3]]))\n\n\n# ---- Rejection: duplicate (path, stage) ----\n\n\ndef test_reject_duplicate_path_stage_in_index() -> None:\n    \"\"\"Two entries with same path and same stage must be rejected.\"\"\"\n    table = bytearray()\n    # Two entries for same path with same stage\n    for _ in range(2):\n        table += _build_entry(0o100644, b\"\\x11\" * 20, b\"dup\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 2) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: stage-zero and conflict mixture ----\n\n\ndef test_reject_stage_zero_conflict_mixture() -> None:\n    \"\"\"Mixing stage-0 (normal) entries with stage-1/2/3 (conflict) entries is invalid.\"\"\"\n    table = bytearray()\n    # Stage 0 (normal)\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"normal\", 0)\n    # Stage 2 (conflict)\n    table += _build_entry(0o100644, b\"\\x02\" * 20, b\"conflict\", 2)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 2) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: zero OIDs except intent-to-add ----\n\n\ndef test_reject_zero_oid_as_non_intent_to_add() -> None:\n    \"\"\"All-zero sha1 that is not intent-to-add must be rejected from ROOTS.\"\"\"\n    zero = b\"\\x00\" * 20\n    table = bytearray()\n    table += _build_entry(0o100644, zero, b\"zero\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 1) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\ndef test_allow_intent_to_add_zero_oid_representation() -> None:\n    \"\"\"Intent-to-add uses zero OID with flag bit 0x8000.\"\"\"\n    table = bytearray()\n    # mode=0, flags=0x8000 | len(b\"i2a\") = 0x8003, path=\"i2a\", sha1=zero\n    mode = 0\n    sha1 = b\"\\x00\" * 20\n    path = b\"i2a\"\n    buf = bytearray()\n    buf += struct.pack(\">I\", mode)\n    buf += sha1[4:]  # 16 bytes\n    flags = (0 << 12) | len(path)  # stage=0\n    buf += struct.pack(\">H\", flags)  # this won't set the high bit we need\n    buf += path\n    if not path.endswith(b\"\\x00\"):\n        buf += b\"\\x00\"\n    table = buf\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 1) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n\n\n# ---- Rejection: unsupported modes ----\n\n\ndef test_reject_unsupported_mode_in_index() -> None:\n    \"\"\"Mode value 0 in index entry must be rejected.\"\"\"\n    table = bytearray()\n    table += _build_entry(0, b\"\\x01\" * 20, b\"bad_mode\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 1) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: gitlink (submodule) entries ----\n\n\ndef test_reject_gitlink_entry() -> None:\n    \"\"\"Gitlink mode (0o160000) must be rejected.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o160000, b\"\\x01\" * 20, b\"sub\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 1) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: sparse directory entries ----\n\n\ndef test_reject_sparse_directory_entry() -> None:\n    \"\"\"Sparse directory entries (mode 0o040000 with extension flag) must be rejected.\"\"\"\n    table = bytearray()\n    # Sparse dir: mode with high bits set for extension\n    sparse_mode = 0o040000\n    sha1 = b\"\\x02\" * 20\n    path = b\"sparse\"\n    buf = bytearray()\n    buf += struct.pack(\">I\", sparse_mode)\n    buf += sha1[4:]\n    flags = len(path)\n    buf += struct.pack(\">H\", flags)\n    buf += path\n    if not path.endswith(b\"\\x00\"):\n        buf += b\"\\x00\"\n    table = buf\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 1) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: index v4 ----\n\n\ndef test_reject_index_version_4() -> None:\n    \"\"\"Git index version 4 must be rejected.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x04\\x00\\x00\\x00\" + struct.pack(\">I\", 1) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: split-index link extension ----\n\n\ndef test_reject_split_index_extension() -> None:\n    \"\"\"Split-index (SAMD) extension must be rejected.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 1) + bytes(table) + checksum\n    # Append split-index extension: 4-byte \"SAMD\" + 8-byte link_offset\n    index_bytes += b\"SAMD\" + struct.pack(\">Q\", 0)\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: unknown mandatory extensions ----\n\n\ndef test_reject_unknown_mandatory_extension() -> None:\n    \"\"\"Unknown extension with high bit set (mandatory) must be rejected.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    # Build index with unknown mandatory extension (high bit of name = 1)\n    # name[0] |= 0x80 means mandatory extension\n    unknown_ext_name = bytes([0x80 | ord(\"X\"), ord(\"Y\"), ord(\"Z\"), ord(\"_\")])\n    index_bytes = (\n        b\"DIRC\\x02\\x00\\x00\\x00\"\n        + struct.pack(\">I\", 1)\n        + bytes(table)\n        + checksum\n        + unknown_ext_name\n        + b\"\\x00\" * 8  # extension data\n    )\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: malformed optional extensions ----\n\n\ndef test_reject_malformed_optional_extension() -> None:\n    \"\"\"Optional extension (name high bit = 0) that is not in the known list must be rejected.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    # Known optional extension names: TRREE (TREE), REUC, UNTR, FSMN, EOIE, IEOT\n    # Use an unknown optional extension name (high bit = 0)\n    bad_opt_ext = b\"ABCD\"  # not in known optional set\n    index_bytes = (\n        b\"DIRC\\x02\\x00\\x00\\x00\"\n        + struct.pack(\">I\", 1)\n        + bytes(table)\n        + checksum\n        + bad_opt_ext\n        + b\"\\x00\" * 4\n    )\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: unsafe raw paths ----\n\n\ndef test_reject_null_byte_in_path() -> None:\n    \"\"\"Paths containing null bytes must be rejected.\"\"\"\n    table = bytearray()\n    sha1 = b\"\\x01\" * 20\n    path = b\"safe\\x00path\"\n    buf = bytearray()\n    buf += struct.pack(\">I\", 0o100644)\n    buf += sha1[4:]\n    flags = len(path)\n    buf += struct.pack(\">H\", flags)\n    buf += path\n    table = buf\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", 1) + bytes(table) + checksum\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded)\n\n\n# ---- Rejection: trailing malformed data ----\n\n\ndef test_reject_trailing_malformed_data() -> None:\n    \"\"\"Trailing bytes after all valid sections must be rejected.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded + b\"\\x00\" * 10)\n\n\ndef test_reject_trailing_garbage_in_section() -> None:\n    \"\"\"Trailing garbage after a valid section payload must be rejected.\"\"\"\n    encoded = encode_worktree_artifact(artifact_input())\n    # Append garbage after the end\n    with pytest.raises(WorktreeArtifactDecodeError):\n        decode_worktree_artifact(encoded + b\"garbage\")\n\n\n# ---- Acceptance: supported optional extensions ----\n\n\ndef test_accept_optional_extension_tree() -> None:\n    \"\"\"Optional extension 'TREE' must be accepted when structurally framed.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    # Append TREE extension (known optional)\n    index_bytes = (\n        b\"DIRC\\x02\\x00\\x00\\x00\"\n        + struct.pack(\">I\", 1)\n        + bytes(table)\n        + checksum\n        + b\"TREE\"\n        + struct.pack(\">Q\", 0)  # data offset\n        + b\"\\x00\" * 8  # data\n    )\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n\n\ndef test_accept_optional_extension_reuc() -> None:\n    \"\"\"Optional extension 'REUC' must be accepted.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = (\n        b\"DIRC\\x02\\x00\\x00\\x00\"\n        + struct.pack(\">I\", 1)\n        + bytes(table)\n        + checksum\n        + b\"REUC\"\n        + struct.pack(\">Q\", 0)\n        + b\"\\x00\" * 4\n    )\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n\n\ndef test_accept_optional_extension_untr() -> None:\n    \"\"\"Optional extension 'UNTR' must be accepted.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = (\n        b\"DIRC\\x02\\x00\\x00\\x00\"\n        + struct.pack(\">I\", 1)\n        + bytes(table)\n        + checksum\n        + b\"UNTR\"\n        + struct.pack(\">Q\", 0)\n        + b\"\\x00\" * 4\n    )\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n\n\ndef test_accept_optional_extension_fsmn() -> None:\n    \"\"\"Optional extension 'FSMN' must be accepted.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = (\n        b\"DIRC\\x02\\x00\\x00\\x00\"\n        + struct.pack(\">I\", 1)\n        + bytes(table)\n        + checksum\n        + b\"FSMN\"\n        + struct.pack(\">Q\", 0)\n        + b\"\\x00\" * 4\n    )\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n\n\ndef test_accept_optional_extension_eoie() -> None:\n    \"\"\"Optional extension 'EOIE' must be accepted.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = (\n        b\"DIRC\\x02\\x00\\x00\\x00\"\n        + struct.pack(\">I\", 1)\n        + bytes(table)\n        + checksum\n        + b\"EOIE\"\n        + b\"\\x00\" * 4\n    )\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n\n\ndef test_accept_optional_extension_ieot() -> None:\n    \"\"\"Optional extension 'IEOT' must be accepted.\"\"\"\n    table = bytearray()\n    table += _build_entry(0o100644, b\"\\x01\" * 20, b\"f\", 0)\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    index_bytes = (\n        b\"DIRC\\x02\\x00\\x00\\x00\"\n        + struct.pack(\">I\", 1)\n        + bytes(table)\n        + checksum\n        + b\"IEOT\"\n        + b\"\\x00\" * 4\n    )\n    source = replace(artifact_input(), index_bytes=index_bytes, root_oids=(OID,))\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n\n\n# ---- Acceptance: conflict stages 1/2/3 ----\n\n\ndef test_accept_conflict_stages_1_2_3() -> None:\n    \"\"\"Conflict stages 1, 2, and 3 must be accepted for the same path.\"\"\"\n    index_bytes = _build_conflict_index_sha1()\n    sha1_1 = b\"\\x01\" * 20\n    sha1_2 = b\"\\x02\" * 20\n    sha1_3 = b\"\\x03\" * 20\n    source = replace(\n        artifact_input(),\n        index_bytes=index_bytes,\n        head_oid=OID,\n        root_oids=(OID, sha1_1, sha1_2, sha1_3),\n    )\n    encoded = encode_worktree_artifact(source)\n    decoded = decode_worktree_artifact(encoded)\n    assert decoded.has_index is True\n    assert sha1_1 in decoded.root_oids\n    assert sha1_2 in decoded.root_oids\n    assert sha1_3 in decoded.root_oids\n\n\n# ---- Real Git repository index fixtures ----\n\n\ndef _create_sha1_repo_with_file(tmpdir: str) -> tuple[str, bytes, str]:\n    \"\"\"Create a real Git repo (SHA-1) with one file, return (repo_path, index_bytes, head_oid).\"\"\"\n    repo = os.path.join(tmpdir, \"sha1_repo\")\n    os.makedirs(repo)\n    subprocess.run([\"git\", \"init\", \"--initial-branch=main\"], cwd=repo,\n                   check=True, capture_output=True)\n    subprocess.run([\"git\", \"config\", \"user.email\", \"test@test.com\"], cwd=repo,\n                   check=True, capture_output=True)\n    subprocess.run([\"git\", \"config\", \"user.name\", \"Test\"], cwd=repo,\n                   check=True, capture_output=True)\n    # Create and commit a file\n    with open(os.path.join(repo, \"file.txt\"), \"w\") as f:\n        f.write(\"content\")\n    subprocess.run([\"git\", \"add\", \"file.txt\"], cwd=repo, check=True, capture_output=True)\n    subprocess.run([\"git\", \"commit\", \"-m\", \"initial\"], cwd=repo, check=True, capture_output=True)\n    # Read index\n    idx_path = os.path.join(repo, \".git\", \"index\")\n    with open(idx_path, \"rb\") as f:\n        index_bytes = f.read()\n    # Get HEAD OID\n    head_oid_hex = subprocess.run(\n        [\"git\", \"rev-parse\", \"HEAD\"], cwd=repo, check=True, capture_output=True, text=True\n    ).stdout.strip()\n    head_oid = bytes.fromhex(head_oid_hex)\n    return repo, index_bytes, head_oid\n\n\ndef _create_sha256_repo_with_file(tmpdir: str) -> tuple[str, bytes, str]:\n    \"\"\"Create a real Git repo (SHA-256) with one file, return (repo_path, index_bytes, head_oid).\"\"\"\n    repo = os.path.join(tmpdir, \"sha256_repo\")\n    os.makedirs(repo)\n    subprocess.run(\n        [\"git\", \"init\", \"--initial-branch=main\", \"--object-format\", \"sha256\"],\n        cwd=repo, check=True, capture_output=True,\n    )\n    subprocess.run([\"git\", \"config\", \"user.email\", \"test@test.com\"], cwd=repo,\n                   check=True, capture_output=True)\n    subprocess.run([\"git\", \"config\", \"user.name\", \"Test\"], cwd=repo,\n                   check=True, capture_output=True)\n    with open(os.path.join(repo, \"file.txt\"), \"w\") as f:\n        f.write(\"content\")\n    subprocess.run([\"git\", \"add\", \"file.txt\"], cwd=repo, check=True, capture_output=True)\n    subprocess.run([\"git\", \"commit\", \"-m\", \"initial\"], cwd=repo,\n                   check=True, capture_output=True)\n    idx_path = os.path.join(repo, \".git\", \"index\")\n    with open(idx_path, \"rb\") as f:\n        index_bytes = f.read()\n    head_oid_hex = subprocess.run(\n        [\"git\", \"rev-parse\", \"HEAD\"], cwd=repo, check=True, capture_output=True, text=True\n    ).stdout.strip()\n    head_oid = bytes.fromhex(head_oid_hex)\n    return repo, index_bytes, head_oid\n\n\ndef test_real_git_index_v2_sha1_round_trip() -> None:\n    \"\"\"Decode a real Git SHA-1 index file from a real repository.\"\"\"\n    with tempfile.TemporaryDirectory() as tmpdir:\n        repo, index_bytes, head_oid = _create_sha1_repo_with_file(tmpdir)\n        # Get the OID from the index entry\n        with open(os.path.join(repo, \".git\", \"index\"), \"rb\") as f:\n            raw = f.read()\n        # First entry sha1 starts at byte 12 (after DIRC\\x02\\x00\\x00\\x00 + count)\n        mode = struct.unpack(\">I\", raw[8:12])[0]\n        entry_sha1 = raw[12:32]  # first 4 bytes of mode + 20 bytes sha1 = entries start at 12\n        # Actually: mode (4) + sha1 (20) + flags (2) + path...  starts at offset 12\n        # mode is at 12..16, sha1 is at 16..36\n        entry_sha1 = raw[16:36]\n        source = replace(\n            artifact_input(),\n            index_bytes=index_bytes,\n            head_oid=head_oid,\n            root_oids=(head_oid,),\n        )\n        encoded = encode_worktree_artifact(source)\n        decoded = decode_worktree_artifact(encoded)\n        assert decoded.has_index is True\n        assert decoded.object_format == \"sha1\"\n\n\ndef test_real_git_index_sha256_round_trip() -> None:\n    \"\"\"Decode a real Git SHA-256 index file from a real repository.\"\"\"\n    with tempfile.TemporaryDirectory() as tmpdir:\n        repo, index_bytes, head_oid = _create_sha256_repo_with_file(tmpdir)\n        source = WorktreeArtifactInput(\n            object_format=\"sha256\",\n            head_state=\"symbolic\",\n            head_target=b\"refs/heads/main\",\n            head_oid=head_oid,\n            index_bytes=index_bytes,\n            root_oids=(head_oid,),\n            policy_digest=b\"u\" * 32,\n        )\n        encoded = encode_worktree_artifact(source)\n        decoded = decode_worktree_artifact(encoded)\n        assert decoded.has_index is True\n        assert decoded.object_format == \"sha256\"\n        assert decoded.index_bytes == index_bytes\n"}],"isError":false,"timestamp":1789237199375}}
