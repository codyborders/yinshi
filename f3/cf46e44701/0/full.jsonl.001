s invalid\")\n    return value\n","newText":"def _validate_identifier(name: str, value: object) -> str:\n    try:\n        return validate_replica_identifier(value, name)\n    except ValueError as error:\n        raise ReplicaPublicationRejectedError(str(error)) from error\n"},{"oldText":"    _validate_identifier(\"operation ID\", declaration.operation_id)\n","newText":"    try:\n        validate_replica_operation_id(declaration.operation_id)\n    except ValueError as error:\n        raise ReplicaPublicationRejectedError(str(error)) from error\n"},{"oldText":"    _validate_binding(\n        declaration.index_objects,\n        role=\"index_objects\",\n        maximum=declaration.limits.index_objects.max_pack_bytes,\n    )\n    return declaration\n","newText":"    _validate_binding(\n        declaration.index_objects,\n        role=\"index_objects\",\n        maximum=declaration.limits.index_objects.max_pack_bytes,\n    )\n    try:\n        validate_distinct_artifact_ids(\n            (\n                declaration.bundle.artifact_id,\n                declaration.worktree.artifact_id,\n                declaration.index_objects.artifact_id,\n            )\n        )\n    except ValueError as error:\n        raise ReplicaPublicationRejectedError(str(error)) from error\n    return declaration\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":891,"output":742,"cacheRead":142976,"cacheWrite":0,"reasoning":63,"totalTokens":144609,"cost":{"input":0.004455000000000001,"output":0.022260000000000002,"cacheRead":0.071488,"cacheWrite":0,"total":0.098203}},"stopReason":"toolUse","timestamp":1789256148665,"responseId":"resp_0212e7de83dbbd32016aa5e1d57c1487d0848e219c01c7c857","rawStopReason":"completed"}}
