 return row is not None and tuple(row) == (repo_id, branch, worktree_path)\n\n\ndef _record_retained_unadmitted_workspace(\n    connection: sqlite3.Connection,\n    *,\n    workspace_id: str,\n    repo_id: str,\n    name: str,\n    branch: str,\n    worktree_path: str,\n) -> None:\n"},{"oldText":"    except asyncio.CancelledError:\n        try:\n            await _settle_unadmitted_worktree(\n                run_database_operation,\n                repo_id=repo_id,\n                repo_path=repo_path,\n                worktree_path=worktree_path,\n                name=name,\n                branch=branch,\n            )\n        except (GitError, OSError):\n            pass\n        raise\n","newText":"    except asyncio.CancelledError:\n        reconciliation = asyncio.create_task(\n            run_database_operation(\n                lambda connection: _workspace_admission_matches(\n                    connection,\n                    workspace_id=workspace_id,\n                    repo_id=repo_id,\n                    branch=branch,\n                    worktree_path=worktree_path,\n                )\n            )\n        )\n        admitted = False\n        while not reconciliation.done():\n            try:\n                admitted = await asyncio.shield(reconciliation)\n            except asyncio.CancelledError:\n                continue\n            except BaseException:  # noqa: BLE001 - uncertain admission forbids cleanup\n                admitted = True\n                break\n        if reconciliation.done() and not reconciliation.cancelled():\n            try:\n                admitted = reconciliation.result()\n            except BaseException:  # noqa: BLE001 - uncertain admission forbids cleanup\n                admitted = True\n        if not admitted:\n            try:\n                await _settle_unadmitted_worktree(\n                    run_database_operation,\n                    repo_id=repo_id,\n                    repo_path=repo_path,\n                    worktree_path=worktree_path,\n                    name=name,\n                    branch=branch,\n                )\n            except (GitError, OSError):\n                pass\n        raise\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":666,"output":1303,"cacheRead":62848,"cacheWrite":0,"reasoning":618,"totalTokens":64817,"cost":{"input":0.00333,"output":0.03909,"cacheRead":0.031424,"cacheWrite":0,"total":0.07384399999999999}},"stopReason":"toolUse","timestamp":1789293426420,"responseId":"resp_0212e7de83dbbd32016aa67372d13487d09c24f6f5eb0fbaeb","rawStopReason":"completed"}}
