7     monkeypatch.setattr(module.os, \"lstat\", fail_root)\n 348     with pytest.raises(StageOutcomeUnknown) as unknown:\n     ...\n 350     assert unknown.value.reason == \"transfer_unknown\"\n 351 \n 352 \n 353 @pytest.mark.asyncio\n+358 async def test_verify_publish_and_reconcile_preserve_stage_unknown(\n+359     tmp_path: Path,\n+360     monkeypatch: pytest.MonkeyPatch,\n+361 ) -> None:\n+362     artifact_effects = effects(tmp_path)\n+363 \n+364     @asynccontextmanager\n+365     async def fail_open(\n+366         _self: BrokerArtifactStore,\n+367         _manifest: object,\n+368     ) -> AsyncIterator[object]:\n+369         raise BrokerArtifactStoreUnresolvedError(\"read fault\")\n+370         yield object()\n+371 \n+372     monkeypatch.setattr(BrokerArtifactStore, \"open_incoming_async\", fail_open)\n+373     for stage_name, reason in (\n+374         (\"verify\", \"verification_unknown\"),\n+375         (\"publish\", \"publication_unknown\"),\n+376     ):\n+377         with pytest.raises(StageOutcomeUnknown) as unknown:\n+378             await getattr(artifact_effects, stage_name).apply(lifecycle_context())\n+379         assert unknown.value.reason == reason\n+380 \n+381     async def fail_reconcile(_self: object, _declaration: object) -> object:\n+382         raise ReplicaPublicationUnresolvedError(\"sync fault\")\n+383 \n+384     monkeypatch.setattr(\n+385         WorkspaceReplicaPublicationStore,\n+386         \"reconcile_published_artifact_set\",\n+387         fail_reconcile,\n+388     )\n+389     with pytest.raises(StageOutcomeUnknown) as reconciled:\n+390         await artifact_effects.publish.reconcile(lifecycle_context())\n+391     assert reconciled.value.reason == \"publication_unknown\"\n+392 \n+393 \n+394 @pytest.mark.asyncio\n 354 async def test_publish_reconcile_reports_confirmed_absence(tmp_path: Path) -> None:\n 355     artifact_effects = effects(tmp_path)\n 356     reconciled = await artifact_effects.publish.reconcile(lifecycle_context())\n 357     assert reconciled.outcome == \"not_applied\"\n     ...","patch":"--- backend/tests/test_broker_replica_artifact_effects.py\n+++ backend/tests/test_broker_replica_artifact_effects.py\n@@ -14,8 +14,9 @@\n from yinshi.services.broker_artifact_store import (\n     BrokerArtifactLimits,\n     BrokerArtifactStore,\n     BrokerArtifactStoreRejectedError,\n+    BrokerArtifactStoreUnresolvedError,\n )\n from yinshi.services.broker_protocol import BROKER_PROTOCOL_VERSION, BrokerRequest\n from yinshi.services.broker_replica_artifact_effects import (\n     BrokerReplicaArtifactEffects,\n@@ -40,8 +41,9 @@\n     ReplicaArtifactBinding,\n     ReplicaArtifactSetDeclaration,\n     ReplicaIdentity,\n     ReplicaPublicationReceipt,\n+    ReplicaPublicationUnresolvedError,\n     ReplicaStoreLimits,\n     ReplicaVerificationReceipt,\n     WorkspaceReplicaPublicationStore,\n )\n@@ -323,11 +325,13 @@\n     assert limits.value.status == \"limit_rejected\"\n \n \n @pytest.mark.asyncio\n+@pytest.mark.parametrize(\"error_number\", [errno.EIO, errno.ENOSPC, errno.EMFILE])\n async def test_operational_incoming_failure_is_stage_unknown(\n     tmp_path: Path,\n     monkeypatch: pytest.MonkeyPatch,\n+    error_number: int,\n ) -> None:\n     from yinshi.services import broker_artifact_store as module\n \n     incoming, publication_store = stores(tmp_path)\n@@ -340,9 +344,9 @@\n     real_lstat = os.lstat\n \n     def fail_root(path: object, *args: object, **kwargs: object):\n         if path == incoming_root:\n-            raise OSError(errno.EIO, \"storage fault\")\n+            raise OSError(error_number, \"storage fault\")\n         return real_lstat(path, *args, **kwargs)\n \n     monkeypatch.setattr(module.os, \"lstat\", fail_root)\n     with pytest.raises(StageOutcomeUnknown) as unknown:\n@@ -350,8 +354,45 @@\n     assert unknown.value.reason == \"transfer_unknown\"\n \n \n @pytest.mark.asyncio\n+async def test_verify_publish_and_reconcile_preserve_stage_unknown(\n+    tmp_path: Path,\n+