{"type":"message","id":"beeebd98","parentId":"a9e683c0","timestamp":"2026-09-12T23:01:43.387Z","message":{"role":"toolResult","toolCallId":"call_ayOOf3VZ3Urbt1QqE8H1YsD3|fc_0212e7de83dbbd32016aa5d9d6981087d0b73ca53345c9ec81","toolName":"read","content":[{"type":"text","text":"    if result_extra is not None:\n        result.update(result_extra)\n    return create_signed_response(\n        request,\n        private_key=Ed25519PrivateKey.generate(),\n        status=\"ok\" if state == \"completed\" else \"error\",\n        error=None if state == \"completed\" else code,\n        result=result,\n    )\n\n\ndef journal(tmp_path: Path) -> BrokerReplicaJournal:\n    return BrokerReplicaJournal(tmp_path / \"replica.sqlite3\", application_id=APPLICATION_ID)\n\n\ndef receipt_for(stage: str, artifact_set: str = ARTIFACT_SET_SHA256) -> object:\n    receipt_id = f\"receipt_{stage}_000000000000000000\"\n    if stage == \"ingest\":\n        return IngestReceipt(\n            receipt_id=receipt_id,\n            bundle=BUNDLE,\n            worktree=WORKTREE,\n            REDACTED,\n        )\n    if stage == \"verify\":\n\n[858 more lines in file. Use offset=205 to continue.]"}],"isError":false,"timestamp":1789254103387}}
