d\"\n 513                 ) from error\n 514             attempt_state = \"published\"\n 515             try:\n-516                 return await self._run_blocking(self.inspect_incoming, manifest)\n+516                 return await self.inspect_incoming_async(manifest)\n 517             except asyncio.CancelledError as error:\n 518                 raise BrokerArtifactStoreUnresolvedError(\n 519                     \"artifact publication acknowledgment is unresolved\"\n 520                 ) from error\n     ...\n 780             if directory >= 0:\n 781                 os.close(directory)\n 782             os.close(root)\n 783 \n+784     @asynccontextmanager\n+785     async def open_incoming_async(\n+786         self,\n+787         manifest: ReplicaArtifactManifest,\n+788     ) -> AsyncIterator[OpenedReplicaArtifacts]:\n+789         \"\"\"Open and hash incoming files without blocking the event loop.\"\"\"\n+790         manager = self.open_incoming(manifest)\n+791         opened = await self._run_blocking(manager.__enter__)\n+792         try:\n+793             yield opened\n+794         finally:\n+795             await self._run_blocking(manager.__exit__, None, None, None)\n+796 \n 784     def recheck_opened(self, opened: OpenedReplicaArtifacts) -> None:\n 785         \"\"\"Recheck pinned incoming files after an external verification step.\"\"\"\n 786         if type(opened) is not OpenedReplicaArtifacts:\n 787             raise BrokerArtifactStoreRejectedError(\"opened artifact set is invalid\")\n     ...\n 832             _NAMES[\"index_objects\"],\n 833             opened.index_objects,\n 834         )\n 835 \n+849     async def recheck_opened_async(self, opened: OpenedReplicaArtifacts) -> None:\n+850         \"\"\"Recheck pinned incoming files without blocking the event loop.\"\"\"\n+851         await self._run_blocking(self.recheck_opened, opened)\n+852 \n 836     def inspect_incoming(self, manifest: ReplicaArtifactManifest) -> IngestReceipt:\n 837         \"\"\"Verify exact immutable storage and return its deterministic receipt.\"\"\"\n 838         with self.open_incoming(manifest):\n 839             return _receipt(manifest)\n+857 \n+858     async def inspect_incoming_async(\n+859         self,\n+860         manifest: ReplicaArtifactManifest,\n+861     ) -> IngestReceipt:\n+862         \"\"\"Inspect immutable storage without blocking the event loop.\"\"\"\n+863         return await self._run_blocking(self.inspect_incoming, manifest)","patch":"--- /Users/user/projects/yinshi/backend/src/yinshi/services/broker_artifact_store.py\n+++ /Users/user/projects/yinshi/backend/src/yinshi/services/broker_artifact_store.py\n@@ -7,10 +7,10 @@\n import json\n import os\n import re\n import stat\n-from collections.abc import Callable, Iterator\n-from contextlib import contextmanager\n+from collections.abc import AsyncIterator, Callable, Iterator\n+from contextlib import asynccontextmanager, contextmanager\n from dataclasses import dataclass\n from pathlib import Path\n from typing import TypeVar\n \n@@ -353,17 +353,17 @@\n         manifest: ReplicaArtifactManifest,\n         reader: asyncio.StreamReader,\n     ) -> IngestReceipt:\n         try:\n-            receipt = await self._run_blocking(self.inspect_incoming, manifest)\n+            receipt = await self.inspect_incoming_async(manifest)\n         except BrokerArtifactStoreRejectedError as error:\n             raise BrokerArtifactStoreCollisionError(\n                 \"artifact operation target already contains different state\"\n             ) from error\n         for reference in (manifest.bundle, manifest.worktree, manifest.index_objects):\n             await self._receive_one(reader, reference, None)\n         await self._read_trailer(reader)\n-        if await self._run_blocking(self.inspect_incoming, manifest) != receipt:\n+        if await self.inspect_incoming_async(manifest) != receipt:\n             raise BrokerArtifactStoreRejectedError(\"stored artifact receipt changed\