- SHA-256 support depends on installed Git.\n  - Worktree stability depends on effective drain ownership.\n  - Object promotion requires restart-safe journaling.\n  - Existing dirty workspace may obscure unrelated integration failures.\n  - POSIX raw-byte paths remain unsuitable for Windows replicas.\n  No files changed. No tests ran.\n  ```acceptance-report\n  {\n    \"criteriaSatisfied\": [\n      {\n        \"id\": \"criterion-1\",\n        \"status\": \"satisfied\",\n        \"evidence\": \"Findings identify blockers in artifact ROOTS validation and broker artifact schemas.\"\n      }\n    ],\n    \"changedFiles\": [],\n    \"testsAddedOrUpdated\": [],\n    \"commandsRun\": [\n      {\n        \"command\": \"git status --short && git branch --show-current && git rev-parse HEAD\",\n        \"result\": \"passed\",\n        \"summary\": \"Workspace was dirty only from existing unstaged and untracked files.\"\n      },\n      {\n        \"command\": \"git ls-files backend/src/yinshi/services/workspace_replica_artifact.py backend/src/yinshi/services/workspace_replica_bundle.py\",\n        \"result\": \"passed\",\n        \"summary\": \"Both inspected modules are committed files.\"\n      },\n      {\n        \"command\": \"git show HEAD:<file> | sha256sum\",\n        \"result\": \"passed\",\n        \"summary\": \"Committed module bytes matched working-tree module bytes.\"\n      },\n      {\n        \"command\": \"temporary repository Git index and pack option probe\",\n        \"result\": \"passed\",\n        \"summary\": \"Intent-to-add used a nonzero empty-blob OID. Required pack options were available.\"\n      },\n      {\n        \"command\": \"pytest backend/tests/test_workspace_replica_artifact.py backend/tests/test_workspace_replica_bundle.py backend/tests/test_workspace_replica_reconciliation.py\",\n        \"result\": \"not-run\",\n        \"summary\": \"Read-only design review did not run tests.\"\n      }\n    ],\n    \"validationOutput\": [\n      \"Committed bundle generation receives only committed refs plus optional HEAD.\",\n      \"Worktree ROOTS contains identities but no Git object bytes.\",\n      \"Current reconciliation accepts conflict stages and preserves exact index bytes.\",\n      \"Exactly three artifacts are required for publication.\"\n    ],\n    \"residualRisks\": [\n      \"index-pack CPU use requires process quotas.\",\n      \"Git index extensions vary by Git version.\",\n      \"Object promotion still needs crash-safe integration.\",\n      \"Source capture requires effective drain ownership.\"\n    ],\n    \"noStagedFiles\": true,\n    \"diffSummary\": \"No files changed.\",\n    \"reviewFindings\": [\n      \"blocker: backend/src/yinshi/services/workspace_replica_artifact.py:405-433 - ROOTS is not derived from parsed index entries.\",\n      \"blocker: backend/src/yinshi/services/broker_replica_journal.py:112-141 - no supplemental object artifact role exists.\",\n      \"high: backend/src/yinshi/services/workspace_replica_bundle.py:219-248 - verification does not prove refs-only object reachability.\",\n      \"high: backend/src/yinshi/services/git.py:634-776 - bounded Git output remains fully buffered.\"\n    ],\n    \"manualNotes\": \"Read-only review. Existing unrelated workspace changes were preserved.\"\n  }\n  ```"}],"details":{"mode":"single","results":[],"spawnBudget":{"used":0,"configuredLimit":null,"granted":0,"limit":null,"remaining":null,"grantRemaining":null,"grantHistory":[]}},"isError":false,"timestamp":1789236719859}}
