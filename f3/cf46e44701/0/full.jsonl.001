ubagent branch; binding the Phase 6 request to the worker session (or /tdd off) is required before this agent can write files directly. Packet design: ingest apply/reconcile inspect exact incoming set; verify opens pinned descriptors via open_incoming_async + verify_opened_artifact_set(recheck_source); publish apply uses publish_opened_artifact_set; publish reconcile uses the new authority-preserving store method returning completed/not_applied/unknown; rejections carry deterministic receipt IDs derived from stage+operation+code; cancellation propagates only after store-internal descriptor/blocking work drains (store-owned shields); no SQLite handles cross awaits (effects never touch SQLite).\"\n  }\n  ```"}],"details":{"mode":"single","results":[],"spawnBudget":{"used":0,"configuredLimit":null,"granted":0,"limit":null,"remaining":null,"grantRemaining":null,"grantHistory":[]}},"isError":false,"timestamp":1789317592499}}
{"type":"custom_message","customType":"subagent-notify","content":"Background task failed: **worker-advanced**\n\nworker-advanced:\nReturning now per instruction — exact parent-applicable packets, no further validation.\n\n## Status\n\nTDD Guard rejected every repo write (\"no current request bound to this session branch\"); supervisor authorized exact-edit-packet mode. Nothing was written; working tree untouched by me (no staged files). Baselines observed green before the block: `test_broker_replica_lifecycle.py` 32 passed, `test_workspace_replica_publication.py` 36 passed, `test_broker_artifact_store.py` 25 passed.\n\n## Packet 1 — NEW `backend/tests/test_broker_replica_artifact_effects.py` (apply first, observe red)\n\n```python\n\"\"\"Check concrete ingest, verify, and publish effects for replica lifecycles.\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport hashlib\nimport json\nimport os\nimport sqlite3\nimport subprocess\nfrom dataclasses import asdict, dataclass\nfrom pathlib import Path\nfrom typing import cast\n\nimport pytest\nfrom cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey\n\nfrom yinshi.services.broker_artifact_store import (\n    BrokerArtifactLimits,\n    BrokerArtifactStore,\n    ReplicaArtifactManifest,\n)\nfrom yinshi.services.broker_protocol import (\n    BROKER_PROTOCOL_VERSION,\n    BrokerRequest,\n    create_signed_request,\n    parse_signed_request,\n)\nfrom yinshi.services.broker_replica_artifact_effects import BrokerReplicaArtifactEffects\nfrom yinshi.services.broker_replica_journal import (\n    AdmissionReceipt,\n    ArtifactReference,\n    BrokerReplicaJournal,\n    DrainReceipt,\n    ExportReceipt,\n    PublishReceipt,\n    ReclaimReceipt,\n    ReplicaAuthority,\n    VerifyReceipt,\n)\nfrom yinshi.services.broker_replica_lifecycle import (\n    BrokerReplicaLifecycleCoordinator,\n    ReplicaLifecycleContext,\n    ReplicaLifecycleEffects,\n    StageReconciliation,\n    StageRejected,\n)\nfrom yinshi.services.replica_artifact_contract import (\n    compute_replica_artifact_set_sha256,\n    compute_replica_limits_sha256,\n)\nfrom yinshi.services.workspace_replica_artifact import (\n    ManifestEntry,\n    WorktreeArtifactInput,\n    WorktreeEntryKind,\n    decode_worktree_artifact,\n    encode_worktree_artifact,\n)\nfrom yinshi.services.workspace_replica_bundle import create_committed_bundle\nfrom yinshi.services.workspace_replica_object_pack import create_index_object_pack\nfrom yinshi.services.workspace_replica_publication import (\n    DEFAULT_REPLICA_STORE_LIMITS,\n    ReplicaArtifactBinding,\n    ReplicaArtifactSetDeclaration,\n    ReplicaIdentity,\n    ReplicaPublicationRejectedError,\n    ReplicaStoreLimits,\n    WorkspaceReplicaPublicationStore,\n)\n\nBROKER_INCARNATION = \"b\" * 32\nDATABASE_INCARNATION = \"d\" * 32\nOPERATION_ID = \"0123456789abcdef0123456789abcdef\"\nSTAGES = (\"ingest\", \"verify\", \"publish\", \"admission\", \"drain\", \"export\", \"reclaim\")\nOWNER_TOKEN = \"owner_token_000000000000000\"\nREQUEST_PRIVATE_KEY = Ed25519PrivateKey.generate()\nRESPONSE_PRIVATE_KEY = Ed25519PrivateKey.generate()\nLIMITS = ReplicaStoreLimits()\nLIMITS_SHA256 = compute_replica_limits_sha256(asdict(DEFAULT_REPLICA_STORE_LIMITS))\nAUTHORITY = ReplicaAuthority(\n    physical_target_id=\"target-0000000000000\",\n    replica_generation=3,\n    execution_owner_id=\"yinshi-executor-00000\",\n)\nOTHER_AUTHORITY = ReplicaAuthority(\n    physical_target_id=\"target-other-00000000\",\n    replica_generation=4,\n    execution_owner_id=\"yinshi-executor-other\",\n)\n\n\ndef git(repository: Path, *args: str) -> str:\n    return subprocess.run(\n        [\"git\", \"-C\", str(repository), *args],\n        check=True,\n        capture_output=True,\n        text=True,\n    ).stdout.strip()\n\n\nasync def artifact_bytes(tmp_path: Path) -> tuple[bytes, bytes, bytes]:\n    repository = tmp_path / \"source\"\n    repository.mkdir()\n    git(repository, \"init\", \"-q\", \"--initial-branch=main\")\n    git(repository, \"config\", \"user.name\", \"Test\")\n    git(repository, \"config\", \"user.email\", \"test@example.invalid\")\n    (repository / \"file.txt\").write_bytes(b\"committed\")\n    git(repository, \"add\", \"file.txt\")\n    git(repository, \"commit\", \"-qm\", \"initial\")\n    bundle = await create_committed_bundle(\n        repository,\n        (\"refs/heads/main\",),\n        include_head=True,\n    )\n    (repository / \"file.txt\").write_bytes(b\"staged\")\n    staged_oid = git(repository, \"rev-parse\", \":file.txt\")\n    (repository / \"file.txt\").write_bytes(b\"working\")\n    worktree = encode_worktree_artifact(\n        WorktreeArtifactInput(\n            object_format=\"sha1\",\n            head_state=\"symbolic\",\n            head_target=b\"refs/heads/main\",\n            head_oid=bytes.fromhex(git(repository, \"rev-parse\", \"HEAD\")),\n            index_bytes=(repository / \".git\" / \"index\").read_bytes(),\n            entries=(\n                ManifestEntry(\n                    raw_path=b\"file.txt\",\n                    kind=WorktreeEntryKind.FILE,\n                    executable=False,\n                    allowed_ignored=False,\n                    content=b\"working\",\n                ),\n            ),\n            root_oids=tuple(\n                sorted(\n                    (\n                        bytes.fromhex(git(repository, \"rev-parse\", \"HEAD\")),\n                        bytes.fromhex(staged_oid),\n                    )\n                )\n            ),\n        )\n    )\n    object_pack = await create_index_object_pack(repository, (staged_oid,), bundle.objects)\n    return bundle.bundle_bytes, worktree, object_pack.pack_bytes\n\n\ndef binding(role: str, artifact_id: str, content: bytes) -> ReplicaArtifactBinding:\n    media_types = {\n        \"committed_bundle\": \"application/vnd.yinshi.git-bundle.v1\",\n        \"worktree\": \"application/vnd.yinshi.replica-worktree.v1\",\n        \"index_objects\": \"application/vnd.yinshi.git-index-objects-pack.v1\",\n    }\n    return ReplicaArtifactBinding(\n        role=cast(object, role),\n        media_type=media_types[role],\n        artifact_id=artifact_id,\n        sha256=hashlib.sha256(content).hexdigest(),\n        byte_length=len(content),\n    )\n\n\n@dataclass(frozen=True)\nclass Scenario:\n    declaration: ReplicaArtifactSetDeclaration\n    bundle: bytes\n    worktree: bytes\n    objects: bytes\n\n\nasync def scenario(tmp_path: Path) -> Scenario:\n    bundle, worktree, objects = await artifact_bytes(tmp_path)\n    declaration = ReplicaArtifactSetDeclaration(\n        version=2,\n        operation_id=OPERATION_ID,\n        repository_id=\"repository-000000000000\",\n        workspace_id=\"workspace-000000000000\",\n        identity=ReplicaIdentity(\n            physical_target_id=AUTHORITY.physical_target_id,\n            replica_generation=AUTHORITY.replica_generation,\n            execution_owner_id=AUTHORITY.execution_owner_id,\n        ),\n        object_format=\"sha1\",\n        source_state_sha256=decode_worktree_artifact(worktree).source_state_sha256.hex(),\n        reconciliation_fingerprint=\"a\" * 64,\n        bundle=binding(\"committed_bundle\", \"bundle-000000000000\", bundle),\n        worktree=binding(\"worktree\", \"worktree-0000000000000\", worktree),\n        index_objects=binding(\"index_objects\", \"objects-00000000000000\", objects),\n        limits=LIMITS,\n    )\n    return Scenario(declaration=declaration, bundle=bundle, worktree=worktree, objects=objects)\n\n\ndef _reference_json(role: str, raw: object) -> dict[str, object]:\n    value = cast(dict[str, object], raw)\n    roles = {\n        \"bundle\": \"committed_bundle\",\n        \"worktree\": \"worktree\",\n        \"index_objects\": \"index_objects\",\n    }\n    media_types = {\n        \"committed_bundle\": \"application/vnd.yinshi.git-bundle.v1\",\n        \"worktree\": \"application/vnd.yinshi.replica-worktree.v1\",\n        \"index_objects\": \"application/vnd.yinshi.git-index-objects-pack.v1\",\n    }\n    resolved = roles[role]\n    return {\n        \"role\": resolved,\n        \"media_type\": media_types[resolved],\n        \"artifact_id\": value[\"artifact_id\"],\n        \"sha256\": value[\"sha256\"],\n        \"byte_length\": value[\"byte_length\"],\n    }\n\n\ndef payload(\n    declaration: ReplicaArtifactSetDeclaration,\n    overrides: dict[str, object] | None = None,\n) -> dict[str, object]:\n    value: dict[str, object] = {\n        \"authority\": {\n            \"execution_owner_id\": AUTHORITY.execution_owner_id,\n            \"physical_target_id\": AUTHORITY.physical_target_id,\n            \"replica_generation\": AUTHORITY.replica_generation,\n        },\n        \"bundle\": {\n            \"artifact_id\": declaration.bundle.artifact_id,\n            \"byte_length\": declaration.bundle.byte_length,\n            \"sha256\": declaration.bundle.sha256,\n        },\n        \"index_objects\": {\n            \"artifact_id\": declaration.index_objects.artifact_id,\n            \"byte_length\": declaration.index_objects.byte_length,\n            \"sha256\": declaration.index_objects.sha256,\n        },\n        \"limits_sha256\": LIMITS_SHA256,\n        \"object_format\": declaration.object_format,\n        \"reconciliation_fingerprint\": declaration.reconciliation_fingerprint,\n        \"repository_id\": declaration.repository_id,\n        \"source_state_sha256\": declaration.source_state_sha256,\n        \"workspace_id\": declaration.workspace_id,\n        \"worktree\": {\n            \"artifact_id\": declaration.worktree.artifact_id,\n            \"byte_length\": declaration.worktree.byte_length,\n            \"sha256\": declaration.worktree.sha256,\n        },\n    }\n    if overrides is not None:\n        value.update(overrides)\n    authority = cast(dict[str, object], value[\"authority\"])\n    value[\"artifact_set_sha256\"] = compute_replica_artifact_set_sha256(\n        operation_id=declaration.operation_id,\n        repository_id=cast(str, value[\"repository_id\"]),\n        workspace_id=cast(str, value[\"workspace_id\"]),\n        physical_target_id=cast(str, authority[\"physical_target_id\"]),\n        replica_generation=cast(int, authority[\"replica_generation\"]),\n        execution_owner_id=cast(str, authority[\"execution_owner_id\"]),\n        object_format=cast(str, value[\"object_format\"]),\n        source_state_sha256=cast(str, value[\"source_state_sha256\"]),\n        reconciliation_fingerprint=cast(str, value[\"reconciliation_fingerprint\"]),\n        bundle=_reference_json(\"bundle\", value[\"bundle\"]),\n        worktree=_reference_json(\"worktree\", value[\"worktree\"]),\n        index_objects=_reference_json(\"index_objects\", value[\"index_objects\"]),\n        limits_sha256=cast(str, value[\"limits_sha256\"]),\n    )\n    return value\n\n\ndef signed_request(\n    declaration: ReplicaArtifactSetDeclaration,\n    overrides: dict[str, object] | None = None,\n) -> tuple[BrokerRequest, bytes]:\n    frame = create_signed_request(\n        private_key=REQUEST_PRIVATE_KEY,\n        protocol_version=BROKER_PROTOCOL_VERSION,\n        broker_incarnation=BROKER_INCARNATION,\n        database_incarnation=DATABASE_INCARNATION,\n        connection_sequence=1,\n        operation_id=declaration.operation_id,\n        request_type=\"replica.lifecycle\",\n        nonce=\"nonce_000000000001\",\n        payload=payload(declaration, overrides),\n    )\n    request = parse_signed_request(frame, public_key=REQUEST_PRIVATE_KEY.public_key())\n    return request, frame\n\n\ndef incoming_store(root: Path) -> BrokerArtifactStore:\n    root.mkdir(mode=0o700)\n    return BrokerArtifactStore(\n        root,\n        limits=BrokerArtifactLimits(),\n        expected_uid=os.geteuid(),\n        expected_gid=os.getegid(),\n    )\n\n\ndef publication_store(root: Path) -> WorkspaceReplicaPublicationStore:\n    root.mkdir(mode=0o700)\n    return WorkspaceReplicaPublicationStore(\n        root,\n        ceilings=ReplicaStoreLimits(),\n        expected_uid=os.geteuid(),\n        expected_gid=os.getegid(),\n    )\n\n\ndef incoming_manifest(\n    declaration: ReplicaArtifactSetDeclaration,\n) -> ReplicaArtifactManifest:\n    return ReplicaArtifactManifest(\n        operation_id=declaration.operation_id,\n        bundle=ArtifactReference(\n            artifact_id=declaration.bundle.artifact_id,\n            sha256=declaration.bundle.sha256,\n            byte_length=declaration.bundle.byte_length,\n        ),\n        worktree=ArtifactReference(\n            artifact_id=declaration.worktree.artifact_id,\n            sha256=declaration.worktree.sha256,\n            byte_length=declaration.worktree.byte_length,\n        ),\n        index_objects=ArtifactReference(\n            artifact_id=declaration.index_objects.artifact_id,\n            sha256=declaration.index_objects.sha256,\n            byte_length=declaration.index_objects.byte_length,\n        ),\n    )\n\n\ndef artifact_reader(*parts: bytes) -> asyncio.StreamReader:\n    reader = asyncio.StreamReader()\n    for part in parts:\n        reader.feed_data(part)\n    reader.feed_eof()\n    return reader\n\n\nasync def upload(\n    incoming: BrokerArtifactStore,\n    declaration: ReplicaArtifactSetDeclaration,\n    data: Scenario,\n) -> None:\n    await incoming.receive(\n        incoming_manifest(declaration),\n        artifact_reader(data.bundle, data.worktree, data.objects),\n    )\n\n\ndef effects(\n    incoming: BrokerArtifactStore,\n    publication: WorkspaceReplicaPublicationStore,\n) -> BrokerReplicaArtifactEffects:\n    return BrokerReplicaArtifactEffects(\n        incoming=incoming,\n        publication=publication,\n        limits=ReplicaStoreLimits(),\n    )\n\n\ndef context(request: BrokerRequest, authority: ReplicaAuthority = AUTHORITY) -> object:\n    return ReplicaLifecycleContext(\n        request=request,\n        authority=authority,\n        owner_token=OWNER_TOKEN,\n    )\n\n\nclass _StaticStage:\n    \"\"\"Test double for the out-of-scope stages after publish.\"\"\"\n\n    def __init__(self, receipt: object) -> None:\n        self._receipt = receipt\n\n    async def apply(self, replica_context: ReplicaLifecycleContext) -> StageReconciliation:\n        return StageReconciliation(outcome=\"completed\", receipt=self._receipt)\n\n    async def reconcile(self, replica_context: ReplicaLifecycleContext) -> StageReconciliation:\n        return StageReconciliation(outcome=\"completed\", receipt=self._receipt)\n\n\ndef _artifact_reference(binding_value: ReplicaArtifactBinding) -> ArtifactReference:\n    return ArtifactReference(\n        artifact_id=binding_value.artifact_id,\n        sha256=binding_value.sha256,\n        byte_length=binding_value.byte_length,\n    )\n\n\ndef build_coordinator(\n    directory: Path,\n    artifact_effects: BrokerReplicaArtifactEffects,\n    declaration: ReplicaArtifactSetDeclaration,\n) -> tuple[BrokerReplicaLifecycleCoordinator, BrokerReplicaJournal]:\n    replica = BrokerReplicaJournal(\n        directory / \"replica.sqlite3\",\n        application_id=\"yinshi-desktop\",\n        expected_limits_sha256=LIMITS_SHA256,\n        REDACTED.public_key(),\n        response_public_keys={BROKER_INCARNATION: RESPONSE_PRIVATE_KEY.public_key()},\n    )\n    instance = BrokerReplicaLifecycleCoordinator(\n        replica,\n        broker_incarnation=BROKER_INCARNATION,\n        broker_private_keys={BROKER_INCARNATION: RESPONSE_PRIVATE_KEY},\n        effects=ReplicaLifecycleEffects(\n            ingest=artifact_effects.ingest,\n            verify=artifact_effects.verify,\n            publish=artifact_effects.publish,\n            admission=_StaticStage(\n                AdmissionReceipt(\n                    receipt_id=\"receipt_admission_0000000000\",\n                    execution_owner_id=AUTHORITY.execution_owner_id,\n                    runtime_unit_id=\"runtime_000000000000000000000\",\n                    session_socket_sha256=\"6\" * 64,\n                )\n            ),\n            drain=_StaticStage(\n                DrainReceipt(\n                    drain_ack_receipt_id=\"drain_ack_00000000000000000000\",\n                    quiescence_receipt_id=\"quiescence_0000000000000000000\",\n                )\n            ),\n            export=_StaticStage(\n                ExportReceipt(\n                    export_receipt_id=\"export_00000000000000000000000\",\n                    bundle=_artifact_reference(declaration.bundle),\n                    worktree=_artifact_reference(declaration.worktree),\n                    index_objects=_artifact_reference(declaration.index_objects),\n                )\n            ),\n            reclaim=_StaticStage(\n                ReclaimReceipt(reclaim_receipt_id=\"reclaim_000000000000000000000\")\n            ),\n        ),\n    )\n    return instance, replica\n\n\ndef journal_events(path: Path) -> list[tuple[str, str | None]]:\n    with sqlite3.connect(path) as database:\n        return [\n            (str(event_type), stage)\n            for event_type, stage in database.execute(\n                \"SELECT event_type, stage FROM replica_journal_events ORDER BY event_id\"\n            ).fetchall()\n        ]\n\n\ndef staged_receipt(path: Path, stage: str) -> dict[str, object]:\n    with sqlite3.connect(path) as database:\n        row = database.execute(\n            \"SELECT receipt_json FROM replica_journal_events \"\n            \"WHERE stage = ? AND event_type = 'stage_outcome'\",\n            (stage,),\n        ).fetchone()\n    assert row is not None and row[0] is not None\n    return cast(dict[str, object], json.loads(bytes(cast(bytes, row[0]))))\n\n\ndef test_effects_constructor_validates_configuration(tmp_path: Path) -> None:\n    incoming = incoming_store(tmp_path / \"incoming\")\n    publication = publication_store(tmp_path / \"published\")\n    with pytest.raises(TypeError):\n        BrokerReplicaArtifactEffects(\n            incoming=object(),  # type: ignore[arg-type]\n            publication=publication,\n            limits=LIMITS,\n        )\n    with pytest.raises(TypeError):\n        BrokerReplicaArtifactEffects(\n            incoming=incoming,\n            publication=object(),  # type: ignore[arg-type]\n            limits=LIMITS,\n        )\n    with pytest.raises(TypeError):\n        BrokerReplicaArtifactEffects(\n            incoming=incoming,\n            publication=publication,\n            limits=object(),  # type: ignore[arg-type]\n        )\n    with pytest.raises(ValueError):\n        BrokerReplicaArtifactEffects(\n            incoming=incoming,\n            publication=publication,\n            limits=ReplicaStoreLimits(max_set_bytes=LIMITS.max_set_bytes + 1),\n        )\n\n\nasync def test_full_lifecycle_ingests_verifies_and_publishes(tmp_path: Path) -> None:\n    data = await scenario(tmp_path)\n    incoming = incoming_store(tmp_path / \"incoming\")\n    publication = publication_store(tmp_path / \"published\")\n    await upload(incoming, data.declaration, data)\n    instance, _replica = build_coordinator(\n        tmp_path, effects(incoming, publication), data.declaration\n    )\n    request, frame = signed_request(data.declaration)\n\n    response = await instance.run(request, frame, AUTHORITY)\n\n    value = json.loads(response)\n    assert value[\"status\"] == \"ok\"\n    final = tmp_path / \"published\" / OPERATION_ID\n    assert (final / \"committed.bundle\").read_bytes() == data.bundle\n    assert (final / \"worktree.yra\").read_bytes() == data.worktree\n    assert (final / \"index-objects.pack\").read_bytes() == data.objects\n    expected: list[tuple[str, str | None]] = [\n        (\"accepted\", None),\n        (\"authority_claimed\", None),\n    ]\n    for stage in STAGES:\n        expected.append((\"stage_started\", stage))\n        expected.append((\"stage_outcome\", stage))\n    assert journal_events(tmp_path / \"replica.sqlite3\") == expected\n    ingest = staged_receipt(tmp_path / \"replica.sqlite3\", \"ingest\")\n    assert ingest[\"receipt_id\"] == (\n        await incoming.inspect_incoming_async(incoming_manifest(data.declaration))\n    ).receipt_id\n    verify = staged_receipt(tmp_path / \"replica.sqlite3\", \"verify\")\n    assert verify[\"source_state_sha256\"] == data.declaration.source_state_sha256\n    publish = staged_receipt(tmp_path / \"replica.sqlite3\", \"publish\")\n    assert publish[\"physical_target_id\"] == AUTHORITY.physical_target_id\n    assert publish[\"replica_generation\"] == AUTHORITY.replica_generation\n    assert publish[\"execution_owner_id\"] == AUTHORITY.execution_owner_id\n    inspection = await publication.inspect_published_artifact_set(data.declaration)\n    assert inspection.artifact_set_sha256 == verify[\"artifact_set_sha256\"]\n    assert inspection.artifact_set_sha256 == request.payload[\"artifact_set_sha256\"]\n\n\nasync def test_missing_incoming_set_rejects_ingest_deterministically(tmp_path: Path) -> None:\n    data = await scenario(tmp_path)\n    direct_incoming = incoming_store(tmp_path / \"direct-incoming\")\n    direct_publication = publication_store(tmp_path / \"direct-published\")\n    request, frame = signed_request(data.declaration)\n    direct_context = cast(ReplicaLifecycleContext, context(request))\n    with pytest.raises(StageRejected) as direct:\n        await effects(direct_incoming, direct_publication).ingest.apply(direct_context)\n    assert direct.value.status == \"artifact_rejected\"\n\n    receipt_ids = {direct.value.receipt_id}\n    for suffix in (\"a\", \"b\"):\n        run_incoming = incoming_store(tmp_path / f\"incoming-{suffix}\")\n        run_publication = publication_store(tmp_path / f\"published-{suffix}\")\n        instance, _replica = build_coordinator(\n            tmp_path / f\"run-{suffix}\",\n            effects(run_incoming, run_publication),\n            data.declaration,\n        )\n        response = await instance.run(request, frame, AUTHORITY)\n        result = json.loads(response)\n        assert result[\"status\"] == \"error\"\n        assert result[\"error\"] == \"artifact_rejected\"\n        assert result[\"result\"][\"stage\"] == \"ingest\"\n        assert result[\"result\"][\"state\"] == \"rejected\"\n        receipt_ids.add(str(result[\"result\"][\"receipt_id\"]))\n    assert len(receipt_ids) == 1\n\n\nasync def test_oversized_declared_artifacts_reject_ingest_with_limit_code(\n    tmp_path: Path,\n) -> None:\n    data = await scenario(tmp_path)\n    incoming = incoming_store(tmp_path / \"incoming\")\n    publication = publication_store(tmp_path / \"published\")\n    await upload(incoming, data.declaration, data)\n    instance, _replica = build_coordinator(\n        tmp_path, effects(incoming, publication), data.declaration\n    )\n    request, frame = signed_request(\n        data.declaration,\n        overrides={\n            \"bundle\": {\n                \"artifact_id\": data.declaration.bundle.artifact_id,\n                \"byte_length\": BrokerArtifactLimits().max_bundle_bytes + 1,\n                \"sha256\": data.declaration.bundle.sha256,\n            }\n        },\n    )\n\n    response = await instance.run(request, frame, AUTHORITY)\n\n    result = json.loads(response)\n    assert result[\"status\"] == \"error\"\n    assert result[\"error\"] == \"limit_rejected\"\n    assert result[\"result\"][\"stage\"] == \"ingest\"\n    assert result[\"result\"][\"state\"] == \"rejected\"\n\n\nasync def test_verify_rejects_tampered_incoming_bytes_deterministically(\n    tmp_path: Path,\n) -> None:\n    data = await scenario(tmp_path)\n    incoming = incoming_store(tmp_path / \"incoming\")\n    publication = publication_store(tmp_path / \"published\")\n    await upload(incoming, data.declaration, data)\n    artifact_effects = effects(incoming, publication)\n    request, _frame = signed_request(data.declaration)\n    replica_context = cast(ReplicaLifecycleContext, context(request))\n\n    ingested = await artifact_effects.ingest.apply(replica_context)\n    assert ingested.outcome == \"completed\"\n\n    target = tmp_path / \"incoming\" / OPERATION_ID / \"worktree.yra\"\n    target.write_bytes(data.worktree + b\"tampered\")\n\n    with pytest.raises(StageRejected) as applied:\n        await artifact_effects.verify.apply(replica_context)\n    assert applied.value.status == \"verification_rejected\"\n    with pytest.raises(StageRejected) as reconciled:\n        await artifact_effects.verify.reconcile(replica_context)\n    assert reconciled.value.receipt_id == applied.value.receipt_id\n\n\nasync def test_publish_reconcile_reports_not_applied_then_matches_apply(\n    tmp_path: Path,\n) -> None:\n    data = await scenario(tmp_path)\n    incoming = incoming_store(tmp_path / \"incoming\")\n    publication = publication_store(tmp_path / \"published\")\n    await upload(incoming, data.declaration, data)\n    artifact_effects = effects(incoming, publication)\n    request, _frame = signed_request(data.declaration)\n    replica_context = cast(ReplicaLifecycleContext, context(request))\n\n    before = await artifact_effects.publish.reconcile(replica_context)\n    assert before.outcome == \"not_applied\"\n    assert before.receipt is None\n    assert before.reason is None\n\n    applied = await artifact_effects.publish.apply(replica_context)\n    assert applied.outcome == \"completed\"\n    receipt = applied.receipt\n    assert isinstance(receipt, PublishReceipt)\n    assert receipt.physical_target_id == AUTHORITY.physical_target_id\n    assert receipt.replica_generation == AUTHORITY.replica_generation\n    assert receipt.execution_owner_id == AUTHORITY.execution_owner_id\n    assert receipt.artifact_set_sha256\n\n    after = await artifact_effects.publish.reconcile(replica_context)\n    assert after.outcome == \"completed\"\n    assert after.receipt == receipt\n\n    with pytest.raises(StageRejected) as repeated:\n        await artifact_effects.publish.apply(replica_context)\n    assert repeated.value.status == \"publication_rejected\"\n\n\nasync def test_declaration_mismatches_are_rejected_per_stage(tmp_path: Path) -> None:\n    data = await scenario(tmp_path)\n    incoming = incoming_store(tmp_path / \"incoming\")\n    publication = publication_store(tmp_path / \"published\")\n    await upload(incoming, data.declaration, data)\n    artifact_effects = effects(incoming, publication)\n    request, _frame = signed_request(data.declaration)\n    stage_rejections = [\n        (\"ingest\", \"artifact_rejected\"),\n        (\"verify\", \"verification_rejected\"),\n        (\"publish\", \"publication_rejected\"),\n    ]\n    for stage, code in stage_rejections:\n        stage_effect = getattr(artifact_effects, stage)\n        with pytest.raises(StageRejected) as mismatched_authority:\n            await stage_effect.apply(\n                cast(ReplicaLifecycleContext, context(request, OTHER_AUTHORITY))\n            )\n        assert mismatched_authority.value.status == code\n\n    wrong_limits_request, _wrong_limits_frame = signed_request(\n        data.declaration,\n        overrides={\"limits_sha256\": \"f\" * 64},\n    )\n    with pytest.raises(StageRejected) as wrong_limits:\n        await artifact_effects.ingest.apply(\n            cast(ReplicaLifecycleContext, context(wrong_limits_request))\n        )\n    assert wrong_limits.value.status == \"limit_rejected\"\n\n    wrong_set_frame = create_signed_request(\n        private_key=REQUEST_PRIVATE_KEY,\n        protocol_version=BROKER_PROTOCOL_VERSION,\n        broker_incarnation=BROKER_INCARNATION,\n        database_incarnation=DATABASE_INCARNATION,\n        connection_sequence=1,\n        operation_id=data.declaration.operation_id,\n        request_type=\"replica.lifecycle\",\n        nonce=\"nonce_000000000001\",\n        payload={\n            **payload(data.declaration),\n            \"artifact_set_sha256\": \"e\" * 64,\n        },\n    )\n    wrong_set_request = parse_signed_request(\n        wrong_set_frame, public_key=REQUEST_PRIVATE_KEY.public_key()\n    )\n    with pytest.raises(StageRejected) as wrong_set:\n        await artifact_effects.verify.apply(\n            cast(ReplicaLifecycleContext, context(wrong_set_request))\n        )\n    assert wrong_set.value.status == \"verification_rejected\"\n\n\nasync def test_verify_cancellation_propagates_after_store_work_drains(\n    tmp_path: Path,\n    monkeypatch: pytest.MonkeyPatch,\n) -> None:\n    data = await scenario(tmp_path)\n    incoming = incoming_store(tmp_path / \"incoming\")\n    publication = publication_store(tmp_path / \"published\")\n    await upload(incoming, data.declaration, data)\n    artifact_effects = effects(incoming, publication)\n    request, _frame = signed_request(data.declaration)\n    replica_context = cast(ReplicaLifecycleContext, context(request))\n    started = asyncio.Event()\n    drained = False\n    real_verify = WorkspaceReplicaPublicationStore.verify_opened_artifact_set\n\n    async def gated(\n        self: WorkspaceReplicaPublicationStore,\n        declaration: ReplicaArtifactSetDeclaration,\n        opened: object,\n        *,\n        recheck_source: object,\n    ) -> object:\n        nonlocal drained\n        started.set()\n        inner = asyncio.create_task(asyncio.sleep(3600))\n        try:\n            await asyncio.shield(inner)\n        except asyncio.CancelledError:\n            inner.cancel()\n            await asyncio.gather(inner, return_exceptions=True)\n            drained = True\n            raise\n        return await real_verify(  # type: ignore[arg-type]\n            self,\n            declaration,  # type: ignore[arg-type]\n            opened,\n            recheck_source=recheck_source,  # type: ignore[arg-type]\n        )\n\n    monkeypatch.setattr(\n        WorkspaceReplicaPublicationStore,\n        \"verify_opened_artifact_set\",\n        gated,\n    )\n    task = asyncio.create_task(artifact_effects.verify.apply(replica_context))\n    await started.wait()\n    task.cancel()\n    with pytest.raises(asyncio.CancelledError):\n        await task\n    assert drained\n\n\nasync def test_store_reconcile_returns_authority_bound_receipt_or_absence(\n    tmp_path: Path,\n) -> None:\n    data = await scenario(tmp_path)\n    publication = publication_store(tmp_path / \"published\")\n\n    absent = await publication.reconcile_published_artifact_set(data.declaration)\n    assert absent is None\n\n    await publication.publish_artifact_set(\n        data.declaration,\n        data.bundle,\n        data.worktree,\n        data.objects,\n    )\n    receipt = await publication.reconcile_published_artifact_set(data.declaration)\n    assert receipt is not None\n    assert receipt.identity == data.declaration.identity\n    assert receipt.source_state_sha256 == data.declaration.source_state_sha256\n    inspection = await publication.inspect_published_artifact_set(data.declaration)\n    assert receipt.artifact_set_sha256 == inspection.artifact_set_sha256\n    assert receipt.publication_marker_sha256 == inspection.publication_marker_sha256\n    assert await publication.reconcile_published_artifact_set(data.declaration) == receipt\n\n    foreign_root = tmp_path / \"foreign-published\"\n    foreign_store = publication_store(foreign_root)\n    foreign = foreign_root / OPERATION_ID\n    foreign.mkdir()\n    (foreign / \"committed.bundle\").write_bytes(b\"junk\")\n    with pytest.raises(ReplicaPublicationRejectedError):\n        await foreign_store.reconcile_published_artifact_set(data.declaration)\n\n    link_root = tmp_path / \"link-published\"\n    link_store = publication_store(link_root)\n    (link_root / OPERATION_ID).symlink_to(tmp_path, target_is_directory=True)\n    with pytest.raises(ReplicaPublicationRejectedError):\n        await link_store.reconcile_published_artifact_set(data.declaration)\n```\n\n## Packet 2 — NEW `backend/src/yinshi/services/broker_replica_artifact_effects.py`\n\n```python\n\"\"\"Concrete ingest, verify, and publish effects for broker replica lifecycles.\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport hashlib\nfrom dataclasses import asdict\nfrom typing import Literal, cast\n\nfrom yinshi.services.broker_artifact_store import (\n    BrokerArtifactStore,\n    BrokerArtifactStoreRejectedError,\n    BrokerArtifactStoreUnresolvedError,\n    ReplicaArtifactManifest,\n)\nfrom yinshi.services.broker_protocol import canonical_json\nfrom yinshi.services.broker_replica_journal import (\n    ArtifactReference,\n    IngestReceipt,\n    PublishReceipt,\n    VerifyReceipt,\n    replica_authority_from_request,\n)\nfrom yinshi.services.broker_replica_lifecycle import (\n    ReplicaLifecycleContext,\n    StageOutcomeUnknown,\n    StageReconciliation,\n    StageRejected,\n)\nfrom yinshi.services.replica_artifact_contract import (\n    REPLICA_ARTIFACT_MEDIA_TYPES,\n    compute_replica_artifact_set_sha256,\n    compute_replica_limits_sha256,\n)\nfrom yinshi.services.workspace_replica_publication import (\n    ReplicaArtifactBinding,\n    ReplicaArtifactSetDeclaration,\n    ReplicaIdentity,\n    ReplicaPublicationReceipt,\n    ReplicaPublicationRejectedError,\n    ReplicaPublicationUnresolvedError,\n    ReplicaStoreLimits,\n    ReplicaVerificationReceipt,\n    WorkspaceReplicaPublicationStore,\n)\n\n_REJECTION_CODE_BY_STAGE: dict[str, str] = {\n    \"ingest\": \"artifact_rejected\",\n    \"verify\": \"verification_rejected\",\n    \"publish\": \"publication_rejected\",\n}\n_UNRESOLVED_REASON_BY_STAGE: dict[str, str] = {\n    \"ingest\": \"transfer_unknown\",\n    \"verify\": \"verification_unknown\",\n    \"publish\": \"publication_unknown\",\n}\n_OBJECT_FORMATS = (\"sha1\", \"sha256\")\n_REFERENCE_KEYS = frozenset({\"artifact_id\", \"byte_length\", \"sha256\"})\n_REJECTION_DOMAIN = b\"yinshi-replica-stage-rejection-v1\\x00\"\n_VERIFICATION_RECEIPT_DOMAIN = b\"yinshi-replica-stage-verification-receipt-v1\\x00\"\n_PUBLICATION_RECEIPT_DOMAIN = b\"yinshi-replica-stage-publication-receipt-v1\\x00\"\n\n\ndef _digest_identity(domain: bytes, value: object) -> str:\n    return hashlib.sha256(domain + canonical_json(value)).hexdigest()\n\n\ndef _rejected_receipt_id(stage: str, operation_id: str, code: str) -> str:\n    \"\"\"Return one deterministic rejection receipt for one stage outcome.\"\"\"\n    return \"rejected_\" + _digest_identity(\n        _REJECTION_DOMAIN,\n        {\"code\": code, \"operation_id\": operation_id, \"stage\": stage},\n    )\n\n\ndef _verification_receipt_id(\n    operation_id: str,\n    verification: ReplicaVerificationReceipt,\n) -> str:\n    return \"verify_\" + _digest_identity(\n        _VERIFICATION_RECEIPT_DOMAIN,\n        {\n            \"artifact_set_sha256\": verification.artifact_set_sha256,\n            \"operation_id\": operation_id,\n            \"verification_receipt_id\": verification.verification_receipt_id,\n        },\n    )\n\n\ndef _publication_receipt_id(\n    operation_id: str,\n    publication: ReplicaPublicationReceipt,\n) -> str:\n    return \"publish_\" + _digest_identity(\n        _PUBLICATION_RECEIPT_DOMAIN,\n        {\n            \"artifact_set_sha256\": publication.artifact_set_sha256,\n            \"operation_id\": operation_id,\n            \"publication_marker_sha256\": publication.publication_marker_sha256,\n            \"synchronization_receipt_id\": publication.synchronization_receipt_id,\n        },\n    )\n\n\ndef _binding(\n    role: str,\n    raw: object,\n) -> ReplicaArtifactBinding | None:\n    if not isinstance(raw, dict) or set(raw) != _REFERENCE_KEYS:\n        return None\n    artifact_id = raw[\"artifact_id\"]\n    sha256 = raw[\"sha256\"]\n    byte_length = raw[\"byte_length\"]\n    if (\n        not isinstance(artifact_id, str)\n        or not isinstance(sha256, str)\n        or type(byte_length) is not int\n    ):\n        return None\n    return ReplicaArtifactBinding(\n        role=cast(Literal[\"committed_bundle\", \"worktree\", \"index_objects\"], role),\n        media_type=REPLICA_ARTIFACT_MEDIA_TYPES[role],\n        artifact_id=artifact_id,\n        sha256=sha256,\n        byte_length=byte_length,\n    )\n\n\ndef _incoming_manifest(\n    declaration: ReplicaArtifactSetDeclaration,\n) -> ReplicaArtifactManifest:\n    return ReplicaArtifactManifest(\n        operation_id=declaration.operation_id,\n        bundle=ArtifactReference(\n            artifact_id=declaration.bundle.artifact_id,\n            sha256=declaration.bundle.sha256,\n            byte_length=declaration.bundle.byte_length,\n        ),\n        worktree=ArtifactReference(\n            artifact_id=declaration.worktree.artifact_id,\n            sha256=declaration.worktree.sha256,\n            byte_length=declaration.worktree.byte_length,\n        ),\n        index_objects=ArtifactReference(\n            artifact_id=declaration.index_objects.artifact_id,\n            sha256=declaration.index_objects.sha256,\n            byte_length=declaration.index_objects.byte_length,\n        ),\n    )\n\n\ndef _declaration(\n    effects: BrokerReplicaArtifactEffects,\n    context: ReplicaLifecycleContext,\n    stage: str,\n) -> ReplicaArtifactSetDeclaration:\n    \"\"\"Build one declaration from the signed payload, authority, and limits.\"\"\"\n    request = context.request\n    operation_id = request.operation_id\n    payload = request.payload\n\n    def rejected(code: str | None = None) -> StageRejected:\n        resolved = code or _REJECTION_CODE_BY_STAGE[stage]\n        return StageRejected(\n            resolved,\n            _rejected_receipt_id(stage, operation_id, resolved),\n        )\n\n    try:\n        payload_authority = replica_authority_from_request(request)\n    except (TypeError, ValueError):\n        raise rejected() from None\n    if payload_authority != context.authority:\n        raise rejected()\n    if payload.get(\"limits_sha256\") != effects._limits_sha256:\n        if stage == \"ingest\":\n            raise rejected(\"limit_rejected\")\n        raise rejected()\n    bundle = _binding(\"committed_bundle\", payload.get(\"bundle\"))\n    worktree = _binding(\"worktree\", payload.get(\"worktree\"))\n    index_objects = _binding(\"index_objects\", payload.get(\"index_objects\"))\n    object_format = payload.get(\"object_format\")\n    repository_id = payload.get(\"repository_id\")\n    workspace_id = payload.get(\"workspace_id\")\n    source_state_sha256 = payload.get(\"source_state_sha256\")\n    reconciliation_fingerprint = payload.get(\"reconciliation_fingerprint\")\n    if (\n        bundle is None\n        or worktree is None\n        or index_objects is None\n        or not isinstance(object_format, str)\n        or object_format not in _OBJECT_FORMATS\n        or not isinstance(repository_id, str)\n        or not isinstance(workspace_id, str)\n        or not isinstance(source_state_sha256, str)\n        or not isinstance(reconciliation_fingerprint, str)\n    ):\n        raise rejected()\n    declaration = ReplicaArtifactSetDeclaration(\n        version=2,\n        operation_id=operation_id,\n        repository_id=repository_id,\n        workspace_id=workspace_id,\n        identity=ReplicaIdentity(\n            physical_target_id=context.authority.physical_target_id,\n            replica_generation=context.authority.replica_generation,\n            execution_owner_id=context.authority.execution_owner_id,\n        ),\n        object_format=cast(Literal[\"sha1\", \"sha256\"], object_format),\n        source_state_sha256=source_state_sha256,\n        reconciliation_fingerprint=reconciliation_fingerprint,\n        bundle=bundle,\n        worktree=worktree,\n        index_objects=index_objects,\n        limits=effects._limits,\n    )\n    expected_set = compute_replica_artifact_set_sha256(\n        operation_id=operation_id,\n        repository_id=repository_id,\n        workspace_id=workspace_id,\n        physical_target_id=context.authority.physical_target_id,\n        replica_generation=context.authority.replica_generation,\n        execution_owner_id=context.authority.execution_owner_id,\n        object_format=object_format,\n        source_state_sha256=source_state_sha256,\n        reconciliation_fingerprint=reconciliation_fingerprint,\n        bundle=asdict(bundle),\n        worktree=asdict(worktree),\n        index_objects=asdict(index_objects),\n        limits_sha256=effects._limits_sha256,\n    )\n    if payload.get(\"artifact_set_sha256\") != expected_set:\n        raise rejected()\n    return declaration\n\n\nclass _IngestStageEffect:\n    \"\"\"Apply or reconcile ingest by inspecting the exact pre-uploaded set.\"\"\"\n\n    def __init__(self, owner: BrokerReplicaArtifactEffects) -> None:\n        self._owner = owner\n\n    async def apply(\n        self,\n        context: ReplicaLifecycleContext,\n    ) -> StageReconciliation[IngestReceipt]:\n        return await self._inspect(context)\n\n    async def reconcile(\n        self,\n        context: ReplicaLifecycleContext,\n    ) -> StageReconciliation[IngestReceipt]:\n        return await self._inspect(context)\n\n    async def _inspect(\n        self,\n        context: ReplicaLifecycleContext,\n    ) -> StageReconciliation[IngestReceipt]:\n        stage = \"ingest\"\n        operation_id = context.request.operation_id\n        declaration = _declaration(self._owner, context, stage)\n        try:\n            receipt = await self._owner._incoming.inspect_incoming_async(\n                _incoming_manifest(declaration)\n            )\n        except asyncio.CancelledError:\n            raise\n        except BrokerArtifactStoreRejectedError as error:\n            code = \"limit_rejected\" if \"limit\" in str(error) else None\n            resolved = code or _REJECTION_CODE_BY_STAGE[stage]\n            raise StageRejected(\n                resolved,\n                _rejected_receipt_id(stage, operation_id, resolved),\n            ) from None\n        except BrokerArtifactStoreUnresolvedError:\n            raise StageOutcomeUnknown(_UNRESOLVED_REASON_BY_STAGE[stage]) from None\n        except Exception:\n            raise StageOutcomeUnknown(_UNRESOLVED_REASON_BY_STAGE[stage]) from None\n        return StageReconciliation(outcome=\"completed\", receipt=receipt)\n\n\nclass _VerifyStageEffect:\n    \"\"\"Apply or reconcile verify over pinned incoming descriptors.\"\"\"\n\n    def __init__(self, owner: BrokerReplicaArtifactEffects) -> None:\n        self._owner = owner\n\n    async def apply(\n        self,\n        context: ReplicaLifecycleContext,\n    ) -> StageReconciliation[VerifyReceipt]:\n        return await self._verify(context)\n\n    async def reconcile(\n        self,\n        context: ReplicaLifecycleContext,\n    ) -> StageReconciliation[VerifyReceipt]:\n        return await self._verify(context)\n\n    async def _verify(\n        self,\n        context: ReplicaLifecycleContext,\n    ) -> StageReconciliation[VerifyReceipt]:\n        stage = \"verify\"\n        operation_id = context.request.operation_id\n        declaration = _declaration(self._owner, context, stage)\n        try:\n            async with self._owner._incoming.open_incoming_async(\n                _incoming_manifest(declaration)\n            ) as opened:\n                verification = await self._owner._publication.verify_opened_artifact_set(\n                    declaration,\n                    opened,\n                    recheck_source=self._owner._incoming.recheck_opened_async,\n                )\n        except asyncio.CancelledError:\n            raise\n        except (BrokerArtifactStoreRejectedError, ReplicaPublicationRejectedError):\n            code = _REJECTION_CODE_BY_STAGE[stage]\n            raise StageRejected(\n                code,\n                _rejected_receipt_id(stage, operation_id, code),\n            ) from None\n        except (BrokerArtifactStoreUnresolvedError, ReplicaPublicationUnresolvedError):\n            raise StageOutcomeUnknown(_UNRESOLVED_REASON_BY_STAGE[stage]) from None\n        except Exception:\n            raise StageOutcomeUnknown(_UNRESOLVED_REASON_BY_STAGE[stage]) from None\n        return StageReconciliation(\n            outcome=\"completed\",\n            receipt=VerifyReceipt(\n                receipt_id=_verification_receipt_id(operation_id, verification),\n                bundle_sha256=verification.bundle.sha256,\n                worktree_sha256=verification.worktree.sha256,\n                index_objects_sha256=verification.index_objects.sha256,\n                source_state_sha256=verification.source_state_sha256,\n                reconciliation_fingerprint=verification.reconciliation_fingerprint,\n                artifact_set_sha256=verification.artifact_set_sha256,\n            ),\n        )\n\n\nclass _PublishStageEffect:\n    \"\"\"Apply or reconcile publish through the one-rename publication store.\"\"\"\n\n    def __init__(self, owner: BrokerReplicaArtifactEffects) -> None:\n        self._owner = owner\n\n    async def apply(\n        self,\n        context: ReplicaLifecycleContext,\n    ) -> StageReconciliation[PublishReceipt]:\n        stage = \"publish\"\n        operation_id = context.request.operation_id\n        declaration = _declaration(self._owner, context, stage)\n        try:\n            async with self._owner._incoming.open_incoming_async(\n                _incoming_manifest(declaration)\n            ) as opened:\n                publication = await self._owner._publication.publish_opened_artifact_set(\n                    declaration,\n                    opened,\n                    recheck_source=self._owner._incoming.recheck_opened_async,\n                )\n        except asyncio.CancelledError:\n            raise\n        except (BrokerArtifactStoreRejectedError, ReplicaPublicationRejectedError):\n            code = _REJECTION_CODE_BY_STAGE[stage]\n            raise StageRejected(\n                code,\n                _rejected_receipt_id(stage, operation_id, code),\n            ) from None\n        except (BrokerArtifactStoreUnresolvedError, ReplicaPublicationUnresolvedError):\n            raise StageOutcomeUnknown(_UNRESOLVED_REASON_BY_STAGE[stage]) from None\n        except Exception:\n            raise StageOutcomeUnknown(_UNRESOLVED_REASON_BY_STAGE[stage]) from None\n        return StageReconciliation(\n            outcome=\"completed\",\n            receipt=self._receipt(declaration, publication, context, stage),\n        )\n\n    async def reconcile(\n        self,\n        context: ReplicaLifecycleContext,\n    ) -> StageReconciliation[PublishReceipt]:\n        stage = \"publish\"\n        operation_id = context.request.operation_id\n        declaration = _declaration(self._owner, context, stage)\n        try:\n            publication = await self._owner._publication.reconcile_published_artifact_set(\n                declaration\n            )\n        except asyncio.CancelledError:\n            raise\n        except ReplicaPublicationRejectedError:\n            code = _REJECTION_CODE_BY_STAGE[stage]\n            raise StageRejected(\n                code,\n                _rejected_receipt_id(stage, operation_id, code),\n            ) from None\n        except ReplicaPublicationUnresolvedError:\n            raise StageOutcomeUnknown(_UNRESOLVED_REASON_BY_STAGE[stage]) from None\n        except Exception:\n            raise StageOutcomeUnknown(_UNRESOLVED_REASON_BY_STAGE[stage]) from None\n        if publication is None:\n            return StageReconciliation(outcome=\"not_applied\")\n        return StageReconciliation(\n            outcome=\"completed\",\n            receipt=self._receipt(declaration, publication, context, stage),\n        )\n\n    @staticmethod\n    def _receipt(\n        declaration: ReplicaArtifactSetDeclaration,\n        publication: ReplicaPublicationReceipt,\n        context: ReplicaLifecycleContext,\n        stage: str,\n    ) -> PublishReceipt:\n        if publication.identity != context.authority:\n            code = _REJECTION_CODE_BY_STAGE[stage]\n            raise StageRejected(\n                code,\n                _rejected_receipt_id(stage, declaration.operation_id, code),\n            )\n        return PublishReceipt(\n            receipt_id=_publication_receipt_id(declaration.operation_id, publication),\n            physical_target_id=context.authority.physical_target_id,\n            replica_generation=context.authority.replica_generation,\n            execution_owner_id=context.authority.execution_owner_id,\n            publication_marker_sha256=publication.publication_marker_sha256,\n            synchronization_receipt_id=publication.synchronization_receipt_id,\n            artifact_set_sha256=publication.artifact_set_sha256,\n        )\n\n\nclass BrokerReplicaArtifactEffects:\n    \"\"\"Own the artifact-backed ingest, verify, and publish stage effects.\n\n    The broker artifact store owns incoming bytes, the publication store owns\n    published bytes, and the replica journal stays the sole lifecycle stage\n    authority. Effects never open SQLite and mint authority only from the\n    authenticated request payload, the context authority, and the configured\n    immutable limit profile.\n    \"\"\"\n\n    def __init__(\n        self,\n        *,\n        incoming: BrokerArtifactStore,\n        publication: WorkspaceReplicaPublicationStore,\n        limits: ReplicaStoreLimits,\n    ) -> None:\n        if type(incoming) is not BrokerArtifactStore:\n            raise TypeError(\"broker artifact effects incoming store is invalid\")\n        if type(publication) is not WorkspaceReplicaPublicationStore:\n            raise TypeError(\"broker artifact effects publication store is invalid\")\n        if type(limits) is not ReplicaStoreLimits:\n            raise TypeError(\"broker artifact effects limits are invalid\")\n        limits_sha256 = compute_replica_limits_sha256(asdict(limits))\n        if publication.limits_sha256 != limits_sha256:\n            raise ValueError(\n                \"broker artifact effects limits differ from the publication store\"\n            )\n        self._incoming = incoming\n        self._publication = publication\n        self._limits = limits\n        self._limits_sha256 = limits_sha256\n        self.ingest = _IngestStageEffect(self)\n        self.verify = _VerifyStageEffect(self)\n        self.publish = _PublishStageEffect(self)\n```\n\n## Packet 3 — EDIT `backend/src/yinshi/services/workspace_replica_publication.py`\n\nExact anchor (end of `inspect_published_artifact_set`, the file's final method — unique in file):\n\n```python\n            return await self._inspect_final(declaration)\n        except asyncio.CancelledError:\n            raise\n        except ReplicaPublicationRejectedError:\n            raise\n        except Exception as error:\n            raise ReplicaPublicationRejectedError(\"published artifact inspection failed\") from error\n```\n\nReplace with that anchor plus the following appended methods (still inside `WorkspaceReplicaPublicationStore`):\n\n```python\n            return await self._inspect_final(declaration)\n        except asyncio.CancelledError:\n            raise\n        except ReplicaPublicationRejectedError:\n            raise\n        except Exception as error:\n            raise ReplicaPublicationRejectedError(\"published artifact inspection failed\") from error\n\n    async def reconcile_published_artifact_set(\n        self,\n        declaration: ReplicaArtifactSetDeclaration,\n    ) -> ReplicaPublicationReceipt | None:\n        \"\"\"Return the authority-bound publication receipt, or None when absent.\n\n        Inspect the exact final publication for one authenticated declaration\n        without minting authority from inspection alone. The returned receipt\n        binds the declaration identity, which the caller must have\n        authenticated. None means the final publication is conclusively\n        absent. Rejection or uncertainty raise as usual.\n        \"\"\"\n        declaration = _validate_declaration(declaration, self._ceilings)\n        try:\n            inspection = await self._inspect_final(declaration)\n        except asyncio.CancelledError:\n            raise\n        except ReplicaPublicationRejectedError as error:\n            presence = self._final_presence(declaration.operation_id)\n            if presence is False:\n                return None\n            if presence is None:\n                raise ReplicaPublicationUnresolvedError(\n                    \"publication presence is unresolved\"\n                ) from error\n            raise\n        except Exception as error:\n            raise ReplicaPublicationUnresolvedError(\n                \"publication reconciliation is unresolved\"\n            ) from error\n        return self._publication_receipt(declaration, inspection)\n\n    def _final_presence(self, operation_id: str) -> bool | None:\n        \"\"\"Report final publication presence, confirmed absence, or uncertainty.\"\"\"\n        try:\n            root_descriptor, _identity = _root_identity(\n                self._root,\n                self._expected_uid,\n                self._expected_gid,\n            )\n        except ReplicaPublicationRejectedError:\n            return None\n        try:\n            try:\n                os.stat(operation_id, dir_fd=root_descriptor, follow_symlinks=False)\n            except FileNotFoundError:\n                return False\n            except OSError:\n                return None\n            return True\n        finally:\n            os.close(root_descriptor)\n```\n\n## Parent application order and checks\n\n1. Apply Packet 1, run `cd backend && ../.venv/bin/python -m pytest tests/test_broker_replica_artifact_effects.py -q` → observe red (import error).\n2. Apply Packets 2+3, rerun → green (expect ~9 passed; git-dependent tests need the git binary, like the existing publication tests).\n3. `pytest tests/test_broker_replica_lifecycle.py tests/test_workspace_replica_publication.py tests/test_broker_artifact_store.py -q`; `black --check src tests` (ruff not installed locally; CI runs black/isort/flake8); `mypy src` (strict); `python -m py_compile` on both new/edited files; `git diff --check`.\n\nSession file: /Users/user/.pi/agent/sessions/--Users-user-projects-yinshi--/2026-09-04T04-44-52-550Z_01a06abb-dfc5-7c65-82bb-7c5f2081ee64/1e7e9618/run-0/session.jsonl","display":true,"id":"1bfb8753","parentId":"186995d6","timestamp":"2026-09-13T16:39:52.500Z"}
