(workspace_module, \"delete_worktree\", cleanup_effect)\n+307     monkeypatch.setattr(workspace_module, \"ensure_secret_guardrails\", lambda path: None)\n+308     with pytest.raises(asyncio.CancelledError):\n+309         asyncio.run(create_workspace_for_repo(run_operation, REPO_ID))\n+310 \n+311     retained = db.execute(\n+312         \"SELECT branch, path, state FROM workspaces WHERE repo_id = ?\", (REPO_ID,)\n+313     ).fetchone()\n+314     expected_path = str(Path(git_repo) / \".worktrees\" / \"committed\")\n+315     assert tuple(retained) == (\"committed\", expected_path, \"ready\")\n+316     assert Path(expected_path).is_dir()\n+317     assert cleanup_called is False\n+318 \n+319 \n 273 def test_failed_workspace_creation_cleanup_retains_durable_owner(\n 274     db, git_repo: str, monkeypatch\n 275 ) -> None:\n 276     from yinshi.exceptions import GitError\n     ...","patch":"--- backend/tests/test_repository_deletion_admission.py\n+++ backend/tests/test_repository_deletion_admission.py\n@@ -269,8 +269,55 @@\n     assert cleanup_calls == [(git_repo, str(Path(git_repo) / \".worktrees\" / \"raced\"))]\n     assert db.execute(\"SELECT COUNT(*) FROM workspaces\").fetchone()[0] == 0\n \n \n+def test_workspace_creation_cancellation_after_commit_preserves_admission(\n+    db, git_repo: str, monkeypatch\n+) -> None:\n+    from yinshi.services import workspace as workspace_module\n+\n+    db.execute(\n+        \"INSERT INTO repos (id, name, root_path) VALUES (?, 'repo', ?)\",\n+        (REPO_ID, git_repo),\n+    )\n+    db.commit()\n+    propagated_commit = False\n+    cleanup_called = False\n+\n+    async def run_operation(operation):\n+        nonlocal propagated_commit\n+        result = operation(db)\n+        admitted = db.execute(\n+            \"SELECT COUNT(*) FROM workspaces WHERE repo_id = ?\", (REPO_ID,)\n+        ).fetchone()[0]\n+        if admitted and not propagated_commit:\n+            propagated_commit = True\n+            raise asyncio.CancelledError\n+        return result\n+\n+    async def create_effect(repo_path, worktree_path, branch, **kwargs):\n+        Path(worktree_path).mkdir(parents=True)\n+\n+    async def cleanup_effect(*args, **kwargs):\n+        nonlocal cleanup_called\n+        cleanup_called = True\n+\n+    monkeypatch.setattr(workspace_module, \"generate_branch_name\", lambda **kwargs: \"committed\")\n+    monkeypatch.setattr(workspace_module, \"create_worktree\", create_effect)\n+    monkeypatch.setattr(workspace_module, \"delete_worktree\", cleanup_effect)\n+    monkeypatch.setattr(workspace_module, \"ensure_secret_guardrails\", lambda path: None)\n+    with pytest.raises(asyncio.CancelledError):\n+        asyncio.run(create_workspace_for_repo(run_operation, REPO_ID))\n+\n+    retained = db.execute(\n+        \"SELECT branch, path, state FROM workspaces WHERE repo_id = ?\", (REPO_ID,)\n+    ).fetchone()\n+    expected_path = str(Path(git_repo) / \".worktrees\" / \"committed\")\n+    assert tuple(retained) == (\"committed\", expected_path, \"ready\")\n+    assert Path(expected_path).is_dir()\n+    assert cleanup_called is False\n+\n+\n def test_failed_workspace_creation_cleanup_retains_durable_owner(\n     db, git_repo: str, monkeypatch\n ) -> None:\n     from yinshi.exceptions import GitError\n","firstChangedLine":273},"isError":false,"timestamp":1789293507576}}
{"type":"message","id":"b1e15164","parentId":"381603ec","timestamp":"2026-09-13T09:58:44.447Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Planning commit cancellation tests**\n\n**Adding cleanup effects with Path.rmdir**","thinkingSignature":"{\"id\":\"rs_0212e7de83dbbd32016aa673c786b487d0bb727f5340dcc055\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"REDACTED\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Planning commit cancellation tests**\"},{\"type\":\"summary_text\",\"text\":\"**Adding cleanup effects with Path.rmdir**\"}]}"},{"type":"toolCall","id":"call_vnsEfA7LuPqofRKl8PDku0do|fc_0212e7de83dbbd32016aa673cea9f087d09ea16a4b66c76d40","name":"edit","arguments":{"path":"backend/tests/test_repository_deletion_admission.py","edits":[{"oldText":"def test_workspace_creation_cancellation_after_commit_preserves_admission(\n","newText":"def test_workspace_creation_cancellation_before_commit_settles_cleanup(\n    db, git_repo: str, monkeypatch\n) -> None:\n    from yinshi.services import workspace as workspace_module\n\n    db.execute(\n        \"INSERT INTO repos (id, name, root_path) VALUES (?, 'repo', ?)\",\n        (REPO_ID, git_repo),\n    )\n    db.commit()\n    authorization_calls = 0\n    cleanup_settled = False\n\n    async def run_operation(operation):\n        return operation(db)\n\n    def authorize(connection) -> None:\n        nonlocal authorization_calls\n        authorization_calls += 1\n        if authorization_calls == 2:\n            raise asyncio.CancelledError\n\n    async def create_effect(repo_path, worktree_path, branch, **kwargs):\n        Path(worktree_path).mkdir(parents=True)\n\n    async def cleanup_effect(repo_path, worktree_path):\n        nonlocal cleanup_settled\n        await asyncio.sleep(0)\n        Path(worktree_path).rmdir()\n        cleanup_settled = True\n\n    monkeypatch.setattr(workspace_module, \"generate_branch_name\", lambda **kwargs: \"cancelled\")\n    monkeypatch.setattr(workspace_module, \"create_worktree\", create_effect)\n    monkeypatch.setattr(workspace_module, \"delete_worktree\", cleanup_effect)\n    monkeypatch.setattr(workspace_module, \"ensure_secret_guardrails\", lambda path: None)\n    with pytest.raises(asyncio.CancelledError):\n        asyncio.run(\n            create_workspace_for_repo(\n                run_operation,\n                REPO_ID,\n                authorize=authorize,\n            )\n        )\n\n    expected_path = Path(git_repo) / \".worktrees\" / \"cancelled\"\n    assert cleanup_settled is True\n    assert not expected_path.exists()\n    assert db.execute(\"SELECT COUNT(*) FROM workspaces\").fetchone()[0] == 0\n\n\ndef test_workspace_creation_cancellation_after_commit_preserves_admission(\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":849,"output":701,"cacheRead":67584,"cacheWrite":0,"reasoning":198,"totalTokens":69134,"cost":{"input":0.0042450000000000005,"output":0.02103,"cacheRead":0.033791999999999996,"cacheWrite":0,"total":0.059066999999999995}},"stopReason":"toolUse","timestamp":1789293507582,"responseId":"resp_0212e7de83dbbd32016aa673c412e887d0acd6b2b9ff35fac2","rawStopReason":"completed"}}
