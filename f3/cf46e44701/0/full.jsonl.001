/promisor dependence.\nUse immutable bounded result metadata. Do not carry bytes in verification receipts. Created result may carry bytes like current bundle API.\nTests: SHA-1/SHA-256 staged-only blob, conflict blobs, staged content differs from worktree, bundle-reachable excluded, empty pack, exact bounds, tamper, wrong type, missing/extra expected OIDs, thin/external base, replacement ignored, public bundle verifier exact inventory and extra-object rejection, stdin overflow/cancellation.\nRun focused tests for git runner, bundle, object pack, artifact. Run Ruff, format check, strict source mypy, py_compile, diff check. Escalate any Git-version behavior mismatch with command output.","routingContract":{"version":1,"agent":"worker-advanced","model":"z-ai/glm-5.3-flash","thinking":"max","policyDigest":"8590d2fc0420152aad3f867aba1c18a56b3632f2d90e01d30d3f04676cd46ac5"},"launchContractDigest":"1ebe79a86965338393a86c6f598bbd99d3d91901c844ed5c476ebf28efc41be7","launchResolvedExtensions":{"version":1,"source":"launch-resolved","disableAmbientExtensions":true,"runtime":["sha256:cb00ccf63b7cf9f4"],"configured":["sha256:890420901a90541d"],"effective":["sha256:cb00ccf63b7cf9f4","sha256:890420901a90541d"],"omitted":{"runtime":0,"configured":0,"effective":0}},"exitCode":-2,"outputState":"absent","usage":{"input":89484,"output":47499,"cacheRead":1089664,"cacheWrite":0,"cost":0,"turns":26},"model":"z-ai/glm-5.3-flash:max","thinking":"max","artifactPaths":{"inputPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/9ba166a3_worker-advanced_0_input.md","outputPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/9ba166a3_worker-advanced_0_output.md","jsonlPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/9ba166a3_worker-advanced_0.jsonl","transcriptPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/9ba166a3_worker-advanced_0_transcript.jsonl","metadataPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/9ba166a3_worker-advanced_0_meta.json"},"trans