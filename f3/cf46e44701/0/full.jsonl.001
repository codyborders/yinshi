, create_effect)\n+213     monkeypatch.setattr(workspace_module, \"ensure_secret_guardrails\", guardrail_effect)\n+214     created = asyncio.run(create_workspace_for_repo(run_operation, REPO_ID))\n+215     assert created[\"branch\"] == \"short-db\"\n+216     assert deletion_checks == [False, True]\n+217 \n+218 \n+219 def test_workspace_creation_receipt_blocks_before_external_effect(\n+220     db, git_repo: str, monkeypatch\n+221 ) -> None:\n+222     from yinshi.services import workspace as workspace_module\n+223 \n+224     db.execute(\n+225         \"INSERT INTO repos (id, name, root_path) VALUES (?, 'repo', ?)\",\n+226         (REPO_ID, git_repo),\n+227     )\n+228     db.commit()\n+229     _insert_receipt(db)\n+230 \n+231     async def run_operation(operation):\n+232         return operation(db)\n+233 \n+234     async def forbidden(*args, **kwargs):\n+235         raise AssertionError(\"workspace creation external effect ran\")\n+236 \n+237     monkeypatch.setattr(workspace_module, \"create_worktree\", forbidden)\n+238     monkeypatch.setattr(workspace_module, \"resolve_remote_base_ref\", forbidden)\n+239     with pytest.raises(RepositoryDeletionPendingError):\n+240         asyncio.run(create_workspace_for_repo(run_operation, REPO_ID))\n+241 \n+242 \n 177 def _repair_tenant() -> TenantContext:\n 178     return TenantContext(\n 179         user_id=\"tenant-user\",\n 180         email=\"tenant@example.com\",\n     ...","patch":"--- backend/tests/test_repository_deletion_admission.py\n+++ backend/tests/test_repository_deletion_admission.py\n@@ -173,8 +173,74 @@\n     assert db.execute(\"SELECT COUNT(*) FROM workspaces\").fetchone()[0] == 0\n     assert not (Path(git_repo) / \".worktrees\").exists()\n \n \n+def test_workspace_creation_uses_short_database_callbacks(\n+    db, git_repo: str, monkeypatch\n+) -> None:\n+    from yinshi.services import workspace as workspace_module\n+\n+    db.execute(\n+        \"INSERT INTO repos (id, name, root_path) VALUES (?, 'repo', ?)\",\n+        (REPO_ID, git_repo),\n+    )\n+    db.commit()\n+    callback_active = False\n+    deletion_checks: list[bool] = []\n+    real_check = workspace_module.require_no_repository_deletion\n+\n+    async def run_operation(operation):\n+        nonlocal callback_active\n+        assert not callback_active\n+        callback_active = True\n+        try:\n+            return operation(db)\n+        finally:\n+            callback_active = False\n+\n+    def checked(database, repo_id):\n+        deletion_checks.append(bool(database.in_transaction))\n+        real_check(database, repo_id)\n+\n+    async def create_effect(*args, **kwargs):\n+        assert not callback_active\n+\n+    def guardrail_effect(*args, **kwargs):\n+        assert not callback_active\n+\n+    monkeypatch.setattr(workspace_module, \"require_no_repository_deletion\", checked)\n+    monkeypatch.setattr(workspace_module, \"generate_branch_name\", lambda **kwargs: \"short-db\")\n+    monkeypatch.setattr(workspace_module, \"create_worktree\", create_effect)\n+    monkeypatch.setattr(workspace_module, \"ensure_secret_guardrails\", guardrail_effect)\n+    created = asyncio.run(create_workspace_for_repo(run_operation, REPO_ID))\n+    assert created[\"branch\"] == \"short-db\"\n+    assert deletion_checks == [False, True]\n+\n+\n+def test_workspace_creation_receipt_blocks_before_external_effect(\n+    db, git_repo: str, monkeypatch\n+) -> None:\n+    from yinshi.services import workspace as workspace_module\n+\n+    db.execute(\n+        \"INSERT INTO repos (id, name, root_path) VALUES (?, 'repo', ?)\",\n+        (REPO_ID, git_repo),\n+    )\n+    db.commit()\n+    _insert_receipt(db)\n+\n+    async def run_operation(operation):\n+        return operation(db)\n+\n+    async def forbidden(*args, **kwargs):\n+        raise AssertionError(\"workspace creation external effect ran\")\n+\n+    monkeypatch.setattr(workspace_module, \"create_worktree\", forbidden)\n+    monkeypatch.setattr(workspace_module, \"resolve_remote_base_ref\", forbidden)\n+    with pytest.raises(RepositoryDeletionPendingError):\n+        asyncio.run(create_workspace_for_repo(run_operation, REPO_ID))\n+\n+\n def _repair_tenant() -> TenantContext:\n     return TenantContext(\n         user_id=\"tenant-user\",\n         email=\"tenant@example.com\",\n","firstChangedLine":177},"isError":false,"timestamp":1789288434102}}
{"type":"message","id":"be87cf28","parentId":"7cffbcae","timestamp":"2026-09-13T08:34:27.230Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Adding integration spies and transaction setup**","thinkingSignature":"{\"id\":\"rs_0212e7de83dbbd32016aa65ff6067c87d0a2c513bb4b9dbf92\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"REDACTED\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Adding integration spies and transaction setup**\"}]}"},{"type":"toolCall","id":"call_Ub9Z66dtCGt8WdwHvJ5bhKda|fc_0212e7de83dbbd32016aa65ff76f5887d096f405ad3b7b16bf","name":"edit","arguments":{"path":"backend/tests/test_repository_deletion_admission.py","edits":[{"oldText":"    assert db.execute(\"SELECT COUNT(*) FROM thread_integrations\").fetchone()[0] == 0\n    assert head_commit(git_repo) == parent_head\n","newText":"    assert db.execute(\"SELECT COUNT(*) FROM thread_integrations\").fetchone()[0] == 0\n    assert head_commit(git_repo) == parent_head\n\n\ndef test_execution_receipt_blocks_before_checkout_recovery(\n    db, git_repo: str, monkeypatch\n) -> None:\n    from yinshi.services import workspace_execution as execution_module\n\n    _seed_worktree_stack(db, git_repo)\n    _insert_receipt(db)\n\n    async def forbidden(*args, **kwargs):\n        raise AssertionError(\"execution checkout recovery ran\")\n\n    monkeypatch.setattr(\n        execution_module, \"_recover_pending_checkout_for_execution\", forbidden\n    )\n    with pytest.raises(WorkspaceAdmissionError):\n        asyncio.run(\n            execution_module.acquire_prompt_workspace(\n                _request(), SESSION_ID, uuid.uuid4().hex, kind=\"prompt\"\n            )\n        )\n\n\ndef test_checkout_publication_receipt_blocks_before_git_validation(\n    db, git_repo: str, monkeypatch\n) -> None:\n    from yinshi.services import workspace_publication as publication_module\n\n    worktree_path = _seed_worktree_stack(db, git_repo)\n    state = WorkspaceCheckoutState(\n        REDACTED,\n        repo_id=REPO_ID,\n        repo_path=git_repo,\n        remote_url=None,\n        installation_id=None,\n        workspaces=((WORKSPACE_ID, BRANCH),),\n        workspace_paths=((WORKSPACE_ID, worktree_path),),\n    )\n    _insert_receipt(db)\n\n    async def run_operation(operation):\n        return operation(db)\n\n    async def forbidden(*args, **kwargs):\n        raise AssertionError(\"checkout Git validation ran\")\n\n    monkeypatch.setattr(publication_module, \"validate_local_repo\", forbidden)\n    with pytest.raises(publication_module.WorkspacePublicationConflictError):\n        asyncio.run(\n            publication_module.publish_workspace_checkout_for_tenant(\n                _repair_tenant(),\n                state,\n                run_database_operation=run_operation,\n                authorize=lambda database: state,\n                authority_hash=\"a\" * 64,\n                database_identity=\"identity\",\n            )\n        )\n\n\ndef test_checkout_metadata_rechecks_deletion_inside_transaction(\n    db, git_repo: str, monkeypatch\n) -> None:\n    from yinshi.services import workspace as workspace_module\n    from yinshi.services.workspace_publication import WorkspacePublicationConflictError\n\n    worktree_path = _seed_worktree_stack(db, git_repo)\n    preparation = workspace_module.WorkspaceCheckoutPreparation(\n        REDACTED,\n        repo_id=REPO_ID,\n        repo_path=git_repo,\n        remote_url=\"https://example.invalid/repo.git\",\n        installation_id=None,\n        workspace_paths=((WORKSPACE_ID, worktree_path),),\n        update_repo_metadata=True,\n        repaired_repo=False,\n    )\n    observed: list[bool] = []\n    real_check = workspace_module.require_no_repository_deletion\n\n    def checked(database, repo_id):\n        observed.append(bool(database.in_transaction))\n        real_check(database, repo_id)\n\n    monkeypatch.setattr(workspace_module, \"require_no_repository_deletion\", checked)\n    _insert_receipt(db)\n    with pytest.raises(WorkspacePublicationConflictError):\n        workspace_module.apply_workspace_checkout_preparation(db, preparation)\n    assert observed == [True]\n    assert db.execute(\"SELECT remote_url FROM repos WHERE id = ?\", (REPO_ID,)).fetchone()[0] is None\n\n\ndef test_managed_integration_receipt_blocks_before_preview_and_identity(\n    client, db, git_repo: str, monkeypatch\n) -> None:\n    from yinshi.services.thread_integration import ThreadIntegrationService\n    from yinshi.services.thread_workspaces import ThreadWorkspaceService\n\n    monkeypatch.setenv(\"THREAD_MANAGED_INTEGRATION_ENABLED\", \"true\")\n    get_settings.cache_clear()\n    seed_parent_stack(db, git_repo)\n    spawned = client.post(\n        \"/api/threads/parent-session/children\",\n        json={\n            \"idempotency_key\": str(uuid.uuid4()),\n            \"title\": \"Preflight child\",\n            \"task\": \"Update README.md\",\n            \"start_immediately\": False,\n        },\n    )\n    assert spawned.status_code == 201\n    child = spawned.json()\n    workspace = db.execute(\n        \"SELECT w.path FROM workspaces w JOIN sessions s ON s.workspace_id = w.id WHERE s.id = ?\",\n        (child[\"child_session_id\"],),\n    ).fetchone()\n    (Path(workspace[\"path\"]) / \"README.md\").write_bytes(b\"# Child result\\n\")\n    from yinshi.services.thread_orchestration import initial_run_idempotency_key\n\n    db.execute(\n        \"INSERT INTO prompt_runs (id, session_id, idempotency_key, status) VALUES (?, ?, ?, 'completed')\",\n        (\n            uuid.uuid4().hex,\n            child[\"child_session_id\"],\n            initial_run_idempotency_key(child[\"delegation_id\"]),\n        ),\n    )\n    db.execute(\n        \"UPDATE thread_delegations SET status = 'completed' WHERE id = ?\",\n        (child[\"delegation_id\"],),\n    )\n    db.commit()\n    sealed = client.get(f\"/api/threads/{child['child_session_id']}/result\")\n    assert sealed.status_code == 200\n    endpoint = f\"/api/threads/parent-session/children/{child['child_session_id']}/integrate\"\n    preview = client.get(endpoint).json()\n    repo_id = db.execute(\n        \"SELECT w.repo_id FROM workspaces w JOIN sessions s ON s.workspace_id = w.id WHERE s.id = 'parent-session'\"\n    ).fetchone()[0]\n    _insert_receipt(db, repo_id=str(repo_id))\n\n    async def forbidden(*args, **kwargs):\n        raise AssertionError(\"managed integration Git effect ran\")\n\n    monkeypatch.setattr(ThreadIntegrationService, \"preview\", forbidden)\n    monkeypatch.setattr(ThreadWorkspaceService, \"integration_workspace_identity\", forbidden)\n    response = client.post(\n        endpoint,\n        json={\n            \"idempotency_key\": str(uuid.uuid4()),\n            \"result_id\": preview[\"result_id\"],\n            \"expected_parent_head\": preview[\"expected_parent_head\"],\n            \"confirmed\": True,\n        },\n    )\n    assert response.status_code == 409\n    assert response.json()[\"detail\"] == \"Integration precondition changed\"\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":935,"output":1606,"cacheRead":184832,"cacheWrite":0,"reasoning":34,"totalTokens":187373,"cost":{"input":0.004675,"output":0.04818,"cacheRead":0.092416,"cacheWrite":0,"total":0.14527099999999998}},"stopReason":"toolUse","timestamp":1789288434124,"responseId":"resp_0212e7de83dbbd32016aa65ff2b9f887d08fdc477979faa3a9","rawStopReason":"completed"}}
