_broker_replica_journal.py\\\",\\n          \\\"fullName\\\": \\\"tests/test_broker_replica_journal.py\\\",\\n          \\\"state\\\": \\\"failed\\\",\\n          \\\"errors\\\": [\\n            {\\n              \\\"message\\\": \\\"ImportError while importing test module '/Users/user/projects/yinshi/backend/tests/test_broker_replica_journal.py'.\\\\nHint: make sure your test modules/packages have valid Python names.\\\\nTraceback:\\\\n../../.pyenv/versions/3.11.9/lib/python3.11/importlib/__init__.py:126: in import_module\\\\n    return _bootstrap._gcd_import(name[level:], package, level)\\\\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\\\\n../../.pyenv/versions/3.11.9/lib/python3.11/site-packages/ddtrace/internal/module.py:295: in _exec_module\\\\n    self.loader.exec_module(module)\\\\nbackend/tests/test_broker_replica_journal.py:15: in <module>\\\\n    from yinshi.services.broker_protocol import (\\\\nE   ModuleNotFoundError: No module named 'yinshi.services.broker_protocol'\\\"\\n            }\\n          ]\\n        }\\n      ]\\n    }\\n  ]\\n}{\\n  \\\"session_id\\\": \\\"10827e3f-22f0-4087-b728-5efd8afa0ee1\\\",\\n  \\\"transcript_path\\\": \\\"/Users/user/.claude/projects/-Users-user-projects-yinshi/10827e3f-22f0-4087-b728-5efd8afa0ee1.jsonl\\\",\\n  \\\"hook_event_name\\\": \\\"PreToolUse\\\",\\n  \\\"tool_name\\\": \\\"Edit\\\",\\n  \\\"tool_input\\\": {\\n    \\\"file_path\\\": \\\"/Users/user/projects/yinshi/frontend/src/App.tsx\\\",\\n    \\\"old_string\\\": \\\"    <Routes>\\\\n      <Route path=\\\\\\\"/landing\\\\\\\" element={<Landing />} />\\\\n      <Route path=\\\\\\\"/login\\\\\\\" element={<Login />} />\\\\n      <Route element={<RequireAuth />}>\\\\n        <Route element={<Layout />}>\\\\n          <Route path=\\\\\\\"/\\\\\\\" element={<EmptyState />} />\\\\n          <Route path=\\\\\\\"/session/:id\\\\\\\" element={<Session />} />\\\\n        </Route>\\\\n      </Route>\\\\n    </Routes>\\\",\\n    \\\"new_string\\\": \\\"    <Routes>\\\\n      <Route path=\\\\\\\"/\\\\\\\" element={<Landing />} />\\\\n      <Route element={<RequireAuth />}>\\\\n        <Route element={<Layout />}>\\\\n          <Route path=\\\\\\\"/app\\\\\\\" element={<EmptyState />} />\\\\n          <Route path=\\\\\\\"/app/session/:id\\\\\\\" element={<Session />} />\\\\n        </Route>\\\\n      </Route>\\\\n    </Routes>\\\",\\n    \\\"replace_all\\\": false\\n  }\\n}{\\n  \\\"testModules\\\": [\\n    {\\n      \\\"moduleId\\\": \\\"tests/test_broker_artifact_store.py\\\",\\n      \\\"tests\\\": [\\n        {\\n          \\\"name\\\": \\\"collection_error_tests/test_broker_artifact_store.py\\\",\\n          \\\"fullName\\\": \\\"tests/test_broker_artifact_store.py\\\",\\n          \\\"state\\\": \\\"failed\\\",\\n          \\\"errors\\\": [\\n            {\\n              \\\"message\\\": \\\"ImportError while importing test module '/Users/user/projects/yinshi/backend/tests/test_broker_artifact_store.py'.\\\\nHint: make sure your test modules/packages have valid Python names.\\\\nTraceback:\\\\n../../../.pyenv/versions/3.11.9/lib/python3.11/importlib/__init__.py:126: in import_module\\\\n    return _bootstrap._gcd_import(name[level:], package, level)\\\\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\\\\n../../../.pyenv/versions/3.11.9/lib/python3.11/site-packages/ddtrace/internal/module.py:295: in _exec_module\\\\n    self.loader.exec_module(module)\\\\ntests/test_broker_artifact_store.py:15: in <module>\\\\n    from yinshi.services.broker_artifact_store import (\\\\nE   ModuleNotFoundError: No module named 'yinshi.services.broker_artifact_store'\\\"\\n            }\\n          ]\\n        }\\n      ]\\n    }\\n  ]\\n}\"}],\"timestamp\":1789268974689}}","truncated":true,"truncatedBy":"bytes","totalLines":43,"totalBytes":264246,"outputLines":13,"outputBytes":18766,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":51200}},"isError":false,"timestamp":1789270312