eplica_reconciliation.py:3243:        \"record_drain\",\nbackend/tests/test_workspace_replica_reconciliation.py:3255:        \"acknowledge_destination_binding\",\nbackend/tests/test_workspace_replica_reconciliation.py:3608:            replace(retained, acknowledgment=replace(retained.acknowledgment, receipt_id=\"wrong\")),\nbackend/tests/test_workspace_replica_reconciliation.py:3609:            \"acknowledgment_unavailable\",\nbackend/tests/test_workspace_replica_reconciliation.py:3612:            replace(retained, drain=replace(retained.drain, replica_generation=4)),\nbackend/tests/test_workspace_replica_reconciliation.py:3613:            \"drain_unverified\",\nbackend/tests/test_workspace_replica_reconciliation.py:3618:                export=replace(retained.export, specification_fingerprint=\"sha256:\" + \"0\" * 64),\nbackend/tests/test_workspace_replica_reconciliation.py:3620:            \"export_stale\",\nbackend/tests/test_workspace_replica_reconciliation.py:4370:    \"acknowledgment\",\nbackend/tests/test_workspace_replica_reconciliation.py:4371:    [\"acknowledge_working_install\", \"acknowledge_index\"],\nbackend/tests/test_workspace_replica_reconciliation.py:4373:def test_acknowledgment_cannot_assign_unreached_physical_state(\nbackend/tests/test_workspace_replica_reconciliation.py:4374:    acknowledgment: str,\nbackend/tests/test_workspace_replica_reconciliation.py:4376:    \"\"\"An acknowledgment must assert its physical precondition.\"\"\"\nbackend/tests/test_workspace_replica_reconciliation.py:4387:            acknowledgment,\nbackend/tests/test_thread_integration_recovery.py:1:\"\"\"Recovery acknowledges an applied exact trial without repeating parent Git changes.\"\"\"\nbackend/tests/test_thread_integration_recovery.py:14:async def test_status_recovers_commit_after_git_acknowledgment_loss(\nbackend/tests/test_thread_integration_recovery.py:30:                raise GitError(\"Fixture lost the successful Git acknowledgment\")\nbackend/tests/test_sidecar