fy known final sets.\"\"\"\n        if (\n            not isinstance(journal_manifests, Mapping)\n            or len(journal_manifests) > self._limits.max_root_entries\n            or any(\n                type(operation) is not str\n                or not _OPERATION_PATTERN.fullmatch(operation)\n                or type(manifest) is not ReplicaArtifactManifest\n                or manifest.operation_id != operation\n                for operation, manifest in journal_manifests.items()\n            )\n        ):\n            raise BrokerArtifactStoreRejectedError(\"journal manifest map is invalid\")\n"},{"oldText":"                if _OPERATION_PATTERN.fullmatch(name):\n                    results.append(\n                        ArtifactReconciliationResult(\n                            entry_name=name,\n                            operation_id=name,\n                            state=(\n                                \"incoming_present\"\n                                if name in journal_operations\n                                else \"unjournaled_present\"\n                            ),\n                        )\n                    )\n                    continue\n","newText":"                if _OPERATION_PATTERN.fullmatch(name):\n                    known_manifest = journal_manifests.get(name)\n                    if known_manifest is None:\n                        final_state = \"unjournaled_present\"\n                    else:\n                        try:\n                            self.inspect_incoming(known_manifest)\n                        except BrokerArtifactStoreRejectedError:\n                            final_state = \"unverified_final_present\"\n                        except (BrokerArtifactStoreUnresolvedError, OSError):\n                            final_state = \"unresolved\"\n                        else:\n                            final_state = \"incoming_verified\"\n                    results.append(\n                        ArtifactReconciliationResult(\n                            entry_name=name,\n                            operation_id=name,\n                            state=final_state,\n                        )\n                    )\n                    continue\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":493,"output":830,"cacheRead":132736,"cacheWrite":0,"reasoning":146,"totalTokens":134059,"cost":{"input":0.002465,"output":0.024900000000000002,"cacheRead":0.066368,"cacheWrite":0,"total":0.093733}},"stopReason":"toolUse","timestamp":1789255932661,"responseId":"resp_0212e7de83dbbd32016aa5e0fd481c87d0a31d29e6844d1ddf","rawStopReason":"completed"}}
