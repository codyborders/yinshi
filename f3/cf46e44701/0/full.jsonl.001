iginal = publication.verify_artifact_set\n+272     started = __import__(\"asyncio\").Event()\n+273     release = __import__(\"asyncio\").Event()\n+274 \n+275     async def paused(*args, **kwargs):\n+276         started.set()\n+277         await release.wait()\n+278         return await original(*args, **kwargs)\n+279 \n+280     monkeypatch.setattr(publication, \"verify_artifact_set\", paused)\n+281     task = __import__(\"asyncio\").create_task(\n+282         publication.inspect_published_artifact_set(declaration)\n+283     )\n+284     await started.wait()\n+285     final = tmp_path / \"published\" / declaration.operation_id\n+286     replacement = final / \"replacement\"\n+287     replacement.write_bytes((final / \"worktree.yra\").read_bytes())\n+288     replacement.chmod(0o600)\n+289     replacement.replace(final / \"worktree.yra\")\n+290     release.set()\n+291     with pytest.raises(ReplicaPublicationRejectedError, match=\"changed\"):\n+292         await task\n+293 \n+294 \n+295 @pytest.mark.asyncio\n+296 async def test_bundled_index_object_must_be_blob(tmp_path: Path) -> None:\n+297     declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n+298     decoded = decode_worktree_artifact(worktree)\n+299     tree_oid = subprocess.run(\n+300         [\"git\", \"bundle\", \"list-heads\", \"/dev/null\"],\n+301         check=False,\n+302         capture_output=True,\n+303     )\n+304     del tree_oid\n+305     repository = tmp_path / \"source\"\n+306     tree = bytes.fromhex(git(repository, \"rev-parse\", \"HEAD^{tree}\"))\n+307     index = bytearray(decoded.index_bytes or b\"\")\n+308     index[52:72] = tree\n+309     index[-20:] = hashlib.sha1(index[:-20]).digest()\n+310     changed_worktree = encode_worktree_artifact(\n+311         WorktreeArtifactInput(\n+312             object_format=decoded.object_format,\n+313             head_state=decoded.head_state,\n+314             head_target=decoded.head_target,\n+315             head_oid=decoded.head_oid,\n+316             index_bytes=bytes(index),\n+317             entries=decoded.entries,\n+318             root_oids=tuple(sorted((decoded.head_oid, tree))),\n+319         )\n+320     )\n+321     changed = replace(\n+322         declaration,\n+323         worktree=binding(\n+324             \"worktree\",\n+325             \"application/vnd.yinshi.replica-worktree.v1\",\n+326             \"worktree-tree\",\n+327             changed_worktree,\n+328         ),\n+329         source_state_sha256=decode_worktree_artifact(\n+330             changed_worktree\n+331         ).source_state_sha256.hex(),\n+332     )\n+333     with pytest.raises(ReplicaPublicationRejectedError, match=\"not a blob\"):\n+334         await store(tmp_path).verify_artifact_set(changed, bundle, changed_worktree, objects)\n+335 \n+336 \n+337 @pytest.mark.asyncio\n+338 async def test_pre_rename_failure_cleans_owned_stage(tmp_path: Path, monkeypatch) -> None:\n+339     from yinshi.services import workspace_replica_publication as module\n+340 \n+341     declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n+342     publication = store(tmp_path)\n+343 \n+344     def fail_before_move(*args, **kwargs):\n+345         raise WorkspacePublicationError(\"before move\")\n+346 \n+347     monkeypatch.setattr(module, \"atomic_rename_no_replace\", fail_before_move)\n+348     with pytest.raises(ReplicaPublicationRejectedError, match=\"before visibility\"):\n+349         await publication.publish_artifact_set(declaration, bundle, worktree, objects)\n+350     assert not any((tmp_path / \"published\").iterdir())\n+351 \n+352 \n+353 @pytest.mark.asyncio\n+354 async def test_post_move_sync_failure_is_unresolved(tmp_path: Path, monkeypatch) -> None:\n+355     from yinshi.services import workspace_replica_publication as module\n+356 \n+357     declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n+358     publication = store(tmp_path)\n+359 \n+360     def move_then_fail(source: Path, target: Path, **kwargs):\n+361         os.rename(source, target)\n+362         raise OSError(\"root sync failed\")\n+363 \n+364     monkeypatch.setattr(module, \"atomic_rename_no_replace\", move_then_fail)\n+365     with pytest.raises(ReplicaPublicationUnresolvedError):\n+366         await publication.publish_artifact_set(declaration, bundle, worktree, objects)\n+367     assert (tmp_path / \"published\" / declaration.operation_id).is_dir()\n+368 \n+369 \n+370 @pytest.mark.asyncio\n+371 async def test_pending_tamper_never_becomes_visible(tmp_path: Path, monkeypatch) -> None:\n+372     declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n+373     publication = store(tmp_path)\n+374     original = publication._inspect_pending\n+375 \n+376     def tamper(parent: int, pending_name: str, expected: dict[str, bytes]):\n+377         pending = tmp_path / \"published\" / pending_name\n+378         (pending / \"unknown\").write_bytes(b\"foreign\")\n+379         return original(parent, pending_name, expected)\n+380 \n+381     monkeypatch.setattr(publication, \"_inspect_pending\", tamper)\n+382     with pytest.raises(ReplicaPublicationUnresolvedError):\n+383         await publication.publish_artifact_set(declaration, bundle, worktree, objects)\n+384     assert not (tmp_path / \"published\" / declaration.operation_id).exists()\n+385     assert (tmp_path / \"published\" / f\".{declaration.operation_id}.pending\" / \"unknown\").exists()\n+386 \n+387 \n+388 @pytest.mark.asyncio\n+389 async def test_malformed_declaration_types_use_stable_rejection(tmp_path: Path) -> None:\n+390     declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n+391     publication = store(tmp_path)\n+392     malformed = replace(declaration, object_format=1)  # type: ignore[arg-type]\n+393     with pytest.raises(ReplicaPublicationRejectedError):\n+394         await publication.verify_artifact_set(malformed, bundle, worktree, objects)\n+395   