72 \n+273 \n 243 def _repair_tenant() -> TenantContext:\n 244     return TenantContext(\n 245         user_id=\"tenant-user\",\n 246         email=\"tenant@example.com\",\n     ...","patch":"--- backend/tests/test_repository_deletion_admission.py\n+++ backend/tests/test_repository_deletion_admission.py\n@@ -239,8 +239,39 @@\n     with pytest.raises(RepositoryDeletionPendingError):\n         asyncio.run(create_workspace_for_repo(run_operation, REPO_ID))\n \n \n+def test_workspace_creation_losing_final_race_cleans_unadmitted_worktree(\n+    db, git_repo: str, monkeypatch\n+) -> None:\n+    from yinshi.services import workspace as workspace_module\n+\n+    db.execute(\n+        \"INSERT INTO repos (id, name, root_path) VALUES (?, 'repo', ?)\",\n+        (REPO_ID, git_repo),\n+    )\n+    db.commit()\n+    cleanup_calls: list[tuple[str, str]] = []\n+\n+    async def run_operation(operation):\n+        return operation(db)\n+\n+    async def create_effect(*args, **kwargs):\n+        _insert_receipt(db)\n+\n+    async def cleanup_effect(repo_path, workspace_path):\n+        cleanup_calls.append((repo_path, workspace_path))\n+\n+    monkeypatch.setattr(workspace_module, \"generate_branch_name\", lambda **kwargs: \"raced\")\n+    monkeypatch.setattr(workspace_module, \"create_worktree\", create_effect)\n+    monkeypatch.setattr(workspace_module, \"delete_worktree\", cleanup_effect)\n+    monkeypatch.setattr(workspace_module, \"ensure_secret_guardrails\", lambda path: None)\n+    with pytest.raises(RepositoryDeletionPendingError):\n+        asyncio.run(create_workspace_for_repo(run_operation, REPO_ID))\n+    assert cleanup_calls == [(git_repo, str(Path(git_repo) / \".worktrees\" / \"raced\"))]\n+    assert db.execute(\"SELECT COUNT(*) FROM workspaces\").fetchone()[0] == 0\n+\n+\n def _repair_tenant() -> TenantContext:\n     return TenantContext(\n         user_id=\"tenant-user\",\n         email=\"tenant@example.com\",\n","firstChangedLine":243},"isError":false,"timestamp":1