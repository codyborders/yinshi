descriptor = os.open(\n                pending_name,\n                os.O_RDONLY\n                | getattr(os, \"O_DIRECTORY\", 0)\n                | getattr(os, \"O_CLOEXEC\", 0)\n                | getattr(os, \"O_NOFOLLOW\", 0),\n                dir_fd=root_descriptor,\n            )\n            try:\n                pending_identity = _directory_identity(pending_descriptor)\n                _write_regular(pending_descriptor, \"committed.bundle\", bundle_bytes)\n                _write_regular(pending_descriptor, \"worktree.yra\", worktree_bytes)\n                _write_regular(pending_descriptor, \"index-objects.pack\", index_object_bytes)\n                marker_value = {\n                    \"declaration\": asdict(declaration),\n                    \"verification\": asdict(verification),\n                }\n                marker = _canonical_json(marker_value)\n                _write_regular(pending_descriptor, \"artifact-set.json\", marker)\n                os.fsync(pending_descriptor)\n            finally:\n                os.close(pending_descriptor)\n            rename_attempted = True\n            try:\n                atomic_rename_no_replace(\n                    self._root / pending_name,\n                    self._root / final_name,\n                    source_parent_identity=root_identity,\n                    target_parent_identity=root_identity,\n                    source_identity=pending_identity,\n                )\n            except WorkspacePublicationCollisionError as error:\n                rename_attempted = False\n                raise ReplicaPublicationCollisionError(\n                    \"publication target already exists\"\n                ) from error\n            except (WorkspacePublicationError, OSError) as error:\n                raise ReplicaPublicationUnresolvedError(\n                    \"publication rename or synchronization is unresolved\"\n                ) from error\n            receipt = await self._inspect_final(declaration, verification)\n            return receipt\n        except asyncio.CancelledError as error:\n            if rename_attempted:\n                raise ReplicaPublicationUnresolvedError(\n                    \"publication cancellation is unresolved\"\n                ) from error\n            raise\n        except ReplicaPublicationUnresolvedError:\n            raise\n        except ReplicaPublicationCollisionError:\n            raise\n        except ReplicaPublicationRejectedError:\n            if rename_attempted:\n                raise ReplicaPublicationUnresolvedError(\n                    \"published artifact verification is unresolved\"\n                )\n            raise\n        except Exception as error:\n            if rename_attempted:\n                raise ReplicaPublicationUnresolvedError(\n                    \"publication outcome is unresolved\"\n                ) from error\n            raise ReplicaPublicationRejectedError(\"publication staging failed\") from error\n        finally:\n            os.close(root_descriptor)\n            if pending_created and not rename_attempted:\n                self._cleanup_pending(pending_name)\n\n    def _cleanup_pending(self, pending_name: str) -> None:\n        try:\n            parent, _identity = _root_identity(\n                self._root,\n                self._expected_uid,\n                self._expected_gid,\n            )\n        except ReplicaPublicationRejectedError:\n            return\n        try:\n            try:\n                child = os.open(\n                    pending_name,\n                    os.O_RDONLY\n                    | getattr(os, \"O_DIRECTORY\", 0)\n                    | getattr(os, \"O_CLOEXEC\", 0)\n                    | getattr(os, \"O_NOFOLLOW\", 0),\n                    dir_fd=parent,\n                )\n            except OSError:\n                return\n            try:\n                names = set(os.listdir(child))\n                if names <= _EXPECTED_FILES:\n                    for name in names:\n                        try:\n                            os.unlink(name, dir_fd=child)\n                        except OSError:\n                            return\n            finally:\n                os.close(child)\n            try:\n                os.rmdir(pending_name, dir_fd=parent)\n                os.fsync(parent)\n            except OSError:\n                return\n        finally:\n            os.close(parent)\n\n    async def _inspect_final(\n        self,\n        declaration: ReplicaArtifactSetDeclaration,\n        expected_verification: ReplicaVerificationReceipt | None = None,\n    ) -> ReplicaPublicationReceipt:\n        root_descriptor, _root_identity_value = _root_identity(\n            self._root,\n            self._expected_uid,\n            self._expected_gid,\n        )\n        try:\n            try:\n                final_descriptor = os.open(\n                    declaration.operation_id,\n                    os.O_RDONLY\n                    | getattr(os, \"O_DIRECTORY\", 0)\n                    | getattr(os, \"O_CLOEXEC\", 0)\n                    | getattr(os, \"O_NOFOLLOW\", 0),\n                    dir_fd=root_descriptor,\n                )\n            except OSError as error:\n                raise ReplicaPublicationRejectedError(\n                    \"published artifact set is unavailable\"\n                ) from error\n            try:\n                final_identity = _directory_identity(final_descriptor)\n                final_stat = os.fstat(final_descriptor)\n                if (\n                    final_stat.st_uid != self._expected_uid\n                    or final_stat.st_gid != self._expected_gid\n                    or stat.S_IMODE(final_stat.st_mode) != 0o700\n                    or set(os.listdir(final_descriptor)) != _EXPECTED_FILES\n                ):\n                    raise ReplicaPublicationRejectedError(\n                        \"published artifact set directory is invalid\"\n                    )\n                bundle_bytes = _read_regular(\n                    final_descriptor,\n                    \"committed.bundle\",\n                    declaration.bundle.byte_length,\n                    self._expected_uid,\n                    self._expected_gid,\n                )\n                worktree_bytes = _read_regular(\n                    final_descriptor,\n                    \"worktree.yra\",\n                    declaration.worktree.byte_length,\n                    self._expected_uid,\n                    self._expected_gid,\n                )\n                index_bytes = _read_regular(\n                    final_descriptor,\n                    \"index-objects.pack\",\n                    declaration.index_objects.byte_length,\n                    self._expected_uid,\n                    self._expected_gid,\n                )\n                marker = _read_regular(\n                    final_descriptor,\n                    \"artifact-set.json\",\n                    1024 * 1024,\n                    self._expected_uid,\n                    self._expected_gid,\n                )\n            finally:\n                os.close(final_descriptor)\n        finally:\n            os.close(root_descriptor)\n        verification = await self.verify_artifact_set(\n            declaration,\n            bundle_bytes,\n            worktree_bytes,\n            index_bytes,\n        )\n        if expected_verification is not None and verification != expected_verification:\n            raise ReplicaPublicationRejectedError(\"published verification receipt changed\")\n        expected_marker = _canonical_json(\n            {\"declaration\": asdict(declaration), \"verification\": asdict(verification)}\n        )\n        if marker != expected_marker:\n            raise ReplicaPublicationRejectedError(\"publication marker differs from artifact set\")\n        marker_sha256 = hashlib.sha256(marker).hexdigest()\n        synchronization_receipt_id = _domain_digest(\n            b\"yinshi-replica-synchronization-v2\",\n            {\n                \"artifact_set_sha256\": verification.artifact_set_sha256,\n                \"final_directory_identity\": final_identity,\n                \"publication_marker_sha256\": marker_sha256,\n            },\n        )\n        receipt_value = {\n            \"artifact_set_sha256\": verification.artifact_set_sha256,\n            \"verification\": asdict(verification),\n            \"identity\": asdict(declaration.identity),\n            \"source_state_sha256\": declaration.source_state_sha256,\n            \"final_directory_identity\": final_identity,\n            \"publication_marker_sha256\": marker_sha256,\n            \"synchronization_receipt_id\": synchronization_receipt_id,\n        }\n        return ReplicaPublicationReceipt(\n            publication_receipt_id=_domain_digest(\n                b\"yinshi-replica-publication-receipt-v2\",\n                receipt_value,\n            ),\n            artifact_set_sha256=verification.artifact_set_sha256,\n            verification=verification,\n            identity=declaration.identity,\n            source_state_sha256=declaration.source_state_sha256,\n            final_directory_identity=final_identity,\n            publication_marker_sha256=marker_sha256,\n            synchronization_receipt_id=synchronization_receipt_id,\n        )\n\n    async def inspect_published_artifact_set(\n        self,\n        declaration: ReplicaArtifactSetDeclaration,\n    ) -> ReplicaPublicationReceipt:\n        \"\"\"Read and reverify one published set without modifying storage.\"\"\"\n        declaration = _validate_declaration(declaration, self._ceilings)\n        try:\n            return await self._inspect_final(declaration)\n        except asyncio.CancelledError:\n            raise\n        except ReplicaPublicationRejectedError:\n            raise\n        except Exception as error:\n            raise ReplicaPublicationRejectedError(\"published artifact inspection failed\") from error\n","newText":"    def _inspect_pending(\n        self,\n        parent: int,\n        pending_name: str,\n        expected: dict[str, bytes],\n    ) -> tuple[str, dict[str, tuple[int, int]]]:\n        child = os.open(\n            pending_name,\n            os.O_RDONLY\n            | getattr(os, \"O_DIRECTORY\", 0)\n            | getattr(os, \"O_CLOEXEC\", 0)\n            | getattr(os, \"O_NOFOLLOW\", 0),\n            dir_fd=parent,\n        )\n        pins: list[_PinnedRegular] = []\n        try:\n            child_stat = os.fstat(child)\n            if (\n                child_stat.st_uid != self._expected_uid\n                or child_stat.st_gid != self._expected_gid\n                or stat.S_IMODE(child_stat.st_mode) != 0o700\n                or set(os.listdir(child)) != _EXPECTED_FILES\n            ):\n                raise ReplicaPublicationRejectedError(\"publication stage directory is invalid\")\n            for name, content in expected.items():\n                pinned = _open_pinned_regular(\n                    child,\n                    name,\n                    len(content),\n                    self._expected_uid,\n                    self._expected_gid,\n                )\n                pins.append(pinned)\n                if pinned.content != content:\n                    raise ReplicaPublicationRejectedError(\"publication stage content changed\")\n            for pinned in pins:\n                _recheck_pinned_regular(child, pinned)\n            return _directory_identity(child), {\n                pinned.name: (pinned.device, pinned.inode) for pinned in pins\n            }\n        finally:\n            for pinned in pins:\n                os.close(pinned.descriptor)\n            os.close(child)\n\n    def _cleanup_pending(\n        self,\n        parent: int,\n        pending_name: str,\n        pending_identity: str,\n        file_identities: dict[str, tuple[int, int]],\n    ) -> None:\n        try:\n            named = os.stat(pending_name, dir_fd=parent, follow_symlinks=False)\n            if not _same_identity(named, pending_identity):\n                raise ReplicaPublicationUnresolvedError(\"publication stage identity changed\")\n            child = os.open(\n                pending_name,\n                os.O_RDONLY\n                | getattr(os, \"O_DIRECTORY\", 0)\n                | getattr(os, \"O_CLOEXEC\", 0)\n                | getattr(os, \"O_NOFOLLOW\", 0),\n                dir_fd=parent,\n            )\n            try:\n                if set(os.listdir(child)) != set(file_identities):\n                    raise ReplicaPublicationUnresolvedError(\"publication stage entries changed\")\n                for name, identity in file_identities.items():\n                    value = os.stat(name, dir_fd=child, follow_symlinks=False)\n                    if (value.st_dev, value.st_ino) != identity or not stat.S_ISREG(\n                        value.st_mode\n                    ):\n                        raise ReplicaPublicationUnresolvedError(\n                            \"publication stage file identity changed\"\n                        )\n                for name in file_identities:\n                    os.unlink(name, dir_fd=child)\n            finally:\n                os.close(child)\n            os.rmdir(pending_name, dir_fd=parent)\n            os.fsync(parent)\n        except ReplicaPublicationUnresolvedError:\n            raise\n        except OSError as error:\n            raise ReplicaPublicationUnresolvedError(\"publication stage cleanup is unresolved\") from error\n\n    def _rename_state(\n        self,\n        parent: int,\n        pending_name: str,\n        final_name: str,\n        pending_identity: str,\n    ) -> Literal[\"not_moved\", \"moved\", \"unknown\"]:\n        def identity(name: str) -> os.stat_result | None:\n            try:\n                return os.stat(name, dir_fd=parent, follow_symlinks=False)\n            except FileNotFoundError:\n                return None\n\n        pending = identity(pending_name)\n        final = identity(final_name)\n        pending_matches = pending is not None and _same_identity(pending, pending_identity)\n        final_matches = final is not None and _same_identity(final, pending_identity)\n        if pending_matches and final is None:\n            return \"not_moved\"\n        if pending is None and final_matches:\n            return \"moved\"\n        return \"unknown\"\n\n    def _publication_receipt(\n        self,\n        declaration: ReplicaArtifactSetDeclaration,\n        inspection: ReplicaInspectionReceipt,\n    ) -> ReplicaPublicationReceipt:\n        synchronization_receipt_id = _domain_digest(\n            b\"yinshi-replica-synchronization-v2\",\n            {\n                \"artifact_set_sha256\": inspection.artifact_set_sha256,\n                \"final_directory_identity\": inspection.final_directory_identity,\n                \"publication_marker_sha256\": inspection.publication_marker_sha256,\n            },\n        )\n        value = {\n            \"artifact_set_sha256\": inspection.artifact_set_sha256,\n            \"verification\": asdict(inspection.verification),\n            \"identity\": asdict(declaration.identity),\n            \"source_state_sha256\": declaration.source_state_sha256,\n            \"final_directory_identity\": inspection.final_directory_identity,\n            \"publication_marker_sha256\": inspection.publication_marker_sha256,\n            \"synchronization_receipt_id\": synchronization_receipt_id,\n        }\n        return ReplicaPublicationReceipt(\n            publication_receipt_id=_domain_digest(\n                b\"yinshi-replica-publication-receipt-v2\",\n                value,\n            ),\n            artifact_set_sha256=inspection.artifact_set_sha256,\n            verification=inspection.verification,\n            identity=declaration.identity,\n            source_state_sha256=declaration.source_state_sha256,\n            final_directory_identity=inspection.final_directory_identity,\n            publication_marker_sha256=inspection.publication_marker_sha256,\n            synchronization_receipt_id=synchronization_receipt_id,\n        )\n\n    async def publish_artifact_set(\n        self,\n        declaration: ReplicaArtifactSetDeclaration,\n        bundle_bytes: bytes,\n        worktree_bytes: bytes,\n        index_object_bytes: bytes,\n    ) -> ReplicaPublicationReceipt:\n        \"\"\"Verify, sync, and publish one set through one no-replace rename.\"\"\"\n        verification = await self.verify_artifact_set(\n            declaration,\n            bundle_bytes,\n            worktree_bytes,\n            index_object_bytes,\n        )\n        declaration = _validate_declaration(declaration, self._ceilings)\n        try:\n            require_atomic_no_replace_support()\n        except WorkspacePublicationError as error:\n            raise ReplicaPublicationRejectedError(\n                \"atomic no-replace publication is unavailable\"\n            ) from error\n        root_descriptor, root_identity = _root_identity(\n            self._root,\n            self._expected_uid,\n            self._expected_gid,\n        )\n        pending_name = f\".{declaration.operation_id}.pending\"\n        final_name = declaration.operation_id\n        pending_identity: str | None = None\n        file_identities: dict[str, tuple[int, int]] = {}\n        moved = False\n        try:\n            try:\n                os.mkdir(pending_name, mode=0o700, dir_fd=root_descriptor)\n            except FileExistsError as error:\n                raise ReplicaPublicationCollisionError(\n                    \"publication stage already exists\"\n                ) from error\n            marker = _canonical_json(\n                {\"declaration\": asdict(declaration), \"verification\": asdict(verification)}\n            )\n            expected = {\n                \"committed.bundle\": bundle_bytes,\n                \"worktree.yra\": worktree_bytes,\n                \"index-objects.pack\": index_object_bytes,\n                \"artifact-set.json\": marker,\n            }\n            try:\n                pending_descriptor = os.open(\n                    pending_name,\n                    os.O_RDONLY\n                    | getattr(os, \"O_DIRECTORY\", 0)\n                    | getattr(os, \"O_CLOEXEC\", 0)\n                    | getattr(os, \"O_NOFOLLOW\", 0),\n                    dir_fd=root_descriptor,\n                )\n                try:\n                    for name, content in expected.items():\n                        _write_regular(pending_descriptor, name, content)\n                    os.fsync(pending_descriptor)\n                finally:\n                    os.close(pending_descriptor)\n                pending_identity, file_identities = self._inspect_pending(\n                    root_descriptor,\n                    pending_name,\n                    expected,\n                )\n            except BaseException:\n                if pending_identity is None:\n                    try:\n                        pending_descriptor = os.open(\n                            pending_name,\n                            os.O_RDONLY\n                            | getattr(os, \"O_DIRECTORY\", 0)\n                            | getattr(os, \"O_CLOEXEC\", 0)\n                            | getattr(os, \"O_NOFOLLOW\", 0),\n                            dir_fd=root_descriptor,\n                        )\n                        try:\n                            pending_identity = _directory_identity(pending_descriptor)\n                            file_identities = {\n                                name: (\n                                    os.stat(name, dir_fd=pending_descriptor, follow_symlinks=False).st_dev,\n                                    os.stat(name, dir_fd=pending_descriptor, follow_symlinks=False).st_ino,\n                                )\n                                for name in os.listdir(pending_descriptor)\n                                if name in _EXPECTED_FILES\n                            }\n                        finally:\n                            os.close(pending_descriptor)\n                    except OSError:\n                        pass\n                if pending_identity is not None:\n                    self._cleanup_pending(\n                        root_descriptor,\n                        pending_name,\n                        pending_identity,\n                        file_identities,\n                    )\n                raise\n            try:\n                atomic_rename_no_replace(\n                    self._root / pending_name,\n                    self._root / final_name,\n                    source_parent_identity=root_identity,\n                    target_parent_identity=root_identity,\n                    source_identity=pending_identity,\n                )\n                moved = True\n            except WorkspacePublicationCollisionError as error:\n                self._cleanup_pending(\n                    root_descriptor,\n                    pending_name,\n                    pending_identity,\n                    file_identities,\n                )\n                raise ReplicaPublicationCollisionError(\n                    \"publication target already exists\"\n                ) from error\n            except (WorkspacePublicationError, OSError) as error:\n                state = self._rename_state(\n                    root_descriptor,\n                    pending_name,\n                    final_name,\n                    pending_identity,\n                )\n                if state == \"not_moved\":\n                    self._cleanup_pending(\n                        root_descriptor,\n                        pending_name,\n                        pending_identity,\n                        file_identities,\n                    )\n                    raise ReplicaPublicationRejectedError(\n                        \"publication rename failed before visibility\"\n                    ) from error\n                raise ReplicaPublicationUnresolvedError(\n                    \"publication rename or synchronization is unresolved\"\n                ) from error\n            try:\n                inspection = await self._inspect_final(declaration, verification)\n            except asyncio.CancelledError as error:\n                raise ReplicaPublicationUnresolvedError(\n                    \"publication cancellation is unresolved\"\n                ) from error\n            except Exception as error:\n                raise ReplicaPublicationUnresolvedError(\n                    \"published artifact verification is unresolved\"\n                ) from error\n            return self._publication_receipt(declaration, inspection)\n        except (ReplicaPublicationCollisionError, ReplicaPublicationRejectedError):\n            raise\n        except ReplicaPublicationUnresolvedError:\n            raise\n        except asyncio.CancelledError:\n            if moved:\n                raise ReplicaPublicationUnresolvedError(\"publication cancellation is unresolved\")\n            raise\n        except Exception as error:\n            if moved:\n                raise ReplicaPublicationUnresolvedError(\"publication outcome is unresolved\") from error\n            raise ReplicaPublicationRejectedError(\"publication staging failed\") from error\n        finally:\n            os.close(root_descriptor)\n\n    async def _inspect_final(\n        self,\n        declaration: ReplicaArtifactSetDeclaration,\n        expected_verification: ReplicaVerificationReceipt | None = None,\n    ) -> ReplicaInspectionReceipt:\n        root_descriptor, _root_identity_value = _root_identity(\n            self._root,\n            self._expected_uid,\n            self._expected_gid,\n        )\n        pins: list[_PinnedRegular] = []\n        try:\n            try:\n                final_descriptor = os.open(\n                    declaration.operation_id,\n                    os.O_RDONLY\n                    | getattr(os, \"O_DIRECTORY\", 0)\n                    | getattr(os, \"O_CLOEXEC\", 0)\n                    | getattr(os, \"O_NOFOLLOW\", 0),\n                    dir_fd=root_descriptor,\n                )\n            except OSError as error:\n                raise ReplicaPublicationRejectedError(\n                    \"published artifact set is unavailable\"\n                ) from error\n            try:\n                final_identity = _directory_identity(final_descriptor)\n                final_stat = os.fstat(final_descriptor)\n                if (\n                    final_stat.st_uid != self._expected_uid\n                    or final_stat.st_gid != self._expected_gid\n                    or stat.S_IMODE(final_stat.st_mode) != 0o700\n                    or set(os.listdir(final_descriptor)) != _EXPECTED_FILES\n                ):\n                    raise ReplicaPublicationRejectedError(\n                        \"published artifact set directory is invalid\"\n                    )\n                maxima = {\n                    \"committed.bundle\": declaration.bundle.byte_length,\n                    \"worktree.yra\": declaration.worktree.byte_length,\n                    \"index-objects.pack\": declaration.index_objects.byte_length,\n                    \"artifact-set.json\": 1024 * 1024,\n                }\n                for name, maximum in maxima.items():\n                    pins.append(\n                        _open_pinned_regular(\n                            final_descriptor,\n                            name,\n                            maximum,\n                            self._expected_uid,\n                            self._expected_gid,\n                        )\n                    )\n                content = {pinned.name: pinned.content for pinned in pins}\n                verification = await self.verify_artifact_set(\n                    declaration,\n                    content[\"committed.bundle\"],\n                    content[\"worktree.yra\"],\n                    content[\"index-objects.pack\"],\n                )\n                if expected_verification is not None and verification != expected_verification:\n                    raise ReplicaPublicationRejectedError(\n                        \"published verification receipt changed\"\n                    )\n                expected_marker = _canonical_json(\n                    {\n                        \"declaration\": asdict(declaration),\n                        \"verification\": asdict(verification),\n                    }\n                )\n                marker = content[\"artifact-set.json\"]\n                if marker != expected_marker:\n                    raise ReplicaPublicationRejectedError(\n                        \"publication marker differs from artifact set\"\n                    )\n                named_final = os.stat(\n                    declaration.operation_id,\n                    dir_fd=root_descriptor,\n                    follow_symlinks=False,\n                )\n                if (\n                    not _same_identity(named_final, final_identity)\n                    or set(os.listdir(final_descriptor)) != _EXPECTED_FILES\n                ):\n                    raise ReplicaPublicationRejectedError(\n                        \"published artifact set changed during verification\"\n                    )\n                for pinned in pins:\n                    _recheck_pinned_regular(final_descriptor, pinned)\n            finally:\n                for pinned in pins:\n                    os.close(pinned.descriptor)\n                os.close(final_descriptor)\n        finally:\n            os.close(root_descriptor)\n        marker_sha256 = hashlib.sha256(marker).hexdigest()\n        value = {\n            \"artifact_set_sha256\": verification.artifact_set_sha256,\n            \"verification_receipt_id\": verification.verification_receipt_id,\n            \"final_directory_identity\": final_identity,\n            \"publication_marker_sha256\": marker_sha256,\n        }\n        return ReplicaInspectionReceipt(\n            inspection_receipt_id=_domain_digest(\n                b\"yinshi-replica-inspection-receipt-v2\",\n                value,\n            ),\n            artifact_set_sha256=verification.artifact_set_sha256,\n            verification=verification,\n            final_directory_identity=final_identity,\n            publication_marker_sha256=marker_sha256,\n        )\n\n    async def inspect_published_artifact_set(\n        self,\n        declaration: ReplicaArtifactSetDeclaration,\n    ) -> ReplicaInspectionReceipt:\n        \"\"\"Read and reverify storage without minting publication authority.\"\"\"\n        declaration = _validate_declaration(declaration, self._ceilings)\n        try:\n            return await self._inspect_final(declaration)\n        except asyncio.CancelledError:\n            raise\n        except ReplicaPublicationRejectedError:\n            raise\n        except Exception as error:\n            raise ReplicaPublicationRejectedError(\"published artifact inspection failed\") from error\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":909,"output":5877,"cacheRead":237824,"cacheWrite":0,"reasoning":7,"totalTokens":244610,"cost":{"input":0.004545,"output":0.17631,"cacheRead":0.11891199999999999,"cacheWrite":0,"total":0.299767}},"stopReason":"toolUse","timestamp":1789243657529,"responseId":"resp_0212e7de83dbbd32016aa5b10a25cc87d090beb8bf82641766","rawStopReason":"completed"}}
