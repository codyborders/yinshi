rivate\")\n\n    monkeypatch.setattr(\n        terminal_channels, \"prepare_tenant_workspace_runtime_paths\", conflict\n    )\n    with pytest.raises(HTTPException) as raised:\n        asyncio.run(terminal_channels._terminal_context(_request(), WORKSPACE_ID))\n    assert raised.value.status_code == 409\n    assert raised.value.detail == \"Workspace publication conflict\"\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":1801,"output":448,"cacheRead":185600,"cacheWrite":0,"reasoning":44,"totalTokens":187849,"cost":{"input":0.009005,"output":0.01344,"cacheRead":0.0928,"cacheWrite":0,"total":0.11524499999999999}},"stopReason":"toolUse","timestamp":1789288467494,"responseId":"resp_0212e7de83dbbd32016aa66014899887d09ab3c36a877a0ee9","rawStopReason":"completed"}}
