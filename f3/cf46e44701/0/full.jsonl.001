ng it.\"\"\"\n85:+        if result_ref != _result_ref(context.delegation_id):\n86:+            raise ThreadGitOwnershipError()\n87:+        if any(\n88:+            re.fullmatch(r\"[0-9a-f]{40}|[0-9a-f]{64}\", value) is None\n89:+            for value in (base_commit, result_commit)\n90:+        ):\n91:+            raise ThreadGitOwnershipError()\n92:+        async with (\n93:+            repository_lifecycle(context.repo_id, context.lock_root),\n94:+            thread_git_namespace(\n95:+                context.repo_path, context.branch, database_identity, create_owner=False\n96:+            ) as actual,\n97:+        ):\n98:+            if actual != namespace:\n99:+                raise ThreadGitOwnershipError()\n100:+            await verify_thread_git_workspace(\n101:+                context.parent_workspace_path, context.branch, namespace\n102:+            )\n103:+            await verify_thread_git_workspace(context.worktree_path, context.branch, namespace)\n104:+            await self._verify_worktree_registration(context, require_absent=False)\n105:+            await self._assert_integration_history(context.repo_path)\n106:+            if await self._exact_ref_value(context.repo_path, result_ref) != result_commit:\n107:+                raise ThreadGitOwnershipError()\n108:+            parents = await _run_git(\n109:+                [\"--no-replace-objects\", \"rev-list\", \"--parents\", \"-n\", \"1\", result_commit],\n110:+                cwd=context.repo_path,\n111:+            )\n112:+            if parents.split() != [result_commit, base_commit]:\n113:+                raise ThreadGitOwnershipError()\n114:+            head, branch = await self._integration_parent_facts(\n115:+                context.parent_workspace_path, parent_branch\n116:+            )\n117:+            exclusions = await self._owned_snapshot_exclusions(context, owned_worktrees)\n118:+            dirty = await _worktree_status_output(\n119:+                context.parent_workspace_path, excluded_worktrees=exclusions\n120:+            )\n121:+            return {\n"}],"isError":false,"timestamp":1789272505351}}
