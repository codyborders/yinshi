refreshed_installation_id, repo_id),\n+                )\n+                database.commit()\n+            except BaseException:\n+                database.rollback()\n+                raise\n+            return dict(_fetch_repo(database, repo_id))\n \n+        return await run_database_operation(commit_metadata)\n+\n     target_repo_path = _tenant_repo_path(tenant, repo_id)\n     remote_url, access_token, installation_id = await _refresh_repo_remote_metadata(\n-        tenant,\n-        repo_path,\n-        remote_url,\n-        installation_id,\n+        tenant, repo_path, remote_url, installation_id\n     )\n     await _materialize_repo_checkout(\n-        repo_path,\n-        target_repo_path,\n-        remote_url,\n-        access_token=access_token,\n+        repo_path, target_repo_path, remote_url, access_token=access_token\n     )\n-\n-    workspaces = db.execute(\n-        \"SELECT * FROM workspaces WHERE repo_id = ? ORDER BY created_at ASC\",\n-        (repo_id,),\n-    ).fetchall()\n-    for workspace in workspaces:\n-        branch = workspace[\"branch\"]\n+    workspace_updates: list[tuple[str, str]] = []\n+    for workspace_id, branch in snapshot[\"workspaces\"]:\n         if not branch:\n-            raise WorkspaceNotFoundError(f\"Workspace {workspace['id']} is missing its branch name\")\n+            raise WorkspaceNotFoundError(\n+                f\"Workspace {workspace_id} is missing its branch name\"\n+            )\n         target_workspace_path = _workspace_path(target_repo_path, branch)\n         await restore_worktree(target_repo_path, target_workspace_path, branch)\n-        db.execute(\n-            \"UPDATE workspaces SET path = ? WHERE id = ?\",\n-            (target_workspace_path, workspace[\"id\"]),\n-        )\n+        workspace_updates.append((workspace_id, target_workspace_path))\n \n-    db.execute(\n-        \"UPDATE repos SET root_path = ?, remote_url = ?, installation_id = ? WHERE id = ?\",\n-        (target_repo_path, remote_url, installation_id, repo_id),\n-    )\n-    db.commit()\n+    def commit_repair(database: sqlite3.Connection) -> dict[str, Any]:\n+        database.execute(\"BEGIN IMMEDIATE\")\n+        try:\n+            require_no_repository_deletion(database, repo_id)\n+            for workspace_id, workspace_path in workspace_updates:\n+                database.execute(\n+                    \"UPDATE workspaces SET path = ? WHERE id = ?\",\n+                    (workspace_path, workspace_id),\n+                )\n+            database.execute(\n+                \"UPDATE repos SET root_path = ?, remote_url = ?, installation_id = ? WHERE id = ?\",\n+                (target_repo_path, remote_url, installation_id, repo_id),\n+            )\n+            database.commit()\n+        except BaseException:\n+            database.rollback()\n+            raise\n+        return dict(_fetch_repo(database, repo_id))\n+\n+    updated_repo = await run_database_operation(commit_repair)\n     logger.info(\"Repaired repository into tenant storage\")\n+    return updated_repo\n \n-    updated_repo = _fetch_repo(db, repo_id)\n-    return dict(updated_repo)\n \n-\n async def relink_github_repos_for_tenant(\n     db: sqlite3.Connection,\n     tenant: TenantContext,\n     owner_login: str,\n","firstChangedLine":417},"isError":false,"timestamp":1789288132985}}
