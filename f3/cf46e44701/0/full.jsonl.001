grationService, \"preview\", forbidden)\n    monkeypatch.setattr(ThreadWorkspaceService, \"integration_workspace_identity\", forbidden)\n    response = client.post(\n        endpoint,\n        json={\n            \"idempotency_key\": str(uuid.uuid4()),\n            \"result_id\": preview[\"result_id\"],\n            \"expected_parent_head\": preview[\"expected_parent_head\"],\n            \"confirmed\": True,\n        },\n    )\n    assert response.status_code == 409\n    assert response.json()[\"detail\"] == \"Integration precondition changed\"\n\n\ndef test_file_boundary_maps_publication_deletion_conflict_to_409() -> None:\n    from yinshi.api.workspace_files import _map_file_error\n    from yinshi.services.workspace_publication import WorkspacePublicationConflictError\n\n    mapped = _map_file_error(WorkspacePublicationConflictError(\"private\"))\n    assert mapped.status_code == 409\n    assert mapped.detail == \"Workspace publication conflict\"\n    infrastructure = _map_file_error(WorkspacePublicationError(\"private\"))\n    assert infrastructure.status_code == 500\n\n\ndef test_terminal_boundary_maps_publication_deletion_conflict_to_409(\n    monkeypatch,\n) -> None:\n    from fastapi import HTTPException\n    from yinshi.api import terminal_channels\n    from yinshi.services.workspace_publication import WorkspacePublicationConflictError\n\n    monkeypatch.setattr(\n        terminal_channels,\n        \"_tenant_identity\",\n        lambda request: (\"tenant-user\", _repair_tenant()),\n    )\n\n    async def conflict(*args, **kwargs):\n        raise WorkspacePublicationConflictError(\"private\")\n\n    monkeypatch.setattr(\n        terminal_channels, \"prepare_tenant_workspace_runtime_paths\", conflict\n    )\n    with pytest.raises(HTTPException) as raised:\n        asyncio.run(terminal_channels._terminal_context(_request(), WORKSPACE_ID))\n    assert raised.value.status_code == 409\n    assert raised.value.detail == \"Workspace publication conflict\"\n"}],"isError":false,"timestamp":1789288494813}}
