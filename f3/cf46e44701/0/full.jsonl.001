{"type":"message","id":"d8817333","parentId":"b5f023e1","timestamp":"2026-09-13T08:26:51.876Z","message":{"role":"toolResult","toolCallId":"call_80O4QnSZK2PUAa4fUNuUk6VN|fc_0212e7de83dbbd32016aa65e4ad7fc87d08aae4fad95ef51a2","toolName":"read","content":[{"type":"text","text":"    return ref in output.splitlines()\n\n\nclass ThreadWorkspaceService:\n    \"\"\"Provision and finalize isolated Git workspaces for child threads.\"\"\"\n\n    async def preview_integration(\n        self,\n        context: ThreadParentGitContext,\n        *,\n        database_identity: str,\n        namespace: str,\n        parent_branch: str,\n        base_commit: str,\n        result_commit: str,\n        result_ref: str,\n        owned_worktrees: tuple[ThreadGitWorktree, ...],\n    ) -> dict[str, object]:\n        \"\"\"Validate result provenance and inspect the parent without changing it.\"\"\"\n        if result_ref != _result_ref(context.delegation_id):\n            raise ThreadGitOwnershipError()\n        if any(\n            re.fullmatch(r\"[0-9a-f]{40}|[0-9a-f]{64}\", value) is None\n            for value in (base_commit, result_commit)\n        ):\n            raise ThreadGitOwnershipError()\n        async with (\n            repository_lifecycle(context.repo_id, context.lock_root),\n            thread_git_namespace(\n                context.repo_path, context.branch, database_identity, create_owner=False\n            ) as actual,\n        ):\n            if actual != namespace:\n                raise ThreadGitOwnershipError()\n            await verify_thread_git_workspace(\n                context.parent_workspace_path, context.branch, namespace\n            )\n            await verify_thread_git_workspace(context.worktree_path, context.branch, namespace)\n            await self._verify_worktree_registration(context, require_absent=False)\n            await self._assert_integration_history(context.repo_path)\n            if await self._exact_ref_value(context.repo_path, result_ref) != result_commit:\n                raise ThreadGitOwnershipError()\n            parents = await _run_git(\n                [\"--no-replace-objects\", \"rev-list\", \"--parents\", \"-n\", \"1\", result_commit],\n                cwd=context.repo_path,\n            )\n            if parents.split() != [result_commit, base_commit]:\n                raise ThreadGitOwnershipError()\n            head, branch = await self._integration_parent_facts(\n                context.parent_workspace_path, parent_branch\n            )\n            exclusions = await self._owned_snapshot_exclusions(context, owned_worktrees)\n            dirty = await _worktree_status_output(\n                context.parent_workspace_path, excluded_worktrees=exclusions\n            )\n            return {\n                \"eligible\": not dirty,\n                \"reason_code\": \"dirty_parent\" if dirty else \"eligible\",\n                \"expected_parent_head\": head,\n                \"parent_branch\": branch,\n            }\n\n    async def _integration_parent_facts(\n        self, workspace_path: str, expected_branch: str\n    ) -> tuple[str, str]:\n        \"\"\"Check the real branch, reflogs, index targets, and idle Git metadata.\"\"\"\n        if not expected_branch or expected_branch.startswith(\"-\"):\n            raise ThreadGitOwnershipError()\n        await _run_git([\"check-ref-format\", f\"refs/heads/{expected_branch}\"], cwd=workspace_path)\n        branch = await _run_git([\"symbolic-ref\", \"--quiet\", \"HEAD\"], cwd=workspace_path)\n        if branch != f\"refs/heads/{expected_branch}\":\n            raise ThreadGitOwnershipError()\n        head = await self._exact_ref_value(workspace_path, branch)\n        if head is None:\n            raise ThreadGitOwnershipError()\n        common_raw = await _run_git_bytes(\n            [\"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\"], cwd=workspace_path\n        )\n        metadata_raw = await _run_git_bytes([\"rev-parse\", \"--absolute-git-dir\"], cwd=workspace_path)\n        common = Path(os.fsdecode(common_raw.removesuffix(b\"\\n\"))).resolve(strict=True)\n        metadata = Path(os.fsdecode(metadata_raw.removesuffix(b\"\\n\"))).resolve(strict=True)\n\n        def validate() -> None:\n            for name in (\"HEAD\", \"ORIG_HEAD\", \"index\", \"logs/HEAD\"):\n                _storage_node(metadata / name, directory=False)\n            for name in (\n                \"MERGE_HEAD\",\n                \"CHERRY_PICK_HEAD\",\n                \"REVERT_HEAD\",\n                \"rebase-merge\",\n                \"rebase-apply\",\n                \"sequencer\",\n                \"BISECT_LOG\",\n                \"index.lock\",\n                \"HEAD.lock\",\n                \"ORIG_HEAD.lock\",\n            ):\n                if os.path.lexists(metadata / name):\n                    raise ThreadGitOwnershipError()\n            candidate = common\n            parts = (\"logs/\" + branch).split(\"/\")\n            for index, part in enumerate(parts):\n                candidate /= part\n                _storage_node(candidate, directory=index != len(parts) - 1)\n            if os.path.lexists(common / (branch + \".lock\")):\n                raise ThreadGitOwnershipError()\n\n        await asyncio.to_thread(validate)\n        await _assert_submodules_clean(workspace_path)\n        return head, expected_branch\n\n    async def integration_workspace_identity(self, context: ThreadParentGitContext) -> str:\n        \"\"\"Capture stable metadata identity plus inode evidence without a database handle.\"\"\"\n        raw_common = await _run_git_bytes(\n            [\"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\"], cwd=context.repo_path\n        )\n        common = Path(os.fsdecode(raw_common.removesuffix(b\"\\n\"))).resolve(strict=True)\n        raw_metadata = await _run_git_bytes(\n            [\"rev-parse\", \"--absolute-git-dir\"], cwd=context.parent_workspace_path\n        )\n        metadata = Path(os.fsdecode(raw_metadata.removesuffix(b\"\\n\"))).resolve(strict=True)\n        workspace = Path(context.parent_workspace_path).resolve(strict=True)\n\n        def capture() -> str:\n            metadata_info = _storage_node(metadata, directory=True)\n            workspace_info = _storage_node(workspace, directory=True)\n            if metadata_info is None or workspace_info is None:\n                raise ThreadGitOwnershipError()\n            relative = metadata.relative_to(common).as_posix()\n            if relative != \".\" and metadata.parent != common / \"worktrees\":\n\n[2235 more lines in file. Use offset=650 to continue.]"}],"isError":false,"timestamp":1789288011876}}
