{"type":"message","id":"c35b34d0","parentId":"f9061004","timestamp":"2026-09-13T04:52:15.561Z","message":{"role":"toolResult","toolCallId":"call_MIDd7fcOyk7Mu5eYscdrIqQc|fc_0212e7de83dbbd32016aa62bfc7ff887d08659e58aacea74d3","toolName":"read","content":[{"type":"text","text":"/* Fixture-only rendered acceptance for managed integration confirmation and focus. */\nimport { expect, test, type Page } from \"@playwright/test\";\n\nconst WIDTHS: Array<[number, number]> = [\n  [390, 844],\n  [768, 1024],\n  [1440, 900],\n];\n\ninterface FixtureOptions {\n  preview: Record<string, unknown>;\n  operation: Record<string, unknown> | null;\n  postReply: Record<string, unknown> | null;\n  hangPost: boolean;\n}\n\nasync function mountIntegrationFixture(page: Page, options: FixtureOptions): Promise<void> {\n  await page.evaluate(async (fixture) => {\n    const reactPath = \"/node_modules/.vite/deps/react.js\";\n    const domPath = \"/node_modules/.vite/deps/react-dom_client.js\";\n    const componentPath = \"/src/components/thread/ThreadPanel.tsx\";\n    const { default: React } = await import(reactPath);\n    const { default: ReactDOM } = await import(domPath);\n    const { default: ThreadPanel } = await import(componentPath);\n    const parent = \"a\".repeat(32);\n    const child = \"b\".repeat(32);\n    const resultId = \"c\".repeat(32);\n    const parentHead = \"d\".repeat(40);\n    const root = { id: parent, delegation_id: null, parent_id: null, root_id: parent, depth: 0,\n      title: \"Parser maintenance\", role: \"general\", origin: \"root\", state: \"completed\", workspace_id: \"parent-workspace\",\n      model: \"Fixture model\", child_count: 1, active_child_count: 0, can_spawn_child: false, created_at: \"2026-01-01\" };\n    const node = { ...root, id: child, delegation_id: \"f\".repeat(32), parent_id: parent,\n      depth: 1, title: \"Fix parser validation\", role: \"implementation\", origin: \"delegated\", workspace_id: \"child-workspace\" };\n    const requests: unknown[] = [];\n    (window as unknown as { integrationRequests: unknown[] }).integrationRequests = requests;\n    const transport = { runtime: { location: \"local\" },\n      async get(path: string) {\n        if (path.includes(\"/integrations/\")) return fixture.operation;\n        return fixture.preview;\n      },\n      async post(path: string, body: unknown) {\n        requests.push({ path, body });\n        if (fixture.hangPost) return new Promise(() => undefined);\n        return fixture.postReply;\n      },\n    };\n    const mount = document.createElement(\"div\");\n    mount.className = \"h-screen w-full bg-gray-900 text-gray-100\";\n    if (window.innerWidth >= 1024) {\n      mount.style.width = \"360px\";\n      mount.style.marginLeft = \"auto\";\n    }\n    document.body.replaceChildren(mount);\n    ReactDOM.createRoot(mount).render(React.createElement(ThreadPanel, {\n      tree: { root, nodes: [node], placeholders: [], thread_count: 2, active_descendant_count: 0, tree_depth: 1 },\n      currentThreadId: child, transport, result: { delegation_id: node.delegation_id, result_id: resultId,\n        version: 2, source: \"reported\", sealed: true, summary: \"Validate parser input and report clear errors.\",\n        tests: [{ command: \"pytest tests/test_parser.py\", status: \"passed\", summary: \"Parser acceptance checks passed.\" }],\n        warnings: [], base_commit: parentHead,\n        result_commit: \"1\".repeat(40), result_ref: `refs/yinshi/results/${node.delegation_id}`,\n        changed_files: [\"src/parser.py\"], created_at: \"2026-01-01\", updated_at: \"2026-01-01\", sealed_at: \"2026-01-01\" },\n    }));\n  }, options);\n}\n\nfunction fixtureIds() {\n  return {\n    resultId: \"c\".repeat(32),\n    parentHead: \"d\".repeat(40),\n    integrationId: \"e\".repeat(32),\n    resultingHead: \"f\".repeat(40),\n  };\n}\n\nfunction integratedReply(resultId: string, parentHead: string, resultingHead: string) {\n  return {\n    id: \"e\".repeat(32),\n    idempotency_key: \"REDACTED\",\n    status: \"integrated\",\n    result_id: resultId,\n    expected_parent_head: parentHead,\n    resulting_parent_head: resultingHead,\n    resulting_commits: [resultingHead],\n    conflicts: [],\n    reason_code: null,\n  };\n}\n\ntest(\"integration confirmation preserves keyboard focus at supported widths\", async ({ page }) => {\n  await page.route((url) => /^\\/(?:api|auth)\\//.test(url.pathname), (route) => route.fulfill({ status: 404, contentType: \"application/json\", body: \"{}\" }));\n  const { resultId, parentHead, resultingHead } = fixtureIds();\n  for (const [width, height] of WIDTHS) {\n    await page.setViewportSize({ width, height });\n    await page.goto(\"/\");\n    await mountIntegrationFixture(page, {\n      preview: { eligible: true, reason_code: \"eligible\", result_id: resultId,\n        expected_parent_head: parentHead, parent_branch: \"main\", child_title: \"Fix parser validation\",\n        summary: \"Validate parser input and report clear errors.\", integration_id: null },\n      operation: null,\n      postReply: integratedReply(resultId, parentHead, resultingHead),\n      hangPost: false,\n    });\n    const review = page.getByRole(\"button\", { name: \"Review integration\" });\n    await review.click();\n    const dialog = page.getByRole(\"dialog\", { name: \"Integrate child result\" });\n    const cancel = dialog.getByRole(\"button\", { name: \"Cancel\", exact: true });\n    const confirm = dialog.getByRole(\"button\", { name: \"Confirm integration\" });\n    await expect(cancel).toBeFocused();\n    await page.keyboard.press(\"Tab\");\n    await expect(confirm).toBeFocused();\n    await page.keyboard.press(\"Tab\");\n    await expect(cancel).toBeFocused();\n    await page.keyboard.press(\"Shift+Tab\");\n    await expect(confirm).toBeFocused();\n    const box = await dialog.boundingBox();\n    expect(box).not.toBeNull();\n    expect(box!.x).toBeGreaterThanOrEqual(0);\n    expect(box!.y).toBeGreaterThanOrEqual(0);\n    expect(box!.x + box!.width).toBeLessThanOrEqual(width);\n    expect(box!.y + box!.height).toBeLessThanOrEqual(height);\n    await page.screenshot({ path: test.info().outputPath(`integration-confirm-${width}.png`) });\n    await page.keyboard.press(\"Escape\");\n    await expect(review).toBeFocused();\n    expect(await page.evaluate(() => (window as unknown as { integrationRequests: unknown[] }).integrationRequests)).toEqual([]);\n    await review.click();\n    await confirm.click();\n    await expect(page.getByText(\"Result integrated into the parent.\")).toBeVisible();\n    const requests = await page.evaluate(() => (window as unknown as { integrationRequests: unknown[] }).integrationRequests);\n    expect(requests).toHaveLength(1);\n    expect(requests[0]).toMatchObject({ body: { confirmed: true } });\n    await page.screenshot({ path: test.info().outputPath(`integration-success-${width}.png`) });\n  }\n});\n\ntest(\"conflict, blocked, pending, and ineligible states render at supported widths\", async ({ page }) => {\n  await page.route((url) => /^\\/(?:api|auth)\\//.test(url.pathname), (route) => route.fulfill({ status: 404, contentType: \"application/json\", body: \"{}\" }));\n  const { resultId, parentHead, integrationId, resultingHead } = fixtureIds();\n  for (const [width, height] of WIDTHS) {\n    await page.setViewportSize({ width, height });\n\n    // Ineligible: the reason renders and no review entry point exists.\n    await page.goto(\"/\");\n    await mountIntegrationFixture(page, {\n      preview: { eligible: false, reason_code: \"dirty_parent\", result_id: resultId,\n        expected_parent_head: null, parent_branch: \"main\", child_title: \"Fix parser validation\",\n        summary: \"Validate parser input and report clear errors.\", integration_id: null },\n      operation: null, postReply: null, hangPost: false,\n    });\n    await expect(page.getByText(\"The parent has local changes. Commit or move those changes before integration.\")).toBeVisible();\n    await expect(page.getByRole(\"button\", { name: \"Review integration\" })).toHaveCount(0);\n    await page.keyboard.press(\"Tab\");\n    await expect(page.getByRole(\"dialog\")).toHaveCount(0);\n    await page.screenshot({ path: test.info().outputPath(`integration-ineligible-${width}.png`) });\n\n    // Conflict: the refusal names every conflicting file and integrates nothing.\n    await page.goto(\"/\");\n    await mountIntegrationFixture(page, {\n      preview: { eligible: true, reason_code: \"eligible\", result_id: resultId,\n        expected_parent_head: parentHead, parent_branch: \"main\", child_title: \"Fix parser validation\",\n        summary: \"Validate parser input and report clear errors.\", integration_id: null },\n      operation: null,\n      postReply: { id: integrationId, idempotency_key: \"REDACTED\",\n        status: \"conflict\", result_id: resultId, expected_parent_head: parentHead,\n        resulting_parent_head: null, resulting_commits: [],\n        conflicts: [\"src/parser.py\", \"src/grammar.py\"], reason_code: \"trial_conflict\" },\n      hangPost: false,\n    });\n    const conflictReview = page.getByRole(\"button\", { name: \"Review integration\" });\n    await conflictReview.click();\n    const conflictDialog = page.getByRole(\"dialog\", { name: \"Integrate child result\" });\n    await expect(conflictDialog.getByRole(\"button\", { name: \"Cancel\", exact: true })).toBeFocused();\n    await conflictDialog.getByRole(\"button\", { name: \"Confirm integration\" }).click();\n    const conflictAlert = page.getByRole(\"alert\");\n    await expect(conflictAlert).toContainText(\"The child result conflicts with the parent.\");\n    await expect(conflictAlert).toContainText(\"src/parser.py\");\n    await expect(conflictAlert).toContainText(\"src/grammar.py\");\n    const conflictBox = await conflictAlert.boundingBox();\n    expect(conflictBox).not.toBeNull();\n    expect(conflictBox!.x + conflictBox!.width).toBeLessThanOrEqual(width);\n    await page.screenshot({ path: test.info().outputPath(`integration-conflict-${width}.png`) });\n\n    // Blocked recovery: status facts render and review resumes the recorded key.\n    await page.goto(\"/\");\n    await mountIntegrationFixture(page, {\n      preview: { eligible: true, reason_code: \"eligible\", result_id: resultId,\n        expected_parent_head: parentHead, parent_branch: \"main\", child_title: \"Fix parser validation\",\n        summary: \"Validate parser input and report clear errors.\", integration_id: integrationId },\n      operation: { id: integrationId, idempotency_key: \"REDACTED\",\n        status: \"blocked\", result_id: resultId, expected_parent_head: parentHead,\n        resulting_parent_head: null, resulting_commits: [], conflicts: [], reason_code: \"apply_refused\" },\n      postReply: integratedReply(resultId, parentHead, resultingHead),\n      hangPost: false,\n    });\n    await expect(page.getByRole(\"alert\")).toContainText(\"Recovery is blocked. Parent state is uncertain.\");\n    const recovery = page.getByRole(\"button\", { name: \"Review recovery\" });\n    await recovery.click();\n    const recoveryDialog = page.getByRole(\"dialog\", { name: \"Integrate child result\" });\n    await expect(recoveryDialog.getByRole(\"button\", { name: \"Cancel\", exact: true })).toBeFocused();\n    await page.keyboard.press(\"Tab\");\n    await expect(recoveryDialog.getByRole(\"button\", { name: \"Confirm integration\" })).toBeFocused();\n    const recoveryBox = await recoveryDialog.boundingBox();\n    expect(recoveryBox).not.toBeNull();\n    expect(recoveryBox!.x + recoveryBox!.width).toBeLessThanOrEqual(width);\n    await recoveryDialog.getByRole(\"button\", { name: \"Confirm integration\" }).click();\n    await expect(page.getByText(\"Result integrated into the parent.\")).toBeVisible();\n    const recoveryRequests = await page.evaluate(() => (window as unknown as { integrationRequests: unknown[] }).integrationRequests);\n    expect(recoveryRequests).toHaveLength(1);\n    expect(recoveryRequests[0]).toMatchObject({\n      body: { confirmed: true, idempotency_key: \"REDACTED\" },\n    });\n    await page.screenshot({ path: test.info().outputPath(`integration-blocked-${width}.png`) });\n\n    // Pending: an unanswered request stays in progress without a second post.\n    await page.goto(\"/\");\n    await mountIntegrationFixture(page, {\n      preview: { eligible: true, reason_code: \"eligible\", result_id: resultId,\n        expected_parent_head: parentHead, parent_branch: \"main\", child_title: \"Fix parser validation\",\n        summary: \"Validate parser input and report clear errors.\", integration_id: null },\n      operation: null, postReply: null, hangPost: true,\n    });\n    const pendingReview = page.getByRole(\"button\", { name: \"Review integration\" });\n    await pendingReview.click();\n    const pendingDialog = page.getByRole(\"dialog\", { name: \"Integrate child result\" });\n    await pendingDialog.getByRole(\"button\", { name: \"Confirm integration\" }).click();\n    await expect(page.getByText(\"Integration is in progress. Closing this view does not stop it.\")).toBeVisible();\n    await expect(pendingDialog.getByRole(\"button\", { name: \"Integrating...\" })).toBeDisabled();\n    // Escape closes the dialog only while focus rests inside it.\n    await pendingDialog.getByRole(\"button\", { name: \"Cancel\", exact: true }).focus();\n    await expect(pendingDialog.getByRole(\"button\", { name: \"Cancel\", exact: true })).toBeFocused();\n    await page.keyboard.press(\"Escape\");\n    await expect(page.getByRole(\"dialog\")).toHaveCount(0);\n    await expect(page.getByText(\"Integration is in progress. Closing this view does not stop it.\")).toBeVisible();\n    await page.screenshot({ path: test.info().outputPath(`integration-pending-${width}.png`) });\n    const pendingRequests = await page.evaluate(() => (window as unknown as { integrationRequests: unknown[] }).integrationRequests);\n    expect(pendingRequests).toHaveLength(1);\n  }\n});\n\n"}],"isError":false,"timestamp":1789275135561}}
