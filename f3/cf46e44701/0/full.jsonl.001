kend/tests/test_git_bytes_runner.py:29:    \"\"\"Timed-out bytes runner should kill and drain before failing.\"\"\"\nbackend/tests/test_git_bytes_runner.py:44:            calls.append(\"drained\")\nbackend/tests/test_git_bytes_runner.py:64:    assert calls == [\"communicate\", \"kill\", \"communicate\", \"drained\"]\nbackend/tests/test_git_bytes_runner.py:86:            calls.append(\"drained\")\nbackend/tests/test_git_bytes_runner.py:110:    assert calls == [\"communicate\", \"kill\", \"communicate\", \"drained\"]\nbackend/tests/test_sidecar_orchestration_errors.py:27:    client._writer.drain = AsyncMock()\nbackend/tests/test_sidecar_orchestration_errors.py:107:    client._writer.drain = AsyncMock()\nbackend/src/yinshi/services/repository_lifecycle.py:240:            except BaseException:  # noqa: BLE001 - drain closes the descriptor\nbackend/tests/test_broker_replica_lifecycle.py:51:STAGES = (\"ingest\", \"verify\", \"publish\", \"admission\", \"drain\", \"export\", \"reclaim\")\nbackend/tests/test_broker_replica_lifecycle.py:73:RECLAIM_RECEIPT_ID = \"reclaim_0000000000000000000000\"\nbackend/tests/test_broker_replica_lifecycle.py:177:            runtime_unit_id=\"runtime_0000000000000000000000000\",\nbackend/tests/test_broker_replica_lifecycle.py:180:    if stage == \"drain\":\nbackend/tests/test_broker_replica_lifecycle.py:182:            drain_ack_receipt_id=\"drain_ack_0000000000000000000000\",\nbackend/tests/test_broker_replica_lifecycle.py:183:            quiescence_receipt_id=\"quiescence_00000000000000000000\",\nbackend/tests/test_broker_replica_lifecycle.py:185:    if stage == \"export\":\nbackend/tests/test_broker_replica_lifecycle.py:187:            export_receipt_id=\"export_000000000000000000000000\",\nbackend/tests/test_broker_replica_lifecycle.py:192:    if stage == \"reclaim\":\nbackend/tests/test_broker_replica_lifecycle.py:193:        return ReclaimReceipt(reclaim_receipt_id=RECLAIM_RECEIPT_ID)\nbackend/tests/test_broker_replica_lifecycle.py:273: