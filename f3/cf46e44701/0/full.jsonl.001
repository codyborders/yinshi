, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n+ 622     publication = store(tmp_path)\n+ 623     await publication.publish_artifact_set(declaration, bundle, worktree, objects)\n+ 624 \n+ 625     def fail_sync(_descriptor: int) -> None:\n+ 626         raise OSError(\"sync failed\")\n+ 627 \n+ 628     monkeypatch.setattr(module.os, \"fsync\", fail_sync)\n+ 629     with pytest.raises(ReplicaPublicationUnresolvedError, match=\"reconciliation\"):\n+ 630         await publication.reconcile_published_artifact_set(declaration)\n+ 631 \n+ 632 \n  589 def test_descriptor_copy_uses_bounded_chunks(\n  590     tmp_path: Path,\n  591     monkeypatch: pytest.MonkeyPatch,\n  592 ) -> None:\n      ...","patch":"--- backend/tests/test_workspace_replica_publication.py\n+++ backend/tests/test_workspace_replica_publication.py\n@@ -585,8 +585,52 @@\n     retained = list(root.glob(\".*.pending.abandoned.*\"))\n     assert len(retained) == 1, list(root.iterdir())\n \n \n+@pytest.mark.asyncio\n+async def test_reconciliation_syncs_files_directory_and_root_before_authority(\n+    tmp_path: Path,\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    from yinshi.services import workspace_replica_publication as module\n+\n+    declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n+    publication = store(tmp_path)\n+    await publication.publish_artifact_set(declaration, bundle, worktree, objects)\n+    real_fsync = os.fsync\n+    synchronized_modes: list[str] = []\n+\n+    def tracked_fsync(descriptor: int) -> None:\n+        value = os.fstat(descriptor)\n+        synchronized_modes.append(\"file\" if stat.S_ISREG(value.st_mode) else \"directory\")\n+        real_fsync(descriptor)\n+\n+    monkeypatch.setattr(module.os, \"fsync\", tracked_fsync)\n+    receipt = await publication.reconcile_published_artifact_set(declaration)\n+\n+    assert receipt is not None\n+    assert synchronized_modes == [\"file\", \"file\", \"file\", \"file\", \"directory\", \"directory\"]\n+\n+\n+@pytest.mark.asyncio\n+async def test_reconciliation_sync_failure_is_unresolved(\n+    tmp_path: Path,\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    from yinshi.services import workspace_replica_publication as module\n+\n+    declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n+    publication = store(tmp_path)\n+    await publication.publish_artifact_set(declaration, bundle, worktree, objects)\n+\n+    def fail_sync(_descriptor: int) -> None:\n+        raise OSError(\"sync failed\")\n+\n+    monkeypatch.setattr(module.os, \"fsync\", fail_sync)\n+    with pytest.raises(ReplicaPublicationUnresolvedError, match=\"reconciliation\"):\n+        await publication.reconcile_published_artifact_set(declaration)\n+\n+\n def test_descriptor_copy_uses_bounded_chunks(\n     tmp_path: Path,\n     monkeypatch: pytest.MonkeyPatch,\n ) -> None:\n","firstChangedLine":589},"isError":false,"timestamp":1789319378815}}
