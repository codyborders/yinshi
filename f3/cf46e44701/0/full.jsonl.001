eclaration,\n            bundle_bytes,\n            worktree_bytes,\n            index_object_bytes,\n            self._ceilings,\n        )\n\n    def _inspect_pending(\n        self,\n        parent: int,\n        pending_name: str,\n        expected: dict[str, bytes],\n    ) -> tuple[str, dict[str, tuple[int, int]]]:\n        child = os.open(\n\n[496 more lines in file. Use offset=625 to continue.]"}],"isError":false,"timestamp":1789254195363}}
