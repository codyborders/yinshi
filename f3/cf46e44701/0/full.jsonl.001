{"type":"message","id":"bfef5ac5","parentId":"cb729f55","timestamp":"2026-09-13T05:41:02.851Z","message":{"role":"toolResult","toolCallId":"call_vwfeQQxbc6oWYW0DM4i1TXVs|fc_0212e7de83dbbd32016aa6376e26bc87d09d3609e8c1ed0a41","toolName":"read","content":[{"type":"text","text":"            context.parent_workspace_path,\n            context.branch,\n            thread_git_claim_namespace(common, context.branch),\n        )\n        return await asyncio.to_thread(capture)\n\n    async def _assert_integration_history(self, repo_path: str) -> None:\n        \"\"\"Reject history substitutions instead of interpreting a different immutable OID.\"\"\"\n        if os.environ.get(\"GIT_GRAFT_FILE\") or os.environ.get(\"GIT_REPLACE_REF_BASE\"):\n            raise ThreadGitOwnershipError()\n        raw = await _run_git_bytes(\n            [\"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\"], cwd=repo_path\n        )\n        common = Path(os.fsdecode(raw.removesuffix(b\"\\n\"))).resolve(strict=True)\n\n        def validate() -> None:\n            _storage_node(common / \"info\", directory=True)\n            if os.path.lexists(common / \"info/grafts\"):\n                raise ThreadGitOwnershipError()\n\n        await asyncio.to_thread(validate)\n        if await _run_git_bytes(\n            [\"--no-replace-objects\", \"for-each-ref\", \"--format=%(refname)\", \"refs/replace\"],\n            cwd=repo_path,\n        ):\n            raise ThreadGitOwnershipError()\n\n    async def plan_integration_trial(\n        self,\n        context: ThreadParentGitContext,\n        operation_id: str,\n        trial_id: str,\n        authority_hash: str,\n    ) -> dict[str, str]:\n        \"\"\"Derive a private trial intent before the workflow records or creates it.\"\"\"\n        if any(re.fullmatch(r\"[0-9a-f]{32}\", value) is None for value in (operation_id, trial_id)):\n            raise ThreadGitOwnershipError()\n        if re.fullmatch(r\"[0-9a-f]{64}\", authority_hash) is None:\n            raise ThreadGitOwnershipError()\n        raw = await _run_git_bytes(\n            [\"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\"], cwd=context.repo_path\n        )\n        common = Path(os.fsdecode(raw.removesuffix(b\"\\n\"))).resolve(strict=True)\n        return {\n            \"id\": trial_id,\n            \"operation_id\": operation_id,\n            \"authority_hash\": authority_hash,\n            \"path\": str(common / \".yinshi-integration-trials-v1\" / trial_id / \"worktree\"),\n            \"ref\": f\"refs/yinshi/integrations/{trial_id}\",\n        }\n\n    async def _validate_trial_intent(\n        self, context: ThreadParentGitContext, intent: dict[str, str]\n    ) -> Path:\n        expected = await self.plan_integration_trial(\n            context, intent[\"operation_id\"], intent[\"id\"], intent[\"authority_hash\"]\n        )\n        if intent != expected:\n            raise ThreadGitOwnershipError()\n        root = Path(intent[\"path\"]).parent\n        await asyncio.to_thread(_storage_node, root.parent.parent, directory=True)\n        return root\n\n    @staticmethod\n    def _trial_manifest(intent: dict[str, str]) -> dict[str, str]:\n        return {key: intent[key] for key in (\"id\", \"operation_id\", \"authority_hash\")}\n\n    @staticmethod\n    def _make_trial_root(root: Path, manifest: dict[str, str]) -> None:\n        try:\n            root.parent.mkdir(mode=0o700)\n        except FileExistsError:\n            pass\n        parent_info = _storage_node(root.parent, directory=True)\n        if parent_info is None or stat.S_IMODE(parent_info.st_mode) != 0o700:\n            raise ThreadGitOwnershipError()\n        root.mkdir(mode=0o700)\n        fd = os.open(\n            root / \"owner.json\", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600\n        )\n        try:\n            remaining = memoryview(json.dumps(manifest, sort_keys=True).encode(\"ascii\"))\n            while remaining:\n                written = os.write(fd, remaining)\n                if written <= 0:\n                    raise ThreadGitOwnershipError()\n                remaining = remaining[written:]\n            os.fsync(fd)\n        finally:\n            os.close(fd)\n        directory_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n        try:\n            os.fsync(directory_fd)\n        finally:\n            os.close(directory_fd)\n\n    @staticmethod\n    def _check_trial_root(root: Path, manifest: dict[str, str]) -> None:\n        for directory in (root.parent, root):\n            info = _storage_node(directory, directory=True)\n            if info is None or stat.S_IMODE(info.st_mode) != 0o700:\n                raise ThreadGitOwnershipError()\n        if set(os.listdir(root)) - {\"owner.json\", \"worktree\"}:\n            raise ThreadGitOwnershipError()\n        info = _storage_node(root / \"owner.json\", directory=False)\n        if (\n            info is None\n            or info.st_size > 1024\n            or info.st_nlink != 1\n            or stat.S_IMODE(info.st_mode) != 0o600\n\n[1840 more lines in file. Use offset=760 to continue.]"}],"isError":false,"timestamp":1789278062851}}
