{"type":"message","id":"e1567f01","parentId":"473f5a6a","timestamp":"2026-09-13T09:57:42.020Z","message":{"role":"toolResult","toolCallId":"call_H2d2nbVdsVMPf0yBbDV7Tg0L|fc_0212e7de83dbbd32016aa67395d69c87d081424697f360fa9d","toolName":"read","content":[{"type":"text","text":"    name: str | None = None,\n    username: str | None = None,\n    tenant: TenantContext | None = None,\n    authorize: Callable[[sqlite3.Connection], None] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Create a worktree without holding SQLite across external effects.\"\"\"\n    require_isolated_execution(\"trusted_git\")\n    lock_root = await run_database_operation(lambda db: repository_lifecycle_root(db, tenant))\n    async with repository_lifecycle(repo_id, lock_root):\n        return await _create_workspace_for_repo_unlocked(\n            run_database_operation,\n            repo_id,\n            name=name,\n            username=username,\n            tenant=tenant,\n            authorize=authorize,\n        )\n\n\ndef _record_unadmitted_worktree(\n    database: sqlite3.Connection,\n    *,\n    repo_id: str,\n    name: str,\n    branch: str,\n    path: str,\n) -> None:\n    \"\"\"Persist cleanup ownership when a created worktree cannot be removed.\"\"\"\n    database.execute(\"BEGIN IMMEDIATE\")\n    try:\n        existing = database.execute(\n            \"SELECT id FROM workspaces WHERE repo_id = ? AND path = ?\",\n            (repo_id, path),\n        ).fetchone()\n        if existing is None:\n            database.execute(\n                \"\"\"INSERT INTO workspaces (repo_id, name, branch, path, state)\n                   VALUES (?, ?, ?, ?, 'archived')\"\"\",\n                (repo_id, f\"{name} (cleanup required)\", branch, path),\n            )\n        database.commit()\n    except BaseException:\n        database.rollback()\n        raise\n\n\nasync def _settle_unadmitted_worktree(\n    run_database_operation: DatabaseOperationRunner,\n    *,\n    repo_id: str,\n    repo_path: str,\n    worktree_path: str,\n    name: str,\n    branch: str,\n) -> None:\n    \"\"\"Remove an unadmitted worktree or persist its exact cleanup owner.\"\"\"\n    attempt = asyncio.create_task(delete_worktree(repo_path, worktree_path))\n    cancellation: asyncio.CancelledError | None = None\n    try:\n        await asyncio.shield(attempt)\n    except (GitError, OSError):\n        pass\n    except asyncio.CancelledError as error:\n        cancellation = error\n        while not attempt.done():\n            try:\n                await asyncio.shield(attempt)\n            except asyncio.CancelledError:\n                continue\n            except (GitError, OSError):\n                break\n    cleanup_error: BaseException | None = None\n    if attempt.cancelled():\n        cleanup_error = GitError(\"Unadmitted worktree cleanup was cancelled\")\n    else:\n        try:\n            attempt.result()\n        except (GitError, OSError) as error:\n            cleanup_error = error\n    if cleanup_error is not None:\n        record = asyncio.create_task(\n            run_database_operation(\n                lambda database: _record_unadmitted_worktree(\n                    database,\n                    repo_id=repo_id,\n                    name=name,\n                    branch=branch,\n                    path=worktree_path,\n                )\n            )\n        )\n        while not record.done():\n            try:\n                await asyncio.shield(record)\n            except asyncio.CancelledError:\n                continue\n        record.result()\n        if cancellation is None:\n            raise cleanup_error\n    if cancellation is not None:\n        raise cancellation\n\n\nasync def _create_workspace_for_repo_unlocked(\n    run_database_operation: DatabaseOperationRunner,\n    repo_id: str,\n    name: str | None = None,\n    username: str | None = None,\n    tenant: TenantContext | None = None,\n    authorize: Callable[[sqlite3.Connection], None] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Create a new worktree after repository lifecycle serialization.\"\"\"\n\n    def load_repo(database: sqlite3.Connection) -> dict[str, Any]:\n        if authorize is not None:\n\n[110 more lines in file. Use offset=700 to continue.]"}],"isError":false,"timestamp":1789293462020}}
