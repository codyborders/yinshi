 workspaces=((WORKSPACE_ID, BRANCH),),\n+383         workspace_paths=((WORKSPACE_ID, worktree_path),),\n+384     )\n+385     _insert_receipt(db)\n+386 \n+387     async def run_operation(operation):\n+388         return operation(db)\n+389 \n+390     async def forbidden(*args, **kwargs):\n+391         raise AssertionError(\"checkout Git validation ran\")\n+392 \n+393     monkeypatch.setattr(publication_module, \"validate_local_repo\", forbidden)\n+394     with pytest.raises(publication_module.WorkspacePublicationConflictError):\n+395         asyncio.run(\n+396             publication_module.publish_workspace_checkout_for_tenant(\n+397                 _repair_tenant(),\n+398                 state,\n+399                 run_database_operation=run_operation,\n+400                 authorize=lambda database: state,\n+401                 authority_hash=\"a\" * 64,\n+402                 database_identity=\"identity\",\n+403             )\n+404         )\n+405 \n+406 \n+407 def test_checkout_metadata_rechecks_deletion_inside_transaction(\n+408     db, git_repo: str, monkeypatch\n+409 ) -> None:\n+410     from yinshi.services import workspace as workspace_module\n+411     from yinshi.services.workspace_publication import WorkspacePublicationConflictError\n+412 \n+413     worktree_path = _seed_worktree_stack(db, git_repo)\n+414     preparation = workspace_module.WorkspaceCheckoutPreparation(\n+415         REDACTED,\n+416         repo_id=REPO_ID,\n+417         repo_path=git_repo,\n+418         remote_url=\"https://example.invalid/repo.git\",\n+419         installation_id=None,\n+420         workspace_paths=((WORKSPACE_ID, worktree_path),),\n+421         update_repo_metadata=True,\n+422         repaired_repo=False,\n+423     )\n+424     observed: list[bool] = []\n+425     real_check = workspace_module.require_no_repository_deletion\n+426 \n+427     def checked(database, repo_id):\n+428         observed.append(bool(database.in_transaction))\n+429         real_check(database, repo_id)\n+430 \n+431     monkeypatch.setattr(workspace_module, \"require_no_repository_deletion\", checked)\n+432     _insert_receipt(db)\n+433     with pytest.raises(WorkspacePublicationConflictError):\n+434         workspace_module.apply_workspace_checkout_preparation(db, preparation)\n+435     assert observed == [True]\n+436     assert db.execute(\"SELECT remote_url FROM repos WHERE id = ?\", (REPO_ID,)).fetchone()[0] is None\n+437 \n+438 \n+439 def test_managed_integration_receipt_blocks_before_preview_and_identity(\n+440     client, db, git_repo: str, monkeypatch\n+441 ) -> None:\n+442     from yinshi.services.thread_integration import ThreadIntegrationService\n+443     from yinshi.services.thread_workspaces import ThreadWorkspaceService\n+444 \n+445     monkeypatch.setenv(\"THREAD_MANAGED_INTEGRATION_ENABLED\", \"true\")\n+446     get_settings.cache_clear()\n+447     seed_parent_stack(db, git_repo)\n+448     spawned = client.post(\n+449         \"/api/threads/parent-session/children\",\n+450         json={\n+451             \"idempotency_key\": str(uuid.uuid4()),\n+452             \"title\": \"Preflight child\",\n+453             \"task\": \"Update README.md\",\n+454             \"start_immediately\": False,\n+455         },\n+456     )\n+457     assert spawned.status_code == 201\n+458     child = spawned.json()\n+459     workspace = db.execute(\n+460         \"SELECT w.path FROM workspaces w JOIN sessions s ON s.workspace_id = w.id WHERE s.id = ?\",\n+461         (child[\"child_session_id\"],),\n+462     ).fetchone()\n+463     (Path(workspace[\"path\"]) / \"README.md\").write_bytes(b\"# Child result\\n\")\n+464     from yinshi.services.thread_orchestration import initial_run_idempotency_key\n+465 \n+466     db.execute(\n+467         \"INSERT INTO prompt_runs (id, session_id, idempotency_key, status) VALUES (?, ?, ?, 'completed')\",\n+468         (\n+469             uuid.uuid4().hex,\n+470             child[\"child_session_id\"],\n+471             initial_run_idempotency_key(child[\"delegation_id\"]),\n+472         ),\n+473     )\n+474     db.execute(\n+475         \"UPDATE thread_delegations SET status = 'completed' WHERE id = ?\",\n+476         (child[\"delegation_id\"],),\n+477     )\n+478     db.commit()\n+479     sealed = client.get(f\"/api/threads/{child['child_session_id']}/result\")\n+480     assert sealed.status_code == 200\n+481     endpoint = f\"/api/threads/parent-session/children/{child['child_session_id']}/integrate\"\n+482     preview = client.get(endpoint).json()\n+483     repo_id = db.execute(\n+484         \"SELECT w.repo_id FROM workspaces w JOIN sessions s ON s.workspace_id = w.id WHERE s.id = 'parent-session'\"\n+485     ).fetchone()[0]\n+486     _insert_receipt(db, repo_id=str(repo_id))\n+487 \n+488     async def forbidden(*args, **kwargs):\n+489         raise AssertionError(\"managed integration Git effect ran\")\n+490 \n+491     monkeypatch.setattr(ThreadIntegrationService, \"preview\", forbidden)\n+492     monkeypatch.setattr(ThreadWorkspaceService, \"integration_workspace_identity\", forbidden)\n+493     response = client.post(\n+494         endpoint,\n+495         json={\n+496             \"idempotency_key\": str(uuid.uuid4()),\n+497             \"result_id\": preview[\"result_id\"],\n+498             \"expected_parent_head\": preview[\"expected_parent_head\"],\n+499             \"confirmed\": True,\n+500         },\n+501     )\n+502     assert response.status_code == 409\n+503     assert response.json()[\"detail\"] == \"Integration precondition changed\"","patch":"--- backend/tests/test_repository_deletion_admission.py\n+++ backend/tests/test_repository_deletion_admission.py\n@@ -342,4 +342,162 @@\n     assert applied.status_code == 409\n     assert applied.json()[\"detail\"] == \"Integration precondition changed\"\n     assert db.execute(\"SELECT COUNT(*) FROM thread_integrations\").fetchone()[0] == 0\n     assert head_commit(git_repo) == parent_head\n+\n+\n+def test_execution_receipt_blocks_before_checkout_recovery(\n+    db, git_repo: str, monkeypatch\n+) -> None:\n+    from yinshi.services import workspace_execution as execution_module\n+\n+    _seed_worktree_stack(db, git_repo)\n+    _insert_receipt(db)\n+\n+    async def forbidden(*args, **kwargs):\n+        raise AssertionError(\"execution checkout recovery ran\")\n+\n+    monkeypatch.setattr(\n+        execution_module, \"_recover_pending_checkout_for_execution\", forbidden\n+    )\n+    with pytest.raises(WorkspaceAdmissionError):\n+        asyncio.run(\n+            execution_module.acquire_prompt_workspace(\n+                _request(), SESSION_ID, uuid.uuid4().hex, kind=\"prompt\"\n+            )\n+        )\n+\n+\n+def test_checkout_publication_receipt_blocks_before_git_validation(\n+    db, git_repo: str, monkeypatch\n+) -> None:\n+    from yinshi.services import workspace_publication as publication_module\n+\n+    worktree_path = _seed_worktree_stack(db, git_repo)\n+    state = WorkspaceCheckoutState(\n+        REDACTED,\n+        repo_id=REPO_ID,\n+        repo_path=git_repo,\n+        remote_url=None,\n+        installation_id=None,\n+        workspaces=((WORKSPACE_ID, BRANCH),),\n+        workspace_paths=((WORKSPACE_ID, worktree_path),),\n+    )\n+    _insert_receipt(db)\n+\n+    async def run_operation(operation):\n+        return operation(db)\n+\n+    async def forbidden(*args, **kwargs):\n+        raise AssertionError(\"checkout Git validation ran\")\n+\n+    monkeypatch.setattr(publication_module, \"validate_local_repo\", forbidden)\n+    with pytest.raises(publication_module.WorkspacePublicationConflictError):\n+        asyncio.run(\n+            publication_module.publish_workspace_checkout_for_tenant(\n+                _repair_tenant(),\n+                state,\n+                run_database_operation=run_operation,\n+                authorize=lambda database: state,\n+                authority_hash=\"a\" * 64,\n+                database_identity=\"identity\",\n+            )\n+        )\n+\n+\n+def test_checkout_metadata_rechecks_deletion_inside_transaction(\n+    db, git_repo: str, monkeypatch\n+) -> None:\n+    from yinshi.services import workspace as workspace_module\n+    from yinshi.services.workspace_publication import WorkspacePublicationConflictError\n+\n+    worktree_path = _seed_worktree_stack(db, git_repo)\n+    preparation = workspace_module.WorkspaceCheckoutPreparation(\n+        REDACTED,\n+        repo_id=REPO_ID,\n+        repo_path=git_repo,\n+        remote_url=\"https://example.invalid/repo.git\",\n+        installation_id=None,\n+        workspace_paths=((WORKSPACE_ID, worktree_path),),\n+        update_repo_metadata=True,\n+        repaired_repo=False,\n+    )\n+    observed: list[bool] = []\n+    real_check = workspace_module.require_no_repository_deletion\n+\n+    def checked(database, repo_id):\n+        observed.append(bool(database.in_transaction))\n+        real_check(database, repo_id)\n+\n+    monkeypatch.setattr(workspace_module, \"require_no_repository_deletion\", checked)\n+    _insert_receipt(db)\n+    with pytest.raises(WorkspacePublicationConflictError):\n+        workspace_module.apply_workspace_checkout_preparation(db, preparation)\n+    assert observed == [True]\n+    assert db.execute(\"SELECT remote_url FROM repos WHERE id = ?\", (REPO_ID,)).fetchone()[0] is None\n+\n+\n+def test_managed_integration_receipt_blocks_before_preview_and_identity(\n+    client, db, git_repo: str, monkeypatch\n+) -> None:\n+    from yinshi.services.thread_integration import ThreadIntegrationService\n+    from yinshi.services.thread_workspaces import ThreadWorkspaceService\n+\n+    monkeypatch.setenv(\"THREAD_MANAGED_INTEGRATION_ENABLED\", \"true\")\n+    get_settings.cache_clear()\n+    seed_parent_stack(db, git_repo)\n+    spawned = client.post(\n+        \"/api/threads/parent-session/children\",\n+        json={\n+            \"idempotency_key\": str(uuid.uuid4()),\n+            \"title\": \"Preflight child\",\n+            \"task\": \"Update README.md\",\n+            \"start_immediately\": False,\n+        },\n+    )\n+    assert spawned.status_code == 201\n+    child = spawned.json()\n+    workspace = db.execute(\n+        \"SELECT w.path FROM workspaces w JOIN sessions s ON s.workspace_id = w.id WHERE s.id = ?\",\n+        (child[\"child_session_id\"],),\n+    ).fetchone()\n+    (Path(workspace[\"path\"]) / \"README.md\").write_bytes(b\"# Child result\\n\")\n+    from yinshi.services.thread_orchestration import initial_run_idempotency_key\n+\n+    db.execute(\n+        \"INSERT INTO prompt_runs (id, session_id, idempotency_key, status) VALUES (?, ?, ?, 'completed')\",\n+        (\n+            uuid.uuid4().hex,\n+            child[\"child_session_id\"],\n+            initial_run_idempotency_key(child[\"delegation_id\"]),\n+        ),\n+    )\n+    db.execute(\n+        \"UPDATE thread_delegations SET status = 'completed' WHERE id = ?\",\n+        (child[\"delegation_id\"],),\n+    )\n+    db.commit()\n+    sealed = client.get(f\"/api/threads/{child['child_session_id']}/result\")\n+    assert sealed.status_code == 200\n+    endpoint = f\"/api/threads/parent-session/children/{child['child_session_id']}/integrate\"\n+    preview = client.get(endpoint).json()\n+    repo_id = db.execute(\n+        \"SELECT w.repo_id FROM workspaces w JOIN sessions s ON s.workspace_id = w.id WHERE s.id = 'parent-session'\"\n+    ).fetchone()[0]\n+    _insert_receipt(db, repo_id=str(repo_id))\n+\n+    async def forbidden(*args, **kwargs):\n+        raise AssertionError(\"managed integration Git effect ran\")\n+\n+    monkeypatch.setattr(ThreadIntegrationService, \"preview\", forbidden)\n+    monkeypatch.setattr(ThreadWorkspaceService, \"integration_workspace_identity\", forbidden)\n+    response = client.post(\n+        endpoint,\n+        json={\n+            \"idempotency_key\": str(uuid.uuid4()),\n+            \"result_id\": preview[\"result_id\"],\n+            \"expected_parent_head\": preview[\"expected_parent_head\"],\n+            \"confirmed\": True,\n+        },\n+    )\n+    assert response.status_code == 409\n+    assert response.json()[\"detail\"] == \"Integration precondition changed\"\n","firstChangedLine":346},"isError":false,"timestamp":1789288467485}}
