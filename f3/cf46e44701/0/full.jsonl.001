{"type":"message","id":"cd9f6b90","parentId":"7ff1205d","timestamp":"2026-09-13T06:38:39.813Z","message":{"role":"toolResult","toolCallId":"call_tRxzdG2YUI4LhwIticCzQcl7|fc_0212e7de83dbbd32016aa644ef5bf887d082f8a68b99bb2e06","toolName":"read","content":[{"type":"text","text":"        return hashlib.sha256(\n            json.dumps(facts, sort_keys=True, separators=(\",\", \":\"), default=str).encode()\n        ).hexdigest()\n\n    @staticmethod\n    def _outcome(row: dict[str, Any]) -> dict[str, Any]:\n        outcome = {\n            key: row[key]\n            for key in (\n                \"id\",\n                \"idempotency_key\",\n                \"status\",\n                \"result_id\",\n                \"expected_parent_head\",\n                \"resulting_parent_head\",\n                \"reason_code\",\n            )\n        }\n        outcome[\"resulting_commits\"] = json.loads(row[\"resulting_commits_json\"])\n        outcome[\"conflicts\"] = json.loads(row[\"conflicts_json\"])\n        if row[\"response_status\"] != 200:\n            raise HTTPException(status_code=int(row[\"response_status\"]), detail=outcome)\n        return outcome\n\n    def _authorize_operation(\n        self,\n        db: sqlite3.Connection,\n        request: Request,\n        selection: IntegrationSelection,\n        operation_id: str,\n    ) -> dict[str, Any]:\n        current = self._load(\n            db,\n            request,\n            str(selection.delegation[\"parent_session_id\"]),\n            str(selection.delegation[\"child_session_id\"]),\n        )\n        if (\n            current.database_identity != selection.database_identity\n            or current.context != selection.context\n            or current.parent_branch != selection.parent_branch\n            or current.result != selection.result\n            or current.delegation[\"git_artifact_namespace\"]\n            != selection.delegation[\"git_artifact_namespace\"]\n            or current.delegation[\"status\"] != \"completed\"\n            or current.delegation[\"git_artifacts_claimed\"] != 1\n        ):\n            raise HTTPException(status_code=409, detail=\"Integration authority changed\")\n        row = db.execute(\n            \"SELECT * FROM thread_integrations WHERE id = ?\", (operation_id,)\n        ).fetchone()\n        if row is None or row[\"authority_hash\"] != self._authority(request):\n            raise HTTPException(status_code=404, detail=\"Integration not found\")\n        if row[\"selection_hash\"] != self._selection_hash(current):\n            raise HTTPException(status_code=409, detail=\"Integration target changed\")\n        if (\n            row[\"parent_workspace_id\"] != current.context.parent_workspace_id\n            or row[\"parent_session_id\"] != current.delegation[\"parent_session_id\"]\n            or row[\"child_session_id\"] != current.delegation[\"child_session_id\"]\n            or current.result is None\n            or row[\"result_id\"] != current.result[\"id\"]\n            or row[\"expected_parent_branch\"] != current.parent_branch\n        ):\n            raise HTTPException(status_code=409, detail=\"Integration intent changed\")\n        return dict(row)\n\n    async def _transition(\n        self,\n        request: Request,\n        selection: IntegrationSelection,\n        operation_id: str,\n        expected: str,\n        **changes: Any,\n    ) -> dict[str, Any]:\n        allowed = {\n            \"status\",\n            \"trials_json\",\n            \"trial_commit\",\n            \"resulting_parent_head\",\n            \"resulting_commits_json\",\n            \"conflicts_json\",\n            \"reason_code\",\n            \"response_status\",\n        }\n        if not changes or not set(changes) <= allowed:\n            raise ValueError(\"Invalid integration transition\")\n\n        def update(db: sqlite3.Connection) -> dict[str, Any]:\n            db.execute(\"BEGIN IMMEDIATE\")\n            try:\n                row = self._authorize_operation(db, request, selection, operation_id)\n                if row[\"status\"] != expected:\n                    raise HTTPException(status_code=409, detail=\"Integration state changed\")\n                assignments = \", \".join(f\"{key} = ?\" for key in changes)\n                db.execute(\n                    f\"UPDATE thread_integrations SET {assignments}, updated_at = CURRENT_TIMESTAMP WHERE id = ?\",\n                    (*changes.values(), operation_id),\n                )\n                updated = db.execute(\n                    \"SELECT * FROM thread_integrations WHERE id = ?\", (operation_id,)\n                ).fetchone()\n                db.commit()\n                assert updated is not None\n                return dict(updated)\n            except BaseException:\n                db.rollback()\n                raise\n\n        return await run_db_operation_for_request(request, update)\n\n\n[947 more lines in file. Use offset=290 to continue.]"}],"isError":false,"timestamp":1789281519813}}
