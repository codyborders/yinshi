rkspace_deletion_claim(db, git_repo: str) -> None:\n@@ -173,11 +172,9 @@\n     assert db.execute(\"SELECT COUNT(*) FROM workspaces\").fetchone()[0] == 0\n     assert not (Path(git_repo) / \".worktrees\").exists()\n \n \n-def test_workspace_creation_uses_short_database_callbacks(\n-    db, git_repo: str, monkeypatch\n-) -> None:\n+def test_workspace_creation_uses_short_database_callbacks(db, git_repo: str, monkeypatch) -> None:\n     from yinshi.services import workspace as workspace_module\n \n     db.execute(\n         \"INSERT INTO repos (id, name, root_path) VALUES (?, 'repo', ?)\",\n@@ -326,10 +323,9 @@\n     )\n     assert spawned.status_code == 201\n     child = spawned.json()\n     workspace = db.execute(\n-        \"SELECT w.path FROM workspaces w JOIN sessions s ON s.workspace_id = w.id \"\n-        \"WHERE s.id = ?\",\n+        \"SELECT w.path FROM workspaces w JOIN sessions s ON s.workspace_id = w.id WHERE s.id = ?\",\n         (child[\"child_session_id\"],),\n     ).fetchone()\n     (Path(workspace[\"path\"]) / \"README.md\").write_bytes(b\"# Child result\\n\")\n     from yinshi.services.thread_orchestration import initial_run_idempotency_key\n@@ -375,22 +371,18 @@\n     assert db.execute(\"SELECT COUNT(*) FROM thread_integrations\").fetchone()[0] == 0\n     assert head_commit(git_repo) == parent_head\n \n \n-def test_execution_receipt_blocks_before_checkout_recovery(\n-    db, git_repo: str, monkeypatch\n-) -> None:\n+def test_execution_receipt_blocks_before_checkout_recovery(db, git_repo: str, monkeypatch) -> None:\n     from yinshi.services import workspace_execution as execution_module\n \n     _seed_worktree_stack(db, git_repo)\n     _insert_receipt(db)\n \n     async def forbidden(*args, **kwargs):\n         raise AssertionError(\"execution checkout recovery ran\")\n \n-    monkeypatch.setattr(\n-        execution_module, \"_recover_pending_checkout_for_execution\", forbidden\n-    )\n+    monkeypatch.setattr(execution_module, \"_recover_pending_checkout_for_execution\", forbidden)\n     with pytest.raises(WorkspaceAdmissionError):\n         asyncio.run(\n             execution_module.acquire_prompt_workspace(\n                 _request(), SESSION_ID, uuid.uuid4().hex, kind=\"prompt\"\n@@ -563,11 +555,9 @@\n \n     async def conflict(*args, **kwargs):\n         raise WorkspacePublicationConflictError(\"private\")\n \n-    monkeypatch.setattr(\n-        terminal_channels, \"prepare_tenant_workspace_runtime_paths\", conflict\n-    )\n+    monkeypatch.setattr(terminal_channels, \"prepare_tenant_workspace_runtime_paths\", conflict)\n     with pytest.raises(HTTPException) as raised:\n         asyncio.run(terminal_channels._terminal_context(_request(), WORKSPACE_ID))\n     assert raised.value.status_code == 409\n     assert raised.value.detail == \"Workspace publication conflict\"\n","firstChangedLine":117},"isError":false,"timestamp":1789288657854}}
