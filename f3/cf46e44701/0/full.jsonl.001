11             \"source_state_sha256\": declaration.source_state_sha256,\n+ 985             \"verification_receipt_id\": verification.verification_receipt_id,\n  812             \"final_directory_identity\": final_identity,\n  813             \"publication_marker_sha256\": marker_sha256,\n- 814             \"synchronization_receipt_id\": synchronization_receipt_id,\n  815         }\n- 816         return ReplicaPublicationReceipt(\n- 817             publication_receipt_id=_domain_digest(\n- 818                 b\"yinshi-replica-publication-receipt-v2\",\n- 819                 receipt_value,\n+ 989         return ReplicaInspectionReceipt(\n+ 990             inspection_receipt_id=_domain_digest(\n+ 991                 b\"yinshi-replica-inspection-receipt-v2\",\n+ 992                 value,\n  820             ),\n  821             artifact_set_sha256=verification.artifact_set_sha256,\n  822             verification=verification,\n- 823             identity=declaration.identity,\n- 824             source_state_sha256=declaration.source_state_sha256,\n  825             final_directory_identity=final_identity,\n  826             publication_marker_sha256=marker_sha256,\n- 827             synchronization_receipt_id=synchronization_receipt_id,\n  828         )\n  829 \n  830     async def inspect_published_artifact_set(\n  831         self,\n  832         declaration: ReplicaArtifactSetDeclaration,\n- 833     ) -> ReplicaPublicationReceipt:\n- 834         \"\"\"Read and reverify one published set without modifying storage.\"\"\"\n+1003     ) -> ReplicaInspectionReceipt:\n+1004         \"\"\"Read and reverify storage without minting publication authority.\"\"\"\n  835         declaration = _validate_declaration(declaration, self._ceilings)\n  836         try:\n  837             return await self._inspect_final(declaration)\n  838         except asyncio.CancelledError:\n      ...","patch":"--- /Users/user/projects/yinshi/backend/src/yinshi/services/workspace_replica_publication.py\n+++ /Users/user/projects/yinshi/backend/src/yinshi/services/workspace_replica_publication.py\n@@ -573,8 +573,153 @@\n             index_object_bytes,\n             self._ceilings,\n         )\n \n+    def _inspect_pending(\n+        self,\n+        parent: int,\n+        pending_name: str,\n+        expected: dict[str, bytes],\n+    ) -> tuple[str, dict[str, tuple[int, int]]]:\n+        child = os.open(\n+            pending_name,\n+            os.O_RDONLY\n+            | getattr(os, \"O_DIRECTORY\", 0)\n+            | getattr(os, \"O_CLOEXEC\", 0)\n+            | getattr(os, \"O_NOFOLLOW\", 0),\n+            dir_fd=parent,\n+        )\n+        pins: list[_PinnedRegular] = []\n+        try:\n+            child_stat = os.fstat(child)\n+            if (\n+                child_stat.st_uid != self._expected_uid\n+                or child_stat.st_gid != self._expected_gid\n+                or stat.S_IMODE(child_stat.st_mode) != 0o700\n+                or set(os.listdir(child)) != _EXPECTED_FILES\n+            ):\n+                raise ReplicaPublicationRejectedError(\"publication stage directory is invalid\")\n+            for name, content in expected.items():\n+                pinned = _open_pinned_regular(\n+                    child,\n+                    name,\n+                    len(content),\n+                    self._expected_uid,\n+                    self._expected_gid,\n+                )\n+                pins.append(pinned)\n+                if pinned.content != content:\n+                    raise ReplicaPublicationRejectedError(\"publication stage content changed\")\n+            for pinned in pins:\n+                _recheck_pinned_regular(child, pinned)\n+            return _directory_identity(child), {\n+                pinned.name: (pinned.device, pinned.inode) for pinned in pins\n+            }\n+        finally:\n+            for pinned in pins:\n+                os.close(pinned.descriptor)\n+            os.close(child)\n+\n+    def _cleanup_pending(\n+        self,\n+        parent: int,\n+        pending_name: str,\n+        pending_identity: str,\n+        file_identities: dict[str, tuple[int, int]],\n+    ) -> None:\n+        try:\n+            named = os.stat(pending_name, dir_fd=parent, follow_symlinks=False)\n+            if not _same_identity(named, pending_identity):\n+                raise ReplicaPublicationUnresolvedError(\"publication stage identity changed\")\n+            child = os.open(\n+                pending_name,\n+                os.O_RDONLY\n+                | getattr(os, \"O_DIRECTORY\", 0)\n+                | getattr(os, \"O_CLOEXEC\", 0)\n+                | getattr(os, \"O_NOFOLLOW\", 0),\n+                dir_fd=parent,\n+            )\n+            try:\n+                if set(os.listdir(child)) != set(file_identities):\n+                    raise ReplicaPublicationUnresolvedError(\"publication stage entries changed\")\n+                for name, identity in file_identities.items():\n+                    value = os.stat(name, dir_fd=child, follow_symlinks=False)\n+                    if (value.st_dev, value.st_ino) != identity or not stat.S_ISREG(\n+                        value.st_mode\n+                    ):\n+                        raise ReplicaPublicationUnresolvedError(\n+                            \"publication stage file identity changed\"\n+                        )\n+                for name in file_identities:\n+                    os.unlink(name, dir_fd=child)\n+            finally:\n+                os.close(child)\n+            os.rmdir(pending_name, dir_fd=parent)\n+            os.fsync(parent)\n+        except ReplicaPublicationUnresolvedError:\n+            raise\n+        except OSError as error:\n+            raise ReplicaPublicationUnresolvedError(\"publication stage cleanup is unresolved\") from error\n+\n+    def _rename_state(\n+        self,\n+        parent: int,\n+        pending_name: str,\n+        final_name: str,\n+        pending_identity: str,\n+    ) -> Literal[\"not_moved\", \"moved\", \"unknown\"]:\n+        def identity(name: str) -> os.stat_result | None:\n+            try:\n+                return os.stat(name, dir_fd=parent, follow_symlinks=False)\n+            except FileNotFoundError:\n+                return None\n+\n+        pending = identity(pending_name)\n+        final = identity(final_name)\n+        pending_matches = pending is not None and _same_identity(pending, pending_identity)\n+        final_matches = final is not None and _same_identity(final, pending_identity)\n+        if pending_matches and final is None:\n+            return \"not_moved\"\n+        if pending is None and final_matches:\n+            return \"moved\"\n+        return \"unknown\"\n+\n+    def _publication_receipt(\n+        self,\n+        declaration: ReplicaArtifactSetDeclaration,\n+        inspection: ReplicaInspectionReceipt,\n+    ) -> ReplicaPublicationReceipt:\n+        synchronization_receipt_id = _domain_digest(\n+            b\"yinshi-replica-synchronization-v2\",\n+            {\n+                \"artifact_set_sha256\": inspection.artifact_set_sha256,\n+                \"final_directory_identity\": inspection.final_directory_identity,\n+                \"publication_marker_sha256\": inspection.publication_marker_sha256,\n+            },\n+        )\n+        value = {\n+            \"artifact_set_sha256\": inspection.artifact_set_sha256,\n+            \"verification\": asdict(inspection.verification),\n+            \"identity\": asdict(declaration.identity),\n+            \"source_state_sha256\": declaration.source_state_sha256,\n+            \"final_directory_identity\": inspection.final_directory_identity,\n+            \"publication_marker_sha256\": inspection.publication_marker_sha256,\n+            \"synchronization_receipt_id\": synchronization_receipt_id,\n+        }\n+        return ReplicaPublicationReceipt(\n+            publication_receipt_id=_domain_digest(\n+                b\"yinshi-replica-publication-receipt-v2\",\n+                value,\n+            ),\n+            artifact_set_sha256=inspection.artifact_set_sha256,\n+            verification=inspection.verification,\n+            identity=declaration.identity,\n+            source_state_sha256=declaration.source_state_sha256,\n+            final_directory_identity=inspection.final_directory_identity,\n+            publication_marker_sha256=inspection.publication_marker_sha256,\n+            synchronization_receipt_id=synchronization_receipt_id,\n+        )\n+\n     async def publish_artifact_set(\n         self,\n         declaration: ReplicaArtifactSetDeclaration,\n         bundle_bytes: bytes,\n@@ -588,143 +733,169 @@\n             worktree_bytes,\n             index_object_bytes,\n         )\n         declaration = _validate_declaration(declaration, self._ceilings)\n+        try:\n+            require_atomic_no_replace_support()\n+        except WorkspacePublicationError as error:\n+            raise ReplicaPublicationRejectedError(\n+                \"atomic no-replace publication is unavailable\"\n+            ) from error\n         root_descriptor, root_identity = _root_identity(\n             self._root,\n             self._expected_uid,\n             self._expected_gid,\n         )\n         pending_name = f\".{declaration.operation_id}.pending\"\n         final_name = declaration.operation_id\n-        pending_created = False\n-        rename_attempted = False\n+        pending_identity: str | None = None\n+        file_identities: dict[str, tuple[int, int]] = {}\n+        moved = False\n         try:\n             try:\n                 os.mkdir(pending_name, mode=0o700, dir_fd=root_descriptor)\n-                pending_created = True\n             except FileExistsError as error:\n                 raise ReplicaPublicationCollisionError(\n                     \"publication stage already exists\"\n                 ) from error\n-            pending_descriptor = os.open(\n-                pending_name,\n-                os.O_RDONLY\n-                | getattr(os, \"O_DIRECTORY\", 0)\n-                | getattr(os, \"O_CLOEXEC\", 0)\n-                | getattr(os, \"O_NOFOLLOW\", 0),\n-                dir_fd=root_descriptor,\n+            marker = _canonical_json(\n+                {\"declaration\": asdict(declaration), \"verification\": asdict(verification)}\n             )\n+            expected = {\n+                \"committed.bundle\": bundle_bytes,\n+                \"worktree.yra\": worktree_bytes,\n+                \"index-objects.pack\": index_object_bytes,\n+                \"artifact-set.json\": marker,\n+            }\n             try:\n-                pending_identity = _directory_identity(pending_descriptor)\n-                _write_regular(pending_descriptor, \"committed.bundle\", bundle_bytes)\n-                _write_regular(pending_descriptor, \"worktree.yra\", worktree_bytes)\n-                _write_regular(pending_descriptor, \"index-objects.pack\", index_object_bytes)\n-                marker_value = {\n-                    \"declaration\": asdict(declaration),\n-                    \"verification\": asdict(verification),\n-                }\n-                marker = _canonical_json(marker_value)\n-                _write_regular(pending_descriptor, \"artifact-set.json\", marker)\n-                os.fsync(pending_descriptor)\n-            finally:\n-                os.close(pending_descriptor)\n-            rename_attempted = True\n+                pending_descriptor = os.open(\n+                    pending_name,\n+                    os.O_RDONLY\n+                    | getattr(os, \"O_DIRECTORY\", 0)\n+                    | getattr(os, \"O_CLOEXEC\", 0)\n+                    | getattr(os, \"O_NOFOLLOW\", 0),\n+                    dir_fd=root_descriptor,\n+                )\n+                try:\n+                    for name, content in expected.items():\n+                        _write_regular(pending_descriptor, name, content)\n+                    os.fsync(pending_descriptor)\n+                finally:\n+                    os.close(pending_descriptor)\n+                pending_identity, file_identities = self._inspect_pending(\n+                    root_descriptor,\n+                    pending_name,\n+                    expected,\n+                )\n+            except BaseException:\n+                if pending_identity is None:\n+                    try:\n+                        pending_descriptor = os.open(\n+                            pending_name,\n+                            os.O_RDONLY\n+                            | getattr(os, \"O_DIRECTORY\", 0)\n+                            | getattr(os, \"O_CLOEXEC\", 0)\n+                            | getattr(os, \"O_NOFOLLOW\", 0),\n+                            dir_fd=root_descriptor,\n+                        )\n+                        try:\n+                            pending_identity = _directory_identity(pending_descriptor)\n+                            file_identities = {\n+                                name: (\n+                                    os.stat(name, dir_fd=pending_descriptor, follow_symlinks=False).st_dev,\n+                                    os.stat(name, dir_fd=pending_descriptor, follow_symlinks=False).st_ino,\n+                                )\n+                                for name in os.listdir(pending_descriptor)\n+                                if name in _EXPECTED_FILES\n+                            }\n+                        finally:\n+                            os.close(pending_descriptor)\n+                    except OSError:\n+                        pass\n+                if pending_identity is not None:\n+                    self._cleanup_pending(\n+                        root_descriptor,\n+                        pending_name,\n+                        pending_identity,\n+                        file_identities,\n+                    )\n+                raise\n             try:\n                 atomic_rename_no_replace(\n                     self._root / pending_name,\n                     self._root / final_name,\n                     source_parent_identity=root_identity,\n                     target_parent_identity=root_identity,\n                     source_identity=pending_identity,\n                 )\n+                moved = True\n             except WorkspacePublicationCollisionError as error:\n-                rename_attempted = False\n+                self._cleanup_pending(\n+                    root_descriptor,\n+                    pending_name,\n+                    pending_identity,\n+                    file_identities,\n+                )\n                 raise ReplicaPublicationCollisionError(\n                     \"publication target already exists\"\n                 ) from error\n             except (WorkspacePublicationError, OSError) as error:\n+                state = self._rename_state(\n+                    root_descriptor,\n+                    pending_name,\n+                    final_name,\n+                    pending_identity,\n+                )\n+                if state == \"not_moved\":\n+                    self._cleanup_pending(\n+                        root_descriptor,\n+                        pending_name,\n+                        pending_identity,\n+                        file_identities,\n+                    )\n+                    raise ReplicaPublicationRejectedError(\n+                        \"publication rename failed before visibility\"\n+                    ) from error\n                 raise ReplicaPublicationUnresolvedError(\n                     \"publication rename or synchronization is unresolved\"\n                 ) from error\n-            receipt = await self._inspect_final(declaration, verification)\n-            return receipt\n-        except asyncio.CancelledError as error:\n-            if rename_attempted:\n+            try:\n+                inspection = await