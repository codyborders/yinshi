\"--format=%(objectname)\", intent[\"ref\"], cwd=git_repo\n+        )\n+        if stage == \"metadata_retired\":\n+            assert ref_value == operation[\"trial_commit\"]\n+            assert sorted(entry.name for entry in trial_root.iterdir()) == [\n+                \"metadata-quarantine\",\n+                \"owner.json\",\n+                \"quarantine\",\n+            ]\n+            assert not retained.exists()\n+        elif stage == \"ref_deleted\":\n+            assert ref_value == \"\"\n+            assert sorted(entry.name for entry in trial_root.iterdir()) == [\n+                \"metadata-quarantine\",\n+                \"owner.json\",\n+                \"quarantine\",\n+            ]\n+            assert not retained.exists()\n+        else:\n+            assert ref_value == \"\"\n+            assert not trial_root.exists()\n+            assert sorted(entry.name for entry in retained.iterdir()) == [\n+                \"metadata-quarantine\",\n+                \"owner.json\",\n+                \"quarantine\",\n+            ]\n+        assert len(list(marker_directory.glob(\"*.json\"))) == 1\n+        monkeypatch.setattr(thread_workspaces, \"_run_git\", real_git)\n+        monkeypatch.setattr(\n+            ThreadWorkspaceService, \"_rename_no_replace\", staticmethod(real_rename)\n+        )\n+        replay = await http.post(endpoint, json=payload)\n+\n+    assert replay.status_code == 200, replay.text\n+    assert replay.json()[\"status\"] == \"integrated\"\n+    assert replay.json()[\"resulting_parent_head\"] == operation[\"trial_commit\"]\n+    completed = db.execute(\"SELECT * FROM thread_integrations\").fetchone()\n+    assert completed[\"status\"] == \"integrated\"\n+    assert completed[\"resulting_parent_head\"] == completed[\"trial_commit\"]\n+    assert json.loads(completed[\"trials_json\"]) == json.loads(operation[\"trials_json\"])\n+    assert run_git(\"for-each-ref\", \"--format=%(refname)\", intent[\"ref\"], cwd=git_repo) == \"\"\n+   