   path = repo(tmp_path)\n    head = git(path, \"rev-parse\", \"HEAD\")\n    closure = git(path, \"rev-list\", \"--objects\", \"--no-object-names\", \"HEAD\").splitlines()\n    extra = git(path, \"hash-object\", \"-w\", \"--stdin\", input_bytes=b\"unadvertised\")\n    packed = subprocess.run(\n        [\"git\", \"-C\", str(path), \"pack-objects\", \"--stdout\"],\n        input=b\"\\n\".join([*closure, extra]) + b\"\\n\",\n        check=True,\n        capture_output=True,\n    ).stdout\n    bundle = b\"# v2 git bundle\\n\" + head + b\" refs/heads/main\\n\\n\" + packed\n    with pytest.raises(GitError, match=\"unreachable\"):\n        await verify_committed_bundle(bundle, object_format=\"sha1\")\n\n\n@pytest.mark.asyncio\nasync def test_public_verifier_rejects_object_format_mismatch(tmp_path: Path) -> None:\n    path = repo(tmp_path)\n    created = await create_committed_bundle(path, (\"refs/heads/main\",), include_head=False)\n    with pytest.raises(GitError):\n        await verify_committed_bundle(created.bundle_bytes, object_format=\"sha256\")\n\n\n@pytest.mark.fail_closed_isolation\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":441,"output":933,"cacheRead":154240,"cacheWrite":0,"reasoning":297,"totalTokens":155614,"cost":{"input":0.0022050000000000004,"output":0.02799,"cacheRead":0.07712,"cacheWrite":0,"total":0.107315}},"stopReason":"toolUse","timestamp":1789241027069,"responseId":"resp_0212e7de83dbbd32016aa5a6c3c5a087d0888dcce12acc125b","rawStopReason":"completed"}}
