{"type":"message","id":"44d73b42","parentId":"14cdbc14","timestamp":"2026-09-13T16:42:16.807Z","message":{"role":"toolResult","toolCallId":"call_1sRL8ICwm0ZyxiacE241G4KG|fc_0212e7de83dbbd32016aa6d268006487d0a66d31d591272fce","toolName":"read","content":[{"type":"text","text":"_REQUEST_SIGNATURE_DOMAIN = b\"YINSHI-BROKER-REQUEST-V1\\x00\"\n_RESPONSE_SIGNATURE_DOMAIN = b\"YINSHI-BROKER-RESPONSE-V1\\x00\"\n\nJsonScalar: TypeAlias = None | bool | int | str\nJsonValue: TypeAlias = JsonScalar | list[\"JsonValue\"] | dict[str, \"JsonValue\"]\n\n\nclass BrokerProtocolError(ValueError):\n    \"\"\"Reject one unauthenticated, malformed, or replayed broker message.\"\"\"\n\n\n@dataclass(frozen=True, slots=True)\nclass BrokerRequest:\n    \"\"\"One verified application-owned logical request.\"\"\"\n\n    protocol_version: str\n    broker_incarnation: str\n    database_incarnation: str\n    connection_sequence: int\n    operation_id: str\n    request_type: str\n    nonce: str\n    payload_digest: str\n    payload: dict[str, JsonValue]\n\n\n@dataclass(frozen=True, slots=True)\nclass BrokerResponse:\n    \"\"\"One verified response bound to its complete request identity.\"\"\"\n\n    protocol_version: str\n    broker_incarnation: str\n    database_incarnation: str\n    connection_sequence: int\n    operation_id: str\n    request_type: str\n    request_nonce: str\n    payload_digest: str\n    status: str\n    error: str | None\n    result: dict[str, JsonValue]\n\n\ndef _reject_constant(value: str) -> object:\n    raise BrokerProtocolError(f\"unsupported JSON constant: {value}\")\n\n\ndef _reject_float(value: str) -> object:\n    raise BrokerProtocolError(\"floating-point JSON values are not supported\")\n\n\ndef _unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:\n    result: dict[str, object] = {}\n    for key, value in pairs:\n        if key in result:\n            raise BrokerProtocolError(\"duplicate JSON object key\")\n        result[key] = value\n    return result\n\n\n\n[315 more lines in file. Use offset=115 to continue.]"}],"isError":false,"timestamp":1789317736807}}
{"type":"message","id":"a91b6978","parentId":"44d73b42","timestamp":"2026-09-13T16:43:02.302Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Refactoring testing with fixture helpers**\n\n**Planning publication apply receipt handling**","thinkingSignature":"{\"id\":\"rs_0212e7de83dbbd32016aa6d26bd8f887d0a1f0d2799b532041\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"REDACTED\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Refactoring testing with fixture helpers**\"},{\"type\":\"summary_text\",\"text\":\"**Planning publication apply receipt handling**\"}]}"},{"type":"toolCall","id":"call_lOzSbo3XFFO00kTZ7m4txQk2|fc_0212e7de83dbbd32016aa6d272471487d0a8d27351243c4f87","name":"write","arguments":{"path":"backend/tests/test_broker_replica_artifact_effects.py","content":"\"\"\"Check concrete artifact effects for broker replica lifecycles.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import asdict\nfrom pathlib import Path\n\nimport pytest\n\nfrom test_workspace_replica_publication import (\n    artifact_reader,\n    declaration_and_bytes,\n    incoming_manifest,\n    incoming_store,\n    store as publication_store,\n)\nfrom yinshi.services.broker_protocol import BROKER_PROTOCOL_VERSION, BrokerRequest\nfrom yinshi.services.broker_replica_artifact_effects import BrokerReplicaArtifactEffects\nfrom yinshi.services.broker_replica_journal import ReplicaAuthority\nfrom yinshi.services.broker_replica_lifecycle import (\n    ReplicaLifecycleContext,\n    StageRejected,\n)\nfrom yinshi.services.replica_artifact_contract import (\n    compute_replica_artifact_set_sha256,\n)\nfrom yinshi.services.workspace_replica_publication import (\n    ReplicaArtifactSetDeclaration,\n    ReplicaIdentity,\n    ReplicaStoreLimits,\n)\n\n\ndef authority(declaration: ReplicaArtifactSetDeclaration) -> ReplicaAuthority:\n    return ReplicaAuthority(\n        physical_target_id=declaration.identity.physical_target_id,\n        replica_generation=declaration.identity.replica_generation,\n        execution_owner_id=declaration.identity.execution_owner_id,\n    )\n\n\ndef request_for(\n    declaration: ReplicaArtifactSetDeclaration,\n    *,\n    authority_value: ReplicaAuthority | None = None,\n    limits_sha256: str | None = None,\n) -> BrokerRequest:\n    selected = authority_value or authority(declaration)\n    selected_limits = limits_sha256 or declaration.limits_sha256\n    payload = {\n        \"authority\": {\n            \"execution_owner_id\": selected.execution_owner_id,\n            \"physical_target_id\": selected.physical_target_id,\n            \"replica_generation\": selected.replica_generation,\n        },\n        \"bundle\": {\n            \"artifact_id\": declaration.bundle.artifact_id,\n            \"byte_length\": declaration.bundle.byte_length,\n            \"sha256\": declaration.bundle.sha256,\n        },\n        \"index_objects\": {\n            \"artifact_id\": declaration.index_objects.artifact_id,\n            \"byte_length\": declaration.index_objects.byte_length,\n            \"sha256\": declaration.index_objects.sha256,\n        },\n        \"limits_sha256\": selected_limits,\n        \"object_format\": declaration.object_format,\n        \"reconciliation_fingerprint\": declaration.reconciliation_fingerprint,\n        \"repository_id\": declaration.repository_id,\n        \"source_state_sha256\": declaration.source_state_sha256,\n        \"workspace_id\": declaration.workspace_id,\n        \"worktree\": {\n            \"artifact_id\": declaration.worktree.artifact_id,\n            \"byte_length\": declaration.worktree.byte_length,\n            \"sha256\": declaration.worktree.sha256,\n        },\n    }\n    payload[\"artifact_set_sha256\"] = compute_replica_artifact_set_sha256(\n        operation_id=declaration.operation_id,\n        repository_id=declaration.repository_id,\n        workspace_id=declaration.workspace_id,\n        physical_target_id=selected.physical_target_id,\n        replica_generation=selected.replica_generation,\n        execution_owner_id=selected.execution_owner_id,\n        object_format=declaration.object_format,\n        source_state_sha256=declaration.source_state_sha256,\n        reconciliation_fingerprint=declaration.reconciliation_fingerprint,\n        bundle=asdict(declaration.bundle),\n        worktree=asdict(declaration.worktree),\n        index_objects=asdict(declaration.index_objects),\n        limits_sha256=selected_limits,\n    )\n    return BrokerRequest(\n        protocol_version=BROKER_PROTOCOL_VERSION,\n        broker_incarnation=\"b\" * 32,\n        database_incarnation=\"d\" * 32,\n        connection_sequence=1,\n        operation_id=declaration.operation_id,\n        request_type=\"replica.lifecycle\",\n        nonce=\"nonce_000000000001\",\n        payload_digest=\"0\" * 64,\n        payload=payload,\n    )\n\n\ndef context(\n    declaration: ReplicaArtifactSetDeclaration,\n    *,\n    request: BrokerRequest | None = None,\n    authority_value: ReplicaAuthority | None = None,\n) -> ReplicaLifecycleContext:\n    return ReplicaLifecycleContext(\n        request=request or request_for(declaration),\n        authority=authority_value or authority(declaration),\n        owner_token=\"owner_token_000000000000000\",\n    )\n\n\n@pytest.mark.asyncio\nasync def test_artifact_effects_ingest_verify_publish_and_reconcile(tmp_path: Path) -> None:\n    declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n    incoming = incoming_store(tmp_path)\n    publication = publication_store(tmp_path)\n    await incoming.receive(\n        incoming_manifest(declaration),\n        artifact_reader(bundle, worktree, objects),\n    )\n    effects = BrokerReplicaArtifactEffects(\n        incoming=incoming,\n        publication=publication,\n        limits=declaration.limits,\n    )\n    lifecycle = context(declaration)\n\n    ingested = await effects.ingest.apply(lifecycle)\n    assert ingested.outcome == \"completed\"\n    assert ingested.receipt is not None\n    assert ingested.receipt.bundle.sha256 == declaration.bundle.sha256\n\n    verified = await effects.verify.apply(lifecycle)\n    assert verified.outcome == \"completed\"\n    assert verified.receipt is not None\n    assert verified.receipt.artifact_set_sha256 == lifecycle.request.payload[\n        \"artifact_set_sha256\"\n    ]\n\n    assert (await effects.publish.reconcile(lifecycle)).outcome == \"not_applied\"\n    published = await effects.publish.apply(lifecycle)\n    assert published.outcome == \"completed\"\n    assert published.receipt is not None\n    assert published.receipt.physical_target_id == lifecycle.authority.physical_target_id\n    assert await effects.publish.reconcile(lifecycle) == published\n\n\n@pytest.mark.asyncio\nasync def test_missing_incoming_rejects_ingest_deterministically(tmp_path: Path) -> None:\n    declaration, _bundle, _worktree, _objects = await declaration_and_bytes(tmp_path)\n    effects = BrokerReplicaArtifactEffects(\n        incoming=incoming_store(tmp_path),\n        publication=publication_store(tmp_path),\n        limits=declaration.limits,\n    )\n    lifecycle = context(declaration)\n\n    with pytest.raises(StageRejected) as first:\n        await effects.ingest.apply(lifecycle)\n    with pytest.raises(StageRejected) as second:\n        await effects.ingest.reconcile(lifecycle)\n\n    assert first.value.status == \"artifact_rejected\"\n    assert first.value.receipt_id == second.value.receipt_id\n\n\n@pytest.mark.asyncio\nasync def test_effects_reject_authority_and_limit_mismatch(tmp_path: Path) -> None:\n    declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n    incoming = incoming_store(tmp_path)\n    publication = publication_store(tmp_path)\n    await incoming.receive(\n        incoming_manifest(declaration),\n        artifact_reader(bundle, worktree, objects),\n    )\n    effects = BrokerReplicaArtifactEffects(\n        incoming=incoming,\n        publication=publication,\n        limits=declaration.limits,\n    )\n    other = ReplicaAuthority(\n        physical_target_id=\"other_target_0000000000000000000\",\n        replica_generation=declaration.identity.replica_generation + 1,\n        execution_owner_id=\"other_owner_00000000000000000000\",\n    )\n\n    for stage_name in (\"ingest\", \"verify\", \"publish\"):\n        with pytest.raises(StageRejected):\n            await getattr(effects, stage_name).apply(\n                context(declaration, authority_value=other)\n            )\n\n    wrong_limits = request_for(declaration, limits_sha256=\"f\" * 64)\n    with pytest.raises(StageRejected) as rejected:\n        await effects.ingest.apply(context(declaration, request=wrong_limits))\n    assert rejected.value.status == \"limit_rejected\"\n\n\n@pytest.mark.asyncio\nasync def test_publication_reconciliation_binds_trusted_declaration(tmp_path: Path) -> None:\n    declaration, bundle, worktree, objects = await declaration_and_bytes(tmp_path)\n    publication = publication_store(tmp_path)\n\n    assert await publication.reconcile_published_artifact_set(declaration) is None\n    created = await publication.publish_artifact_set(\n        declaration,\n        bundle,\n        worktree,\n        objects,\n    )\n    reconciled = await publication.reconcile_published_artifact_set(declaration)\n\n    assert reconciled == created\n    assert reconciled is not None\n    assert reconciled.identity == ReplicaIdentity(\n        physical_target_id=declaration.identity.physical_target_id,\n        replica_generation=declaration.identity.replica_generation,\n        execution_owner_id=declaration.identity.execution_owner_id,\n    )\n\n\ndef test_effects_require_matching_publication_limit_profile(tmp_path: Path) -> None:\n    publication = publication_store(tmp_path)\n    with pytest.raises(ValueError, match=\"limits differ\"):\n        BrokerReplicaArtifactEffects(\n            incoming=incoming_store(tmp_path),\n            publication=publication,\n            limits=ReplicaStoreLimits(\n                max_set_bytes=publication.limits.max_set_bytes - 1,\n            ),\n        )\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":582,"output":2332,"cacheRead":175872,"cacheWrite":0,"reasoning":219,"totalTokens":178786,"cost":{"input":0.0029100000000000003,"output":0.06996000000000001,"cacheRead":0.087936,"cacheWrite":0,"total":0.160806}},"stopReason":"toolUse","timestamp":1789317736817,"responseId":"resp_0212e7de83dbbd32016aa6d269782087d0a75d705f35c1ac62","rawStopReason":"completed"}}
