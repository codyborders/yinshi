pack\"):\\n'\n                       '            failed_opens.append(str(path))\\n'\n                       '            raise OSError(\"second pinned open '\n                       'failed\")\\n'\n                       '        descriptor = real_open(path, flags, mode, '\n                       '**kwargs)\\n'\n                       '        if kwargs.get(\"dir_fd\") is None and '\n                       'str(path).endswith(\"committed.bundle\"):\\n'\n                       '            opened_copies.append(descriptor)\\n'\n                       '        return descriptor\\n'\n                       '\\n'\n                       '    def tracked_close(descriptor: int) -> None:\\n'\n                       '        closed.append(descriptor)\\n'\n                       '        real_close(descriptor)\\n'\n                       '\\n'\n                       '    with incoming.open_incoming(manifest) as opened:\\n'\n                       '        monkeypatch.setattr(module.os, \"open\", '\n                       'guarded_open)\\n'\n                       '        monkeypatch.setattr(module.os, \"close\", '\n                       'tracked_close)\\n'\n                       '        with pytest.raises(\\n'\n                       '            ReplicaPublicationRejectedError,\\n'\n                       '            match=\"artifact verification failed\",\\n'\n                       '        ):\\n'\n                       '            await '\n                       'publication.verify_opened_artifact_set(\\n'\n                       '                declaration,\\n'\n                       '                opened,\\n'\n                       '                '\n                       'recheck_source=incoming.recheck_opened_async,\\n'\n                       '            )\\n'\n                       '\\n'\n                       '    assert failed_opens and '\n                       'failed_opens[0].endswith(\"index-objects.pack\")\\n'\n                       '    assert opened_copies, \"bundle copy must have been '\n                       'opened before the failing open\"\\n'\n                       '    assert opened_copies[0] in closed\\n'\n                       '\\n'\n                       '\\n'\n                       'def test_descriptor_copy_uses_bounded_chunks('}]}\n"}],"isError":false,"timestamp":1789310371923}}
