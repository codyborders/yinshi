{"type":"message","id":"26acfbe0","parentId":"bb0ea470","timestamp":"2026-09-13T04:35:20.520Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Adding initial test and reviewing file**","thinkingSignature":"{\"id\":\"rs_0212e7de83dbbd32016aa628072cec87d0b41430d493218188\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"REDACTED\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Adding initial test and reviewing file**\"}]}"},{"type":"toolCall","id":"call_E8rGkgPqClMtvDgiHX9WgyTa|fc_0212e7de83dbbd32016aa62807d28087d09d1dfddb584bc50e","name":"read","arguments":{"path":"sidecar/tests/execution-admission.test.js","offset":1,"limit":210}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":820,"output":47,"cacheRead":232832,"cacheWrite":0,"reasoning":12,"totalTokens":233699,"cost":{"input":0.0041,"output":0.00141,"cacheRead":0.11641599999999999,"cacheWrite":0,"total":0.12192599999999999}},"stopReason":"toolUse","timestamp":1789274116803,"responseId":"resp_0212e7de83dbbd32016aa628054e8087d0afb7222520036134","rawStopReason":"completed"}}
{"type":"message","id":"306e7b6b","parentId":"26acfbe0","timestamp":"2026-09-13T04:35:20.603Z","message":{"role":"toolResult","toolCallId":"call_E8rGkgPqClMtvDgiHX9WgyTa|fc_0212e7de83dbbd32016aa62807d28087d09d1dfddb584bc50e","toolName":"read","content":[{"type":"text","text":"import assert from \"node:assert/strict\";\nimport { EventEmitter } from \"node:events\";\nimport test from \"node:test\";\n\nimport { YinshiSidecar } from \"../src/sidecar.js\";\n\nfunction recordingSocket() {\n  const socket = new EventEmitter();\n  socket.destroyed = false;\n  socket.messages = [];\n  socket.write = (value) => {\n    socket.messages.push(JSON.parse(String(value).trim()));\n    return true;\n  };\n  return socket;\n}\n\ntest(\"confirmed receipt cleanup allows repeated execution beyond the receipt capacity\", async () => {\n  const sidecar = new YinshiSidecar();\n  const socket = recordingSocket();\n  sidecar._createPiSession = async () => ({\n    session: { subscribe() { return () => {}; }, async prompt() {},\n      abortCompaction() {}, abortRetry() {}, async abort() {}, dispose() {} },\n    model: { provider: \"fixture\", id: \"fixture\" }, piSessionFile: null,\n  });\n  try {\n    for (let index = 0; index < 260; index += 1) {\n      const executionId = index.toString(16).padStart(32, \"0\");\n      sidecar.handleRequest({ type: \"execution_prepare\", id: \"session\", execution_id: executionId }, socket);\n      const prepared = socket.messages.at(-1);\n      assert.equal(prepared.type, \"execution_prepared\");\n      const identity = { instance_id: prepared.instance_id, execution_id: executionId };\n      await sidecar.processQuery(\"session\", socket, \"Fixture only\", { execution: identity });\n      const removal = { type: \"execution_forget\", id: \"session\", ...identity };\n      sidecar.handleRequest(removal, socket);\n      assert.deepEqual(socket.messages.at(-1), { type: \"execution_forgotten\", id: \"session\", ...identity, forgotten: true });\n      sidecar.handleRequest(removal, socket);\n      assert.equal(socket.messages.at(-1).forgotten, true);\n      socket.messages.length = 0;\n    }\n  } finally {\n    sidecar.cleanup();\n  }\n});\n\ntest(\"receipt removal rejects preparation and wrong identities without treating absence as a stop\", async () => {\n  const sidecar = new YinshiSidecar();\n  const socket = recordingSocket();\n  try {\n    sidecar.handleRequest({ type: \"execution_prepare\", id: \"session\", execution_id: \"a\".repeat(32) }, socket);\n    const identity = { instance_id: socket.messages.at(-1).instance_id, execution_id: \"a\".repeat(32) };\n    const removal = { type: \"execution_forget\", id: \"session\", ...identity };\n    sidecar.handleRequest(removal, socket);\n    assert.equal(socket.messages.at(-1).forgotten, false);\n    await sidecar.cancelExecution({ id: \"session\", ...identity }, socket);\n    assert.equal(socket.messages.at(-1).stopped, true);\n    for (const wrong of [{ ...removal, instance_id: \"b\".repeat(32) }, { ...removal, id: \"other\" }]) {\n      sidecar.handleRequest(wrong, socket);\n      assert.equal(socket.messages.at(-1).forgotten, false);\n    }\n    sidecar.handleRequest(removal, socket);\n    assert.equal(socket.messages.at(-1).forgotten, true);\n    await sidecar.cancelExecution({ id: \"session\", ...identity }, socket);\n    assert.equal(socket.messages.at(-1).stopped, false);\n    assert.equal(socket.messages.at(-1).reason_code, \"execution_missing\");\n  } finally {\n    sidecar.cleanup();\n  }\n});\n\ntest(\"matching execution cancellation waits until the exact prompt settles\", async () => {\n  const sidecar = new YinshiSidecar();\n  const socket = recordingSocket();\n  const recoverySocket = recordingSocket();\n  let started;\n  const starting = new Promise((resolve) => { started = resolve; });\n  let finish;\n  const finished = new Promise((resolve) => { finish = resolve; });\n  let allowAbort;\n  const abortAllowed = new Promise((resolve) => { allowAbort = resolve; });\n  sidecar._createPiSession = async () => ({\n    session: { subscribe() { return () => {}; },\n      async prompt() { started(); await finished; },\n      abortCompaction() {}, abortRetry() {},\n      async abort() { await abortAllowed; finish(); }, dispose() {},\n    }, model: { provider: \"fixture\", id: \"fixture\" }, piSessionFile: null,\n  });\n  try {\n    sidecar.handleRequest({ type: \"execution_prepare\", id: \"session\", execution_id: \"a\".repeat(32) }, socket);\n    const prepared = socket.messages.shift();\n    const query = sidecar.processQuery(\"session\", socket, \"Fixture only\", { execution: {\n      instance_id: prepared.instance_id, execution_id: prepared.execution_id,\n    } });\n    await starting;\n    const cancelling = sidecar.cancelExecution({ id: \"session\", instance_id: prepared.instance_id,\n      execution_id: prepared.execution_id }, recoverySocket);\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.deepEqual(recoverySocket.messages, []);\n    allowAbort();\n    await Promise.all([query, cancelling]);\n    assert.equal(recoverySocket.messages[0].stopped, true);\n    assert.equal(recoverySocket.messages[0].execution_id, prepared.execution_id);\n  } finally {\n    allowAbort();\n    finish();\n    sidecar.cleanup();\n  }\n});\n\ntest(\"an admitted query acknowledges its exact execution only after prompt completion\", async () => {\n  const sidecar = new YinshiSidecar();\n  const socket = recordingSocket();\n  let completed = false;\n  sidecar._createPiSession = async () => ({\n    session: {\n      subscribe() { return () => {}; },\n      async prompt() { completed = true; },\n      abortCompaction() {}, abortRetry() {}, async abort() {}, dispose() {},\n    },\n    model: { provider: \"fixture\", id: \"fixture\" }, piSessionFile: null,\n  });\n  try {\n    sidecar.handleRequest({ type: \"execution_prepare\", id: \"session\", execution_id: \"a\".repeat(32) }, socket);\n    const prepared = socket.messages.shift();\n    await sidecar.processQuery(\"session\", socket, \"Fixture only\", { execution: {\n      instance_id: prepared.instance_id, execution_id: prepared.execution_id,\n    } });\n    assert.equal(completed, true);\n    assert.deepEqual(socket.messages.at(-1), { id: \"session\", type: \"execution_stopped\",\n      instance_id: prepared.instance_id, execution_id: prepared.execution_id });\n  } finally {\n    sidecar.cleanup();\n  }\n});\n\ntest(\"a replacement instance cannot acknowledge stopping the original execution\", async () => {\n  const original = new YinshiSidecar();\n  const replacement = new YinshiSidecar();\n  const socket = recordingSocket();\n  try {\n    original.handleRequest({ type: \"execution_prepare\", id: \"session\", execution_id: \"a\".repeat(32) }, socket);\n    const receipt = socket.messages.shift();\n    replacement.handleRequest({ type: \"execution_cancel\", id: \"session\",\n      instance_id: receipt.instance_id, execution_id: receipt.execution_id }, socket);\n    await new Promise((resolve) => setImmediate(resolve));\n    assert.equal(socket.messages[0].type, \"execution_cancelled\");\n    assert.equal(socket.messages[0].stopped, false);\n    assert.equal(socket.messages[0].reason_code, \"instance_mismatch\");\n  } finally {\n    original.cleanup();\n    replacement.cleanup();\n  }\n});\n\ntest(\"execution preparation binds a stable receipt to one sidecar instance\", () => {\n  const sidecar = new YinshiSidecar();\n  const socket = recordingSocket();\n  try {\n    const request = { type: \"execution_prepare\", id: \"session\", execution_id: \"a\".repeat(32) };\n    sidecar.handleRequest(request, socket);\n    const first = socket.messages[0];\n    assert.equal(first.type, \"execution_prepared\");\n    assert.match(first.instance_id, /^[0-9a-f]{32}$/);\n    assert.equal(first.execution_id, \"a\".repeat(32));\n    assert.equal(first.id, \"session\");\n    sidecar.handleRequest(request, socket);\n    assert.deepEqual(socket.messages[1], first);\n  } finally {\n    sidecar.cleanup();\n  }\n});\n"}],"isError":false,"timestamp":1789274120603}}
