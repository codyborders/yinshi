{"type":"message","id":"5345024e","parentId":"97e2db71","timestamp":"2026-09-12T18:29:34.677Z","message":{"role":"toolResult","toolCallId":"call_JYEBoBY7sVvAB0sifkhocJxM|fc_0212e7de83dbbd32016aa59a0cad4487d098d2afffa7e8c704","toolName":"bash","content":[{"type":"text","text":" .../yinshi/services/workspace_replica_artifact.py  | 191 ++++++++++++++-\n backend/tests/test_workspace_replica_artifact.py   | 267 ++++++++++++++++++++-\n 2 files changed, 447 insertions(+), 11 deletions(-)\n184\t7\tbackend/src/yinshi/services/workspace_replica_artifact.py\n263\t4\tbackend/tests/test_workspace_replica_artifact.py\n30:_INDEX_VERSIONS: Final[frozenset[int]] = frozenset({2, 3})\n31:_INDEX_ALLOWED_EXTENSIONS: Final[frozenset[bytes]] = frozenset(\n34:_INDEX_MODE_REGULAR: Final[frozenset[int]] = frozenset({0o100644, 0o100755, 0o120000})\n35:_INDEX_FLAG_ASSUME_VALID: Final[int] = 0x8000\n36:_INDEX_FLAG_EXTENDED: Final[int] = 0x4000\n37:_INDEX_FLAG_STAGE_MASK: Final[int] = 0x3000\n38:_INDEX_FLAG_NAME_MASK: Final[int] = 0x0FFF\n39:_INDEX_EXTENDED_FLAG_SKIP_WORKTREE: Final[int] = 0x4000\n40:_INDEX_EXTENDED_FLAG_INTENT_TO_ADD: Final[int] = 0x2000\n41:_INDEX_EXTENDED_FLAGS_KNOWN: Final[int] = 0x6000\n154:class ArtifactIndexEntry:\n187:    index_entries: tuple[ArtifactIndexEntry, ...]\n201:    \"ArtifactIndexEntry\",\n311:) -> tuple[ArtifactIndexEntry, ...]:\n320:    if version not in _INDEX_VERSIONS:\n337:    entries: list[ArtifactIndexEntry] = []\n352:        if flags & _INDEX_FLAG_EXTENDED:\n359:            if extended_flags & ~_INDEX_EXTENDED_FLAGS_KNOWN:\n368:        encoded_path_length = flags & _INDEX_FLAG_NAME_MASK\n369:        if encoded_path_length != min(len(path), _INDEX_FLAG_NAME_MASK):\n382:        if mode not in _INDEX_MODE_REGULAR:\n386:        stage = (flags & _INDEX_FLAG_STAGE_MASK) >> 12\n397:            ArtifactIndexEntry(\n402:                intent_to_add=bool(extended_flags & _INDEX_EXTENDED_FLAG_INTENT_TO_ADD),\n403:                skip_worktree=bool(extended_flags & _INDEX_EXTENDED_FLAG_SKIP_WORKTREE),\n404:                assume_unchanged=bool(flags & _INDEX_FLAG_ASSUME_VALID),\n416:        if signature not in _INDEX_ALLOWED_EXTENSIONS:\n425:    index_entries: tuple[ArtifactIndexEntry, ...],\n427:    roots = {entry.object_id for entry in index_entries}\n556:    index_entries = (\n594:    roots = _expected_roots(artifact.head_oid, index_entries)\n871:    index_entries = (\n897:    if roots != _expected_roots(head_oid, index_entries):\n905:        index_entries=index_entries,\n"}],"isError":false,"timestamp":1789237774677}}
