{"type":"message","id":"e15d541d","parentId":"c06569bc","timestamp":"2026-09-12T19:24:23.610Z","message":{"role":"toolResult","toolCallId":"call_BV7HfvVDYVLZeYU8owdFu6mr|fc_0212e7de83dbbd32016aa5a6e766ec87d0ad3405b217efaf85","toolName":"read","content":[{"type":"text","text":"\"\"\"Verify bounded committed-ref Git bundle creation and validation.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport subprocess\nfrom dataclasses import replace\nfrom pathlib import Path\n\nimport pytest\n\nfrom yinshi.exceptions import GitError\nfrom yinshi.services.workspace_replica_bundle import (\n    BundleLimits,\n    BundleRef,\n    HeadCapture,\n    create_committed_bundle,\n    verify_committed_bundle,\n)\n\n\ndef git(repo: Path, *args: str) -> str:\n    result = subprocess.run(\n        [\"git\", \"-C\", str(repo), *args],\n        check=True,\n        capture_output=True,\n        text=True,\n        env={**os.environ, \"GIT_CONFIG_NOSYSTEM\": \"1\"},\n    )\n    return result.stdout.strip()\n\n\ndef repo(tmp_path: Path, *, object_format: str = \"sha1\") -> Path:\n    path = tmp_path / object_format\n    path.mkdir()\n    git(\n        path,\n        \"init\",\n        \"-q\",\n        \"--initial-branch=main\",\n        f\"--object-format={object_format}\",\n    )\n    git(path, \"config\", \"user.name\", \"Test\")\n    git(path, \"config\", \"user.email\", \"test@example.invalid\")\n    (path / \"file.txt\").write_text(\"one\", encoding=\"utf-8\")\n    git(path, \"add\", \"file.txt\")\n    git(path, \"commit\", \"-qm\", \"initial\")\n    git(path, \"tag\", \"-a\", \"v1\", \"-m\", \"tag\")\n    return path\n\n[224 more lines in file. Use offset=51 to continue.]"}],"isError":false,"timestamp":1789241063610}}
