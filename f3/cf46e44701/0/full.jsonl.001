  self._expected_uid,\n-                self._expected_gid,\n-            )\n-        except ReplicaPublicationRejectedError:\n-            return\n-        try:\n-            try:\n-                child = os.open(\n-                    pending_name,\n-                    os.O_RDONLY\n-                    | getattr(os, \"O_DIRECTORY\", 0)\n-                    | getattr(os, \"O_CLOEXEC\", 0)\n-                    | getattr(os, \"O_NOFOLLOW\", 0),\n-                    dir_fd=parent,\n-                )\n-            except OSError:\n-                return\n-            try:\n-                names = set(os.listdir(child))\n-                if names <= _EXPECTED_FILES:\n-                    for name in names:\n-                        try:\n-                            os.unlink(name, dir_fd=child)\n-                        except OSError:\n-                            return\n-            finally:\n-                os.close(child)\n-            try:\n-                os.rmdir(pending_name, dir_fd=parent)\n-                os.fsync(parent)\n-            except OSError:\n-                return\n-        finally:\n-            os.close(parent)\n-\n     async def _inspect_final(\n         self,\n         declaration: ReplicaArtifactSetDeclaration,\n         expected_verification: ReplicaVerificationReceipt | None = None,\n-    ) -> ReplicaPublicationReceipt:\n+    ) -> ReplicaInspectionReceipt:\n         root_descriptor, _root_identity_value = _root_identity(\n             self._root,\n             self._expected_uid,\n             self._expected_gid,\n         )\n+        pins: list[_PinnedRegular] = []\n         try:\n             try:\n                 final_descriptor = os.open(\n                     declaration.operation_id,\n@@ -749,90 +920,89 @@\n                 ):\n                     raise ReplicaPublicationRejectedError(\n                         \"published artifact set directory is invalid\"\n                     )\n-                bundle_bytes = _read