{"type":"message","id":"2dffced2","parentId":"d97a9c3d","timestamp":"2026-09-13T03:32:21.564Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Reviewing test concurrency causing 404 errors**","thinkingSignature":"{\"id\":\"rs_0212e7de83dbbd32016aa6193c78bc87d0801b2aa107f144c7\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"REDACTED\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Reviewing test concurrency causing 404 errors**\"}]}"},{"type":"toolCall","id":"call_6fJ8ucMSbG62pNAa6eMv7bwA|fc_0212e7de83dbbd32016aa61942b0e887d0ae643f18c46c805d","name":"read","arguments":{"path":"backend/src/yinshi/services/thread_integration.py","offset":1,"limit":900}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":488,"output":102,"cacheRead":156672,"cacheWrite":0,"reasoning":67,"totalTokens":157262,"cost":{"input":0.0024400000000000003,"output":0.0030600000000000002,"cacheRead":0.078336,"cacheWrite":0,"total":0.08383600000000001}},"stopReason":"toolUse","timestamp":1789270329264,"responseId":"resp_0212e7de83dbbd32016aa61939d5b887d0bfd15d7002dea017","rawStopReason":"completed"}}
{"type":"message","id":"93a222b6","parentId":"2dffced2","timestamp":"2026-09-13T03:32:21.602Z","message":{"role":"toolResult","toolCallId":"call_6fJ8ucMSbG62pNAa6eMv7bwA|fc_0212e7de83dbbd32016aa61942b0e887d0ae643f18c46c805d","toolName":"read","content":[{"type":"text","text":"\"\"\"Authorized managed integration over immutable child results.\n\nThis service owns database selection and durable workflow. Git inspection and\napplication belong to ThreadWorkspaceService. Database reads close before Git.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport re\nimport sqlite3\nimport uuid\nfrom dataclasses import asdict, dataclass\nfrom typing import Any\n\nfrom fastapi import HTTPException, Request\n\nfrom yinshi.api.deps import (\n    check_session_owner,\n    get_tenant,\n    get_user_email,\n    request_database_identity,\n    run_db_operation_for_request,\n)\nfrom yinshi.config import get_settings\nfrom yinshi.exceptions import GitError\nfrom yinshi.models import ThreadIntegrationCreate\nfrom yinshi.services.thread_git_ownership import (\n    ThreadGitOwnershipError,\n    ThreadGitWorktree,\n)\nfrom yinshi.services.thread_queries import ThreadNotFoundError, get_thread\nfrom yinshi.services.thread_workspaces import (\n    ThreadIntegrationApplyAmbiguousError,\n    ThreadIntegrationApplyRefusedError,\n    ThreadParentGitContext,\n    ThreadWorkspaceService,\n)\nfrom yinshi.services.workspace_admission import WorkspaceAdmissionError\nfrom yinshi.services.workspace_isolation import (\n    IsolationGateError,\n    isolation_setup_required,\n    require_isolated_execution,\n)\n\n\n@dataclass(frozen=True)\nclass IntegrationSelection:\n    \"\"\"Captured authorization and Git facts from one closed database read.\"\"\"\n\n    database_identity: str\n    context: ThreadParentGitContext\n    delegation: dict[str, Any]\n    result: dict[str, Any] | None\n    parent_branch: str\n    owned_worktrees: tuple[ThreadGitWorktree, ...]\n    parent_busy: bool\n\n\nclass ThreadIntegrationService:\n    \"\"\"Inspect and coordinate only explicitly confirmed child integration.\"\"\"\n\n    def __init__(self) -> None:\n        self.workspaces = ThreadWorkspaceService()\n\n    @staticmethod\n    def _require_isolated_git() -> None:\n        \"\"\"Deny Git-bearing integration work before repository effects.\"\"\"\n        try:\n            require_isolated_execution(\"trusted_git\")\n        except IsolationGateError as error:\n            raise HTTPException(status_code=409, detail=str(error)) from error\n\n    def _load(\n        self, db: sqlite3.Connection, request: Request, parent_id: str, child_id: str\n    ) -> IntegrationSelection:\n        settings = get_settings()\n        if not settings.thread_hierarchy_enabled or not settings.thread_managed_integration_enabled:\n            raise HTTPException(status_code=404, detail=\"Managed integration is unavailable\")\n        owner = None if get_tenant(request) is not None else get_user_email(request) or None\n        try:\n            get_thread(db, parent_id, owner_email=owner)\n            get_thread(db, child_id, owner_email=owner)\n        except ThreadNotFoundError as error:\n            raise HTTPException(status_code=404, detail=\"Thread not found\") from error\n        check_session_owner(db, parent_id, request)\n        check_session_owner(db, child_id, request)\n        row = db.execute(\n            \"SELECT d.*, p.workspace_id AS parent_workspace_id, pw.branch AS parent_branch, pw.state AS parent_state, \"\n            \"pw.repo_id AS parent_repo_id, cw.repo_id AS child_repo_id, cw.kind AS child_kind, cw.path AS child_path \"\n            \"FROM thread_delegations d JOIN sessions p ON p.id = d.parent_session_id \"\n            \"JOIN sessions c ON c.id = d.child_session_id JOIN workspaces pw ON pw.id = p.workspace_id \"\n            \"JOIN workspaces cw ON cw.id = c.workspace_id \"\n            \"WHERE d.parent_session_id = ? AND d.child_session_id = ? AND d.child_workspace_id = cw.id\",\n            (parent_id, child_id),\n        ).fetchone()\n        if (\n            row is None\n            or row[\"parent_repo_id\"] != row[\"child_repo_id\"]\n            or row[\"child_kind\"] != \"delegated\"\n        ):\n            raise HTTPException(status_code=404, detail=\"Thread not found\")\n        if row[\"parent_state\"] == \"deleting\":\n            raise HTTPException(status_code=409, detail=\"Parent workspace is deleting\")\n        delegation = dict(row)\n        result = db.execute(\n            \"SELECT v.* FROM thread_result_versions v JOIN thread_results r ON r.result_id = v.id \"\n            \"WHERE r.delegation_id = ? AND v.delegation_id = r.delegation_id AND r.sealed = 1\",\n            (row[\"id\"],),\n        ).fetchone()\n        context = self.workspaces.load_parent_context(\n            db,\n            get_tenant(request),\n            parent_workspace_id=str(row[\"parent_workspace_id\"]),\n            delegation_id=str(row[\"id\"]),\n        )\n        if str(row[\"child_path\"]) != context.worktree_path:\n            raise HTTPException(status_code=404, detail=\"Thread not found\")\n        owned = tuple(\n            ThreadGitWorktree(\n                str(item[\"id\"]), str(item[\"git_artifact_namespace\"]), str(item[\"path\"])\n            )\n            for item in db.execute(\n                \"SELECT d.id, d.git_artifact_namespace, w.path FROM thread_delegations d \"\n                \"JOIN workspaces w ON w.id = d.child_workspace_id WHERE w.repo_id = ? \"\n                \"AND w.kind = 'delegated' AND d.git_artifacts_claimed = 1 AND d.git_artifact_namespace IS NOT NULL\",\n                (context.repo_id,),\n            )\n        )\n        busy = (\n            db.execute(\n                \"SELECT 1 FROM sessions s WHERE s.workspace_id = ? AND (s.status = 'running' OR EXISTS \"\n                \"(SELECT 1 FROM prompt_runs p WHERE p.session_id = s.id AND p.status IN ('starting', 'running', 'stopping')) OR EXISTS \"\n                \"(SELECT 1 FROM workspace_execution_receipts e WHERE e.workspace_id = s.workspace_id AND e.status IN ('reserved', 'prepared'))) LIMIT 1\",\n                (context.parent_workspace_id,),\n            ).fetchone()\n            is not None\n        )\n        repair_busy = db.execute(\n            \"SELECT 1 FROM workspace_checkout_repairs WHERE repo_id = ? \"\n            \"AND state IN ('active', 'published', 'unresolved') LIMIT 1\",\n            (context.repo_id,),\n        ).fetchone()\n        if repair_busy is not None:\n            busy = True\n        return IntegrationSelection(\n            request_database_identity(request),\n            context,\n            delegation,\n            None if result is None else dict(result),\n            str(row[\"parent_branch\"]),\n            owned,\n            busy,\n        )\n\n    @staticmethod\n    def _authority(request: Request) -> str:\n        from yinshi.services.workspace_execution import admission_authority\n\n        return admission_authority(request)\n\n    @staticmethod\n    def _selection_hash(selection: IntegrationSelection) -> str:\n        facts = {\n            \"database_identity\": selection.database_identity,\n            \"context\": asdict(selection.context),\n            \"parent_branch\": selection.parent_branch,\n            \"namespace\": selection.delegation[\"git_artifact_namespace\"],\n            \"result\": selection.result,\n        }\n        return hashlib.sha256(\n            json.dumps(facts, sort_keys=True, separators=(\",\", \":\"), default=str).encode()\n        ).hexdigest()\n\n    @staticmethod\n    def _outcome(row: dict[str, Any]) -> dict[str, Any]:\n        outcome = {\n            key: row[key]\n            for key in (\n                \"id\",\n                \"idempotency_key\",\n                \"status\",\n                \"result_id\",\n                \"expected_parent_head\",\n                \"resulting_parent_head\",\n                \"reason_code\",\n            )\n        }\n        outcome[\"resulting_commits\"] = json.loads(row[\"resulting_commits_json\"])\n        outcome[\"conflicts\"] = json.loads(row[\"conflicts_json\"])\n        if row[\"response_status\"] != 200:\n            raise HTTPException(status_code=int(row[\"response_status\"]), detail=outcome)\n        return outcome\n\n    def _authorize_operation(\n        self,\n        db: sqlite3.Connection,\n        request: Request,\n        selection: IntegrationSelection,\n        operation_id: str,\n    ) -> dict[str, Any]:\n        current = self._load(\n            db,\n            request,\n            str(selection.delegation[\"parent_session_id\"]),\n            str(selection.delegation[\"child_session_id\"]),\n        )\n        if (\n            current.database_identity != selection.database_identity\n            or current.context != selection.context\n            or current.parent_branch != selection.parent_branch\n            or current.result != selection.result\n            or current.delegation[\"git_artifact_namespace\"]\n            != selection.delegation[\"git_artifact_namespace\"]\n            or current.delegation[\"status\"] != \"completed\"\n            or current.delegation[\"git_artifacts_claimed\"] != 1\n        ):\n            raise HTTPException(status_code=409, detail=\"Integration authority changed\")\n        row = db.execute(\n            \"SELECT * FROM thread_integrations WHERE id = ?\", (operation_id,)\n        ).fetchone()\n        if row is None or row[\"authority_hash\"] != self._authority(request):\n            raise HTTPException(status_code=404, detail=\"Integration not found\")\n        if row[\"selection_hash\"] != self._selection_hash(current):\n            raise HTTPException(status_code=409, detail=\"Integration target changed\")\n        if (\n            row[\"parent_workspace_id\"] != current.context.parent_workspace_id\n            or row[\"parent_session_id\"] != current.delegation[\"parent_session_id\"]\n            or row[\"child_session_id\"] != current.delegation[\"child_session_id\"]\n            or current.result is None\n            or row[\"result_id\"] != current.result[\"id\"]\n            or row[\"expected_parent_branch\"] != current.parent_branch\n        ):\n            raise HTTPException(status_code=409, detail=\"Integration intent changed\")\n        return dict(row)\n\n    async def _transition(\n        self,\n        request: Request,\n        selection: IntegrationSelection,\n        operation_id: str,\n        expected: str,\n        **changes: Any,\n    ) -> dict[str, Any]:\n        allowed = {\n            \"status\",\n            \"trials_json\",\n            \"trial_commit\",\n            \"resulting_parent_head\",\n            \"resulting_commits_json\",\n            \"conflicts_json\",\n            \"reason_code\",\n            \"response_status\",\n        }\n        if not changes or not set(changes) <= allowed:\n            raise ValueError(\"Invalid integration transition\")\n\n        def update(db: sqlite3.Connection) -> dict[str, Any]:\n            db.execute(\"BEGIN IMMEDIATE\")\n            try:\n                row = self._authorize_operation(db, request, selection, operation_id)\n                if row[\"status\"] != expected:\n                    raise HTTPException(status_code=409, detail=\"Integration state changed\")\n                assignments = \", \".join(f\"{key} = ?\" for key in changes)\n                db.execute(\n                    f\"UPDATE thread_integrations SET {assignments}, updated_at = CURRENT_TIMESTAMP WHERE id = ?\",\n                    (*changes.values(), operation_id),\n                )\n                updated = db.execute(\n                    \"SELECT * FROM thread_integrations WHERE id = ?\", (operation_id,)\n                ).fetchone()\n                db.commit()\n                assert updated is not None\n                return dict(updated)\n            except BaseException:\n                db.rollback()\n                raise\n\n        return await run_db_operation_for_request(request, update)\n\n    async def integrate(\n        self, request: Request, parent_id: str, child_id: str, body: ThreadIntegrationCreate\n    ) -> dict[str, Any]:\n        \"\"\"Reserve a confirmed intent, then trial and apply its exact recorded commit.\"\"\"\n        selection = await run_db_operation_for_request(\n            request, lambda db: self._load(db, request, parent_id, child_id)\n        )\n        self._require_isolated_git()\n        key = str(body.idempotency_key)\n        operation_id = uuid.uuid4().hex\n\n        def existing(db: sqlite3.Connection) -> dict[str, Any] | None:\n            self._load(db, request, parent_id, child_id)\n            row = db.execute(\n                \"SELECT * FROM thread_integrations WHERE parent_session_id = ? AND idempotency_key = ?\",\n                (parent_id, key),\n            ).fetchone()\n            if row is None:\n                return None\n            if (\n                row[\"result_id\"] != body.result_id\n                or row[\"expected_parent_head\"] != body.expected_parent_head\n                or row[\"child_session_id\"] != child_id\n            ):\n                raise HTTPException(\n                    status_code=409, detail=\"Idempotency key has a different payload\"\n                )\n            return self._authorize_operation(db, request, selection, str(row[\"id\"]))\n\n        operation = await run_db_operation_for_request(request, existing)\n        if operation is not None and operation[\"status\"] not in {\"checking\", \"applying\"}:\n            return self._outcome(operation)\n        if operation is None:\n            preview = await self.preview(request, parent_id, child_id)\n            if (\n                not preview[\"eligible\"]\n                or preview[\"result_id\"] != body.result_id\n                or preview[\"expected_parent_head\"] != body.expected_parent_head\n            ):\n                raise HTTPException(\n                    status_code=409,\n                    detail=(\n                        preview[\"reason_code\"]\n                        if not preview[\"eligible\"]\n                        else \"parent_or_result_changed\"\n                    ),\n                )\n            physical_identity = await self.workspaces.integration_workspace_identity(\n                selection.context\n            )\n\n            def reserve(db: sqlite3.Connection) -> dict[str, Any]:\n                db.execute(\"BEGIN IMMEDIATE\")\n                try:\n                    current = self._load(db, request, parent_id, child_id)\n                    if (\n                        current.context != selection.context\n                        or current.result != selection.result\n                        or current.parent_branch != selection.parent_branch\n                        or current.parent_busy\n                    ):\n                        raise HTTPException(\n                            status_code=409, detail=\"Integration precondition changed\"\n                        )\n                    duplicate = existing(db)\n                    if duplicate is not None:\n                        db.rollback()\n                        return duplicate\n                    db.execute(\n                        \"INSERT INTO thread_integrations (id, parent_session_id, parent_workspace_id, child_session_id, \"\n                        \"result_id, idempotency_key, expected_parent_head, expected_parent_branch, authority_hash, selection_hash, physical_workspace_json, status) \"\n                        \"VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'checking')\",\n                        (\n                            operation_id,\n                            parent_id,\n                            current.context.parent_workspace_id,\n                            child_id,\n                            body.result_id,\n                            key,\n                            body.expected_parent_head,\n                            current.parent_branch,\n                            self._authority(request),\n                            self._selection_hash(current),\n                            physical_identity,\n                        ),\n                    )\n                    row = db.execute(\n                        \"SELECT * FROM thread_integrations WHERE id = ?\", (operation_id,)\n                    ).fetchone()\n                    db.commit()\n                    assert row is not None\n                    return dict(row)\n                except sqlite3.IntegrityError as error:\n                    db.rollback()\n                    raise HTTPException(\n                        status_code=409, detail=\"Result or workspace is already claimed\"\n                    ) from error\n                except BaseException:\n                    db.rollback()\n                    raise\n\n            operation = await run_db_operation_for_request(request, reserve)\n        if operation[\"status\"] not in {\"checking\", \"applying\"}:\n            return self._outcome(operation)\n        return await self._execute(request, selection, operation)\n\n    async def status(\n        self, request: Request, parent_id: str, child_id: str, operation_id: str\n    ) -> dict[str, Any]:\n        \"\"\"Acknowledge recorded application without ever applying a new parent change.\"\"\"\n        if re.fullmatch(r\"[0-9a-f]{32}\", operation_id) is None:\n            raise HTTPException(status_code=404, detail=\"Integration not found\")\n        selection = await run_db_operation_for_request(\n            request, lambda db: self._load(db, request, parent_id, child_id)\n        )\n        operation = await run_db_operation_for_request(\n            request, lambda db: self._authorize_operation(db, request, selection, operation_id)\n        )\n        if isolation_setup_required():\n            return self._outcome(operation)\n        if operation[\"status\"] == \"checking\":\n            return self._outcome(operation)\n        context = selection.context\n        if (\n            await self.workspaces.integration_workspace_identity(context)\n            != operation[\"physical_workspace_json\"]\n        ):\n            if operation[\"status\"] in {\"applying\", \"blocked\"}:\n                return {\n                    **self._outcome(operation),\n                    \"status\": \"blocked\",\n                    \"reason_code\": \"physical_parent_changed\",\n                }\n            return self._outcome(operation)\n        try:\n            lease = await self.workspaces.acquire_workspace_admission(\n                repo_path=context.repo_path,\n                workspace_path=context.parent_workspace_path,\n                authority_hash=self._authority(request),\n                operation_id=operation_id,\n                kind=\"integration\",\n                resume=True,\n            )\n        except WorkspaceAdmissionError:\n            return self._outcome(operation)\n        terminal = operation[\"status\"] not in {\"checking\", \"applying\", \"blocked\"}\n        try:\n            if operation[\"status\"] != \"applying\":\n                return self._outcome(operation)\n            trials = json.loads(operation[\"trials_json\"])\n            if not isinstance(trials, list) or not trials or not operation[\"trial_commit\"]:\n                return {\n                    **self._outcome(operation),\n                    \"status\": \"blocked\",\n                    \"reason_code\": \"recovery_facts_unavailable\",\n                }\n\n            def authorize(db: sqlite3.Connection) -> None:\n                db.execute(\"BEGIN IMMEDIATE\")\n                try:\n                    current = self._authorize_operation(db, request, selection, operation_id)\n                    if current != operation:\n                        raise HTTPException(status_code=409, detail=\"Integration state changed\")\n                    db.commit()\n                except BaseException:\n                    db.rollback()\n                    raise\n\n            async def reauthorize() -> None:\n                await run_db_operation_for_request(request, authorize)\n\n            try:\n                committed = await self.workspaces.apply_integration_trial(\n                    context,\n                    trials[-1],\n                    database_identity=selection.database_identity,\n                    namespace=str(selection.delegation[\"git_artifact_namespace\"]),\n                    parent_branch=str(operation[\"expected_parent_branch\"]),\n                    expected_parent_head=str(operation[\"expected_parent_head\"]),\n                    trial_commit=str(operation[\"trial_commit\"]),\n                    owned_worktrees=selection.owned_worktrees,\n                    reauthorize=reauthorize,\n                    physical_identity=str(operation[\"physical_workspace_json\"]),\n                    allow_apply=False,\n                )\n            except (ThreadGitOwnershipError, GitError, OSError, ValueError, KeyError, TypeError):\n                return {\n                    **self._outcome(operation),\n                    \"status\": \"blocked\",\n                    \"reason_code\": \"parent_state_ambiguous\",\n                }\n            if committed is None:\n                return {**self._outcome(operation), \"reason_code\": \"confirmation_required\"}\n            operation = await self._transition(\n                request,\n                selection,\n                operation_id,\n                \"applying\",\n                status=\"integrated\",\n                resulting_parent_head=committed,\n                resulting_commits_json=json.dumps([committed]),\n                reason_code=None,\n            )\n            terminal = True\n            return self._outcome(operation)\n        finally:\n            if terminal:\n                await lease.release()\n            else:\n                lease.close()\n\n    async def abort(\n        self, request: Request, parent_id: str, child_id: str, operation_id: str\n    ) -> dict[str, Any]:\n        \"\"\"Release only a known non-applied attempt, retaining all uncertain user files.\"\"\"\n        if re.fullmatch(r\"[0-9a-f]{32}\", operation_id) is None:\n            raise HTTPException(status_code=404, detail=\"Integration not found\")\n        selection = await run_db_operation_for_request(\n            request, lambda db: self._load(db, request, parent_id, child_id)\n        )\n        operation = await run_db_operation_for_request(\n            request, lambda db: self._authorize_operation(db, request, selection, operation_id)\n        )\n        if operation[\"status\"] not in {\"checking\", \"applying\", \"blocked\"}:\n            return await self.status(request, parent_id, child_id, operation_id)\n        self._require_isolated_git()\n        if operation[\"status\"] == \"blocked\":\n            raise HTTPException(status_code=409, detail=\"Integration ownership remains uncertain\")\n        context = selection.context\n        if (\n            await self.workspaces.integration_workspace_identity(context)\n            != operation[\"physical_workspace_json\"]\n        ):\n            raise HTTPException(status_code=409, detail=\"Physical integration target changed\")\n        try:\n            lease = await self.workspaces.acquire_workspace_admission(\n                repo_path=context.repo_path,\n                workspace_path=context.parent_workspace_path,\n                authority_hash=self._authority(request),\n                operation_id=operation_id,\n                kind=\"integration\",\n                resume=True,\n            )\n        except WorkspaceAdmissionError as error:\n            raise HTTPException(\n                status_code=409, detail=\"Integration is still active or ownership is unavailable\"\n            ) from error\n        terminal = False\n        try:\n            operation = await run_db_operation_for_request(\n                request, lambda db: self._authorize_operation(db, request, selection, operation_id)\n            )\n            if operation[\"status\"] not in {\"checking\", \"applying\"}:\n                terminal = operation[\"status\"] not in {\"blocked\"}\n                return self._outcome(operation)\n\n            def authorize(db: sqlite3.Connection) -> None:\n                db.execute(\"BEGIN IMMEDIATE\")\n                try:\n                    if self._authorize_operation(db, request, selection, operation_id) != operation:\n                        raise HTTPException(status_code=409, detail=\"Integration state changed\")\n                    db.commit()\n                except BaseException:\n                    db.rollback()\n                    raise\n\n            async def reauthorize() -> None:\n                await run_db_operation_for_request(request, authorize)\n\n            trials = json.loads(operation[\"trials_json\"])\n            if not isinstance(trials, list) or len(trials) > 8:\n                raise HTTPException(status_code=409, detail=\"Integration trial records are invalid\")\n            for intent in trials:\n                if (\n                    not isinstance(intent, dict)\n                    or intent.get(\"operation_id\") != operation_id\n                    or intent.get(\"authority_hash\") != self._authority(request)\n                ):\n                    raise HTTPException(\n                        status_code=409, detail=\"Integration trial ownership is unavailable\"\n                    )\n            if operation[\"status\"] == \"applying\":\n                if not trials or not operation[\"trial_commit\"]:\n                    raise HTTPException(\n                        status_code=409, detail=\"Integration application facts are unavailable\"\n                    )\n                committed = await self.workspaces.apply_integration_trial(\n                    context,\n                    trials[-1],\n                    database_identity=selection.database_identity,\n                    namespace=str(selection.delegation[\"git_artifact_namespace\"]),\n                    parent_branch=str(operation[\"expected_parent_branch\"]),\n                    expected_parent_head=str(operation[\"expected_parent_head\"]),\n                    trial_commit=str(operation[\"trial_commit\"]),\n                    owned_worktrees=selection.owned_worktrees,\n                    reauthorize=reauthorize,\n                    physical_identity=str(operation[\"physical_workspace_json\"]),\n                    allow_apply=False,\n                )\n                if committed is not None:\n                    operation = await self._transition(\n                        request,\n                        selection,\n                        operation_id,\n                        \"applying\",\n                        status=\"integrated\",\n                        resulting_parent_head=committed,\n                        resulting_commits_json=json.dumps([committed]),\n                        reason_code=None,\n                    )\n                    terminal = True\n                    return self._outcome(operation)\n            retained = False\n            for intent in trials:\n                removed = await self.workspaces.cleanup_integration_trial(\n                    context,\n                    intent,\n                    database_identity=selection.database_identity,\n                    namespace=str(selection.delegation[\"git_artifact_namespace\"]),\n                    expected_parent_head=str(operation[\"expected_parent_head\"]),\n                    known_commit=operation[\"trial_commit\"],\n                    physical_identity=str(operation[\"physical_workspace_json\"]),\n                    reauthorize=reauthorize,\n                )\n                retained = retained or not removed\n            operation = await self._transition(\n                request,\n                selection,\n                operation_id,\n                str(operation[\"status\"]),\n                status=\"aborted\",\n                reason_code=\"owned_trial_retained\" if retained else \"aborted_by_user\",\n            )\n            terminal = True\n            return self._outcome(operation)\n        except (\n            ThreadGitOwnershipError,\n            GitError,\n            OSError,\n            ValueError,\n            KeyError,\n            TypeError,\n        ) as error:\n            raise HTTPException(\n                status_code=409, detail=\"Integration cleanup cannot establish safe ownership\"\n            ) from error\n        finally:\n            if terminal:\n                await lease.release()\n            else:\n                lease.close()\n\n    async def _execute(\n        self, request: Request, selection: IntegrationSelection, operation: dict[str, Any]\n    ) -> dict[str, Any]:\n        assert selection.result is not None\n        context = selection.context\n        if (\n            await self.workspaces.integration_workspace_identity(context)\n            != operation[\"physical_workspace_json\"]\n        ):\n            raise HTTPException(status_code=409, detail=\"Physical integration target changed\")\n\n        async def reauthorize() -> None:\n            def check(db: sqlite3.Connection) -> None:\n                db.execute(\"BEGIN IMMEDIATE\")\n                try:\n                    current = self._authorize_operation(\n                        db, request, selection, str(operation[\"id\"])\n                    )\n                    if current[\"status\"] != operation[\"status\"]:\n                        raise HTTPException(status_code=409, detail=\"Integration state changed\")\n                finally:\n                    db.rollback()\n\n            await run_db_operation_for_request(request, check)\n\n        try:\n            lease = await self.workspaces.acquire_workspace_admission(\n                repo_path=context.repo_path,\n                workspace_path=context.parent_workspace_path,\n                authority_hash=self._authority(request),\n                operation_id=str(operation[\"id\"]),\n                kind=\"integration\",\n                resume=True,\n            )\n        except WorkspaceAdmissionError as error:\n            raise HTTPException(status_code=409, detail=\"Workspace is busy\") from error\n        terminal = False\n        try:\n            operation = await run_db_operation_for_request(\n                request,\n                lambda db: self._authorize_operation(db, request, selection, str(operation[\"id\"])),\n            )\n            if operation[\"status\"] == \"checking\":\n                intent = await self.workspaces.plan_integration_trial(\n                    context, str(operation[\"id\"]), uuid.uuid4().hex, self._authority(request)\n                )\n                trials = json.loads(operation[\"trials_json\"])\n                if len(trials) >= 8:\n                    raise HTTPException(\n                        status_code=409, detail=\"Integration recovery attempts are exhausted\"\n                    )\n                trials.append(intent)\n                operation = await self._transition(\n                    request,\n                    selection,\n                    str(operation[\"id\"]),\n                    \"checking\",\n                    trials_json=json.dumps(trials, sort_keys=True),\n                )\n                trial = await self.workspaces.create_integration_trial(\n                    context,\n                    intent,\n                    expected_parent_head=str(operation[\"expected_parent_head\"]),\n                    result_commit=str(selection.result[\"result_commit\"]),\n                    database_identity=selection.database_identity,\n                    namespace=str(selection.delegation[\"git_artifact_namespace\"]),\n                    reauthorize=reauthorize,\n                    physical_identity=str(operation[\"physical_workspace_json\"]),\n                )\n                if trial[\"conflicts\"]:\n                    operation = await self._transition(\n                        request,\n                        selection,\n                        str(operation[\"id\"]),\n                        \"checking\",\n                        status=\"conflict\",\n                        reason_code=\"trial_conflict\",\n                        conflicts_json=json.dumps(trial[\"conflicts\"]),\n                    )\n                    terminal = True\n                    return self._outcome(operation)\n                operation = await self._transition(\n                    request,\n                    selection,\n                    str(operation[\"id\"]),\n                    \"checking\",\n                    status=\"applying\",\n                    trial_commit=trial[\"commit\"],\n                )\n            trials = json.loads(operation[\"trials_json\"])\n            if not trials or not operation[\"trial_commit\"]:\n                raise HTTPException(\n                    status_code=409, detail=\"Integration recovery facts are incomplete\"\n                )\n            try:\n                result = await self.workspaces.apply_integration_trial(\n                    context,\n                    trials[-1],\n                    database_identity=selection.database_identity,\n                    namespace=str(selection.delegation[\"git_artifact_namespace\"]),\n                    parent_branch=str(operation[\"expected_parent_branch\"]),\n                    expected_parent_head=str(operation[\"expected_parent_head\"]),\n                    trial_commit=str(operation[\"trial_commit\"]),\n                    owned_worktrees=selection.owned_worktrees,\n                    reauthorize=reauthorize,\n                    physical_identity=str(operation[\"physical_workspace_json\"]),\n                )\n            except ThreadIntegrationApplyAmbiguousError as error:\n                # The parent checkout is partially updated, so the outcome is\n                # unresolved. Keep exclusion and recovery facts, never claim a\n                # safe failure, and never release the marker here.\n                operation = await self._transition(\n                    request,\n                    selection,\n                    str(operation[\"id\"]),\n                    \"applying\",\n                    status=\"blocked\",\n                    reason_code=\"application_unresolved\",\n                )\n                raise HTTPException(\n                    status_code=409, detail=\"Integration application is unresolved\"\n                ) from error\n            except ThreadIntegrationApplyRefusedError as error:\n                # The parent refused application, so it stayed byte-identical.\n                # Record the durable refusal and reject without applying.\n                operation = await self._transition(\n                    request,\n                    selection,\n                    str(operation[\"id\"]),\n                    \"applying\",\n                    status=\"failed\",\n                    reason_code=\"parent_collision\",\n                )\n                terminal = True\n                raise HTTPException(\n                    status_code=409, detail=\"Integration parent refused application\"\n                ) from error\n            assert result is not None\n            operation = await self._transition(\n                request,\n                selection,\n                str(operation[\"id\"]),\n                \"applying\",\n                status=\"integrated\",\n                resulting_parent_head=result,\n                resulting_commits_json=json.dumps([result]),\n                reason_code=None,\n            )\n            terminal = True\n            return self._outcome(operation)\n        finally:\n            if terminal:\n                await lease.release()\n            else:\n                lease.close()\n\n    async def preview(self, request: Request, parent_id: str, child_id: str) -> dict[str, Any]:\n        selection = await run_db_operation_for_request(\n            request, lambda db: self._load(db, request, parent_id, child_id)\n        )\n        self._require_isolated_git()\n        result = selection.result\n\n        def load_operation(db: sqlite3.Connection) -> dict[str, Any] | None:\n            self._load(db, request, parent_id, child_id)\n            if result is None:\n                return None\n            row = db.execute(\n                \"SELECT id FROM thread_integrations WHERE parent_session_id = ? AND child_session_id = ? \"\n                \"AND result_id = ? AND authority_hash = ? ORDER BY created_at DESC, rowid DESC LIMIT 1\",\n                (parent_id, child_id, result[\"id\"], self._authority(request)),\n            ).fetchone()\n            return (\n                None\n                if row is None\n                else self._authorize_operation(db, request, selection, str(row[\"id\"]))\n            )\n\n        operation = await run_db_operation_for_request(request, load_operation)\n        response: dict[str, Any] = {\n            \"eligible\": False,\n            \"reason_code\": \"result_unavailable\",\n            \"result_id\": None if result is None else result[\"id\"],\n            \"expected_parent_head\": None,\n            \"parent_branch\": selection.parent_branch,\n            \"integration_id\": None if operation is None else operation[\"id\"],\n            \"child_title\": selection.delegation[\"title\"],\n            \"summary\": None if result is None else result[\"summary\"],\n        }\n        if operation is not None and operation[\"status\"] in {\n            \"checking\",\n            \"applying\",\n            \"blocked\",\n            \"integrated\",\n        }:\n            response[\"reason_code\"] = (\n                \"already_integrated\"\n                if operation[\"status\"] == \"integrated\"\n                else \"integration_pending\"\n            )\n            response[\"expected_parent_head\"] = operation[\"expected_parent_head\"]\n            return response\n        if result is None or selection.delegation[\"status\"] != \"completed\":\n            return response\n        if selection.delegation[\"base_kind\"] != \"head\":\n            response[\"reason_code\"] = \"snapshot_origin\"\n            return response\n        if selection.parent_busy:\n            response[\"reason_code\"] = \"parent_busy\"\n            return response\n        if (\n            selection.delegation[\"git_artifacts_claimed\"] != 1\n            or not selection.delegation[\"git_artifact_namespace\"]\n        ):\n            response[\"reason_code\"] = \"unowned_result\"\n            return response\n        try:\n            facts = await self.workspaces.preview_integration(\n                selection.context,\n                database_identity=selection.database_identity,\n                namespace=str(selection.delegation[\"git_artifact_namespace\"]),\n                parent_branch=selection.parent_branch,\n                base_commit=str(result[\"base_commit\"]),\n                result_commit=str(result[\"result_commit\"]),\n                result_ref=str(result[\"result_ref\"]),\n                owned_worktrees=selection.owned_worktrees,\n            )\n        except (ThreadGitOwnershipError, GitError, OSError, ValueError):\n            response[\"reason_code\"] = \"unsafe_git_storage\"\n            return response\n        response.update(facts)\n        return response\n"}],"isError":false,"timestamp":1789270341602}}
