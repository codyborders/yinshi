allation_id\"]:\n            refreshed_repo_count += 1\n\n    return refreshed_repo_count","newText":"async def relink_github_repos_for_tenant(\n    run_database_operation: DatabaseOperationRunner,\n    tenant: TenantContext,\n    owner_login: str,\n) -> int:\n    \"\"\"Refresh existing tenant repos after one GitHub App installation is connected.\"\"\"\n    if not owner_login:\n        raise ValueError(\"owner_login must not be empty\")\n    if isolation_setup_required():\n        logger.info(\"Deferring GitHub repository refresh while isolation is unsupported\")\n        return 0\n    repos = await run_database_operation(\n        lambda db: tuple(\n            dict(row)\n            for row in db.execute(\n                \"SELECT * FROM repos WHERE remote_url IS NOT NULL ORDER BY created_at ASC\"\n            ).fetchall()\n        )\n    )\n    refreshed_repo_count = 0\n    for repo in repos:\n        remote_url = repo[\"remote_url\"]\n        if not isinstance(remote_url, str) or not remote_url:\n            continue\n        github_remote = normalize_github_remote(remote_url)\n        if github_remote is None or github_remote.owner.lower() != owner_login.lower():\n            continue\n        refreshed_repo = await ensure_repo_checkout_for_tenant(\n            run_database_operation, tenant, str(repo[\"id\"])\n        )\n        if (\n            refreshed_repo[\"remote_url\"] != repo[\"remote_url\"]\n            or refreshed_repo[\"installation_id\"] != repo[\"installation_id\"]\n        ):\n            refreshed_repo_count += 1\n    return refreshed_repo_count"},{"oldText":"async def ensure_workspace_checkout_for_tenant(\n    db: sqlite3.Connection,\n    tenant: TenantContext,\n    workspace_id: str,\n) -> dict[str, Any]:\n    \"\"\"Repair the repo backing a workspace and return the updated workspace row.\"\"\"\n    workspace = _fetch_workspace(db, workspace_id)\n    repo_id = workspace[\"repo_id\"]\n    assert repo_id, \"workspace repo_id must not be empty\"\n\n    await ensure_repo_checkout_for_tenant(db, tenant, repo_id)\n    updated_workspace = _fetch_workspace(db, workspace_id)\n    return dict(updated_workspace)","newText":"async def ensure_workspace_checkout_for_tenant(\n    run_database_operation: DatabaseOperationRunner,\n    tenant: TenantContext,\n    workspace_id: str,\n) -> dict[str, Any]:\n    \"\"\"Repair the repo backing a workspace and return the updated workspace row.\"\"\"\n    workspace = await run_database_operation(\n        lambda db: dict(_fetch_workspace(db, workspace_id))\n    )\n    repo_id = str(workspace[\"repo_id\"])\n    assert repo_id, \"workspace repo_id must not be empty\"\n    await ensure_repo_checkout_for_tenant(run_database_operation, tenant, repo_id)\n    return await run_database_operation(\n        lambda db: dict(_fetch_workspace(db, workspace_id))\n    )"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":1995,"output":1104,"cacheRead":169600,"cacheWrite":0,"reasoning":86,"totalTokens":172699,"cost":{"input":0.009975000000000001,"output":0.033120000000000004,"cacheRead":0.0848,"cacheWrite":0,"total":0.127895}},"stopReason":"toolUse","timestamp":1789288132994,"responseId":"resp_0212e7de83dbbd32016aa65ec62f8487d0b55a5d9c7c027333","rawStopReason":"completed"}}
