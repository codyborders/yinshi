{"type":"message","id":"97aea5a0","parentId":"bc9cc1cb","timestamp":"2026-09-13T08:48:44.245Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_RssOphPdzNrFahc8ygCA0OON|fc_0212e7de83dbbd32016aa6636b3c4087d0a785b8b1d33f9555","name":"read","arguments":{"path":"backend/src/yinshi/services/workspace_execution.py","offset":1530,"limit":265}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":409,"output":34,"cacheRead":219008,"cacheWrite":0,"reasoning":0,"totalTokens":219451,"cost":{"input":0.0020450000000000004,"output":0.00102,"cacheRead":0.10950399999999999,"cacheWrite":0,"total":0.11256899999999999}},"stopReason":"toolUse","timestamp":1789289320396,"responseId":"resp_0212e7de83dbbd32016aa66369133487d08bc3bcb2f04ce9ff","rawStopReason":"completed"}}
{"type":"message","id":"f7535878","parentId":"97aea5a0","timestamp":"2026-09-13T08:48:44.272Z","message":{"role":"toolResult","toolCallId":"call_RssOphPdzNrFahc8ygCA0OON|fc_0212e7de83dbbd32016aa6636b3c4087d0a785b8b1d33f9555","toolName":"read","content":[{"type":"text","text":"    return cast(sqlite3.Row | None, row)\n\n\n@contextmanager\ndef use_execution_admission(admission: ExecutionAdmission) -> Iterator[None]:\n    token = _ACTIVE_ADMISSION.set(admission)\n    try:\n        yield\n    finally:\n        _ACTIVE_ADMISSION.reset(token)\n\n\nasync def _recover_pending_checkout_for_execution(\n    request: Request,\n    session_id: str,\n    selected: PromptWorkspace,\n    kind: str,\n) -> PromptWorkspace:\n    \"\"\"Recover original durable repair before creating another physical execution owner.\"\"\"\n    from yinshi.services.workspace import (\n        WorkspaceCheckoutPreparation,\n        WorkspaceCheckoutState,\n        apply_workspace_checkout_preparation,\n        load_workspace_checkout_state,\n    )\n    from yinshi.services.workspace_publication import (\n        WorkspaceCheckoutPublication,\n        publish_apply_workspace_checkout_for_tenant,\n    )\n\n    def inspect(database: sqlite3.Connection) -> sqlite3.Row | None:\n        return _pending_checkout_repair(database, request, session_id, selected)\n\n    pending = await run_db_operation_for_request(request, inspect)\n    try:\n        physical_identity = await read_workspace_identity(\n            repo_path=selected.repo_path,\n            workspace_path=selected.workspace_path,\n        )\n    except WorkspaceAdmissionError:\n        physical_identity = None\n    physical_missing = physical_identity is None\n    if pending is None and not physical_missing:\n        return selected\n    tenant = get_tenant(request)\n    if tenant is None:\n        raise WorkspaceAdmissionError()\n\n    def authorize(database: sqlite3.Connection) -> WorkspaceCheckoutState:\n        prompt_workspace(database, request, session_id)\n        return load_workspace_checkout_state(database, selected.workspace_id)\n\n    state = await run_db_operation_for_request(request, authorize)\n    source_lease: WorkspaceAdmissionLease | None = None\n    if (\n        pending is not None\n        and pending[1] is not None\n        and pending[3] == selected.repo_path\n        and pending[2] != selected.repo_path\n        and isinstance(pending[4], str)\n        and isinstance(pending[5], str)\n        and physical_identity == pending[5]\n    ):\n        source_lease = await ThreadWorkspaceService().acquire_workspace_admission(\n            repo_path=selected.repo_path,\n            workspace_path=selected.workspace_path,\n            authority_hash=selected.authority_hash,\n            operation_id=str(pending[1]),\n            kind=str(pending[4]),\n            resume=True,\n            physical_identity=physical_identity,\n        )\n    retained_publications: list[WorkspaceCheckoutPublication] = []\n\n    async def bind_recovered_publication(\n        publication: WorkspaceCheckoutPublication,\n    ) -> None:\n        retained_publications.append(publication)\n        if pending is None or pending[1] is None:\n            return\n        destination_path = dict(publication.preparation.workspace_paths).get(selected.workspace_id)\n        if destination_path is None:\n            raise WorkspaceAdmissionError()\n        destination = PromptWorkspace(\n            selected.database_identity,\n            selected.workspace_id,\n            selected.repo_id,\n            publication.preparation.repo_path,\n            destination_path,\n            selected.branch,\n            selected.authority_hash,\n        )\n        if _stable_selection(destination) != _stable_selection(selected):\n            raise WorkspaceAdmissionError()\n        lease = publication.selected_lease\n        if (\n            lease.owner.get(\"operation\") != str(pending[1])\n            or lease.owner.get(\"authority\") != selected.authority_hash\n        ):\n            raise WorkspaceAdmissionError()\n\n        def bind(database: sqlite3.Connection) -> None:\n            database.execute(\"BEGIN IMMEDIATE\")\n            try:\n                authorize(database)\n                repair = database.execute(\n                    \"SELECT execution_operation_id, state FROM workspace_checkout_repairs \"\n                    \"WHERE operation_id = ?\",\n                    (str(pending[0]),),\n                ).fetchone()\n                if repair is None or tuple(repair) not in {\n                    (str(pending[1]), \"active\"),\n                    (str(pending[1]), \"published\"),\n                    (str(pending[1]), \"unresolved\"),\n                }:\n                    raise WorkspaceAdmissionError()\n                expected = (\n                    \"destination\",\n                    \"held\",\n                    destination.repo_path,\n                    destination.workspace_path,\n                    publication.selected_identity,\n                    str(lease.common),\n                    lease.key,\n                )\n                target = database.execute(\n                    \"SELECT role, state, repo_path, workspace_path, physical_workspace_json, \"\n                    \"marker_directory, marker_key FROM workspace_execution_targets \"\n                    \"WHERE operation_id = ? AND generation = 1\",\n                    (str(pending[1]),),\n                ).fetchone()\n                if target is None:\n                    database.execute(\n                        \"INSERT INTO workspace_execution_targets \"\n                        \"(operation_id, generation, role, state, repo_path, workspace_path, \"\n                        \"physical_workspace_json, marker_directory, marker_key) \"\n                        \"VALUES (?, 1, 'destination', 'held', ?, ?, ?, ?, ?)\",\n                        (\n                            str(pending[1]),\n                            destination.repo_path,\n                            destination.workspace_path,\n                            publication.selected_identity,\n                            str(lease.common),\n                            lease.key,\n                        ),\n                    )\n                elif tuple(target) != expected:\n                    raise WorkspaceAdmissionError()\n                changed = database.execute(\n                    \"UPDATE workspace_execution_receipts SET physical_workspace_json = ?, \"\n                    \"updated_at = CURRENT_TIMESTAMP WHERE operation_id = ? \"\n                    \"AND physical_workspace_json = ?\",\n                    (\n                        publication.selected_identity,\n                        str(pending[1]),\n                        str(pending[5]),\n                    ),\n                )\n                if changed.rowcount != 1:\n                    receipt = database.execute(\n                        \"SELECT physical_workspace_json FROM workspace_execution_receipts \"\n                        \"WHERE operation_id = ?\",\n                        (str(pending[1]),),\n                    ).fetchone()\n                    if receipt is None or receipt[0] != publication.selected_identity:\n                        raise WorkspaceAdmissionError()\n                database.commit()\n            except BaseException:\n                database.rollback()\n                raise\n\n        await run_db_operation_for_request(request, bind)\n\n    def apply(database: sqlite3.Connection, preparation: WorkspaceCheckoutPreparation) -> None:\n        authorize(database)\n        apply_workspace_checkout_preparation(database, preparation)\n\n    try:\n        await publish_apply_workspace_checkout_for_tenant(\n            tenant,\n            state,\n            run_database_operation=lambda operation: run_db_operation_for_request(\n                request, operation\n            ),\n            authorize=authorize,\n            authority_hash=selected.authority_hash,\n            database_identity=selected.database_identity,\n            execution_operation_id=None if pending is None else pending[1],\n            marker_kind=(\n                kind if pending is None or not isinstance(pending[4], str) else str(pending[4])\n            ),\n            bind_published=bind_recovered_publication if pending is not None else None,\n            apply=apply,\n        )\n        if pending is not None and not retained_publications:\n            raise WorkspaceAdmissionError()\n    except BaseException:\n        for publication in retained_publications:\n            publication.selected_lease.close()\n        if source_lease is not None:\n            source_lease.close()\n        raise\n    for publication in retained_publications:\n        publication.selected_lease.close()\n    if source_lease is not None:\n        source_lease.close()\n    if pending is not None and pending[1] is not None and isinstance(pending[6], str):\n        recovery = await recover_workspace_execution(\n            request,\n            str(pending[6]),\n            {\"operation_id\": str(pending[1]), \"confirmed\": True},\n        )\n        if not recovery.get(\"physical_released\", True):\n            raise WorkspaceAdmissionError()\n    return await run_db_operation_for_request(\n        request, lambda database: prompt_workspace(database, request, session_id)\n    )\n\n\nasync def _repository_deletion_preflight(request: Request, repo_id: str) -> None:\n    \"\"\"Reject deletion-owned repositories before checkout or Git effects.\"\"\"\n    lock_root = await run_db_operation_for_request(\n        request,\n        lambda db: repository_lifecycle_root(db, get_tenant(request)),\n    )\n    async with repository_lifecycle(repo_id, lock_root):\n        try:\n            await run_db_operation_for_request(\n                request, lambda db: require_no_repository_deletion(db, repo_id)\n            )\n        except RepositoryDeletionPendingError as error:\n            raise WorkspaceAdmissionError() from error\n\n\nasync def acquire_prompt_workspace(\n    request: Request, session_id: str, operation_id: str, *, kind: str\n) -> ExecutionAdmission:\n    \"\"\"Publish physical exclusion, then reauthorize before any checkout or provider work.\"\"\"\n    # Fail-closed isolation gate: no admission marker, Git work, credential\n    # resolution, or provider access may run before the profile is verified.\n    require_isolated_execution(kind)\n    selected = await run_db_operation_for_request(\n        request, lambda db: prompt_workspace(db, request, session_id)\n    )\n    await _repository_deletion_preflight(request, selected.repo_id)\n    selected = await _recover_pending_checkout_for_execution(request, session_id, selected, kind)\n    physical = await read_workspace_identity(\n        repo_path=selected.repo_path, workspace_path=selected.workspace_path\n    )\n    await _retry_stopped_receipts(request, selected, physical)\n    admission = ExecutionAdmission(\n        None, selected, request, session_id, operation_id, physical, kind\n    )\n    await admission.reserve()\n\n    def confirm(db: sqlite3.Connection) -> None:\n        db.execute(\"BEGIN IMMEDIATE\")\n        try:\n            admission.authorize(db)\n            row = db.execute(\n                \"SELECT selection_hash, physical_workspace_json, kind, status FROM workspace_execution_receipts WHERE operation_id = ?\",\n                (operation_id,),\n            ).fetchone()\n            if row is None or tuple(row) != (selected.identity_hash(), physical, kind, \"reserved\"):\n                raise WorkspaceAdmissionError()\n\n[33 more lines in file. Use offset=1795 to continue.]"}],"isError":false,"timestamp":1789289324272}}
