{"type":"message","id":"8cb4a847","parentId":"a2c5f203","timestamp":"2026-09-13T04:30:46.730Z","message":{"role":"toolResult","toolCallId":"call_v5J3W0zPilrEyhoKBgusTfwE|fc_0212e7de83dbbd32016aa626f4f28087d0bd080b53ba9cbab5","toolName":"read","content":[{"type":"text","text":"        \"CREATE INDEX IF NOT EXISTS idx_workspace_checkout_publications_state \"\n        \"ON workspace_checkout_publications(operation_id, state)\"\n    )\n\n\ndef migrate_repository_deletion_schema(conn: sqlite3.Connection) -> None:\n    \"\"\"Persist repository deletion ownership beyond repository row removal.\"\"\"\n    conn.execute(\n        \"CREATE TABLE IF NOT EXISTS repository_deletions (\"\n        \"operation_id TEXT PRIMARY KEY CHECK (length(operation_id) = 32 \"\n        \"AND operation_id NOT GLOB '*[^0-9a-f]*'), \"\n        \"repo_id TEXT NOT NULL, repo_root TEXT NOT NULL, \"\n        \"database_identity TEXT NOT NULL, principal_authority TEXT NOT NULL, \"\n        \"principal_identity_json TEXT NOT NULL, entries_json TEXT NOT NULL, \"\n        \"git_cleanup_path TEXT NOT NULL, \"\n        \"git_worktrees_json TEXT NOT NULL, \"\n        \"phase TEXT NOT NULL CHECK (phase IN \"\n        \"('prepared', 'quarantined', 'delete_committed')), \"\n        \"created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, \"\n        \"updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)\"\n    )\n    columns = {\n        str(row[1]) for row in conn.execute(\"PRAGMA table_info(repository_deletions)\").fetchall()\n    }\n    if \"principal_identity_json\" not in columns:\n        conn.execute(\n            \"ALTER TABLE repository_deletions \"\n            \"ADD COLUMN principal_identity_json TEXT NOT NULL DEFAULT 'null'\"\n        )\n    conn.execute(\n        \"CREATE INDEX IF NOT EXISTS idx_repository_deletions_repo \"\n        \"ON repository_deletions(repo_id)\"\n    )\n\n\ndef migrate_thread_agent_schema(conn: sqlite3.Connection) -> None:\n    \"\"\"Preserve manual queues and immutable tool report receipts during upgrades.\"\"\"\n    conn.execute(\n        \"CREATE TABLE IF NOT EXISTS thread_report_calls (\"\n        \"run_id TEXT NOT NULL REFERENCES prompt_runs(id) ON DELETE CASCADE, \"\n        \"tool_call_id TEXT NOT NULL CHECK (length(tool_call_id) BETWEEN 1 AND 256), \"\n        \"delegation_id TEXT NOT NULL REFERENCES thread_delegations(id) ON DELETE CASCADE, \"\n        \"payload_json TEXT NOT NULL, version INTEGER NOT NULL CHECK (version > 0), \"\n        \"PRIMARY KEY (run_id, tool_call_id))\"\n    )\n\n[1185 more lines in file. Use offset=955 to continue.]"}],"isError":false,"timestamp":1789273846730}}
