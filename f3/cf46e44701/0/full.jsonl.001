       reconciliation = asyncio.create_task(\n            run_database_operation(\n                lambda database: _workspace_admission_matches(\n                    database,\n                    repo_id=repo_id,\n                    branch=branch,\n                    path=worktree_dir,\n                )\n            )\n        )\n        admitted = False\n        admission_unknown = False\n        while not reconciliation.done():\n            try:\n                admitted = await asyncio.shield(reconciliation)\n            except asyncio.CancelledError:\n                continue\n            except BaseException:  # noqa: BLE001 - uncertainty forbids cleanup\n                admission_unknown = True\n                break\n        if reconciliation.done() and not reconciliation.cancelled():\n            try:\n                admitted = reconciliation.result()\n            except BaseException:  # noqa: BLE001 - uncertainty forbids cleanup\n                admission_unknown = True\n        if not admitted and not admission_unknown:\n            await _settle_unadmitted_worktree(\n                run_database_operation,\n                repo_id=repo_id,\n                repo_path=repo_path,\n                worktree_path=worktree_dir,\n                name=name,\n                branch=branch,\n            )\n        raise\n"}]}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":1040,"output":913,"cacheRead":65536,"cacheWrite":0,"reasoning":328,"totalTokens":67489,"cost":{"input":0.005200000000000001,"output":0.02739,"cacheRead":0.032768,"cacheWrite":0,"total":0.065358}},"stopReason":"toolUse","timestamp":1789293466451,"responseId":"resp_0212e7de83dbbd32016aa6739adce087d0913b6f344e1cdc6c","rawStopReason":"completed"}}
