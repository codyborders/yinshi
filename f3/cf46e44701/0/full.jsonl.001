t.py"},{"text":"read backend/src/yinshi/services/broker_protocol.py","expandedText":"read backend/src/yinshi/services/broker_protocol.py"},{"text":"read backend/src/yinshi/broker_stdio_relay.py","expandedText":"read backend/src/yinshi/broker_stdio_relay.py"},{"text":"read backend/src/yinshi/services/broker_replica_lifecycle.py","expandedText":"read backend/src/yinshi/services/broker_replica_lifecycle.py"},{"text":"read backend/tests/test_broker_replica_lifecycle.py","expandedText":"read backend/tests/test_broker_replica_lifecycle.py"},{"text":"$ python3 - <<'PY'\nimport ast, pathlib\nfor f in ['backend/src/...","expandedText":"$ python3 - <<'PY'\nimport ast, pathlib\nfor f in ['backend/src/yinshi/services/broker_replica_journal.py','backend/src/yinshi/services/broker_artifact_store.py','backend/src/yinshi/services/workspace_replica_publication.py','backend/src/yinshi..."},{"text":"read backend/src/yinshi/services/broker_replica_journal.py","expandedText":"read backend/src/yinshi/services/broker_replica_journal.py"},{"text":"grep {\"path\":\"backend/tests/test_broker_repli...","expandedText":"grep {\"path\":\"backend/tests/test_broker_replica_journal.py\",\"pattern\":\"^def test_|^async def test_\",\"ignoreCase\":false,\"context\":0,\"limit\":300}"},{"text":"read backend/src/yinshi/services/broker_artifact_store.py","expandedText":"read backend/src/yinshi/services/broker_artifact_store.py"},{"text":"grep {\"path\":\"backend/tests/test_broker_artif...","expandedText":"grep {\"path\":\"backend/tests/test_broker_artifact_store.py\",\"pattern\":\"^def test_|^async def test_\",\"ignoreCase\":false,\"context\":0,\"limit\":200}"},{"text":"grep {\"path\":\"backend\",\"pattern\":\"BrokerRepli...","expandedText":"grep {\"path\":\"backend\",\"pattern\":\"BrokerReplicaLifecycleCoordinator|ReplicaLifecycleEffects|BrokerArtifactStore|WorkspaceReplicaPublicationStore\",\"glob\":\"**/*.py\",\"i..."},{"text":"grep {\"path\":\"backend\",\"pattern\":\"broker_stdi...","expandedText":"grep {\"path\":\"backend\",\"pattern\":\"broker_stdio_relay|yinshi-broker-stdio-relay\",\"glob\":\"**/*\",\"ignoreCase\":false,\"context\":2,\"limit\":200}"},{"text":"read backend/src/yinshi/services/execution_broker.py","expandedText":"read backend/src/yinshi/services/execution_broker.py"},{"text":"read backend/src/yinshi/services/broker_runtime.py","expandedText":"read backend/src/yinshi/services/broker_runtime.py"},{"text":"read backend/src/yinshi/execution_daemons.py","expandedText":"read backend/src/yinshi/execution_daemons.py"},{"text":"$ python3 - <<'PY'\nimport json\nfor p in ['.pi-subagents/missio...","expandedText":"$ python3 - <<'PY'\nimport json\nfor p in ['.pi-subagents/missions/26941e53-e8a4-440c-b48c-87e68c2ecd96.json','.pi-subagents/missions/1ddc3600-5633-4f2b-add2-60c692b5.json']:\n try:\n  d=json.load(open(p)); print('\\n##',p); print(d.get('summary',..."},{"text":"$ find /tmp -maxdepth 1 -type f \\( -iname '*phase6*' -o -iname...","expandedText":"$ find /tmp -maxdepth 1 -type f \\( -iname '*phase6*' -o -iname '*replica*' -o -iname '*transport*' \\) -print | sort | tail -100"},{"text":"find {\"path\":\"desktop\",\"pattern\":\"**/*\",\"limi...","expandedText":"find {\"path\":\"desktop\",\"pattern\":\"**/*\",\"limit\":500}"},{"text":"grep {\"path\":\"desktop\",\"pattern\":\"ssh|broker|...","expandedText":"grep {\"path\":\"desktop\",\"pattern\":\"ssh|broker|replica|artifact|VM|vm\",\"glob\":\"**/*.{ts,tsx,js,mjs,json,plist,swift,md}\",\"ignoreCase\":true,\"context\":2,\"limit\":300}"},{"text":"grep {\"path\":\"backend/src\",\"pattern\":\"workspa...","expandedText":"grep {\"path\":\"backend/src\",\"pattern\":\"workspace_replica\",\"glob\":\"**/*.py\",\"ignoreCase\":false,\"context\":2,\"limit\":300}"},{"text":"$ python3 - <<'PY'\nimport json,re\np='.pi-subagents/missions/26...","expandedText":"$ python3 - <<'PY'\nimport json,re\np='.pi-subagents/missions/26941e53-e8a4-440c-b48c-87e68c2ecd96.json'\nd=json.load(open(p)); s=d['summary']\ntry:\n j=json.loads(s[s.index('{'):])\n print(j['output'])\nexcept Exception as e:\n print('parse failed',..."},{"text":"read .pi-subagents/missions/26941e53-e8a4-440c-b48c-87e68c2ecd96.json","expandedText":"read .pi-subagents/missions/26941e53-e8a4-440c-b48c-87e68c2ecd96.json"},{"text":"read .pi-subagents/artifacts/44151b43_worker-expert_0_output.md","expandedText":"read .pi-subagents/artifacts/44151b43_worker-expert_0_output.md"},{"text":"$ git show --format=fuller --stat 7f91105f -- && printf '\\n---...","expandedText":"$ git show --format=fuller --stat 7f91105f -- && printf '\\n---\\n' && git show --format=fuller --stat 922f197b -- && printf '\\nNAMES\\n' && git diff-tree --no-commit-id --name-status -r 7f91105f && git diff-tree --no-commit-id --name-status -r ..."},{"text":"$ git status --short | sed -n '1,200p'","expandedText":"$ git status --short | sed -n '1,200p'"},{"text":"$ git diff --name-status -- backend/src/yinshi/services backen...","expandedText":"$ git diff --name-status -- backend/src/yinshi/services backend/src/yinshi desktop deploy docs .github backend/tests | sed -n '1,250p'"},{"text":"$ git diff -- backend/src/yinshi/services/broker_protocol.py b...","expandedText":"$ git diff -- backend/src/yinshi/services/broker_protocol.py backend/src/yinshi/services/execution_broker.py backend/src/yinshi/services/broker_runtime.py backend/src/yinshi/execution_daemons.py backend/src/yinshi/root_launcher.py | git diff ..."},{"text":"read docs/workspace-isolation.md","expandedText":"read docs/workspace-isolation.md"},{"text":"read docs/workspace-os-isolation.md","expandedText":"read docs/workspace-os-isolation.md"}]}],"totalChildUsage":{"input":266768,"output":21072,"cacheRead":698368,"cacheWrite":0,"cost":2.315184,"turns":14},"totalCost":{"inputTokens":266768,"outputTokens":21072,"costUsd":2.315184},"usageBudget":{"version":1,"source":"reported","tokens":{"hard":120000,"used":287840,"outcome":"hard-exceeded"},"exhausted":true,"reason":"tokens"},"workflow":{"value":{"key":"remaining_phase6_plan","ok":true,"runId":"d856fe34","output":"# Remaining Phase 6 production wiring plan\n\n## 1. Scope and requested observable result\n\nPhase 6 should provide this observable path:\n\n1. Desktop captures three replica artifacts.\n2. Desktop signs one strict `replica.lifecycle` request.\n3. Desktop streams request plus three artifacts through a fixed SSH command.\n4. Broker authenticates request before reading artifact bytes.\n5. Broker journals and executes seven ordered stages.\n6. Broker returns an Ed25519-authenticated response.\n7. Desktop verifies response before reporting success.\n8. Broker resumes incomplete operations after restart.\n9. Native Darwin execution remains unavailable.\n10. Linux execution remains unavailable until qualification passes.\n11. Root prepare, launch, and reclaim gates remain separately disabled by default.\n\nRequired artifact stream order is fixed:\n\n1. `committed.bundle`\n2. `worktree.yra`\n3. `index-objects.pack`\n\nNo artifact identifier becomes a filesystem path.\n\n## 2. Established current behavior\n\n### Foundation state\n\n- Commit `7f91105f` added authenticated artifact contracts, storage, publication, and the append-only replica journal.\n- Commit `922f197b` added `BrokerReplicaLifecycleCoordinator` and its seven-stage effect contract.\n- Evidence: `git show --format=fuller --stat 7f91105f` and the equivalent `922f197b` command.\n\n### Control plane\n\n- `backend/src/yinshi/services/broker_protocol.py` authenticates requests and responses with Ed25519.\n- Request frames are limited to 65,536 bytes.\n- `BrokerRequest` contains authenticated parsed data. Exact raw frame bytes remain separately available.\n- `backend/src/yinshi/services/execution_broker.py` currently handles only `executor.launch`.\n- No production caller instantiates `BrokerReplicaLifecycleCoordinator`.\n- Evidence: repository search for `BrokerReplicaLifecycleCoordinator`, `ReplicaLifecycleEffects`, and `replica.lifecycle`.\n\n### Existing relay\n\n- `backend/src/yinshi/broker_stdio_relay.py` accepts one bounded frame.\n- Relay connects only to `/run/yinshi/broker.sock`.\n- Relay accepts no caller-selected socket or CLI option.\n- Relay buffers the complete control frame, then requires EOF.\n- It cannot safely carry artifact bodies approaching the configured one-GiB aggregate limit.\n- Existing behavior has focused coverage in `backend/tests/test_broker_stdio_relay.py`.\n\n### Existing artifact support\n\n- `BrokerArtifactStore.receive()` already streams fixed-role files into broker-owned private storage.\n- It hashes content incrementally and enforces role plus aggregate limits.\n- It publishes incoming sets without replacement.\n- It returns reference-only `IngestReceipt` values.\n- `BrokerArtifactStore.open_incoming()` pins files through descriptors.\n- `BrokerArtifactStore.reconcile_attempts()` classifies retained incoming state.\n- Evidence: `backend/src/yinshi/services/broker_artifact_store.py` and `backend/tests/test_broker_artifact_store.py`.\n\n### Existing publication support\n\n- `WorkspaceReplicaPublicationStore` validates and atomically publishes exact-three artifact sets.\n- Production-facing publication still accepts three complete `bytes` values.\n- Verification paths retain or reconstruct complete file contents.\n- This can amplify memory usage several times near maximum limits.\n- Published layout contains artifact files plus `artifact-set.json`.\n- Root prepare instead requires one staging directory containing exactly `repo/` and `home/`.\n- Evidence: `backend/src/yinshi/services/workspace_replica_publication.py` and `backend/src/yinshi/root_launcher.py`.\n\n### Existing lifecycle coordinator\n\n- `BrokerReplicaLifecycleCoordinator` orders ingest, verify, publish, admission, drain, export, and reclaim.\n- `ReplicaLifecycleEffects` supplies one effect and reconciliation implementation per stage.\n- Journal calls occur outside awaited effects.\n- Unknown outcomes remain tied to the active stage.\n- `BrokerReplicaJournal.incomplete_lifecycles()` exposes restart work.\n- Existing tests use synthetic effects only.\n- Evidence: `backend/src/yinshi/services/broker_replica_lifecycle.py` and `backend/tests/test_broker_replica_lifecycle.py`.\n\n### Isolation and root boundaries\n\n- Native Darwin execution fails closed in `backend/src/yinshi/services/workspace_isolation.py`.\n- `desktop/src/localRuntime.ts` also blocks the untrusted local sidecar on unsupported profiles.\n- Linux currently returns `isolation_unverified`.\n- Root protocol accepts only `prepare`, `launch`, and `reclaim`.\n- `resolve_execution_gate()`, `resolve_prepare_gate()`, and `resolve_reclaim_gate()` are separate.\n- Existing deployment documentation states that production isolation remains incomplete.\n- Evidence: `docs/workspace-isolation.md`, `docs/workspace-os-isolation.md`, and `backend/src/yinshi/execution_daemons.py`.\n\n### Desktop gap\n\n- Desktop source contains no replica request signer, artifact uploader, broker response verifier, or VM lifecycle transport.\n- Existing SSH handling only forwards `SSH_AUTH_SOCK` into local runtime configuration.\n- Evidence: search of `desktop/src` for `broker`, `replica`, `artifact`, `ssh`, and `VM`.\n\n## 3. Constraints\n\nThese constraints are fixed for implementation:\n\n- No SQLite connection may cross `await` or any external effect.\n- Artifact bytes remain outside SQLite.\n- Artifact order and filenames remain exact.\n- Root actions remain `prepare`, `launch`, and `reclaim`.\n- No root stop action may be added.\n- Reclaim requires a drain acknowledgment and a dead runtime.\n- Unknown results remain unresolved under their original stage.\n- Executor identities come from protected configuration, never requests.\n- Requests and responses require Ed25519 authentication.\n- Coordinator receives authenticated `BrokerRequest` plus exact raw request frame.\n- Artifact IDs remain logical identifiers, never path components.\n- Existing control relay behavior remains compatible.\n- All root gates remain independently disabled unless explicitly enabled.\n\n## 4. Recommended transport and ownership design\n\nThis design needs parent approval before implementation.\n\n### 4.1 Transport choice\n\nAdd a second fixed SSH forced command named:\n\n```text\nyinshi-broker-artifact-upload\n```\n\nKeep `yinshi-broker-stdio-relay` unchanged.\n\nBoth commands connect only to:\n\n```text\n/run/yinshi/broker.sock\n```\n\nThe upload framing is:\n\n```text\nu32be request_frame_length\nexact signed BrokerRequest frame\ncommitted.bundle bytes using signed length\nworktree.yra bytes using signed length\nindex-objects.pack bytes using signed length\nEOF\n```\n\nResponse framing remains:\n\n```text\nu32be response_frame_length\nexact signed BrokerResponse frame\nEOF\n```\n\nNo role names, paths, chunk offsets, or caller-selected commands appear in the body.\n\nSigned metadata binds each role to:\n\n- Artifact ID\n- SHA-256 digest\n- Byte length\n\nSigned request also binds operation identity, sequence, nonce, object format, source state, fingerprint, and artifact-set digest.\n\nWhole-file signatures are unnecessary. Signed lengths, fixed order, and signed SHA-256 values bind every streamed byte.\n\n### 4.2 Backpressure and limits\n\nEvery hop uses a fixed 64-KiB copy buffer.\n\n- Desktop waits for child-process stream backpressure.\n- Upload relay calls `drain()` after each broker-socket write.\n- Broker reads exactly each signed length.\n- Broker rejects truncation or one trailing byte.\n- Broker applies independent role and aggregate limits before body acceptance.\n- Broker uses idle deadlines plus an operator-approved absolute deadline.\n- Existing 120-second control-connection deadline must not govern large uploads.\n- Concurrency and disk reservations must be bounded before accepting a body.\n\n### 4.3 Retry handling\n\n`BrokerReplicaService` owns one operation lock and one connection-scoped transfer session.\n\nFor a new request:\n\n1. Coordinator accepts and claims the exact raw frame.\n2. Coordinator records ingest intent.\n3. Connection-bound ingest effect calls `BrokerArtifactStore.receive()`.\n4. Response waits until exact EOF has been checked.\n\nFor an exact replay after ingest:\n\n1. Service confirms journal frame identity.\n2. `BrokerArtifactStore.receive()` consumes the duplicate body.\n3. Existing immutable incoming state is inspected and reused.\n4. Coordinator resumes from its durable journal position.\n5. No existing artifact is overwritten.\n\nThis retains intent-before-effect ordering for new operations.\n\nA transport error never becomes a successful stage result. Desktop retries only the same signed frame or creates a new operation.\n\n### 4.4 Ownership\n\n| Mutable or durable value | Owner |\n|---|---|\n| Desktop signing private key | Desktop credential store |\n| Broker response public key pin | Desktop release configuration |\n| Client authorization keys | Root-protected broker configuration |\n| Exact signed request and stage history | `BrokerReplicaJournal` |\n| Connection reader and consumed-byte count | Connection-scoped upload session |\n| Partial incoming directory | `BrokerArtifactStore` |\n| Immutable incoming files | `BrokerArtifactStore` |\n| Semantic verification receipt | `BrokerReplicaJournal` |\n| Published artifact set | `WorkspaceReplicaPublicationStore` |\n| Materialization pending directory | Broker materializer |\n| Prepared `repo/` and `home/` | Root launcher, then fixed executor |\n| Runtime admission and liveness observations | Broker runtime service |\n| Quiesced runtime state | Executor runtime |\n| Exported artifact bytes | Broker artifact store |\n| Export receipt references | `BrokerReplicaJournal` |\n| Reclaim quarantine and deletion | Root launcher |\n\nSQLite owns references and authenticated receipts only. Filesystems own artifact and replica bytes.\n\n## 5. Implementation milestones\n\n### Milestone 0: approve unresolved contracts\n\nNo writer should change persisted framing before this milestone completes.\n\n#### Decisions required\n\n- Approve separate fixed upload command versus extending the existing relay.\n- Approve artifact-set digest version and canonical projection.\n- Approve client key enrollment, rotation, revocation, and tenant authorization.\n- Approve upload quotas, concurrency, deadlines, and quarantine retention.\n- Approve supported Linux image, kernel, init system, and VM provider.\n- Approve source capture policy on Darwin.\n- Approve exact event that begins drain.\n- Approve export namespace and lifecycle ownership.\n- Approve verifier privilege separation.\n\n#### Completion check\n\nRecord decisions in an ADR under `docs/`. Include protocol version, owners, limits, and compatibility policy.\n\n### Milestone 1: freeze cross-language wire contract\n\n#### Affected paths\n\n- `backend/src/yinshi/services/replica_artifact_contract.py`\n- `backend/src/yinshi/services/broker_protocol.py`\n- `backend/tests/test_broker_replica_journal.py`\n- New `backend/tests/test_broker_replica_wire_vectors.py`\n- New `desktop/src/replicaRequest.ts`\n- New `desktop/src/replicaRequest.test.ts`\n- `docs/broker-root-launcher.md`\n\n#### Work\n\n- Define one versioned canonical artifact-set projection.\n- Reuse exact role names and fixed ordering from `replica_artifact_contract.py`.\n- Require three distinct artifact IDs.\n- Reject unknown, missing, duplicated, null, or reordered declarations.\n- Publish request and response golden vectors.\n- Include Ed25519 valid, invalid, and wrong-incarnation vectors.\n- Make TypeScript reproduce canonical bytes exactly.\n- Keep raw signed frame separate from parsed `BrokerRequest`.\n\nDo not silently reinterpret existing `artifact_set_sha256` rows.\n\n#### Completion behavior\n\nPython and TypeScript produce identical bytes, digests, signatures, and verification results.\n\n#### Focused checks\n\n```bash\ncd backend && uv run pytest tests/test_broker_replica_wire_vectors.py tests/test_broker_replica_journal.py\ncd desktop && npm test -- replicaRequest.test.ts\n```\n\nExisting coverage is not enough. No cross-language vector test exists.\n\n### Milestone 2: add streaming relay and authenticated broker dispatch\n\n#### Affected paths\n\n- New `backend/src/yinshi/broker_artifact_stdio_relay.py`\n- `backend/src/yinshi/execution_daemons.py`\n- `backend/src/yinshi/services/execution_broker.py`\n- New `backend/src/yinshi/services/broker_replica_service.py`\n- `backend/pyproject.toml`\n- New `backend/tests/test_broker_artifact_stdio_relay.py`\n- `backend/tests/test_execution_daemons.py`\n- `backend/tests/test_broker_foundation.py`\n- `backend/tests/test_broker_stdio_relay.py`\n\n#### Work\n\n- Add no-argument `yinshi-broker-artifact-upload` entry point.\n- Preserve existing control relay byte-for-byte behavior.\n- Split `_read_frame` into initial-frame reading and optional EOF enforcement.\n- Authenticate request before reading any artifact body.\n- Dispatch exact authenticated action values.\n- Route `executor.launch` to existing service and require immediate EOF.\n- Route `replica.lifecycle` to `BrokerReplicaService`.\n- Pass authenticated `BrokerRequest`, exact frame bytes, and body reader.\n- Reject unknown actions without reading a body.\n- Return only coordinator-produced signed responses.\n- Log stable error codes without request, artifact, path, or key material.\n\nDo not add a pass-through router class unless it owns authentication and framing complexity.\n\n#### Failure behavior\n\n- Invalid frame or signature: close without a success response.\n- Valid request with invalid limits: signed rejection before body read.\n- Truncation: ingest-stage rejection when outcome is conclusive.\n- Timeout or socket uncertainty: ingest-stage unresolved.\n- Trailing bytes: rejection before any signed success.\n- Response-write uncertainty: retain journal result for exact replay.\n\n#### Completion behavior\n\nOne broker socket supports bounded controls and streamed replica requests without ambiguity.\n\n#### Focused checks\n\nTests must prove:\n\n- Authentication happens before first artifact read.\n- Dispatcher passes the exact raw frame.\n- Existing control relay still requires EOF.\n- Upload relay never accepts a socket or command argument.\n- Partial writes propagate backpressure.\n- Cancellation closes both streams promptly.\n- One trailing byte fails.\n- A valid signed response is never emitted before request EOF.\n\n### Milestone 3: wire concrete ingest, verification, and publication effects\n\n#### Affected paths\n\n- `backend/src/yinshi/services/broker_replica_service.py`\n- `backend/src/yinshi/services/broker_artifact_store.py`\n- `backend/src/yinshi/services/workspace_replica_publication.py`\n- `backend/src/yinshi/services/workspace_replica_bundle.py`\n- `backend/src/yinshi/services/workspace_replica_object_pack.py`\n- `backend/src/yinshi/services/workspace_replica_artifact.py`\n- `backend/src/yinshi/services/git.py`\n- New `backend/tests/test_broker_replica_service.py`\n- Existing artifact, bundle, object-pack, publication, journal, and lifecycle tests\n\n#### Ingest effect\n\n- Convert authenticated payload into `ReplicaArtifactManifest`.\n- Recompute artifact-set digest before reading bytes.\n- Call `BrokerArtifactStore.receive()`.\n- Return existing reference-only `IngestReceipt`.\n- Never pass a SQLite object into the effect.\n- Retain partial or ambiguous state for recovery.\n\n#### Verification effect\n\nAdd descriptor-based APIs:\n\n```python\nverify_committed_bundle_file(...)\nverify_index_object_pack_file(...)\ninspect_worktree_artifact_file(...)\n```\n\nRequirements:\n\n- Consume pinned read-only descriptors.\n- Hash with bounded `pread` loops.\n- Use descriptor-backed Git input.\n- Avoid joining complete files into memory.\n- Recheck inode, mode, length, link count, and digest afterward.\n- Run Git with scrubbed configuration and no broker credentials.\n- Return deterministic semantic receipt data.\n\n#### Publication effect\n\nAdd a descriptor-based production API to `WorkspaceReplicaPublicationStore`.\n\nIt must:\n\n1. Accept pinned incoming descriptors.\n2. Require the matching verification receipt.\n3. Write bounded `artifact-set.json`.\n4. Preserve exact filenames.\n5. Publish without replacement.\n6. Synchronize files plus both directory parents.\n7. Inspect final state before returning.\n8. Return `ReplicaPublicationReceipt`.\n\nKeep the current bytes API only if compatibility policy approves it. Mark it non-production.\n\n#### State transitions\n\n```text\naccepted\n-> claimed\n-> ingest_started\n-> ingested\n-> verify_started\n-> verified\n-> publish_started\n-> published\n```\n\nEach completion follows durable external inspection. Commit uncertainty uses existing exact-row reconciliation.\n\n#### Completion behavior\n\nA valid stream becomes one verified immutable publication without whole-set memory retention.\n\n#### Focused checks\n\nAdd assertions for:\n\n- Near-limit streaming with bounded process memory.\n- Descriptor replacement during verification.\n- Git verifier timeout and cancellation.\n- Publication rename uncertainty.\n- Exact replay after lost response.\n- No artifact sentinel appears in journal SQLite files.\n- Every unknown uses the journal’s matching stage-specific code.\n\n### Milestone 4: materialize and admit one fixed executor replica\n\n#### Affected paths\n\n- New `backend/src/yinshi/services/workspace_replica_materialization.py`\n- `backend/src/yinshi/services/broker_replica_service.py`\n- `backend/src/yinshi/services/broker_runtime.py`\n- `backend/src/yinshi/execution_daemons.py`\n- `backend/src/yinshi/root_launcher.py`\n- `backend/tests/test_root_replica_lifecycle.py`\n- New `backend/tests/test_workspace_replica_materialization.py`\n- New `backend/tests/test_broker_replica_admission.py`\n\n#### Materialization\n\nDo not point publication storage at launcher staging.\n\nBuild a separate broker-owned pending tree:\n\n```text\n/var/lib/yinshi-launcher/staging/.<operation>.pending/\n  repo/\n  home/\n```\n\nMaterializer must:\n\n- Open published artifacts through pinned descriptors.\n- Build repository objects from verified bundle and object pack.\n- Restore HEAD, index, worktree, and required metadata.\n- Disable hooks, filters, alternates, and external Git configuration.\n- Validate complete reconstructed state.\n- Synchronize content and parent directories.\n- Rename without replacement to `staging/<operation_id>`.\n\nOnly the operation ID enters root protocol.\n\n#### Admission effect\n\n1. Reconcile existing root state.\n2. Call root `prepare`.\n3. Call root `launch`.\n4. Use executor identity selected from protected fixed configuration.\n5. Authenticate runtime handshake.\n6. Register runtime incarnation and liveness observation.\n7. Return `AdmissionReceipt`.\n\nRequest fields must not select usernames, UIDs, sockets, commands, or service units.\n\n#### Failure behavior\n\n- Invalid materialization: admission rejection before root effect.\n- Prepare rejection: admission rejection.\n- Prepare uncertainty: admission unresolved and startup inspection.\n- Launch uncertainty: admission unresolved without duplicate launch.\n- Wrong executor identity or handshake: admission unresolved, then fail closed.\n\n#### Completion behavior\n\nPublished artifacts produce one isolated runtime under a fixed executor identity.\n\n#### Focused checks\n\nTests must cover each crash point between:\n\n- Materialization rename and parent sync.\n- Root prepare and broker receipt.\n- Root launch and runtime registration.\n- Runtime handshake and journal completion.\n\n### Milestone 5: implement graceful drain, export, shutdown, and guarded reclaim\n\n#### Affected paths\n\n- New `backend/src/yinshi/services/executor_replica_runtime.py`\n- `backend/src/yinshi/execution_daemons.py`\n- `backend/src/yinshi/services/broker_runtime.py`\n- `backend/src/yinshi/services/broker_replica_service.py`\n- New `backend/src/yinshi/services/workspace_replica_export.py`\n- `backend/src/yinshi/services/workspace_replica_bundle.py`\n- `backend/src/yinshi/services/workspace_replica_object_pack.py`\n- `backend/src/yinshi/services/workspace_replica_artifact.py`\n- New `backend/tests/test_executor_replica_runtime.py`\n- New `backend/tests/test_workspace_replica_export.py`\n- New `backend/tests/test_broker_replica_reclaim.py`\n\n#### Graceful drain effect\n\n- Send a fixed runtime `drain` command.\n- Close admission before waiting for active work.\n- Wait for all readers, writers, terminals, and agent work to quiesce.\n- Require an authenticated acknowledgment.\n- Bind acknowledgment to operation, generation, runtime incarnation, and zero active work.\n- Persist only receipt metadata in the replica journal.\n\nA timeout or missing acknowledgment becomes drain-stage unresolved.\n\nDrain acknowledgment does not imply process death.\n\n#### Export effect\n\nAfter drain acknowledgment:\n\n1. Ask the quiesced executor to capture final state.\n2. Generate exactly the three artifact roles.\n3. Stream output into broker-owned storage.\n4. Verify lengths, digests, object format, and source-state digest.\n5. Publish output immutably.\n6. Return exactly three references in `ExportReceipt`.\n7. Reject paths, inline bytes, duplicate IDs, or extra references.\n\nExecutor must not gain write access to broker artifact roots.\n\nPreferred data flow is executor-to-broker streaming over the authenticated runtime channel. Shared writable directories are rejected.\n\n#### Runtime shutdown\n\nAfter durable export:\n\n- Executor exits itself or accepts a fixed unprivileged shutdown command.\n- Broker waits for socket closure plus authoritative liveness failure.\n- No root stop operation is introduced.\n- Shutdown uncertainty remains reclaim-stage blocked.\n\n#### Reclaim effect\n\nBefore calling root `reclaim`, require all conditions:\n\n- Matching drain acknowledgment exists.\n- Matching export receipt exists.\n- Runtime registry reports no live connection.\n- Authoritative process or cgroup observation reports no live runtime.\n- Root state matches the admitted operation and executor identity.\n\nA live runtime or missing acknowledgment blocks reclaim. It never becomes successful cleanup.\n\nRoot `reclaim` remains destructive and irreversible.\n\n#### Completion behavior\n\nEach lifecycle ends with durable exact-three output or remains unresolved before destructive cleanup.\n\n#### Focused checks\n\nTests must prove:\n\n- Missing drain acknowledgment blocks root calls.\n- Forged or stale acknowledgment blocks root calls.\n- Live runtime blocks reclaim.\n- Export returns exactly three references.\n- Export failure does not start shutdown or reclaim.\n- Root protocol has no `stop`.\n- Reclaim response loss reconciles through fresh root observation.\n\n### Milestone 6: wire startup recovery\n\n#### Affected paths\n\n- `backend/src/yinshi/services/broker_replica_service.py`\n- New `backend/src/yinshi/services/broker_replica_recovery.py`\n- `backend/src/yinshi/execution_daemons.py`\n- `backend/src/yinshi/services/broker_artifact_store.py`\n- `backend/src/yinshi/services/broker_runtime.py`\n- `backend/src/yinshi/root_launcher.py`\n- New `backend/tests/test_broker_replica_recovery.py`\n- `backend/tests/test_broker_replica_lifecycle.py`\n\n#### Startup order\n\n1. Load protected identities and keys.\n2. Open and fully validate replica journal.\n3. Reauthenticate every stored request and response.\n4. Reconcile artifact attempts against journal manifests.\n5. Reconcile publication directories.\n6. Reconcile launcher staging and prepared replicas.\n7. Reconcile runtime sockets, process identities, and liveness.\n8. Resume `BrokerReplicaJournal.incomplete_lifecycles()`.\n9. Start accepting new broker connections only after bounded recovery finishes.\n\nCorrupt journal history must prevent readiness.\n\n#### Recovery rules\n\n- Exact synchronized incoming set may complete ingest.\n- Partial incoming set becomes ingest-stage unresolved or quarantined.\n- Semantic verification may repeat against pinned immutable files.\n- Exact final publication may complete publish.\n- Ambiguous publication remains publication-stage unresolved.\n- Prepared root state may complete prepare reconciliation.\n- Unknown launch never causes blind relaunch.\n- Missing drain acknowledgment never permits export or reclaim.\n- Exact exported publication may complete export.\n- Reclaim requires fresh runtime and root observations.\n- Unjournaled final directories are never adopted.\n- Foreign state is retained or quarantined without replacement.\n\n#### Completion behavior\n\nProcess restart produces the same terminal response or the same stage-specific unresolved result.\n\n#### Focused checks\n\nUse subprocess kill points after every external effect and before every journal completion.\n\nOne reboot test must cover a live runtime. Another must cover a lost final response.\n\n### Milestone 7: add desktop capture, signing, upload, and response verification\n\n#### Affected paths\n\n- New `desktop/src/brokerArtifactUpload.ts`\n- New `desktop/src/brokerArtifactUpload.test.ts`\n- New `desktop/src/replicaRequest.ts`\n- `desktop/src/credentialStore.ts`\n- `desktop/src/appController.ts`\n- `desktop/src/localRuntime.ts`\n- `desktop/src/mainRouting.ts`\n- Corresponding existing tests\n\n#### Work\n\n- Keep remote username and forced command fixed.\n- Do not accept an arbitrary SSH command or broker socket.\n- Pin VM host identity using approved provisioning data.\n- Load desktop private key through existing credential boundary.\n- Never place private keys in environment variables or command arguments.\n- Open each artifact with no-follow semantics.\n- Validate identity, ownership, mode, length, and digest before sending.\n- Stream files in fixed order with backpressure.\n- Half-close stdin after the third file.\n- Parse one bounded response frame.\n- Verify broker response signature, incarnation, operation, nonce, and request binding.\n- Treat EOF, timeout, malformed response, or wrong signer as unknown.\n\nNative Darwin may orchestrate the Linux VM. It must not start a native executor or untrusted sidecar.\n\n#### Completion behavior\n\nDesktop reports success only after validating the broker-signed terminal response.\n\n#### Focused checks\n\nTests must cover:\n\n- Wrong host key.\n- Wrong request key.\n- Wrong response key.\n- Artifact replacement after preflight.\n- Backpressure.\n- Partial SSH writes.\n- Lost response after broker completion.\n- No native Darwin execution fallback.\n\n### Milestone 8: deployment, independent gates, and Linux qualification\n\n#### Affected paths\n\n- `deploy/systemd/`\n- `deploy/sysusers.d/`\n- `deploy/tmpfiles.d/yinshi.conf`\n- `deploy/orbstack/`\n- New `scripts/qualify-phase6-linux.sh`\n- New `backend/tests/test_phase6_linux_qualification.py`\n- `.github/workflows/`\n- `backend/src/yinshi/services/workspace_isolation.py`\n- `desktop/src/isolationProfile.ts`\n- `docs/workspace-isolation.md`\n- `docs/workspace-os-isolation.md`\n- `docs/broker-root-launcher.md`\n\n#### Deployment work\n\n- Provision fixed `yinshi-app`, `yinshi-broker`, root launcher, and executor identities.\n- Create separate broker-owned incoming and published roots.\n- Keep launcher staging ownership separate.\n- Install upload relay as a forced SSH command.\n- Deny arbitrary commands, PTY allocation, forwarding, and caller environment injection.\n- Protect request public keys and broker private keys from executors.\n- Add disk quotas and retained-state capacity alarms.\n- Sandbox Git verifiers away from broker signing keys.\n\n#### Root gates\n\nKeep three independent defaults:\n\n```text\nlaunch = disabled\nprepare = disabled\nreclaim = disabled\n```\n\nNo aggregate switch may enable all three.\n\nPackaged unit tests must confirm each action remains rejected when only another action is enabled.\n\n#### Linux qualification\n\nQualification must verify:\n\n- Approved distribution, kernel, and systemd versions.\n- Required atomic no-replace filesystem support.\n- Unix peer credential support.\n- PID or cgroup liveness authority.\n- Fixed account identities and group membership.\n- Directory ownership and modes.\n- Socket ownership and modes.\n- SSH forced-command restrictions.\n- Broker key protection.\n- Executor isolation from host and broker data.\n- Resource ceilings.\n- Reboot recovery.\n- Live-runtime reclaim blocking.\n- Near-limit upload behavior.\n- Every root gate default.\n\n`evaluate_local_isolation_profile()` must remain the sole policy owner.\n\nLinux becomes supported only after checking a root-owned qualification attestation. Platform name alone must never enable execution.\n\n#### Completion behavior\n\nA qualified Linux image passes end-to-end testing. Unqualified Linux and native Darwin remain fail closed.\n\n## 6. Migration concerns\n\n### Journal compatibility\n\nCurrent journal rows bind exact canonical request bytes.\n\nChanging digest projection or payload interpretation can make existing rows unreplayable. This requires an explicit compatibility decision.\n\nSafe options are:\n\n1. Introduce a versioned request schema and retain old readers.\n2. Use a new journal database for the new protocol.\n3. Declare pre-production data disposable through an approved migration.\n\nSource does not establish which policy is acceptable.\n\n### Filesystem migration\n\nIncoming, published, launcher staging, and runtime roots must remain separate.\n\nStartup must reject or quarantine orphan directories. It must not infer authority from directory names.\n\n### Key rotation\n\nOld journal responses require their original broker public keys for replay verification.\n\nRotation needs retained key identifiers and a protected trust history. Deleting old verification keys can strand incomplete operations.\n\n## 7. Rollback\n\nRollback begins by disabling upload access plus all root gates.\n\n- Stop accepting new replica requests.\n- Keep journal, artifacts, prepared replicas, and unresolved state.\n- Do not delete a live or unresolved replica.\n- Retain a binary version capable of reading the active journal schema.\n- Reclaim only after verified export, drain acknowledgment, and dead-runtime observation.\n\nPublished artifacts are append-only. Root reclaim is the principal irreversible operation.\n\n## 8. Review findings\n\n1. **Blocker:** `backend/src/yinshi/services/execution_broker.py` does not dispatch `replica.lifecycle`.\n2. **Blocker:** `backend/src/yinshi/broker_stdio_relay.py` cannot stream the required artifact body.\n3. **High:** `workspace_replica_publication.py` uses whole-file byte APIs unsuitable for maximum production sizes.\n4. **Blocker:** publication layout does not match root launcher’s exact `repo/` plus `home/` staging contract.\n5. **Blocker:** no concrete seven-stage `ReplicaLifecycleEffects` implementation exists.\n6. **Blocker:** desktop has no VM artifact transport or response verifier.\n7. **Blocker:** Linux remains `isolation_unverified`, so no production execution profile exists.\n8. **High:** drain, export, runtime shutdown, and liveness authority lack a production protocol.\n9. **High:** artifact quota, key provisioning, and verifier isolation need infrastructure approval.\n10. **Low:** `docs/workspace-isolation.md` still says broker schemas do not exist, which conflicts with committed foundations.\n\n## 9. Residual risks\n\n- Git parsing under the broker identity could expose signing credentials after verifier compromise.\n- A one-GiB upload can exhaust disk without reservation and quotas.\n- Worktree descriptor decoding needs parser-equivalence tests.\n- Lost executor export identity may be impossible to recover safely.\n- Old broker keys may be required for journal replay indefinitely.\n- Runtime liveness authority differs between systemd, containers, and VM implementations.\n- Existing dirty Phase 6 files can shift APIs during implementation.\n\n## 10. Completion conditions\n\nPhase 6 production wiring is complete only when all conditions hold:\n\n- Desktop streams exactly three authenticated artifacts to a fixed VM command.\n- Broker authenticates before artifact reads.\n- Broker dispatches authenticated request plus exact raw frame.\n- All seven concrete effects pass crash-window tests.\n- SQLite contains no artifact bytes.\n- No connection crosses an awaited effect.\n- Root protocol contains no stop action.\n- Missing drain acknowledgment blocks reclaim.\n- Live runtime blocks reclaim.\n- Every unknown remains stage-specific.\n- Request and response signatures are checked end to end.\n- Root gates are independently off by default.\n- Startup recovery runs before readiness.\n- Native Darwin remains fail closed.\n- Qualified Linux passes disposable-VM end-to-end tests.\n\n## 11. Handoff\n\nParent must approve Milestone 0 decisions before a writer starts.\n\nFirst implementation action after approval: freeze canonical wire vectors in `replica_artifact_contract.py` and cross-language tests.\n\nDeployment unit contents under `deploy/systemd/` still need line-level inspection before editing.\n\nHighest-impact assumption is desktop-side source capture. A VM-pull model would replace desktop streaming, key ownership, and export routing.","artifactPaths":["/Users/user/projects/yinshi/.pi-subagents/artifacts/outputs/d856fe34/.pi-subagents/artifacts/remaining-phase6-plan.md","/Users/user/.pi/agent/sessions/--Users-user-projects-yinshi--/2026-09-04T04-44-52-550Z_01a06abb-dfc5-7c65-82bb-7c5f2081ee64/d856fe34/run-0/session.jsonl"],"results":[{"index":0,"agent":"planner","task":"Create an implementation-ready plan for the remaining Phase 6 production wiring in the current checkout. The completed foundations are commits 7f91105f and 922f197b: authenticated exact-three artifact contract/store/publication, append-only replica journal, and stateless seven-stage coordinator. Required result: authenticated desktop-to-VM artifact transport; broker dispatch; concrete ingest, verify, publish, admission, graceful drain, exact-three-reference export, and reclaim effects; fail-closed native Darwin; all root gates independently disabled by default; startup recovery; Linux qualification. Preserve these invariants: no SQLite handle crosses await or external effect; artifact bytes stay outside SQLite; stream exactly committed.bundle, worktree.yra, index-objects.pack; root protocol remains prepare, launch, reclaim only; no root stop action; missing drain acknowledgment or live runtime blocks reclaim; unknown results stay stage-specific unresolved; fixed executor identities; request and response Ed25519 authentication; coordinator receives authenticated BrokerRequest plus raw frame. Inspect actual current files and APIs. Do not modify files. Resolve ownership and transport framing, identify precise modules/tests per milestone, and distinguish concrete reusable support from new interfaces. Also identify any requirements that cannot be safely implemented without a product decision.\n\n---\n**Output:**\nWrite your findings to exactly this path: /Users/user/projects/yinshi/.pi-subagents/artifacts/outputs/d856fe34/.pi-subagents/artifacts/remaining-phase6-plan.md\nThis path is authoritative for this run.\nIgnore any other output filename or output path mentioned elsewhere, including output destinations in the base agent prompt, system prompt, or task instructions.","routingContract":{"version":1,"agent":"planner","model":"openai-codex/gpt-5.6-sol","thinking":"max","policyDigest":"8590d2fc0420152aad3f867aba1c18a56b3632f2d90e01d30d3f04676cd46ac5"},"launchContractDigest":"7966fcb31d045df9bb0324100fe87cd5aec7ee00e193477cf16298f047e49470","launchResolvedExtensions":{"version":1,"source":"launch-resolved","disableAmbientExtensions":false,"runtime":["sha256:cb00ccf63b7cf9f4"],"configured":[],"effective":["sha256:cb00ccf63b7cf9f4"],"omitted":{"runtime":0,"configured":0,"effective":0}},"exitCode":0,"outputState":"present","usage":{"input":266768,"output":21072,"cacheRead":698368,"cacheWrite":0,"cost":2.315184,"turns":14},"model":"openai-codex/gpt-5.6-sol:max","thinking":"max","artifactPaths":{"inputPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/d856fe34_planner_0_input.md","outputPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/d856fe34_planner_0_output.md","jsonlPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/d856fe34_planner_0.jsonl","transcriptPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/d856fe34_planner_0_transcript.jsonl","metadataPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/d856fe34_planner_0_meta.json"},"transcriptPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/d856fe34_planner_0_transcript.jsonl","turnBudget":{"maxTurns":16,"graceTurns":3,"outcome":"within-budget","turnCount":14},"toolBudget":{"hard":65,"soft":45,"block":["bash","read","grep","find","ls"],"toolCount":48,"outcome":"soft-reached","softReachedAt":45},"context":"fresh","progressSummary":{"toolCount":48,"tokens":287840,"durationMs":660163},"effects":{"fileMutation":{"status":"not-applicable","expected":false,"attempted":true}},"savedOutputPath":"/Users/user/projects/yinshi/.pi-subagents/artifacts/outputs/d856fe34/.pi-subagents/artifacts/remaining-phase6-plan.md","outputReference":{"path":"/Users/user/projects/yinshi/.pi-subagents/artifacts/outputs/d856fe34/.pi-subagents/artifacts/remaining-phase6-plan.md","bytes":32460,"lines":848,"message":"Output saved to: /Users/user/projects/yinshi/.pi-subagents/artifacts/outputs/d856fe34/.pi-subagents/artifacts/remaining-phase6-plan.md (31.7 KB, 848 lines). Read this file if needed."},"outputMode":"inline","finalOutput":"# Remaining Phase 6 production wiring plan\n\n## 1. Scope and requested observable result\n\nPhase 6 should provide this observable path:\n\n1. Desktop captures three replica artifacts.\n2. Desktop signs one strict `replica.lifecycle` request.\n3. Desktop streams request plus three artifacts through a fixed SSH command.\n4. Broker authenticates request before reading artifact bytes.\n5. Broker journals and executes seven ordered stages.\n6. Broker returns an Ed25519-authenticated response.\n7. Desktop verifies response before reporting success.\n8. Broker resumes incomplete operations after restart.\n9. Native Darwin execution remains unavailable.\n10. Linux execution remains unavailable until qualification passes.\n11. Root prepare, launch, and reclaim gates remain separately disabled by default.\n\nRequired artifact stream order is fixed:\n\n1. `committed.bundle`\n2. `worktree.yra`\n3. `index-objects.pack`\n\nNo artifact identifier becomes a filesystem path.\n\n## 2. Established current behavior\n\n### Foundation state\n\n- Commit `7f91105f` added authenticated artifact contracts, storage, publication, and the append-only replica journal.\n- Commit `922f197b` added `BrokerReplicaLifecycleCoordinator` and its seven-stage effect contract.\n- Evidence: `git show --format=fuller --stat 7f91105f` and the equivalent `922f197b` command.\n\n### Control plane\n\n- `backend/src/yinshi/services/broker_protocol.py` authenticates requests and responses with Ed25519.\n- Request frames are limited to 65,536 bytes.\n- `BrokerRequest` contains authenticated parsed data. Exact raw frame bytes remain separately available.\n- `backend/src/yinshi/services/execution_broker.py` currently handles only `executor.launch`.\n- No production caller instantiates `BrokerReplicaLifecycleCoordinator`.\n- Evidence: repository search for `BrokerReplicaLifecycleCoordinator`, `ReplicaLifecycleEffects`, and `replica.lifecycle`.\n\n### Existing relay\n\n- `backend/src/yinshi/broker_stdio_relay.py` accepts one bounded frame.\n- Relay connects only to `/run/yinshi/broker.sock`.\n- Relay accepts no caller-selected socket or CLI option.\n- Relay buffers the complete control frame, then requires EOF.\n- It cannot safely carry artifact bodies approaching the configured one-GiB aggregate limit.\n- Existing behavior has focused coverage in `backend/tests/test_broker_stdio_relay.py`.\n\n### Existing artifact support\n\n- `BrokerArtifactStore.receive()` already streams fixed-role files into broker-owned private storage.\n- It hashes content incrementally and enforces role plus aggregate limits.\n- It publishes incoming sets without replacement.\n- It returns reference-only `IngestReceipt` values.\n- `BrokerArtifactStore.open_incoming()` pins files through descriptors.\n- `BrokerArtifactStore.reconcile_attempts()` classifies retained incoming state.\n- Evidence: `backend/src/yinshi/services/broker_artifact_store.py` and `backend/tests/test_broker_artifact_store.py`.\n\n### Existing publication support\n\n- `WorkspaceReplicaPublicationStore` validates and atomically publishes exact-three artifact sets.\n- Production-facing publication still accepts three complete `bytes` values.\n- Verification paths retain or reconstruct complete file contents.\n- This can amplify memory usage several times near maximum limits.\n- Published layout contains artifact files plus `artifact-set.json`.\n- Root prepare instead requires one staging directory containing exactly `repo/` and `home/`.\n- Evidence: `backend/src/yinshi/services/workspace_replica_publication.py` and `backend/src/yinshi/root_launcher.py`.\n\n### Existing lifecycle coordinator\n\n- `BrokerReplicaLifecycleCoordinator` orders ingest, verify, publish, admission, drain, export, and reclaim.\n- `ReplicaLifecycleEffects` supplies one effect and reconciliation implementation per stage.\n- Journal calls occur outside awaited effects.\n- Unknown outcomes remain tied to the active stage.\n- `BrokerReplicaJournal.incomplete_lifecycles()` exposes restart work.\n- Existing tests use synthetic effects only.\n- Evidence: `backend/src/yinshi/services/broker_replica_lifecycle.py` and `backend/tests/test_broker_replica_lifecycle.py`.\n\n### Isolation and root boundaries\n\n- Native Darwin execution fails closed in `backend/src/yinshi/services/workspace_isolation.py`.\n- `desktop/src/localRuntime.ts` also blocks the untrusted local sidecar on unsupported profiles.\n- Linux currently returns `isolation_unverified`.\n- Root protocol accepts only `prepare`, `launch`, and `reclaim`.\n- `resolve_execution_gate()`, `resolve_prepare_gate()`, and `resolve_reclaim_gate()` are separate.\n- Existing deployment documentation states that production isolation remains incomplete.\n- Evidence: `docs/workspace-isolation.md`, `docs/workspace-os-isolation.md`, and `backend/src/yinshi/execution_daemons.py`.\n\n### Desktop gap\n\n- Desktop source contains no replica request signer, artifact uploader, broker response verifier, or VM lifecycle transport.\n- Existing SSH handling only forwards `SSH_AUTH_SOCK` into local runtime configuration.\n- Evidence: search of `desktop/src` for `broker`, `replica`, `artifact`, `ssh`, and `VM`.\n\n## 3. Constraints\n\nThese constraints are fixed for implementation:\n\n- No SQLite connection may cross `await` or any external effect.\n- Artifact bytes remain outside SQLite.\n- Artifact order and filenames remain exact.\n- Root actions remain `prepare`, `launch`, and `reclaim`.\n- No root stop action may be added.\n- Reclaim requires a drain acknowledgment and a dead runtime.\n- Unknown results remain unresolved under their original stage.\n- Executor identities come from protected configuration, never requests.\n- Requests and responses require Ed25519 authentication.\n- Coordinator receives authenticated `BrokerRequest` plus exact raw request frame.\n- Artifact IDs remain logical identifiers, never path components.\n- Existing control relay behavior remains compatible.\n- All root gates remain independently disabled unless explicitly enabled.\n\n## 4. Recommended transport and ownership design\n\nThis design needs parent approval before implementation.\n\n### 4.1 Transport choice\n\nAdd a second fixed SSH forced command named:\n\n```text\nyinshi-broker-artifact-upload\n```\n\nKeep `yinshi-broker-stdio-relay` unchanged.\n\nBoth commands connect only to:\n\n```text\n/run/yinshi/broker.sock\n```\n\nThe upload framing is:\n\n```text\nu32be request_frame_length\nexact signed BrokerRequest frame\ncommitted.bundle bytes using signed length\nworktree.yra bytes using signed length\nindex-objects.pack bytes using signed length\nEOF\n```\n\nResponse framing remains:\n\n```text\nu32be response_frame_length\nexact signed BrokerResponse frame\nEOF\n```\n\nNo role names, paths, chunk offsets, or caller-selected commands appear in the body.\n\nSigned metadata binds each role to:\n\n- Artifact ID\n- SHA-256 digest\n- Byte length\n\nSigned request also binds operation identity, sequence, nonce, object format, source state, fingerprint, and artifact-set digest.\n\nWhole-file signatures are unnecessary. Signed lengths, fixed order, and signed SHA-256 values bind every streamed byte.\n\n### 4.2 Backpressure and limits\n\nEvery hop uses a fixed 64-KiB copy buffer.\n\n- Desktop waits for child-process stream backpressure.\n- Upload relay calls `drain()` after each broker-socket write.\n- Broker reads exactly each signed length.\n- Broker rejects truncation or one trailing byte.\n- Broker applies independent role and aggregate limits before body acceptance.\n- Broker uses idle deadlines plus an operator-approved absolute deadline.\n- Existing 120-second control-connection deadline must not govern large uploads.\n- Concurrency and disk reservations must be bounded before accepting a body.\n\n### 4.3 Retry handling\n\n`BrokerReplicaService` owns one operation lock and one connection-scoped transfer session.\n\nFor a new request:\n\n1. Coordinator accepts and claims the exact raw frame.\n2. Coordinator records ingest intent.\n3. Connection-bound ingest effect calls `BrokerArtifactStore.receive()`.\n4. Response waits until exact EOF has been checked.\n\nFor an exact replay after ingest:\n\n1. Service confirms journal frame identity.\n2. `BrokerArtifactStore.receive()` consumes the duplicate body.\n3. Existing immutable incoming state is inspected and reused.\n4. Coordinator resumes from its durable journal position.\n5. No existing artifact is overwritten.\n\nThis retains intent-before-effect ordering for new operations.\n\nA transport error never becomes a successful stage result. Desktop retries only the same signed frame or creates a new operation.\n\n### 4.4 Ownership\n\n| Mutable or durable value | Owner |\n|---|---|\n| Desktop signing private key | Desktop credential store |\n| Broker response public key pin | Desktop release configuration |\n| Client authorization keys | Root-protected broker configuration |\n| Exact signed request and stage history | `BrokerReplicaJournal` |\n| Connection reader and consumed-byte count | Connection-scoped upload session |\n| Partial incoming directory | `BrokerArtifactStore` |\n| Immutable incoming files | `BrokerArtifactStore` |\n| Semantic verification receipt | `BrokerReplicaJournal` |\n| Published artifact set | `WorkspaceReplicaPublicationStore` |\n| Materialization pending directory | Broker materializer |\n| Prepared `repo/` and `home/` | Root launcher, then fixed executor |\n| Runtime admission and liveness observations | Broker runtime service |\n| Quiesced runtime state | Executor runtime |\n| Exported artifact bytes | Broker artifact store |\n| Export receipt references | `BrokerReplicaJournal` |\n| Reclaim quarantine and deletion | Root launcher |\n\nSQLite owns references and authenticated receipts only. Filesystems own artifact and replica bytes.\n\n## 5. Implementation milestones\n\n### Milestone 0: approve unresolved contracts\n\nNo writer should change persisted framing before this milestone completes.\n\n#### Decisions required\n\n- Approve separate fixed upload command versus extending the existing relay.\n- Approve artifact-set digest version and canonical projection.\n- Approve client key enrollment, rotation, revocation, and tenant authorization.\n- Approve upload quotas, concurrency, deadlines, and quarantine retention.\n- Approve supported Linux image, kernel, init system, and VM provider.\n- Approve source capture policy on Darwin.\n- Approve exact event that begins drain.\n- Approve export namespace and lifecycle ownership.\n- Approve verifier privilege separation.\n\n#### Completion check\n\nRecord decisions in an ADR under `docs/`. Include protocol version, owners, limits, and compatibility policy.\n\n### Milestone 1: freeze cross-language wire contract\n\n#### Affected paths\n\n- `backend/src/yinshi/services/replica_artifact_contract.py`\n- `backend/src/yinshi/services/broker_protocol.py`\n- `backend/tests/test_broker_replica_journal.py`\n- New `backend/tests/test_broker_replica_wire_vectors.py`\n- New `desktop/src/replicaRequest.ts`\n- New `desktop/src/replicaRequest.test.ts`\n- `docs/broker-root-launcher.md`\n\n#### Work\n\n- Define one versioned canonical artifact-set projection.\n- Reuse exact role names and fixed ordering from `replica_artifact_contract.py`.\n- Require three distinct artifact IDs.\n- Reject unknown, missing, duplicated, null, or reordered declarations.\n- Publish request and response golden vectors.\n- Include Ed25519 valid, invalid, and wrong-incarnation vectors.\n- Make TypeScript reproduce canonical bytes exactly.\n- Keep raw signed frame separate from parsed `BrokerRequest`.\n\nDo not silently reinterpret existing `artifact_set_sha256` rows.\n\n#### Completion behavior\n\nPython and TypeScript produce identical bytes, digests, signatures, and verification results.\n\n#### Focused checks\n\n```bash\ncd backend && uv run pytest tests/test_broker_replica_wire_vectors.py tests/test_broker_replica_journal.py\ncd desktop && npm test -- replicaRequest.test.ts\n```\n\nExisting coverage is not enough. No cross-language vector test exists.\n\n### Milestone 2: add streaming relay and authenticated broker dispatch\n\n#### Affected paths\n\n- New `backend/src/yinshi/broker_artifact_stdio_relay.py`\n- `backend/src/yinshi/execution_daemons.py`\n- `backend/src/yinshi/services/execution_broker.py`\n- New `backend/src/yinshi/services/broker_replica_service.py`\n- `backend/pyproject.toml`\n- New `backend/tests/test_broker_artifact_stdio_relay.py`\n- `backend/tests/test_execution_daemons.py`\n- `backend/tests/test_broker_foundation.py`\n- `backend/tests/test_broker_stdio_relay.py`\n\n#### Work\n\n- Add no-argument `yinshi-broker-artifact-upload` entry point.\n- Preserve existing control relay byte-for-byte behavior.\n- Split `_read_frame` into initial-frame reading and optional EOF enforcement.\n- Authenticate request before reading any artifact body.\n- Dispatch exact authenticated action values.\n- Route `executor.launch` to existing service and require immediate EOF.\n- Route `replica.lifecycle` to `BrokerReplicaService`.\n- Pass authenticated `BrokerRequest`, exact frame bytes, and body reader.\n- Reject unknown actions without reading a body.\n- Return only coordinator-produced signed responses.\n- Log stable error codes without request, artifact, path, or key material.\n\nDo not add a pass-through router class unless it owns authentication and framing complexity.\n\n#### Failure behavior\n\n- Invalid frame or signature: close without a success response.\n- Valid request with invalid limits: signed rejection before body read.\n- Truncation: ingest-stage rejection when outcome is conclusive.\n- Timeout or socket uncertainty: ingest-stage unresolved.\n- Trailing bytes: rejection before any signed success.\n- Response-write uncertainty: retain journal result for exact replay.\n\n#### Completion behavior\n\nOne broker socket supports bounded controls and streamed replica requests without ambiguity.\n\n#### Focused checks\n\nTests must prove:\n\n- Authentication happens before first artifact read.\n- Dispatcher passes the exact raw frame.\n- Existing control relay still requires EOF.\n- Upload relay never accepts a socket or command argument.\n- Partial writes propagate backpressure.\n- Cancellation closes both streams promptly.\n- One trailing byte fails.\n- A valid signed response is never emitted before request EOF.\n\n### Milestone 3: wire concrete ingest, verification, and publication effects\n\n#### Affected paths\n\n- `backend/src/yinshi/services/broker_replica_service.py`\n- `backend/src/yinshi/services/broker_artifact_store.py`\n- `backend/src/yinshi/services/workspace_replica_publication.py`\n- `backend/src/yinshi/services/workspace_replica_bundle.py`\n- `backend/src/yinshi/services/workspace_replica_object_pack.py`\n- `backend/src/yinshi/services/workspace_replica_artifact.py`\n- `backend/src/yinshi/services/git.py`\n- New `backend/tests/test_broker_replica_service.py`\n- Existing artifact, bundle, object-pack, publication, journal, and lifecycle tests\n\n#### Ingest effect\n\n- Convert authenticated payload into `ReplicaArtifactManifest`.\n- Recompute artifact-set digest before reading bytes.\n- Call `BrokerArtifactStore.receive()`.\n- Return existing reference-only `IngestReceipt`.\n- Never pass a SQLite object into the effect.\n- Retain partial or ambiguous state for recovery.\n\n#### Verification effect\n\nAdd descriptor-based APIs:\n\n```python\nverify_committed_bundle_file(...)\nverify_index_object_pack_file(...)\ninspect_worktree_artifact_file(...)\n```\n\nRequirements:\n\n- Consume pinned read-only descriptors.\n- Hash with bounded `pread` loops.\n- Use descriptor-backed Git input.\n- Avoid joining complete files into memory.\n- Recheck inode, mode, length, link count, and digest afterward.\n- Run Git with scrubbed configuration and no broker credentials.\n- Return deterministic semantic receipt data.\n\n#### Publication effect\n\nAdd a descriptor-based production API to `WorkspaceReplicaPublicationStore`.\n\nIt must:\n\n1. Accept pinned incoming descriptors.\n2. Require the matching verification receipt.\n3. Write bounded `artifact-set.json`.\n4. Preserve exact filenames.\n5. Publish without replacement.\n6. Synchronize files plus both directory parents.\n7. Inspect final state before returning.\n8. Return `ReplicaPublicationReceipt`.\n\nKeep the current bytes API only if compatibility policy approves it. Mark it non-production.\n\n#### State transitions\n\n```text\naccepted\n-> claimed\n-> ingest_started\n-> ingested\n-> verify_started\n-> verified\n-> publish_started\n-> published\n```\n\nEach completion follows durable external inspection. Commit uncertainty uses existing exact-row reconciliation.\n\n#### Completion behavior\n\nA valid stream becomes one verified immutable publication without whole-set memory retention.\n\n#### Focused checks\n\nAdd assertions for:\n\n- Near-limit streaming with bounded process memory.\n- Descriptor replacement during verification.\n- Git verifier timeout and cancellation.\n- Publication rename uncertainty.\n- Exact replay after lost response.\n- No artifact sentinel appears in journal SQLite files.\n- Every unknown uses the journal’s matching stage-specific code.\n\n### Milestone 4: materialize and admit one fixed executor replica\n\n#### Affected paths\n\n- New `backend/src/yinshi/services/workspace_replica_materialization.py`\n- `backend/src/yinshi/services/broker_replica_service.py`\n- `backend/src/yinshi/services/broker_runtime.py`\n- `backend/src/yinshi/execution_daemons.py`\n- `backend/src/yinshi/root_launcher.py`\n- `backend/tests/test_root_replica_lifecycle.py`\n- New `backend/tests/test_workspace_replica_materialization.py`\n- New `backend/tests/test_broker_replica_admission.py`\n\n#### Materialization\n\nDo not point publication storage at launcher staging.\n\nBuild a separate broker-owned pending tree:\n\n```text\n/var/lib/yinshi-launcher/staging/.<operation>.pending/\n  repo/\n  home/\n```\n\nMaterializer must:\n\n- Open published artifacts through pinned descriptors.\n- Build repository objects from verified bundle and object pack.\n- Restore HEAD, index, worktree, and required metadata.\n- Disable hooks, filters, alternates, and external Git configuration.\n- Validate complete reconstructed state.\n- Synchronize content and parent directories.\n- Rename without replacement to `staging/<operation_id>`.\n\nOnly the operation ID enters root protocol.\n\n#### Admission effect\n\n1. Reconcile existing root state.\n2. Call root `prepare`.\n3. Call root `launch`.\n4. Use executor identity selected from protected fixed configuration.\n5. Authenticate runtime handshake.\n6. Register runtime incarnation and liveness observation.\n7. Return `AdmissionReceipt`.\n\nRequest fields must not select usernames, UIDs, sockets, commands, or service units.\n\n#### Failure behavior\n\n- Invalid materialization: admission rejection before root effect.\n- Prepare rejection: admission rejection.\n- Prepare uncertainty: admission unresolved and startup inspection.\n- Launch uncertainty: admission unresolved without duplicate launch.\n- Wrong executor identity or handshake: admission unresolved, then fail closed.\n\n#### Completion behavior\n\nPublished artifacts produce one isolated runtime under a fixed executor identity.\n\n#### Focused checks\n\nTests must cover each crash point between:\n\n- Materialization rename and parent sync.\n- Root prepare and broker receipt.\n- Root launch and runtime registration.\n- Runtime handshake and journal completion.\n\n### Milestone 5: implement graceful drain, export, shutdown, and guarded reclaim\n\n#### Affected paths\n\n- New `backend/src/yinshi/services/executor_replica_runtime.py`\n- `backend/src/yinshi/execution_daemons.py`\n- `backend/src/yinshi/services/broker_runtime.py`\n- `backend/src/yinshi/services/broker_replica_service.py`\n- New `backend/src/yinshi/services/workspace_replica_export.py`\n- `backend/src/yinshi/services/workspace_replica_bundle.py`\n- `backend/src/yinshi/services/workspace_replica_object_pack.py`\n- `backend/src/yinshi/services/workspace_replica_artifact.py`\n- New `backend/tests/test_executor_replica_runtime.py`\n- New `backend/tests/test_workspace_replica_export.py`\n- New `backend/tests/test_broker_replica_reclaim.py`\n\n#### Graceful drain effect\n\n- Send a fixed runtime `drain` command.\n- Close admission before waiting for active work.\n- Wait for all readers, writers, terminals, and agent work to quiesce.\n- Require an authenticated acknowledgment.\n- Bind acknowledgment to operation, generation, runtime incarnation, and zero active work.\n- Persist only receipt metadata in the replica journal.\n\nA timeout or missing acknowledgment becomes drain-stage unresolved.\n\nDrain acknowledgment does not imply process death.\n\n#### Export effect\n\nAfter drain acknowledgment:\n\n1. Ask the quiesced executor to capture final state.\n2. Generate exactly the three artifact roles.\n3. Stream output into broker-owned storage.\n4. Verify lengths, digests, object format, and source-state digest.\n5. Publish output immutably.\n6. Return exactly three references in `ExportReceipt`.\n7. Reject paths, inline bytes, duplicate IDs, or extra references.\n\nExecutor must not gain write access to broker artifact roots.\n\nPreferred data flow is executor-to-broker streaming over the authenticated runtime channel. Shared writable directories are rejected.\n\n#### Runtime shutdown\n\nAfter durable export:\n\n- Executor exits itself or accepts a fixed unprivileged shutdown command.\n- Broker waits for socket closure plus authoritative liveness failure.\n- No root stop operation is introduced.\n- Shutdown uncertainty remains reclaim-stage blocked.\n\n#### Reclaim effect\n\nBefore calling root `reclaim`, require all conditions:\n\n- Matching drain acknowledgment exists.\n- Matching export receipt exists.\n- Runtime registry reports no live connection.\n- Authoritative process or cgroup observation reports no live runtime.\n- Root state matches the admitted operation and executor identity.\n\nA live runtime or missing acknowledgment blocks reclaim. It never becomes successful cleanup.\n\nRoot `reclaim` remains destructive and irreversible.\n\n#### Completion behavior\n\nEach lifecycle ends with durable exact-three output or remains unresolved before destructive cleanup.\n\n#### Focused checks\n\nTests must prove:\n\n- Missing drain acknowledgment blocks root calls.\n- Forged or stale acknowledgment blocks root calls.\n- Live runtime blocks reclaim.\n- Export returns exactly three references.\n- Export failure does not start shutdown or reclaim.\n- Root protocol has no `stop`.\n- Reclaim response loss reconciles through fresh root observation.\n\n### Milestone 6: wire startup recovery\n\n#### Affected paths\n\n- `backend/src/yinshi/services/broker_replica_service.py`\n- New `backend/src/yinshi/services/broker_replica_recovery.py`\n- `backend/src/yinshi/execution_daemons.py`\n- `backend/src/yinshi/services/broker_artifact_store.py`\n- `backend/src/yinshi/services/broker_runtime.py`\n- `backend/src/yinshi/root_launcher.py`\n- New `backend/tests/test_broker_replica_recovery.py`\n- `backend/tests/test_broker_replica_lifecycle.py`\n\n#### Startup order\n\n1. Load protected identities and keys.\n2. Open and fully validate replica journal.\n3. Reauthenticate every stored request and response.\n4. Reconcile artifact attempts against journal manifests.\n5. Reconcile publication directories.\n6. Reconcile launcher staging and prepared replicas.\n7. Reconcile runtime sockets, process identities, and liveness.\n8. Resume `BrokerReplicaJournal.incomplete_lifecycles()`.\n9. Start accepting new broker connections only after bounded recovery finishes.\n\nCorrupt journal history must prevent readiness.\n\n#### Recovery rules\n\n- Exact synchronized incoming set may complete ingest.\n- Partial incoming set becomes ingest-stage unresolved or quarantined.\n- Semantic verification may repeat against pinned immutable files.\n- Exact final publication may complete publish.\n- Ambiguous publication remains publication-stage unresolved.\n- Prepared root state may complete prepare reconciliation.\n- Unknown launch never causes blind relaunch.\n- Missing drain acknowledgment never permits export or reclaim.\n- Exact exported publication may complete export.\n- Reclaim requires fresh runtime and root observations.\n- Unjournaled final directories are never adopted.\n- Foreign state is retained or quarantined without replacement.\n\n#### Completion behavior\n\nProcess restart produces the same terminal response or the same stage-specific unresolved result.\n\n#### Focused checks\n\nUse subprocess kill points after every external effect and before every journal completion.\n\nOne reboot test must cover a live runtime. Another must cover a lost final response.\n\n### Milestone 7: add desktop capture, signing, upload, and response verification\n\n#### Affected paths\n\n- New `desktop/src/brokerArtifactUpload.ts`\n- New `desktop/src/brokerArtifactUpload.test.ts`\n- New `desktop/src/replicaRequest.ts`\n- `desktop/src/credentialStore.ts`\n- `desktop/src/appController.ts`\n- `desktop/src/localRuntime.ts`\n- `desktop/src/mainRouting.ts`\n- Corresponding existing tests\n\n#### Work\n\n- Keep remote username and forced command fixed.\n- Do not accept an arbitrary SSH command or broker socket.\n- Pin VM host identity using approved provisioning data.\n- Load desktop private key through existing credential boundary.\n- Never place private keys in environment variables or command arguments.\n- Open each artifact with no-follow semantics.\n- Validate identity, ownership, mode, length, and digest before sending.\n- Stream files in fixed order with backpressure.\n- Half-close stdin after the third file.\n- Parse one bounded response frame.\n- Verify broker response signature, incarnation, operation, nonce, and request binding.\n- Treat EOF, timeout, malformed response, or wrong signer as unknown.\n\nNative Darwin may orchestrate the Linux VM. It must not start a native executor or untrusted sidecar.\n\n#### Completion behavior\n\nDesktop reports success only after validating the broker-signed terminal response.\n\n#### Focused checks\n\nTests must cover:\n\n- Wrong host key.\n- Wrong request key.\n- Wrong response key.\n- Artifact replacement after preflight.\n- Backpressure.\n- Partial SSH writes.\n- Lost response after broker completion.\n- No native Darwin execution fallback.\n\n### Milestone 8: deployment, independent gates, and Linux qualification\n\n#### Affected paths\n\n- `deploy/systemd/`\n- `deploy/sysusers.d/`\n- `deploy/tmpfiles.d/yinshi.conf`\n- `deploy/orbstack/`\n- New `scripts/qualify-phase6-linux.sh`\n- New `backend/tests/test_phase6_linux_qualification.py`\n- `.github/workflows/`\n- `backend/src/yinshi/services/workspace_isolation.py`\n- `desktop/src/isolationProfile.ts`\n- `docs/workspace-isolation.md`\n- `docs/workspace-os-isolation.md`\n- `docs/broker-root-launcher.md`\n\n#### Deployment work\n\n- Provision fixed `yinshi-app`, `yinshi-broker`, root launcher, and executor identities.\n- Create separate broker-owned incoming and published roots.\n- Keep launcher staging ownership separate.\n- Install upload relay as a forced SSH command.\n- Deny arbitrary commands, PTY allocation, forwarding, and caller environment injection.\n- Protect request public keys and broker private keys from executors.\n- Add disk quotas and retained-state capacity alarms.\n- Sandbox Git verifiers away from broker signing keys.\n\n#### Root gates\n\nKeep three independent defaults:\n\n```text\nlaunch = disabled\nprepare = disabled\nreclaim = disabled\n```\n\nNo aggregate switch may enable all three.\n\nPackaged unit tests must confirm each action remains rejected when only another action is enabled.\n\n#### Linux qualification\n\nQualification must verify:\n\n- Approved distribution, kernel, and systemd versions.\n- Required atomic no-replace filesystem support.\n- Unix peer credential support.\n- PID or cgroup liveness authority.\n- Fixed account identities and group membership.\n- Directory ownership and modes.\n- Socket ownership and modes.\n- SSH forced-command restrictions.\n- Broker key protection.\n- Executor isolation from host and broker data.\n- Resource ceilings.\n- Reboot recovery.\n- Live-runtime reclaim blocking.\n- Near-limit upload behavior.\n- Every root gate default.\n\n`evaluate_local_isolation_profile()` must remain the sole policy owner.\n\nLinux becomes supported only after checking a root-owned qualification attestation. Platform name alone must never enable execution.\n\n#### Completion behavior\n\nA qualified Linux image passes end-to-end testing. Unqualified Linux and native Darwin remain fail closed.\n\n## 6. Migration concerns\n\n### Journal compatibility\n\nCurrent journal rows bind exact canonical request bytes.\n\nChanging digest projection or payload interpretation can make existing rows unreplayable. This requires an explicit compatibility decision.\n\nSafe options are:\n\n1. Introduce a versioned request schema and retain old readers.\n2. Use a new journal database for the new protocol.\n3. Declare pre-production data disposable through an approved migration.\n\nSource does not establish which policy is acceptable.\n\n### Filesystem migration\n\nIncoming, published, launcher staging, and runtime roots must remain separate.\n\nStartup must reject or quarantine orphan directories. It must not infer authority from directory names.\n\n### Key rotation\n\nOld journal responses require their original broker public keys for replay verification.\n\nRotation needs retained key identifiers and a protected trust history. Deleting old verification keys can strand incomplete operations.\n\n## 7. Rollback\n\nRollback begins by disabling upload access plus all root gates.\n\n- Stop accepting new replica requests.\n- Keep journal, artifacts, prepared replicas, and unresolved state.\n- Do not delete a live or unresolved replica.\n- Retain a binary version capable of reading the active journal schema.\n- Reclaim only after verified export, drain acknowledgment, and dead-runtime observation.\n\nPublished artifacts are append-only. Root reclaim is the principal irreversible operation.\n\n## 8. Review findings\n\n1. **Blocker:** `backend/src/yinshi/services/execution_broker.py` does not dispatch `replica.lifecycle`.\n2. **Blocker:** `backend/src/yinshi/broker_stdio_relay.py` cannot stream the required artifact body.\n3. **High:** `workspace_replica_publication.py` uses whole-file byte APIs unsuitable for maximum production sizes.\n4. **Blocker:** publication layout does not match root launcher’s exact `repo/` plus `home/` staging contract.\n5. **Blocker:** no concrete seven-stage `ReplicaLifecycleEffects` implementation exists.\n6. **Blocker:** desktop has no VM artifact transport or response verifier.\n7. **Blocker:** Linux remains `isolation_unverified`, so no production execution profile exists.\n8. **High:** drain, export, runtime shutdown, and liveness authority lack a production protocol.\n9. **High:** artifact quota, key provisioning, and verifier isolation need infrastructure approval.\n10. **Low:** `docs/workspace-isolation.md` still says broker schemas do not exist, which conflicts with committed foundations.\n\n## 9. Residual risks\n\n- Git parsing under the broker identity could expose signing credentials after verifier compromise.\n- A one-GiB upload can exhaust disk without reservation and quotas.\n- Worktree descriptor decoding needs parser-equivalence tests.\n- Lost executor export identity may be impossible to recover safely.\n- Old broker keys may be required for journal replay indefinitely.\n- Runtime liveness authority differs between systemd, containers, and VM implementations.\n- Existing dirty Phase 6 files can shift APIs during implementation.\n\n## 10. Completion conditions\n\nPhase 6 production wiring is complete only when all conditions hold:\n\n- Desktop streams exactly three authenticated artifacts to a fixed VM command.\n- Broker authenticates before artifact reads.\n- Broker dispatches authenticated request plus exact raw frame.\n- All seven concrete effects pass crash-window tests.\n- SQLite contains no artifact bytes.\n- No connection crosses an awaited effect.\n- Root protocol contains no stop action.\n- Missing drain acknowledgment blocks reclaim.\n- Live runtime blocks reclaim.\n- Every unknown remains stage-specific.\n- Request and response signatures are checked end to end.\n- Root gates are independently off by default.\n- Startup recovery runs before readiness.\n- Native Darwin remains fail closed.\n- Qualified Linux passes disposable-VM end-to-end tests.\n\n## 11. Handoff\n\nParent must approve Milestone 0 decisions before a writer starts.\n\nFirst implementation action after approval: freeze canonical wire vectors in `replica_artifact_contract.py` and cross-language tests.\n\nDeployment unit contents under `deploy/systemd/` still need line-level inspection before editing.\n\nHighest-impact assumption is desktop-side source capture. A VM-pull model would replace desktop streaming, key ownership, and export routing.","controlEvents":[{"type":"active_long_running","to":"active_long_running","ts":1789267154893,"runId":"d856fe34","agent":"planner","index":0,"message":"planner is still active but long-running","reason":"time_threshold","turns":13,"tokens":263424,"toolCount":48,"elapsedMs":240544}],"attemptedModels":["openai-codex/gpt-5.6-sol:max"],"modelAttempts":[{"model":"openai-codex/gpt-5.6-sol:max","success":true,"exitCode":0,"usage":{"input":266768,"output":21072,"cacheRead":698368,"cacheWrite":0,"cost":2.315184,"turns":14}}],"sessionFile":"/Users/user/.pi/agent/sessions/--Users-user-projects-yinshi--/2026-09-04T04-44-52-550Z_01a06abb-dfc5-7c65-82bb-7c5f2081ee64/d856fe34/run-0/session.jsonl","acceptance":{"status":"attested","evidenceStatus":"attested","explicit":false,"effectiveAcceptance":{"level":"attested","explicit":false,"inferredReason":["read-only task wording"],"criteria":[{"id":"criterion-1","must":"Return concrete findings with file paths and severity when applicable","evidence":["review-findings","residual-risks"],"severity":"required"}],"evidence":["review-findings","residual-risks"],"verify":[],"stopRules":[]},"inferredReason":["read-only task wording"],"criteria":[{"id":"criterion-1","must":"Return concrete findings with file paths and severity when applicable","evidence":["review-findings","residual-risks"],"severity":"required"}],"runtimeChecks":[],"verifyRuns":[],"childReport":{"criteriaSatisfied":[{"id":"criterion-1","status":"satisfied","evidence":"Sections 2, 8, and 9 provide path-cited current behavior, severity-ranked review findings, and residual risks."}],"changedFiles":[],"testsAddedOrUpdated":[],"commandsRun":[{"command":"git status --short && git log --oneline --decorate -15","result":"passed","summary":"Confirmed current commits, extensive inherited dirty worktree state, and no staged files."},{"command":"git show --format=fuller --stat 7f91105f && git show --format=fuller --stat 922f197b","result":"passed","summary":"Confirmed exact committed Phase 6 foundations and affected files."},{"command":"repository searches and AST outlines for broker, replica, root, desktop, deployment, and test symbols","result":"passed","summary":"Mapped current APIs, callers, tests, missing dispatch, and missing desktop transport."},{"command":"pytest and desktop test suites","result":"not-run","summary":"Plan-only review made no implementation changes."}],"validationOutput":["Confirmed broker production dispatch currently supports executor.launch only.","Confirmed existing stdio relay is fixed-path, bounded, opaque, and request-frame-only.","Confirmed artifact store streams exact-three files outside SQLite.","Confirmed lifecycle coordinator has no concrete production effect wiring.","Confirmed native Darwin and unqualified Linux currently fail closed."],"residualRisks":["Desktop source-capture policy needs product approval.","Artifact digest compatibility and journal migration policy remain unresolved.","Executor drain, export, shutdown, and liveness authority need approval.","Linux provider, quota, SSH authorization, and key lifecycle need infrastructure decisions.","Verifier isolation from broker signing credentials remains unresolved."],"noStagedFiles":true,"diffSummary":"No files changed. Repository already contains extensive inherited Phase 6 working-tree changes.","reviewFindings":["blocker: backend/src/yinshi/services/execution_broker.py - replica.lifecycle is not dispatched.","blocker: backend/src/yinshi/broker_stdio_relay.py - current relay cannot stream artifact bodies.","high: backend/src/yinshi/services/workspace_replica_publication.py - production publication retains whole-file bytes.","blocker: backend/src/yinshi/root_launcher.py - required repo/home staging layout differs from artifact publication layout.","blocker: backend/src/yinshi/services/broker_replica_lifecycle.py - only synthetic effects exist.","blocker: desktop/src - no authenticated VM artifact transport exists.","blocker: backend/src/yinshi/services/workspace_isolation.py - Linux remains unqualified and fail closed."],"manualNotes":"Runtime should persist this plan at the configured authoritative output path. No repository or remote state was modified."}},"toolCalls":[{"text":"ls {\"path\":\".\",\"limit\":500}","expandedText":"ls {\"path\":\".\",\"limit\":500}"},{"text":"find {\"path\":\".\",\"pattern\":\"**/{AGENTS.md,CLA...","expandedText":"find {\"path\":\".\",\"pattern\":\"**/{AGENTS.md,CLAUDE.md,CONTRIBUTING.md,README.md}\",\"limit\":100}"},{"text":"$ git status --short && git log --oneline --decorate -15","expandedText":"$ git status --short && git log --oneline --decorate -15"},{"text":"find {\"path\":\".\",\"pattern\":\"**/*phase*6*\",\"li...","expandedText":"find {\"path\":\".\",\"pattern\":\"**/*phase*6*\",\"limit\":200}"},{"text":"read CLAUDE.md","expandedText":"read CLAUDE.md"},{"text":"read README.md","expandedText":"read README.md"},{"text":"$ git diff --stat && git diff --numstat | tail -n +1 && git st...","expandedText":"$ git diff --stat && git diff --numstat | tail -n +1 && git status --short | wc -l"},{"text":"find {\"path\":\"docs\",\"pattern\":\"**/*.md\",\"limi...","expandedText":"find {\"path\":\"docs\",\"pattern\":\"**/*.md\",\"limit\":200}"},{"text":"find {\"path\":\"plans\",\"pattern\":\"**/*\",\"limit\"...","expandedText":"find {\"path\":\"plans\",\"pattern\":\"**/*\",\"limit\":200}"},{"text":"$ git show --stat --oneline 7f91105f && printf '\\n--- 922 ---\\...","expandedText":"$ git show --stat --oneline 7f91105f && printf '\\n--- 922 ---\\n' && git show --stat --oneline 922f197b"},{"text":"grep {\"path\":\".\",\"pattern\":\"Phase 6|phase 6|p...","expandedText":"grep {\"path\":\".\",\"pattern\":\"Phase 6|phase 6|phase6|production wiring\",\"glob\":\"*.{md,py,ts,js,json,toml}\",\"ignoreCase\":false,\"context\":2,\"limit\":200}"},{"text":"read docs/broker-root-launcher.md","expandedText":"read docs/broker-root-launcher.md"},{"text":"read PYTHON.md","expandedText":"read PYTHON.md"},{"text":"grep {\"path\":\"backend/src\",\"pattern\":\"BrokerR...","expandedText":"grep {\"path\":\"backend/src\",\"pattern\":\"BrokerRequest|Replica|artifact|coordinator|prepare|reclaim\",\"glob\":\"**/*.py\",\"ignoreCase\":false,\"context\":1,\"limit\":300}"},{"text":"find {\"path\":\"backend/src/yinshi/services\",\"p...","expandedText":"find {\"path\":\"backend/src/yinshi/services\",\"pattern\":\"*broker*\",\"limit\":100}"},{"text":"find {\"path\":\"backend/src/yinshi/services\",\"p...","expandedText":"find {\"path\":\"backend/src/yinshi/services\",\"pattern\":\"*replica*\",\"limit\":100}"},{"text":"find {\"path\":\"backend/tests\",\"pattern\":\"test_...","expandedText":"find {\"path\":\"backend/tests\",\"pattern\":\"test_*broker*\",\"limit\":100}"},{"text":"find {\"path\":\"backend/tests\",\"pattern\":\"test_...","expandedText":"find {\"path\":\"backend/tests\",\"pattern\":\"test_*replica*\",\"limit\":100}"},{"text":"$ python3 - <<'PY'\nimport ast, pathlib\nfiles = [\n'backend/src/...","expandedText":"$ python3 - <<'PY'\nimport ast, pathlib\nfiles = [\n'backend/src/yinshi/services/replica_artifact_contract.py',\n'backend/src/yinshi/services/broker_artifact_store.py',\n'backend/src/yinshi/services/broker_replica_journal.py',\n'backend/src/yinshi/..."},{"text":"read backend/src/yinshi/services/replica_artifact_contract.py","expandedText":"read backend/src/yinshi/services/replica_artifact_contract.py"},{"text":"read backend/src/yinshi/services/broker_protocol.py","expandedText":"read backend/src/yinshi/services/broker_protocol.py"},{"text":"read backend/src/yinshi/broker_stdio_relay.py","expandedText":"read backend/src/yinshi/broker_stdio_relay.py"},{"text":"read backend/src/yinshi/services/broker_replica_lifecycle.py","expandedText":"read backend/src/yinshi/services/broker_replica_lifecycle.py"},{"text":"read backend/tests/test_broker_replica_lifecycle.py","expandedText":"read backend/tests/test_broker_replica_lifecycle.py"},{"text":"$ python3 - <<'PY'\nimport ast, pathlib\nfor f in ['backend/src/...","expandedText":"$ python3 - <<'PY'\nimport ast, pathlib\nfor f in ['backend/src/yinshi/services/broker_replica_journal.py','backend/src/yinshi/services/broker_artifact_store.py','backend/src/yinshi/services/workspace_replica_publication.py','backend/src/yinshi..."},{"text":"read backend/src/yinshi/services/broker_replica_journal.py","expandedText":"read backend/src/yinshi/services/broker_replica_journal.py"},{"text":"grep {\"path\":\"backend/tests/test_broker_repli...","expandedText":"grep {\"path\":\"backend/tests/test_broker_replica_journal.py\",\"pattern\":\"^def test_|^async def test_\",\"ignoreCase\":false,\"context\":0,\"limit\":300}"},{"text":"read backend/src/yinshi/services/broker_artifact_store.py","expandedText":"read backend/src/yinshi/services/broker_artifact_store.py"},{"text":"grep {\"path\":\"backend/tests/test_broker_artif...","expandedText":"grep {\"path\":\"backend/tests/test_broker_artifact_store.py\",\"pattern\":\"^def test_|^async def test_\",\"ignoreCase\":false,\"context\":0,\"limit\":200}"},{"text":"grep {\"path\":\"backend\",\"pattern\":\"BrokerRepli...","expandedText":"grep {\"path\":\"backend\",\"pattern\":\"BrokerReplicaLifecycleCoordinator|ReplicaLifecycleEffects|BrokerArtifactStore|WorkspaceReplicaPublicationStore\",\"glob\":\"**/*.py\",\"i..."},{"text":"grep {\"path\":\"backend\",\"pattern\":\"broker_stdi...","expandedText":"grep {\"path\":\"backend\",\"pattern\":\"broker_stdio_relay|yinshi-broker-stdio-relay\",\"glob\":\"**/*\",\"ignoreCase\":false,\"context\":2,\"limit\":200}"},{"text":"read backend/src/yinshi/services/execution_broker.py","expandedText":"read backend/src/yinshi/services/execution_broker.py"},{"text":"read backend/src/yinshi/services/broker_runtime.py","expandedText":"read backend/src/yinshi/services/broker_runtime.py"},{"text":"read backend/src/yinshi/execution_daemons.py","expandedText":"read backend/src/yinshi/execution_daemons.py"},{"text":"$ python3 - <<'PY'\nimport json\nfor p in ['.pi-subagents/missio...","expandedText":"$ python3 - <<'PY'\nimport json\nfor p in ['.pi-subagents/missions/26941e53-e8a4-440c-b48c-87e68c2ecd96.json','.pi-subagents/missions/1ddc3600-5633-4f2b-add2-60c692b5.json']:\n try:\n  d=json.load(open(p)); print('\\n##',p); print(d.get('summary',..."},{"text":"$ find /tmp -maxdepth 1 -type f \\( -iname '*phase6*' -o -iname...","expandedText":"$ find /tmp -maxdepth 1 -type f \\( -iname '*phase6*' -o -iname '*replica*' -o -iname '*transport*' \\) -print | sort | tail -100"},{"text":"find {\"path\":\"desktop\",\"pattern\":\"**/*\",\"limi...","expandedText":"find {\"path\":\"desktop\",\"pattern\":\"**/*\",\"limit\":500}"},{"text":"grep {\"path\":\"desktop\",\"pattern\":\"ssh|broker|...","expandedText":"grep {\"path\":\"desktop\",\"pattern\":\"ssh|broker|replica|artifact|VM|vm\",\"glob\":\"**/*.{ts,tsx,js,mjs,json,plist,swift,md}\",\"ignoreCase\":true,\"context\":2,\"limit\":300}"},{"text":"grep {\"path\":\"backend/src\",\"pattern\":\"workspa...","expandedText":"grep {\"path\":\"backend/src\",\"pattern\":\"workspace_replica\",\"glob\":\"**/*.py\",\"ignoreCase\":false,\"context\":2,\"limit\":300}"},{"text":"$ python3 - <<'PY'\nimport json,re\np='.pi-subagents/missions/26...","expandedText":"$ python3 - <<'PY'\nimport json,re\np='.pi-subagents/missions/26941e53-e8a4-440c-b48c-87e68c2ecd96.json'\nd=json.load(open(p)); s=d['summary']\ntry:\n j=json.loads(s[s.index('{'):])\n print(j['output'])\nexcept Exception as e:\n print('parse failed',..."},{"text":"read .pi-subagents/missions/26941e53-e8a4-440c-b48c-87e68c2ecd96.json","expandedText":"read .pi-subagents/missions/26941e53-e8a4-440c-b48c-87e68c2ecd96.json"},{"text":"read .pi-subagents/artifacts/44151b43_worker-expert_0_output.md","expandedText":"read .pi-subagents/artifacts/44151b43_worker-expert_0_output.md"},{"text":"$ git show --format=fuller --stat 7f91105f -- && printf '\\n---...","expandedText":"$ git show --format=fuller --stat 7f91105f -- && printf '\\n---\\n' && git show --format=fuller --stat 922f197b -- && printf '\\nNAMES\\n' && git diff-tree --no-commit-id --name-status -r 7f91105f && git diff-tree --no-commit-id --name-status -r ..."},{"text":"$ git status --short | sed -n '1,200p'","expandedText":"$ git status --short | sed -n '1,200p'"},{"text":"$ git diff --name-status -- backend/src/yinshi/services backen...","expandedText":"$ git diff --name-status -- backend/src/yinshi/services backend/src/yinshi desktop deploy docs .github backend/tests | sed -n '1,250p'"},{"text":"$ git diff -- backend/src/yinshi/services/broker_protocol.py b...","expandedText":"$ git diff -- backend/src/yinshi/services/broker_protocol.py backend/src/yinshi/services/execution_broker.py backend/src/yinshi/services/broker_runtime.py backend/src/yinshi/execution_daemons.py backend/src/yinshi/root_launcher.py | git diff ..."},{"text":"read docs/workspace-isolation.md","expandedText":"read docs/workspace-isolation.md"},{"text":"read docs/workspace-os-isolation.md","expandedText":"read docs/workspace-os-isolation.md"}]}]},"trace":[{"operation":"run","key":"remaining_phase6_plan","state":"started"},{"operation":"run","key":"remaining_phase6_plan","state":"completed","durationMs":660358,"runId":"d856fe34"}],"emits":[],"console":[]},"chatProgress":{"mode":"live-card","repoRelation":"same","repoLabel":"yinshi"},"missionId":"c9db31be-0a8f-42cf-87a5-d8109817e2fa","missionPath":"/Users/user/projects/yinshi/.pi-subagents/missions/c9db31be-0a8f-42cf-87a5-d8109817e2fa.json","mission":{"schemaVersion":1,"id":"c9db31be-0a8f-42cf-87a5-d8109817e2fa","title":"Create an implementation-ready plan for the remaining Phase 6 production wiring in the current ch...","objective":"Create an implementation-ready plan for the remaining Phase 6 production wiring in the current checkout. The completed foundations are commits 7f91105f and 922f197b: authenticated exact-three artifact contract/store/publication, append-only replica journal, and stateless seven-stage coordinator. Required result: authenticated desktop-to-VM artifact transport; broker dispatch; concrete ingest, verify, publish, admission, graceful drain, exact-three-reference export, and reclaim effects; fail-closed native Darwin; all root gates independently disabled by default; startup recovery; Linux qualification. Preserve these invariants: no SQLite handle crosses await or external effect; artifact bytes stay outside SQLite; stream exactly committed.bundle, worktree.yra, index-objects.pack; root protocol remains prepare, launch, reclaim only; no root stop action; missing drain acknowledgment or live runtime blocks reclaim; unknown results stay stage-specific unresolved; fixed executor identities; request and response Ed25519 authentication; coordinator receives authenticated BrokerRequest plus raw frame. Inspect actual current files and APIs. Do not modify files. Resolve ownership and transport framing, identify precise modules/tests per milestone, and distinguish concrete reusable support from new interfaces. Also identify any requirements that cannot be safely implemented without a product decision.","status":"completed","createdAt":"2026-09-13T02:35:14.022Z","updatedAt":"2026-09-13T02:46:14.552Z","runs":[{"runId":"call_7mwCmVosIBiAbiXcIKclYzbb|fc_0212e7de83dbbd32016aa60bd91f2c87d0bc1153cb22736dc5","mode":"workflow","agent":"planner","status":"completed","startedAt":"2026-09-13T02:46:14.551Z","completedAt":"2026-09-13T02:46:14.551Z","usage":{"tokens":287840}}],"decisions":[],"artifacts":[{"kind":"output","path":"/Users/user/projects/yinshi/.pi-subagents/artifacts/d856fe34_planner_0_output.md"},{"kind":"output","path":"/Users/user/projects/yinshi/.pi-subagents/artifacts/outputs/d856fe34/.pi-subagents/artifacts/remaining-phase6-plan.md"},{"kind":"other","path":"/Users/user/projects/yinshi/.pi-subagents/artifacts/d856fe34_planner_0_transcript.jsonl","description":"Child transcript"}],"receipts":[],"cwd":"/Users/user/projects/yinshi","ownerSessionId":"/Users/user/.pi/agent/sessions/--Users-user-projects-yinshi--/2026-09-04T04-44-52-550Z_01a06abb-dfc5-7c65-82bb-7c5f2081ee64.jsonl","summary":"Workflow completed.\n\nReturn:\n{\n  \"key\": \"remaining_phase6_plan\",\n  \"ok\": true,\n  \"runId\": \"d856fe34\",\n  \"output\": \"# Remaining Phase 6 production wiring plan\\n\\n## 1. Scope and requested observable result\\n\\nPhase 6 should provide this observable path:\\n\\n1. Desktop captures three replica artifacts.\\n2. Desktop signs one strict `replica.lifecycle` request.\\n3. Desktop streams request plus three artifacts through a fixed SSH command.\\n4. Broker authenticates request before reading artifact bytes.\\n5. Broker journals and executes seven ordered stages.\\n6. Broker returns an Ed25519-authenticated response.\\n7. Desktop verifies response before reporting success.\\n8. Broker resumes incomplete operations after restart.\\n9. Native Darwin execution remains unavailable.\\n10. Linux execution remains unavailable until qualification passes.\\n11. Root prepare, launch, and reclaim gates remain separately disabled by default.\\n\\nRequired artifact stream order is fixed:\\n\\n1. `committed.bundle`\\n2. `worktree.yra`\\n3. `index-objects.pack`\\n\\nNo artifact identifier becomes a filesystem path.\\n\\n## 2. Established current behavior\\n\\n### Foundation state\\n\\n- Commit `7f91105f` added authenticated artifact contracts, storage, publication, and the append-only replica journal.\\n- Commit `922f197b` added `BrokerReplicaLifecycleCoordinator` and its seven-stage effect contract.\\n- Evidence: `git show --format=fuller --stat 7f91105f` and the equivalent `922f197b` command.\\n\\n### Control plane\\n\\n- `backend/src/yinshi/services/broker_protocol.py` authenticates requests and responses with Ed25519.\\n- Request frames are limited to 65,536 bytes.\\n- `BrokerRequest` contains authenticated parsed data. Exact raw frame bytes remain separately available.\\n- `backend/src/yinshi/services/execution_broker.py` currently handles only `executor.launch`.\\n- No production caller instantiates `BrokerReplicaLifecycleCoordinator`.\\n- Evidence: repository search for `BrokerReplicaLifecycleCoordinator`, `Replica...","acceptance":{"status":"attested","evidenceStatus":"attested","explicit":false,"effectiveAcceptance":{"level":"attested","explicit":false,"inferredReason":["read-only task wording"],"criteria":[{"id":"criterion-1","must":"Return concrete findings with file paths and severity when applicable","evidence":["review-findings","residual-risks"],"severity":"required"}],"evidence":["review-findings","residual-risks"],"verify":[],"stopRules":[]},"inferredReason":["read-only task wording"],"criteria":[{"id":"criterion-1","must":"Return concrete findings with file paths and severity when applicable","evidence":["review-findings","residual-risks"],"severity":"required"}],"runtimeChecks":[],"verifyRuns":[],"childReport":{"criteriaSatisfied":[{"id":"criterion-1","status":"satisfied","evidence":"Sections 2, 8, and 9 provide path-cited current behavior, severity-ranked review findings, and residual risks."}],"changedFiles":[],"testsAddedOrUpdated":[],"commandsRun":[{"command":"git status --short && git log --oneline --decorate -15","result":"passed","summary":"Confirmed current commits, extensive inherited dirty worktree state, and no staged files."},{"command":"git show --format=fuller --stat 7f91105f && git show --format=fuller --stat 922f197b","result":"passed","summary":"Confirmed exact committed Phase 6 foundations and affected files."},{"command":"repository searches and AST outlines for broker, replica, root, desktop, deployment, and test symbols","result":"passed","summary":"Mapped current APIs, callers, tests, missing dispatch, and missing desktop transport."},{"command":"pytest and desktop test suites","result":"not-run","summary":"Plan-only review made no implementation changes."}],"validationOutput":["Confirmed broker production dispatch currently supports executor.launch only.","Confirmed existing stdio relay is fixed-path, bounded, opaque, and request-frame-only.","Confirmed artifact store streams exact-three files outside SQLite.","Confirmed lifecycle coordinator has no concrete production effect wiring.","Confirmed native Darwin and unqualified Linux currently fail closed."],"residualRisks":["Desktop source-capture policy needs product approval.","Artifact digest compatibility and journal migration policy remain unresolved.","Executor drain, export, shutdown, and liveness authority need approval.","Linux provider, quota, SSH authorization, and key lifecycle need infrastructure decisions.","Verifier isolation from broker signing credentials remains unresolved."],"noStagedFiles":true,"diffSummary":"No files changed. Repository already contains extensive inherited Phase 6 working-tree changes.","reviewFindings":["blocker: backend/src/yinshi/services/execution_broker.py - replica.lifecycle is not dispatched.","blocker: backend/src/yinshi/broker_stdio_relay.py - current relay cannot stream artifact bodies.","high: backend/src/yinshi/services/workspace_replica_publication.py - production publication retains whole-file bytes.","blocker: backend/src/yinshi/root_launcher.py - required repo/home staging layout differs from artifact publication layout.","blocker: backend/src/yinshi/services/broker_replica_lifecycle.py - only synthetic effects exist.","blocker: desktop/src - no authenticated VM artifact transport exists.","blocker: backend/src/yinshi/services/workspace_isolation.py - Linux remains unqualified and fail closed."],"manualNotes":"Runtime should persist this plan at the configured authoritative output path. No repository or remote state was modified."}}}},"isError":false,"timestamp":1789267574978}}
{"type":"message","id":"22f18d87","parentId":"1b7d5984","timestamp":"2026-09-13T02:46:33.549Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Planning key enrollment and upload decisions**\n\n**Evaluating lifecycle stage sequencing and constraints**\n\n**Analyzing admission effect for job execution**","thinkingSignature":"{\"id\":\"rs_0212e7de83dbbd32016aa60e791e2887d0bf92b7b1f0e4152e\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"REDACTED\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Planning key enrollment and upload decisions**\"},{\"type\":\"summary_text\",\"text\":\"**Evaluating lifecycle stage sequencing and constraints**\"},{\"type\":\"summary_text\",\"text\":\"**Analyzing admission effect for job execution**\"}]}"},{"type":"toolCall","id":"call_xn5LNTBcyPHtdgE8XkHmdjfk|fc_0212e7de83dbbd32016aa60e88f10087d082fa2404ca611fb4","name":"read","arguments":{"path":".pi-subagents/artifacts/44151b43_worker-expert_0_output.md","offset":1,"limit":800}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-sol","usage":{"input":20672,"output":556,"cacheRead":98304,"cacheWrite":0,"reasoning":512,"totalTokens":119532,"cost":{"input":0.10336000000000001,"output":0.01668,"cacheRead":0.049152,"cacheWrite":0,"total":0.169192}},"stopReason":"toolUse","timestamp":1789267575004,"responseId":"resp_0212e7de83dbbd32016aa60e77936c87d0af7490043a1770bb","rawStopReason":"completed"}}
{"type":"message","id":"4ab2b339","parentId":"22f18d87","timestamp":"2026-09-13T02:46:33.583Z","message":{"role":"toolResult","toolCallId":"call_xn5LNTBcyPHtdgE8XkHmdjfk|fc_0212e7de83dbbd32016aa60e88f10087d082fa2404ca611fb4","toolName":"read","content":[{"type":"text","text":"## Causal diagnosis\n\nPhase 6 has a control plane, but no artifact data plane.\n\nCurrent signed broker request can authenticate artifact metadata. Current relay cannot carry artifact bytes safely. Current publication store only accepts in-memory bytes. Root prepare expects a different directory shape.\n\n### Findings\n\n1. **Blocker: replica lifecycle requests never reach replica journal**\n   - `backend/src/yinshi/services/execution_broker.py:22-24` supports only `executor.launch`.\n   - `BrokerReplicaJournal` exists, but broker daemon does not dispatch `replica.lifecycle`.\n   - Result: signed replica requests cannot begin ingestion, verification, or publication.\n\n2. **Blocker: current relay cannot carry artifacts**\n   - `backend/src/yinshi/broker_stdio_relay.py:27-29` fixes `/run/yinshi/broker.sock`, which is correct.\n   - `backend/src/yinshi/services/broker_protocol.py:16-18` caps requests at 65,536 bytes.\n   - `backend/src/yinshi/execution_daemons.py:_read_frame` reads one complete frame, requires EOF, and buffers frame bytes.\n   - Artifacts allow up to 1 GiB per set. Sending them inside signed JSON is impossible and unsafe.\n\n3. **High: publication APIs cause whole-set memory amplification**\n   - `backend/src/yinshi/services/workspace_replica_publication.py:773-779` accepts three `bytes` objects.\n   - `_PinnedRegular.content` retains complete file bytes.\n   - `_read_descriptor` joins all chunks into one object.\n   - `_recheck_pinned_regular` reads files again and compares full byte objects.\n   - Bundle verification copies bytes into a temporary file.\n   - Index-pack verification passes the entire pack through `stdin_bytes`.\n   - A near-limit set can create several GiB of transient memory.\n\n4. **Blocker: published artifact layout is incompatible with root prepare**\n   - `WorkspaceReplicaPublicationStore` publishes:\n     - `artifact-set.json`\n     - `committed.bundle`\n     - `worktree.yra`\n     - `index-objects.pack`\n   - `backend/src/yinshi/root_launcher.py:1198-1199` requires exactly `repo` and `home`.\n   - Pointing the publication store at `/var/lib/yinshi-launcher/staging` will always fail prepare.\n\n5. **High: artifact-set digest contracts need one shared definition**\n   - Replica journal accepts caller-supplied `artifact_set_sha256`.\n   - Publication store computes a domain digest from the complete declaration.\n   - That declaration includes authority, limits, repository identity, workspace identity, and media metadata.\n   - Journal payload tests do not establish that desktop can reproduce this exact declaration.\n   - Broker must recompute one shared digest before accepting bytes. Silent reinterpretation would change persisted meaning.\n\n6. **Medium: current deadlines do not fit bounded GiB ingestion**\n   - `backend/src/yinshi/execution_daemons.py` uses a 120-second connection deadline.\n   - `backend/src/yinshi/broker_stdio_relay.py` uses 125 seconds.\n   - Slow but valid 1 GiB uploads can fail despite continuous progress.\n\n7. **High: SSH identity is not end-to-end artifact authentication**\n   - Broker sees Unix peer UID `yinshi-app`, not original desktop SSH identity.\n   - Existing Ed25519 request verification provides correct application-layer authentication.\n   - Artifact bytes must be bound to that signed request through signed lengths and digests.\n\n## Smallest secure wire protocol\n\nKeep existing `yinshi-broker-stdio-relay` unchanged.\n\nAdd a second fixed executable:\n\n```text\nyinshi-broker-artifact-upload\n```\n\nIt accepts no arguments and connects only to:\n\n```text\n/run/yinshi/broker.sock\n```\n\nReuse existing broker socket. No caller-selected path or new Unix listener is needed.\n\n### Upload wire format\n\n```text\nu32be signed_request_length\nsigned replica.lifecycle request\ncommitted.bundle bytes, exact signed length\nworktree.yra bytes, exact signed length\nindex-objects.pack bytes, exact signed length\nEOF\n```\n\nResponse remains existing format:\n\n```text\nu32be signed_response_length\nbroker-signed canonical JSON response\n```\n\nNo artifact names, offsets, paths, or chunk headers cross the wire. Order is fixed by protocol.\n\n### Authentication\n\nDesktop signs metadata containing, for every fixed role:\n\n- Artifact ID\n- SHA-256 digest\n- Byte length\n\nSignature also binds:\n\n- Operation ID\n- Broker incarnation\n- Database incarnation\n- Sequence\n- Nonce\n- Object format\n- Source-state digest\n- Reconciliation fingerprint\n- Artifact-set digest\n\nBroker authenticates signed request before reading artifact data.\n\nChunks need no individual Ed25519 signatures. Chunk boundaries are transport details. Signed file length, fixed ordering, and signed SHA-256 bind every file byte and position.\n\nBroker publishes nothing until all three incremental hashes match. Modified, reordered, truncated, extended, or substituted bytes fail verification.\n\n## Bounds and backpressure\n\nUse 64 KiB transfer buffers at every hop.\n\nDesktop:\n\n1. Write bounded signed frame.\n2. Stream each local file through SSH.\n3. Respect writable-stream backpressure.\n4. Close SSH stdin after third file.\n\nUpload relay:\n\n1. Buffer only four-byte prefix plus signed frame.\n2. Forward frame immediately.\n3. Copy remaining stdin in 64 KiB blocks.\n4. Call socket drain after each block.\n5. Enforce fixed global tail ceiling of 1 GiB.\n6. Expose no CLI options.\n\nBroker:\n\n1. Validate signed declared lengths before reading data.\n2. Enforce per-role server ceilings.\n3. Enforce aggregate 1 GiB ceiling.\n4. Read exactly each declared length.\n5. Reject any trailing byte.\n6. Incrementally hash while writing.\n7. Apply idle deadlines, not one 120-second total deadline.\n8. Limit concurrent uploads and reserve declared storage.\n\nSocket and SSH flow control then propagate disk pressure back to desktop. No layer queues an entire artifact.\n\n## Storage ownership and safe mapping\n\n### Durable artifact roots\n\nAdd broker-owned roots:\n\n```text\n/var/lib/yinshi/artifacts/incoming\n/var/lib/yinshi/artifacts/published\n```\n\nBoth should be `0700`, owned by `yinshi-broker`.\n\nDesktop and `yinshi-app` never write these roots. Broker performs every artifact write.\n\nArtifact IDs must never become path components. Broker maps signed roles to fixed names:\n\n```text\ncommitted_bundle -> committed.bundle\nworktree         -> worktree.yra\nindex_objects    -> index-objects.pack\n```\n\nRequire all three artifact IDs to be distinct.\n\nOpen operation directories relative to pinned root descriptors. Open files with:\n\n```text\nO_NOFOLLOW | O_CLOEXEC | O_NONBLOCK\n```\n\nRequire:\n\n- Regular file\n- Broker ownership\n- Mode `0600`\n- Link count one\n- Exact signed length\n- Matching named and opened inode\n- Matching filesystem identity\n\nConsumers request a role. Store returns a pinned descriptor plus authenticated artifact ID. It never resolves `root / artifact_id`.\n\n## Ingestion and retry flow\n\n1. Broker authenticates request.\n2. Broker validates strict replica payload and limits.\n3. Journal records exact signed request.\n4. Journal claims lifecycle authority.\n5. Journal begins `ingest`.\n6. Broker creates broker-generated pending directory with `O_EXCL` semantics.\n7. Broker streams fixed files using exclusive creation.\n8. Broker hashes and synchronizes each file.\n9. Broker verifies directory and file identities.\n10. Broker renames pending directory to `incoming/<operation_id>` with no replacement.\n11. Broker synchronizes both parents.\n12. Journal completes `ingest`.\n\nNever overwrite an existing file or directory.\n\nRetry rules:\n\n- Exact request plus exact completed incoming set: inspect and reuse.\n- Exact request plus exact published set: return stored or reconstructed progress.\n- Existing set with different identity or content: reject. Never replace it.\n- Different signed frame using same operation ID: journal conflict.\n- Partial live attempt with confirmed cleanup: retry starts a new exclusive attempt.\n- Uncertain cleanup or rename: mark unresolved and retain state.\n- Lost final response: exact request replay returns journaled signed response.\n- Restart with only partial bytes: quarantine attempt and mark `transfer_unknown`.\n- Restart with exact synchronized incoming files: resume deterministic verification.\n- Retry after stale broker incarnation requires a new signed request and operation.\n\n## Verification and publication\n\n### Ingest verification\n\nIngest verifies only:\n\n- Signed lengths\n- SHA-256 digests\n- Fixed role ordering\n- Safe file identity\n\nThen journal records `IngestReceipt`.\n\n### Semantic verification\n\nOpen pinned descriptors from `incoming`.\n\nAdd file-based verification:\n\n- Bundle verifier passes a stable read-only file descriptor path to Git.\n- Index-pack verifier passes a stable read-only pack path to Git.\n- Worktree decoder reads bounded sections from a descriptor.\n- Hash checks use incremental `pread`.\n- Identity and digest are rechecked after semantic verification.\n\nJournal then records `VerifyReceipt`.\n\n### Artifact publication\n\nAdd adoption support to `WorkspaceReplicaPublicationStore`.\n\nIt should:\n\n1. Accept pinned incoming descriptors plus prior verification receipt.\n2. Write bounded `artifact-set.json`.\n3. Recheck all identities and hashes.\n4. Rename `incoming/<operation_id>` to `published/<operation_id>` without replacement.\n5. Synchronize source and destination parents.\n6. Inspect final directory.\n7. Return `ReplicaPublicationReceipt`.\n\nKeep current bytes API as an explicit compatibility wrapper for existing tests. Production ingestion must use descriptor API.\n\nJournal records `PublishReceipt` only after durable final inspection.\n\n### Launcher staging\n\nPublished artifacts cannot be sent directly to root prepare.\n\nBroker-owned materializer must build:\n\n```text\n/var/lib/yinshi-launcher/staging/.<operation_id>.pending/\n  repo/\n  home/\n```\n\nIt reconstructs repository and worktree from pinned published artifacts. It then synchronizes and renames pending directory to:\n\n```text\n/var/lib/yinshi-launcher/staging/<operation_id>\n```\n\nRoot launcher then performs existing transitions:\n\n```text\nprepare -> launch -> reclaim\n```\n\nNo path enters root protocol. Only operation ID enters it.\n\n## State ownership\n\n| State | Owner |\n|---|---|\n| Source snapshot and desktop private key | Desktop |\n| SSH session authorization | SSH infrastructure |\n| Signed logical request and replay identity | `BrokerReplicaJournal` |\n| Partial upload descriptors | Broker ingestion handler |\n| Incoming immutable artifact set | `BrokerArtifactStore` |\n| Semantic verification result | Broker journal |\n| Published immutable artifacts | `WorkspaceReplicaPublicationStore` |\n| Unprepared `repo/home` tree | Broker |\n| Promotion and ownership transfer | Root launcher |\n| Prepared operation directory | Root |\n| Prepared `repo/home` | Allocated executor |\n| Runtime listener and retained descriptor | Broker runtime |\n| Reclaim quarantine and deletion | Root launcher |\n\n## Permitted transitions\n\n```text\nabsent\n  -> accepted\n  -> claimed\n  -> ingest_started\n  -> ingested\n  -> verify_started\n  -> verified\n  -> publish_started\n  -> published\n  -> admission\n  -> drain\n  -> export\n  -> reclaim\n```\n\nDisk transitions:\n\n```text\nabsent\n  -> private attempt\n  -> synchronized incoming\n  -> verified incoming\n  -> published artifacts\n  -> materialization pending\n  -> launcher staging\n  -> protected replica\n  -> quarantine\n  -> reclaimed\n```\n\n## Invalid transitions\n\n- Reading artifact bytes before request authentication\n- Unknown, missing, duplicated, or reordered roles\n- Duplicate artifact IDs\n- Declared limits above server ceilings\n- Truncation or trailing data\n- Artifact ID used as a path\n- Replacing existing incoming, published, staging, or replica state\n- Verification completion before ingest completion\n- Publication completion before semantic verification\n- Root prepare before exact `repo/home` staging exists\n- Launch after unresolved synchronization\n- Adopting orphan disk state without matching signed journal request\n- Continuing when both incoming and published states exist\n- Converting journal or filesystem uncertainty into success\n\n## Failure and cancellation outcomes\n\n- Authentication failure: close without signed success.\n- Limit failure before upload: signed rejection when request authentication succeeded.\n- Digest or length mismatch: `artifact_rejected`.\n- Declared aggregate overflow: `limit_rejected`.\n- Semantic failure: `verification_rejected`.\n- Confirmed publication collision: `publication_rejected`.\n- Rename or synchronization uncertainty: `publication_unknown` or `synchronization_unknown`.\n- Cancellation during partial receive: clean only pinned owned attempt.\n- Uncertain cleanup: `transfer_unknown`.\n- Cancellation after durable ingest: shield verification and publication. Journal remains authoritative.\n- SQLite failure before acceptance: do not read artifact bytes.\n- SQLite commit uncertainty after bytes: retain synchronized files, return no success, and reconcile exact row plus exact files.\n- Identity uncertainty: fail closed and retain state.\n\n## Restart behavior\n\nStartup reconciliation must use `BrokerReplicaJournal.incomplete_lifecycles()`.\n\nFor each stored signed request:\n\n- Reauthenticate stored frame.\n- Reconstruct fixed manifest.\n- Open only descriptor-relative fixed locations.\n- Resume ingest completion when exact incoming files exist.\n- Repeat semantic verification because it has no external irreversible effect.\n- Inspect exact published state before completing publish.\n- Quarantine partial or foreign state.\n- Mark ambiguity unresolved.\n- Never adopt an unjournaled operation.\n- Never overwrite state to make recovery succeed.\n\nReceipts should be deterministic from request identity and verified state. This permits safe replay after commit-response loss.\n\n## Exact module and API additions\n\n### New modules\n\n`backend/src/yinshi/services/broker_artifact_store.py`\n\n```python\n@dataclass(frozen=True)\nclass OpenedReplicaArtifacts:\n    operation_id: str\n    bundle: OpenedArtifact\n    worktree: OpenedArtifact\n    index_objects: OpenedArtifact\n\nclass BrokerArtifactStore:\n    async def receive(\n        self,\n        manifest: ReplicaArtifactManifest,\n        reader: asyncio.StreamReader,\n    ) -> IngestReceipt: ...\n\n    @contextmanager\n    def open_incoming(\n        self,\n        manifest: ReplicaArtifactManifest,\n    ) -> Iterator[OpenedReplicaArtifacts]: ...\n\n    def inspect_incoming(\n        self,\n        manifest: ReplicaArtifactManifest,\n    ) -> IngestReceipt: ...\n\n    def reconcile_attempts(\n        self,\n        journal_operations: frozenset[str],\n    ) -> tuple[ReconciliationResult, ...]: ...\n```\n\n`backend/src/yinshi/services/broker_replica_service.py`\n\n```python\nclass BrokerReplicaService:\n    async def handle_upload(\n        self,\n        request: BrokerRequest,\n        request_frame: bytes,\n        reader: asyncio.StreamReader,\n    ) -> bytes: ...\n\n    async def recover_startup(self) -> None: ...\n```\n\n`backend/src/yinshi/broker_artifact_stdio_relay.py`\n\n```python\nasync def relay_upload(\n    *,\n    broker_socket: Path = DEFAULT_BROKER_SOCKET,\n) -> bytes: ...\n```\n\nProduction entry point accepts no arguments.\n\n`desktop/src/brokerArtifactUpload.ts`\n\n```typescript\nexport async function uploadReplicaArtifacts(\n  request: SignedBrokerRequest,\n  artifacts: ReplicaArtifactFiles,\n): Promise<SignedBrokerResponse>;\n```\n\nRemote command must be a fixed constant. API must not accept a socket path or arbitrary remote command.\n\n### Existing module changes\n\n`backend/src/yinshi/services/broker_protocol.py`\n\n- Add strict `ReplicaArtifactManifest`.\n- Add `parse_replica_lifecycle_payload`.\n- Add shared `compute_replica_artifact_set_sha256`.\n- Require distinct artifact IDs.\n\n`backend/src/yinshi/execution_daemons.py`\n\n- Split framed request reading from EOF enforcement.\n- Authenticate initial frame before reading upload tail.\n- Dispatch `executor.launch` to existing service.\n- Dispatch `replica.lifecycle` to replica service.\n- Preserve EOF requirement for ordinary broker relay.\n- Replace total upload timeout with bounded idle deadlines.\n\n`backend/src/yinshi/services/workspace_replica_publication.py`\n\n```python\nasync def verify_artifact_files(\n    declaration: ReplicaArtifactSetDeclaration,\n    artifacts: OpenedReplicaArtifacts,\n) -> ReplicaVerificationReceipt: ...\n\nasync def adopt_verified_artifact_set(\n    declaration: ReplicaArtifactSetDeclaration,\n    artifacts: OpenedReplicaArtifacts,\n    verification: ReplicaVerificationReceipt,\n) -> ReplicaPublicationReceipt: ...\n```\n\nKeep `publish_artifact_set(...bytes...)` only as compatibility wrapper.\n\n`backend/src/yinshi/services/workspace_replica_bundle.py`\n\n```python\nasync def verify_committed_bundle_file(\n    descriptor: int,\n    *,\n    object_format: Literal[\"sha1\", \"sha256\"],\n    limits: BundleLimits,\n) -> VerifiedCommittedBundle: ...\n```\n\n`backend/src/yinshi/services/workspace_replica_object_pack.py`\n\n```python\nasync def verify_index_object_pack_file(\n    descriptor: int,\n    *,\n    object_format: Literal[\"sha1\", \"sha256\"],\n    expected_oids: Sequence[str],\n    limits: IndexObjectPackLimits,\n) -> VerifiedIndexObjectPack: ...\n```\n\n`backend/src/yinshi/services/workspace_replica_artifact.py`\n\n```python\ndef inspect_worktree_artifact_file(\n    descriptor: int,\n    *,\n    limits: ArtifactLimits,\n) -> VerifiedWorktreeArtifactMetadata: ...\n```\n\nMaterialization should use a streaming entry visitor rather than retaining every content payload.\n\n## Rejected alternatives\n\n- **Put artifacts in signed JSON:** rejected by 65,536-byte broker frame ceiling.\n- **Use current relay for raw trailing bytes:** rejected because it requires one framed request and EOF.\n- **Use SCP or SFTP into launcher staging:** rejected because `yinshi-app` does not own staging. It would also bypass journal admission.\n- **Let desktop select a Unix socket:** rejected because it breaks fixed relay boundary.\n- **Use artifact IDs as filenames:** rejected because IDs are caller-controlled identifiers.\n- **Point publication store at launcher staging:** rejected by root launcher exact `repo/home` check.\n- **Sign each 64 KiB chunk:** rejected as unnecessary. Signed whole-file length and digest already bind complete ordered content.\n- **Rely on SSH authentication alone:** rejected because broker sees only local Unix UID.\n\n## Privileged infrastructure blockers\n\nProduction gates must remain off until these receive approval:\n\n1. Install and allowlist fixed SSH command `yinshi-broker-artifact-upload`.\n2. Confirm `yinshi-app` cannot request arbitrary relay commands or socket paths.\n3. Provision desktop Ed25519 public key into protected broker configuration.\n4. Create broker-owned incoming and published roots through `tmpfiles.d`.\n5. Define disk quota or reserved capacity for concurrent 1 GiB uploads.\n6. Isolate untrusted Git verification from broker signing keys.\n\nLast item may require a dedicated verifier service account or systemd sandbox. Root launcher actions should not expand beyond prepare, launch, and reclaim.\n\n## Residual risks\n\n- Whole-file SHA-256 detects corruption only after received bytes consume bandwidth and temporary disk.\n- Persistent abandoned attempts need bounded quarantine retention.\n- Worktree streaming decoder requires careful parser equivalence tests.\n- Git subprocess compromise remains dangerous if verification runs with broker key access.\n- Artifact-set digest definition needs explicit compatibility approval before persisted meaning changes.\n- No implementation or runtime validation occurred because task was read-only."}],"isError":false,"timestamp":1789267593583}}
