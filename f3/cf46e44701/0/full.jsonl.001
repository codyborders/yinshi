  intent = json.loads(operation[\"trials_json\"])[0]\n         trial_root = Path(intent[\"path\"]).parent\n-        retained = (\n-            Path(git_repo) / \".git\" / \".yinshi-integration-retained-v1\" / intent[\"id\"]\n-        )\n+        retained = Path(git_repo) / \".git\" / \".yinshi-integration-retained-v1\" / intent[\"id\"]\n         marker_directory = Path(git_repo) / \".git\" / \".yinshi-workspace-admission-v1\"\n         assert operation[\"status\"] == \"applying\"\n         assert operation[\"reason_code\"] == \"trial_cleanup_pending\"\n         assert operation[\"resulting_parent_head\"] == operation[\"trial_commit\"]\n         assert run_git(\"rev-parse\", \"HEAD\", cwd=git_repo) == operation[\"trial_commit\"]\n-        ref_value = run_git(\n-            \"for-each-ref\", \"--format=%(objectname)\", intent[\"ref\"], cwd=git_repo\n-        )\n+        ref_value = run_git(\"for-each-ref\", \"--format=%(objectname)\", intent[\"ref\"], cwd=git_repo)\n         if stage == \"metadata_retired\":\n             assert ref_value == operation[\"trial_commit\"]\n             assert sorted(entry.name for entry in trial_root.iterdir()) == [\n                 \"metadata-quarantine\",\n@@ -773,11 +767,9 @@\n                 \"quarantine\",\n             ]\n         assert len(list(marker_directory.glob(\"*.json\"))) == 1\n         monkeypatch.setattr(thread_workspaces, \"_run_git\", real_git)\n-        monkeypatch.setattr(\n-            ThreadWorkspaceService, \"_rename_no_replace\", staticmethod(real_rename)\n-        )\n+        monkeypatch.setattr(ThreadWorkspaceService, \"_rename_no_replace\", staticmethod(real_rename))\n         replay = await http.post(endpoint, json=payload)\n \n     assert replay.status_code == 200, replay.text\n     assert replay.json()[\"status\"] == \"integrated\"\n","firstChangedLine":717},"isError":false,"timestamp":1789284663292}}
