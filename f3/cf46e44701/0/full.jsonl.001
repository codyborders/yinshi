{"type":"message","id":"bca9fc0e","parentId":"addfdc86","timestamp":"2026-09-12T20:44:04.698Z","message":{"role":"toolResult","toolCallId":"call_sSqMLnBzhQV8vGYdMJxoPB16|fc_0212e7de83dbbd32016aa5b994308087d0a17edf3eb2c38195","toolName":"read","content":[{"type":"text","text":"        sha256=hashlib.sha256(content).hexdigest(),\n        byte_length=len(content),\n    )\n\n\nasync def declaration_and_bytes(tmp_path: Path):\n    bundle, worktree, object_pack = await artifact_set(tmp_path)\n    declaration = ReplicaArtifactSetDeclaration(\n        version=2,\n        operation_id=\"0123456789abcdef\",\n        repository_id=\"repo-1\",\n        workspace_id=\"workspace-1\",\n        identity=ReplicaIdentity(\n            physical_target_id=\"target-1\",\n            replica_generation=1,\n            execution_owner_id=\"yinshi-executor-00\",\n        ),\n        object_format=\"sha1\",\n        source_state_sha256=decode_worktree_artifact(worktree).source_state_sha256.hex(),\n        reconciliation_fingerprint=\"a\" * 64,\n        bundle=binding(\n            \"committed_bundle\",\n            \"application/vnd.yinshi.git-bundle.v1\",\n            \"bundle-1\",\n            bundle.bundle_bytes,\n        ),\n        worktree=binding(\n            \"worktree\",\n            \"application/vnd.yinshi.replica-worktree.v1\",\n            \"worktree-1\",\n\n[509 more lines in file. Use offset=130 to continue.]"}],"isError":false,"timestamp":1789245844698}}
