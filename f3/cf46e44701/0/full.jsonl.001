maxima: dict[str, int],\n    expected_uid: int,\n    expected_gid: int,\n) -> list[_PinnedRegular]:\n    pins: list[_PinnedRegular] = []\n    try:\n        for name, maximum in maxima.items():\n            pins.append(\n                _open_pinned_regular(\n\n[1008 more lines in file. Use offset=710 to continue.]"}],"isError":false,"timestamp":1789319160792}}
