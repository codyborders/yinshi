{"type":"message","id":"2972b2aa","parentId":"8d0ab04c","timestamp":"2026-09-12T18:20:24.925Z","message":{"role":"toolResult","toolCallId":"call_5x5idNnfMPqvc2Du3rzmZovh|fc_0212e7de83dbbd32016aa597e8608c87d084c0ae8d2d76c687","toolName":"read","content":[{"type":"text","text":"\"\"\"Validate bounded deterministic workspace-replica artifact encoding.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport struct\nimport subprocess\nimport tempfile\nfrom dataclasses import replace\nfrom typing import cast\n\nimport pytest\n\nimport yinshi.services.workspace_replica_artifact as artifact_module\nfrom yinshi.services.workspace_replica_artifact import (\n    ArtifactLimits,\n    ManifestEntry,\n    WorktreeArtifactDecodeError,\n    WorktreeArtifactEncodeError,\n    WorktreeArtifactInput,\n    WorktreeEntryKind,\n    decode_worktree_artifact,\n    encode_worktree_artifact,\n)\n\nOID = b\"a\" * 20\nOTHER_OID = b\"b\" * 20\n# --- Git index binary fixture helpers ---\n\n\ndef _sha1_checksum(data: bytes) -> bytes:\n    \"\"\"Return the SHA-1 checksum of data for Git index v2.\"\"\"\n    return hashlib.sha1(data).digest()\n\n\ndef _build_git_index_v2(entries: list[tuple[int, bytes, bytes]]) -> bytes:\n    \"\"\"Build a Git index v2 blob.\n\n    Each entry is (mode, sha1_20_bytes, path_bytes).\n    Returns the full index bytes including header, entries, and trailing checksum.\n    \"\"\"\n    # Build entry table first (without checksum)\n    table = bytearray()\n    for mode, sha1, path in entries:\n        table += struct.pack(\">II\", mode, 1)  # ce_u32(mode), ce_u32(sha1[0..3])\n        table += sha1[4:]  # remaining 16 bytes of sha1\n        flags = (len(path) & 0xFFF)  # stage = 0\n        table += struct.pack(\">H\", flags)\n        table += path\n        if path and not path.endswith(b\"\\x00\"):\n            table += b\"\\x00\"\n    # Pad to 8-byte boundary\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    # Trailing checksum = sha1 of everything before\n    checksum = _sha1_checksum(bytes(table))\n    return b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", len(entries)) + bytes(table) + checksum\n\n\ndef _build_git_index_v3(entries: list[tuple[int, bytes, bytes]]) -> bytes:\n    \"\"\"Build a Git index v3 blob with ctime/mtime/dev/ino/fullmode/uid/gid/size.\n\n    Each entry is (mode, sha1_20_bytes, path_bytes).\n    Returns the full index bytes including header, entries, and trailing checksum.\n    \"\"\"\n    table = bytearray()\n    for mode, sha1, path in entries:\n        table += struct.pack(\">I\", mode & 0xFFF)  # ce_u32(mode low bits)\n        table += sha1[4:]  # remaining 16 bytes of sha1 after first 4 bytes\n        flags = len(path) & 0xFFF\n        table += struct.pack(\">H\", flags)\n        # ctime_s, ctime_n, mtime_s, mtime_n, dev, ino, fullmode, uid, gid, size\n        table += struct.pack(\">IIIIIIIIII\", 0, 0, 0, 0, 0, 0, mode, 0, 0, 0)\n        table += path\n        if path and not path.endswith(b\"\\x00\"):\n            table += b\"\\x00\"\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    return b\"DIRC\\x03\\x00\\x00\\x00\" + struct.pack(\">I\", len(entries)) + bytes(table) + checksum\n\n\ndef _build_git_index_v2_sha256(entries: list[tuple[int, bytes, bytes]]) -> bytes:\n    \"\"\"Build a Git index v2 blob using 32-byte SHA-256 hashes.\"\"\"\n    table = bytearray()\n    for mode, sha256, path in entries:\n        table += struct.pack(\">I\", mode)\n        table += sha256  # 32 bytes\n        flags = len(path) & 0xFFF\n        table += struct.pack(\">H\", flags)\n        table += path\n        if path and not path.endswith(b\"\\x00\"):\n            table += b\"\\x00\"\n    padding = (-len(table)) & 7\n    table += b\"\\x00\" * padding\n    checksum = _sha1_checksum(bytes(table))\n    return b\"DIRC\\x02\\x00\\x00\\x00\" + struct.pack(\">I\", len(entries)) + bytes(table) + checksum\n\n\n\n[1515 more lines in file. Use offset=101 to continue.]"}],"isError":false,"timestamp":1789237224925}}
