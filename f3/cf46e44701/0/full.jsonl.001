ath\"]) != conflict_snapshot:\n                    return False\n            raw_common = await _run_git_bytes(\n                [\"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\"],\n                cwd=context.repo_path,\n            )\n            common = Path(os.fsdecode(raw_common.removesuffix(b\"\\n\"))).resolve(strict=True)\n            removed = await self._run_threaded_mutation(\n                self._quarantine_conflict_trial,\n                root,\n                Path(intent[\"path\"]),\n                common,\n                conflict_snapshot,\n            )\n            if await self._trial_worktree_registered(context.repo_path, intent[\"path\"]):\n                return False\n            return removed\n\n    async def cleanup_integration_trial(\n        self,\n        context: ThreadParentGitContext,\n        intent: dict[str, str],\n        *,\n        database_identity: str,\n        namespace: str,\n        expected_parent_head: str,\n        known_commit: str | None,\n        physical_identity: str,\n        reauthorize: Callable[[], Awaitable[None]],\n    ) -> bool:\n        \"\"\"Quarantine all owned bytes and retire only exact active Git artifacts.\"\"\"\n        root = await self._validate_trial_intent(context, intent)\n        manifest = self._trial_manifest(intent)\n        raw_common = await _run_git_bytes(\n            [\"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\"],\n            cwd=context.repo_path,\n        )\n        common = Path(os.fsdecode(raw_common.removesuffix(b\"\\n\"))).resolve(strict=True)\n        retained_root = common / \".yinshi-integration-retained-v1\" / intent[\"id\"]\n        async with (\n            repository_lifecycle(context.repo_id, context.lock_root),\n            thread_git_namespace(\n                context.repo_path, context.branch, database_identity, create_owner=False\n            ) as actual,\n        ):\n            if (\n                actual != namespace\n                or await self.integration_workspace_identity(context) != physical_identity\n            ):\n                raise ThreadGitOwnershipError()\n            await reauthorize()\n            present = await asyncio.to_thread(os.path.lexists, root)\n            retained = await asyncio.to_thread(os.path.lexists, retained_root)\n            ref = await self._exact_ref_value(context.repo_path, intent[\"ref\"])\n            registered = await self._trial_worktree_registered(context.repo_path, intent[\"path\"])\n            if not present:\n                if ref is not None or registered:\n                    raise ThreadGitOwnershipError()\n                if retained:\n                    await asyncio.to_thread(\n                        self._check_trial_root,\n                        retained_root,\n                        manifest,\n                        allowed_phases=frozenset({_TRIAL_PHASE_METADATA_QUARANTINE}),\n                    )\n                return True\n            if retained:\n                raise ThreadGitOwnershipError()\n            phase = await asyncio.to_thread(\n                self._check_trial_root,\n                root,\n                manifest,\n                allowed_phases=_TRIAL_PHASES,\n            )\n            if phase == _TRIAL_PHASE_MANIFEST:\n                if ref is not None or registered:\n                    raise ThreadGitOwnershipError()\n                return await self._run_threaded_mutation(\n                    self._remove_trial_manifest, root, manifest\n                )\n            if phase == _TRIAL_PHASE_ACTIVE:\n                if not registered:\n                    raise ThreadGitOwnershipError()\n                await verify_thread_git_workspace(intent[\"path\"], context.branch, namespace)\n                if (\n                    await _run_git(\n                        [\"rev-parse\", \"--symbolic-full-name\", \"HEAD\"], cwd=intent[\"path\"]\n                    )\n                    != \"HEAD\"\n                ):\n                    return False\n                head = await _run_git(\n                    [\"--no-replace-objects\", \"rev-parse\", \"HEAD\"], cwd=intent[\"path\"]\n                )\n                expected = expected_parent_head if known_commit is None else known_commit\n                if (\n                    head != expected\n                    or (known_commit is None and ref is not None)\n                    or (known_commit is not None and ref != known_commit)\n                ):\n                    return False\n                snapshot = await self._integration_trial_snapshot(intent[\"path\"])\n                await reauthorize()\n                if await self.integration_workspace_identity(context) != physical_identity:\n                    raise ThreadGitOwnershipError()\n                await self._run_threaded_mutation(\n                    self._quarantine_trial_bytes,\n                    root,\n                    Path(intent[\"path\"]),\n                    common,\n                    snapshot,\n                    False,\n                )\n            elif phase == _TRIAL_PHASE_QUARANTINE:\n                snapshot = await self._integration_trial_snapshot(str(root / \"quarantine\"))\n                await self._run_threaded_mutation(\n                    self._quarantine_trial_bytes,\n                    root,\n                    Path(intent[\"path\"]),\n                    common,\n                    snapshot,\n                    False,\n                )\n            if await self._trial_worktree_registered(context.repo_path, intent[\"path\"]):\n                return False\n            current_ref = await self._exact_ref_value(context.repo_path, intent[\"ref\"])\n            if current_ref is not None:\n                if known_commit is None or current_ref != known_commit:\n                    raise ThreadGitOwnershipError()\n                await _run_git(\n                    [\"update-ref\", \"--no-deref\", \"-d\", intent[\"ref\"], known_commit],\n                    cwd=context.repo_path,\n                )\n            if await self._exact_ref_value(context.repo_path, intent[\"ref\"]) is not None:\n                return False\n            if await self._trial_worktree_registered(context.repo_path, intent[\"path\"]):\n                return False\n            await self._run_threaded_mutation(\n                self._retain_quarantined_trial, root, retained_root, manifest\n            )\n            return not await asyncio.to_thread(os.path.lexists, root)\n\n    @staticmethod\n    def _remove_trial_manifest(root: Path, manifest: dict[str, str]) -> bool:\n        ThreadWorkspaceService._check_trial_root(root, manifest)\n        directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n        try:\n            if os.listdir(directory) != [\"owner.json\"]:\n                return False\n            os.unlink(\"owner.json\", dir_fd=directory)\n            os.fsync(directory)\n        finally:\n            os.close(directory)\n        root.rmdir()\n        parent = os.open(root.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n        try:\n            os.fsync(parent)\n        finally:\n            os.close(parent)\n        return True\n\n    async def apply_integration_trial(\n        self,\n        context: ThreadParentGitContext,\n        intent: dict[str, str],\n        *,\n        database_identity: str,\n        namespace: str,\n        parent_branch: str,\n        expected_parent_head: str,\n        trial_commit: str,\n        owned_worktrees: tuple[ThreadGitWorktree, ...],\n        reauthorize: Callable[[], Awaitable[None]],\n        physical_identity: str,\n        allow_apply: bool = True,\n        application_may_have_started: bool = False,\n        mark_applying: Callable[[], Awaitable[None]] | None = None,\n    ) -> str | None:\n\n[1218 more lines in file. Use offset=1660 to continue.]"}],"isError":false,"timestamp":1789281314261}}
