# Yinshi Configuration

# Authentication is disabled only through this explicit local-development flag.
DISABLE_AUTH=true

# Google OAuth (required when DISABLE_AUTH=false unless GitHub OAuth is complete)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback/google

# GitHub OAuth (optional -- leave empty to disable GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback/github

# GitHub App (required for private GitHub repo imports)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=
# GitHub App user-authorization credentials prove installation ownership.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_USER_CALLBACK_URL=http://localhost:8000/auth/github/install/verify

# Session signing key: use at least 32 random bytes with diverse characters.
SECRET_KEY=

# Server-managed key encryption key for wrapping per-user DEKs.
# Generate 32+ random bytes and store as hex. ENCRYPTION_PEPPER remains as
# legacy fallback only for existing deployments.
KEY_ENCRYPTION_KEY=
KEY_ENCRYPTION_KEY_ID=local-v1
# During rotation, map previous key IDs to hex keys until all data is rewrapped.
KEY_ENCRYPTION_KEYS_PREVIOUS={}
ENCRYPTION_PEPPER=

# Middle-ground storage encryption controls.
# Production should use TENANT_DB_ENCRYPTION=required with sqlcipher3/pysqlcipher3
# installed, and place USER_DATA_DIR on fscrypt/LUKS/encrypted-volume storage.
TENANT_DB_ENCRYPTION=auto
CONTROL_FIELD_ENCRYPTION=auto
USER_DATA_ENCRYPTION=disabled
REQUIRE_HTTPS=auto
HSTS_ENABLED=true
TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_HOSTS=yinshi.example.com,localhost,127.0.0.1,[::1]
REQUEST_BODY_MAX_BYTES=10485760

# Backups use a separate 32-byte key encoded as 64 hexadecimal characters.
BACKUP_DIR=/var/lib/yinshi/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
# Optional absolute executable path. Script receives encrypted artifact path as its only argument.
BACKUP_UPLOAD_COMMAND=

# Database path
DB_PATH=yinshi.db

# Host-side sidecar socket (used only when CONTAINER_ENABLED=false)
SIDECAR_SOCKET_PATH=/tmp/yinshi-sidecar.sock

# Managed Fly Sprites runtime. Leave disabled for local and BYOC deployments.
MANAGED_RUNTIME_PROVIDER=disabled
# Public launch requires Fly Sprites plus verified off-provider backup and restore.
SPRITES_PUBLIC_LAUNCH_ENABLED=false
# Set true only after Sprite storage encryption is confirmed for this deployment.
SPRITES_STORAGE_ENCRYPTION_CONFIRMED=false
# Secret values stay empty in this example. Configure them through deployment secrets.
SPRITES_API_TOKEN=
SPRITES_API_URL=https://api.sprites.dev/v1
SPRITES_NAME_PREFIX=yinshi
SPRITES_NAME_KEY=
SPRITES_ARTIFACT_URL=https://artifacts.example.com/yinshi-runner.pyz
SPRITES_ARTIFACT_SHA256=<64-lowercase-hex-sha256>
SPRITES_ALLOWED_DOMAINS=registry.npmjs.org,nodejs.org,pypi.org,files.pythonhosted.org,auth.openai.com,chatgpt.com,api.openai.com,control.example.com
SPRITES_PUBLIC_CONTROL_URL=https://control.example.com
SPRITES_BOOTSTRAP_SCRIPT_PATH=/absolute/path/to/bootstrap.sh
SPRITES_WAKE_TIMEOUT_SECONDS=30
SPRITES_OPERATION_STALE_SECONDS=1800

# Independent encrypted managed guest backups. Supported providers are aws_s3 and
# digitalocean_spaces. All archives use AES-256-GCM before upload.
MANAGED_BACKUP_PROVIDER=aws_s3
MANAGED_BACKUP_BUCKET=
MANAGED_BACKUP_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
MANAGED_BACKUP_REGION=us-east-1
MANAGED_BACKUP_ACCESS_KEY_ID=
MANAGED_BACKUP_SECRET_ACCESS_KEY=
MANAGED_BACKUP_PREFIX=yinshi-managed-v1
MANAGED_BACKUP_PART_BYTES=16777216
MANAGED_BACKUP_RETENTION_DAYS=30

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
# Per-user container isolation is mandatory when authentication is enabled.
# Explicit loopback no-auth development must keep this false.
CONTAINER_ENABLED=false
CONTAINER_MOUNT_MODE=narrow
TERMINAL_KEEPALIVE_S=7200
TERMINAL_SCROLLBACK_LINES=1000

# Pi agent API key (used by sidecar)
ANTHROPIC_API_KEY=
