[Unit]
Description=Yinshi fixed-profile root launcher foundation
Requires=yinshi-launcher.socket
After=yinshi-launcher.socket

[Service]
Type=simple
UMask=0077
ExecStart=/opt/yinshi/runtime-v1/bin/yinshi-root-launcher --systemd-socket
Environment=YINSHI_LAUNCH_EXECUTION_ENABLED=false
Environment=YINSHI_REPLICA_PREPARE_ENABLED=false
Environment=YINSHI_REPLICA_RECLAIM_ENABLED=false
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/yinshi-launcher /run/yinshi-launcher-state
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Root identity is intentional. The process only validates one fixed action and asks systemd to create a locked unit.
# Deliberately no [Install] section. Foundation must not be enabled at boot.
